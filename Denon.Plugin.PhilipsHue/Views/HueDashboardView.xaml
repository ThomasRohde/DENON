<UserControl x:Class="Denon.Plugin.PhilipsHue.Views.HueDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Denon.Plugin.PhilipsHue.Views"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="960"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="Segoe UI Variable Display, Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HueBoolToVis" />
        <views:HexColorToBrushConverter x:Key="HexToBrush" />

        <SolidColorBrush x:Key="HueCardBg" Color="{StaticResource Ink04Color}" />
        <SolidColorBrush x:Key="HueCardInnerBg" Color="{StaticResource Ink06Color}" />
        <SolidColorBrush x:Key="HueControlBg" Color="{StaticResource Ink07Color}" />
        <SolidColorBrush x:Key="HueBorder" Color="{StaticResource Ink09Color}" />
        <SolidColorBrush x:Key="HueTextPrimary" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="HueTextSecondary" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="HueTextMuted" Color="{StaticResource TextFaintColor}" />
        <SolidColorBrush x:Key="HueAmber" Color="{StaticResource AccentAmberColor}" />
        <SolidColorBrush x:Key="HueCyan" Color="{StaticResource AccentCyanColor}" />
        <SolidColorBrush x:Key="HueEmerald" Color="{StaticResource AccentEmeraldColor}" />

        <Style x:Key="HueSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        </Style>

        <Style x:Key="HueSurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HueCardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource HueBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="HueButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSpecBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ink11Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink16Brush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HuePrimaryButton" TargetType="Button" BasedOn="{StaticResource HueButton}">
            <Setter Property="Background" Value="{StaticResource AccentAmberDeepBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HueTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="CaretBrush" Value="{StaticResource AccentAmberBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="HueCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">

            <!-- ================= BRIDGE CONNECTION & PAIRING CARD ================= -->
            <Border Style="{StaticResource HueSurfaceCard}" Padding="16,12" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentAmberSubtleBgBrush}" BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Philips Hue Smart Lighting" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource HueTextPrimary}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Ink03Brush}"
                                        BorderBrush="{Binding ConnectionBadgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="9,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding ConnectionBadgeBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConnectionBadgeText}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding ConnectionBadgeBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource AccentCyanBrightBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="All On" Command="{Binding AllLightsOnCommand}" Style="{StaticResource HueButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}" />
                            <Button Content="All Off" Command="{Binding AllLightsOffCommand}" Style="{StaticResource HueButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}" />
                            <Button Content="Sync" Command="{Binding RefreshStateCommand}" Style="{StaticResource HueButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}" />
                            <Button Content="{Binding SetupToggleLabel}" Command="{Binding ToggleSetupCommand}" Style="{StaticResource HueButton}" Padding="10,5" FontSize="11.5" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}" />
                        </WrapPanel>
                    </Grid>

                    <!-- Collapsible Bridge IP, Discovery & Pairing Panel (auto-collapses once connected!) -->
                    <Border Background="{StaticResource Ink03Brush}"
                            BorderBrush="{StaticResource Ink11Brush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,12,0,0"
                            Visibility="{Binding ShowSetupControls, Converter={StaticResource HueBoolToVis}}">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="BRIDGE IP" Style="{StaticResource HueSectionLabel}" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Text="{Binding BridgeIpInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HueTextBox}" Tag="192.168.1.16" Width="152" Margin="0,0,8,6" ToolTip="Local LAN IP of your Philips Hue Bridge (e.g. 192.168.1.42)" />
                                <Button Content="Auto-Discover" Command="{Binding DiscoverBridgeCommand}" Style="{StaticResource HueButton}" Padding="10,6" Margin="0,0,6,6" />
                                <Button Content="Press Bridge Button &amp; Pair" Command="{Binding StartPairingCommand}" Style="{StaticResource HuePrimaryButton}" Padding="11,6" Margin="0,0,6,6" />
                                <Button Content="Cancel" Command="{Binding CancelPairingCommand}" Style="{StaticResource HueButton}" Padding="10,6" Visibility="{Binding IsPairing, Converter={StaticResource HueBoolToVis}}" Margin="0,0,6,6" />
                                <Button Content="{Binding DemoModeButtonLabel}" Command="{Binding ToggleDemoModeCommand}" Style="{StaticResource HueButton}" Padding="10,6" Margin="0,0,6,6" ToolTip="Simulate a 6-light Philips Hue setup to preview controls &amp; AVR automations" />
                                <Button Content="Unlink" Command="{Binding DisconnectBridgeCommand}" Style="{StaticResource HueButton}" Padding="10,6" Visibility="{Binding IsPaired, Converter={StaticResource HueBoolToVis}}" Margin="0,0,0,6" />
                            </WrapPanel>

                            <!-- Discovered Bridges Pills -->
                            <ItemsControl ItemsSource="{Binding DiscoveredBridges}"
                                          Visibility="{Binding HasDiscoveredBridges, Converter={StaticResource HueBoolToVis}}"
                                          Margin="0,4,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectDiscoveredBridgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource HueButton}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Bridge " Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" />
                                                <TextBlock Text="{Binding IpAddress}" FontWeight="SemiBold" FontSize="11.5" />
                                                <TextBlock Text="{Binding Source, StringFormat=' ({0})'}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Pairing countdown banner -->
                            <Border Background="{StaticResource AccentAmberSubtleBgBrush}"
                                    BorderBrush="{StaticResource AccentAmberBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12,8"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding IsPairing, Converter={StaticResource HueBoolToVis}}">
                                <TextBlock Text="{Binding PairingHintText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentAmberTextBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= REAL-TIME MUSIC SYNC & ALBUM-ART AMBIENT ================= -->
            <Border Style="{StaticResource HueSurfaceCard}" Margin="0,0,0,14" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="REAL-TIME MUSIC SYNC &amp; ALBUM-ART AMBIENT"
                                       Style="{StaticResource HueSectionLabel}"
                                       VerticalAlignment="Center"
                                       Margin="0,2,10,2" />
                            <Border Background="{StaticResource Ink05Brush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,2,6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EntertainmentAreaSummary}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" />
                            </Border>
                            <Border Background="{StaticResource Ink05Brush}" BorderBrush="{StaticResource Ink14Brush}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,2,0,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MusicSyncStatusBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" />
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding DemoBeatButtonLabel}"
                                    Command="{Binding ToggleDemoBeatCommand}"
                                    Style="{StaticResource HueButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    Margin="0,0,6,0"
                                    ToolTip="Generate a 125 BPM test beat to preview FFT meters &amp; beat-reactive lighting live" />
                            <Button Content="{Binding MusicSyncToggleLabel}"
                                    Command="{Binding ToggleMusicSyncCommand}"
                                    Style="{StaticResource HuePrimaryButton}"
                                    Padding="12,5"
                                    FontSize="11.5" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: 4 Sync Modes + Sliders -->
                        <StackPanel Grid.Column="0">
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Bass Pulse" Command="{Binding SetMusicSyncModeCommand}" CommandParameter="BassPulse" Padding="10,5" FontSize="11.5" Margin="0,0,6,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicSyncModeName}" Value="BassPulse">
                                                    <Setter Property="Background" Value="{StaticResource AccentAmberSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Spectrum Split" Command="{Binding SetMusicSyncModeCommand}" CommandParameter="SpectrumSplit" Padding="10,5" FontSize="11.5" Margin="0,0,6,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicSyncModeName}" Value="SpectrumSplit">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Album-Art Ambient" Command="{Binding SetMusicSyncModeCommand}" CommandParameter="AlbumArtAmbient" Padding="10,5" FontSize="11.5" Margin="0,0,6,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicSyncModeName}" Value="AlbumArtAmbient">
                                                    <Setter Property="Background" Value="{StaticResource AccentPinkSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPinkBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentPinkTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Cinema Subtle" Command="{Binding SetMusicSyncModeCommand}" CommandParameter="CinemaSubtle" Padding="10,5" FontSize="11.5" Margin="0,0,6,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicSyncModeName}" Value="CinemaSubtle">
                                                    <Setter Property="Background" Value="{StaticResource AccentIndigoSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentIndigoBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentIndigoTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel>
                                        <TextBlock Text="SENSITIVITY" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding MusicSyncSensitivityLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="0.5" Maximum="2.5" SmallChange="0.1" LargeChange="0.25" Value="{Binding MusicSyncSensitivity}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock Text="MIN BRIGHT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding MusicSyncMinBrightness, StringFormat='{}{0}%'}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TextSoftBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="5" Maximum="80" Value="{Binding MusicSyncMinBrightness}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <DockPanel>
                                        <TextBlock Text="MAX BRIGHT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding MusicSyncMaxBrightness, StringFormat='{}{0}%'}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TextSoftBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="25" Maximum="100" Value="{Binding MusicSyncMaxBrightness}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Right: Live 3-Band FFT Audio Meter + Beat LED + Album Art Swatch -->
                        <Border Grid.Column="2" Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="LIVE FFT SPECTRUM" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Margin="0,0,5,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Ink14Brush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LiveBeatFlash}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentAmberBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="BEAT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BASS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentRoseTextBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="7" Minimum="0" Maximum="100" Value="{Binding LiveBassPercent, Mode=OneWay}" Foreground="{StaticResource AccentRoseTextBrush}" Background="{StaticResource Ink08Brush}" BorderThickness="0" />
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MIDS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="7" Minimum="0" Maximum="100" Value="{Binding LiveMidPercent, Mode=OneWay}" Foreground="{StaticResource AccentCyanBrush}" Background="{StaticResource Ink08Brush}" BorderThickness="0" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HIGH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentIndigoBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="7" Minimum="0" Maximum="100" Value="{Binding LiveTreblePercent, Mode=OneWay}" Foreground="{StaticResource AccentIndigoBrush}" Background="{StaticResource Ink08Brush}" BorderThickness="0" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{Binding AlbumArtDominantHex, Converter={StaticResource HexToBrush}}" Stroke="{StaticResource Ink16Brush}" StrokeThickness="1" Margin="0,0,4,0" />
                                    <Ellipse Width="12" Height="12" Fill="{Binding AlbumArtSecondaryHex, Converter={StaticResource HexToBrush}}" Stroke="{StaticResource Ink16Brush}" StrokeThickness="1" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding AlbumArtTrackLabel}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= MASTER & ROOM CONTROLS ================= -->
            <Grid Margin="0,0,0,14" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Master & Selected Room Control -->
                <Border Grid.Column="0" Style="{StaticResource HueSurfaceCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="MASTER &amp; ROOMS" Style="{StaticResource HueSectionLabel}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All On" Command="{Binding AllLightsOnCommand}" Style="{StaticResource HueButton}" Padding="10,4" FontSize="11" Margin="0,0,5,0" />
                                <Button Content="All Off" Command="{Binding AllLightsOffCommand}" Style="{StaticResource HueButton}" Padding="10,4" FontSize="11" Margin="0,0,8,0" />
                                <Button Content="15%" Command="{Binding SetAllBrightnessCommand}" CommandParameter="15" Style="{StaticResource HueButton}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" />
                                <Button Content="50%" Command="{Binding SetAllBrightnessCommand}" CommandParameter="50" Style="{StaticResource HueButton}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" />
                                <Button Content="100%" Command="{Binding SetAllBrightnessCommand}" CommandParameter="100" Style="{StaticResource HueButton}" Padding="8,4" FontSize="10.5" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Room Selector Chips -->
                        <ItemsControl ItemsSource="{Binding Rooms}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,8,8"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource CardElevatedBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Ink12Brush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Padding" Value="12,8" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="10"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentAmberSubtleBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selected Room Dimmer & Mood Swatches -->
                        <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource ControlHoverBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding SelectedRoomHeader}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Content="{Binding SelectedRoomToggleLabel}"
                                            Command="{Binding ToggleSelectedRoomCommand}"
                                            Style="{StaticResource HueButton}"
                                            Padding="10,4"
                                            FontSize="11"
                                            HorizontalAlignment="Right" />
                                </DockPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DIMMER" Style="{StaticResource HueSectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SelectedRoomBrightness}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedRoomBrightness, StringFormat='{}{0}%'}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="AMBIENCE PRESETS" Style="{StaticResource HueSectionLabel}" Margin="0,2,0,6" />
                                <ItemsControl ItemsSource="{Binding MoodPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ApplyMoodPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource HueButton}"
                                                    Padding="9,5"
                                                    Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding HexColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Hue Bridge Native Scenes -->
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding HasVisibleScenes, Converter={StaticResource HueBoolToVis}}">
                                    <TextBlock Text="HUE BRIDGE SCENES" Style="{StaticResource HueSectionLabel}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding VisibleScenes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}"
                                                        Command="{Binding DataContext.ActivateHueSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource HueButton}"
                                                        Padding="10,4"
                                                        FontSize="11"
                                                        Margin="0,0,6,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Denon AVR Reactive Automations -->
                <Border Grid.Column="2" Style="{StaticResource HueSurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="DENON AVR LIGHTING AUTOMATIONS" Style="{StaticResource HueSectionLabel}" Margin="0,0,0,6" />
                        <TextBlock Text="Automatically react when you switch Denon power, trigger Smart Scenes, or pause playback."
                                   FontSize="11.5"
                                   Foreground="{StaticResource HueTextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource ControlHoverBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TARGET ROOM" Style="{StaticResource HueSectionLabel}" />
                                    <TextBlock Text="{Binding AutomationTargetRoomLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentAmberBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Content="Use Selected Room"
                                        Command="{Binding UseSelectedRoomForAutomationCommand}"
                                        Style="{StaticResource HueButton}"
                                        Padding="10,5"
                                        FontSize="11"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <CheckBox IsChecked="{Binding SyncWithSmartScenes}" Style="{StaticResource HueCheckBox}">
                            <StackPanel>
                                <TextBlock Text="Sync with Denon Smart Scenes" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Movie Night → Cinema Dim • Late Night → Candlelight • Party → Neon" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding TurnOnWithReceiverPower}" Style="{StaticResource HueCheckBox}" Margin="0,8,0,4">
                            <StackPanel>
                                <TextBlock Text="Turn on Hue lights when Denon powers ON" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Brings up room ambiance automatically with your receiver" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding TurnOffWithReceiverStandby}" Style="{StaticResource HueCheckBox}" Margin="0,6,0,4">
                            <StackPanel>
                                <TextBlock Text="Turn off Hue lights when Denon enters Standby" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="One-button room shutdown when you turn off your AVR" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding CinemaPauseLights}" Style="{StaticResource HueCheckBox}" Margin="0,6,0,10">
                            <StackPanel>
                                <TextBlock Text="Cinema Pause Lights (Play / Pause sync)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Gently brightens to 55% on Pause, dims back to 18% on Resume" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                            <TextBlock Text="{Binding LastAutomationEventText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource AccentCyanBrightBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= INDIVIDUAL LIGHTS GRID ================= -->
            <Border Style="{StaticResource HueSurfaceCard}" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding IndividualLightsHeader}" Style="{StaticResource HueSectionLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Show All Lights"
                                    Command="{Binding ShowAllLightsCommand}"
                                    Style="{StaticResource HueButton}"
                                    Padding="9,3"
                                    FontSize="10.5"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding IsFilteredToSingleRoom, Converter={StaticResource HueBoolToVis}}" />
                            <TextBlock Text="Drag sliders to dim or adjust warmth"
                                       FontSize="11"
                                       Foreground="{StaticResource HueTextMuted}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding VisibleLights}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardElevatedBrush}"
                                        BorderBrush="{StaticResource Ink11Brush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Width="310"
                                        Margin="0,0,10,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="16" Height="16" Fill="{Binding PreviewBrush}" Stroke="{StaticResource Ink14Brush}" StrokeThickness="1" Margin="0,0,10,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding StateSummary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Content="{Binding PowerLabel}"
                                                    Command="{Binding ToggleCommand}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    MinWidth="54"
                                                    Padding="10,4"
                                                    FontSize="11">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentAmberSubtleBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentAmberTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DockPanel>

                                        <!-- Brightness Slider -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="BRIGHT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrightnessPercent}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding BrightnessPercent, StringFormat='{}{0}%'}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource TextSoftBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Color Temp Slider -->
                                        <Grid Margin="0,0,0,8" Visibility="{Binding SupportsColorTemp, Converter={StaticResource HueBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="WARMTH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="153" Maximum="500" Value="{Binding ColorTempMirek}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ColorTempKelvinLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource AccentAmberTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Quick Color Dots -->
                                        <ItemsControl ItemsSource="{Binding QuickSwatches}"
                                                      Visibility="{Binding SupportsColor, Converter={StaticResource HueBoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.ApplySwatchCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding Name}"
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,0,6,0"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="{Binding HexColor, Converter={StaticResource HexToBrush}}" Stroke="{StaticResource Ink16Brush}" StrokeThickness="1.2" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
