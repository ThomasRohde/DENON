<UserControl x:Class="Denon.Plugin.PhilipsHue.Views.HueDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.Plugin.PhilipsHue"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Denon.Plugin.PhilipsHue.Views"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="960"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource DisplayFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HueBoolToVis" />
        <views:HexColorToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="HueSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize03}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        </Style>

        <Style x:Key="HueButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="{skin:Space 12,7}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="HuePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="{skin:Space 12,7}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="HueTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="{skin:Space 10,6}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="HueCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize07}" />
            <Setter Property="Margin" Value="{skin:Space 0,4}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{skin:Space 0,0,4,12}">

            <!-- ================= BRIDGE CONNECTION & PAIRING CARD ================= -->
            <Border Style="{StaticResource SurfaceCard}" Padding="{skin:Space 16,12}" Margin="{skin:Space 0,0,0,14}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 12}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="{skin:Size 34}" Height="{skin:Size 34}" CornerRadius="{DynamicResource Radius03}" Background="{DynamicResource AccentAmberSubtleBgBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" Margin="{skin:Space 0,0,12,0}" VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="{DynamicResource FontSize11}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Philips Hue Smart Lighting" FontSize="{DynamicResource FontSize10}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Ink03Brush}"
                                        BorderBrush="{Binding ConnectionBadgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius04}"
                                        Padding="{skin:Space 9,2}"
                                        Margin="{skin:Space 10,0,0,0}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="{skin:Size 7}" Height="{skin:Size 7}" Fill="{Binding ConnectionBadgeBrush}" Margin="{skin:Space 0,0,6,0}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConnectionBadgeText}"
                                                   FontSize="{DynamicResource FontSize02}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding ConnectionBadgeBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="{DynamicResource FontSize05}"
                                       Foreground="{DynamicResource AccentCyanBrightBrush}"
                                       TextWrapping="Wrap"
                                       Margin="{skin:Space 0,2,0,0}" />
                        </StackPanel>

                        <WrapPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="All On" Command="{Binding AllLightsOnCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,0}" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}" />
                            <Button Content="All Off" Command="{Binding AllLightsOffCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,0}" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}" />
                            <Button Content="Sync" Command="{Binding RefreshStateCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,0}" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}" />
                            <Button Content="{Binding SetupToggleLabel}" Command="{Binding ToggleSetupCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}" />
                        </WrapPanel>
                    </Grid>

                    <!-- Collapsible Bridge IP, Discovery & Pairing Panel (auto-collapses once connected!) -->
                    <Border Background="{DynamicResource Ink03Brush}"
                            BorderBrush="{DynamicResource Ink11Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius04}"
                            Padding="{skin:Space 12,10}"
                            Margin="{skin:Space 0,12,0,0}"
                            Visibility="{Binding ShowSetupControls, Converter={StaticResource HueBoolToVis}}">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="BRIDGE IP" Style="{StaticResource HueSectionLabel}" VerticalAlignment="Center" Margin="{skin:Space 0,0,10,6}" />
                                <TextBox Text="{Binding BridgeIpInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HueTextBox}" Tag="192.168.1.16" Width="{skin:Size 152}" Margin="{skin:Space 0,0,8,6}" ToolTip="Local LAN IP of your Philips Hue Bridge (e.g. 192.168.1.42)" />
                                <Button Content="Auto-Discover" Command="{Binding DiscoverBridgeCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,6}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="Press Bridge Button &amp; Pair" Command="{Binding StartPairingCommand}" Style="{StaticResource HuePrimaryButton}" Padding="{skin:Space 11,6}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="Cancel" Command="{Binding CancelPairingCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,6}" Visibility="{Binding IsPairing, Converter={StaticResource HueBoolToVis}}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="{Binding DemoModeButtonLabel}" Command="{Binding ToggleDemoModeCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,6}" Margin="{skin:Space 0,0,6,6}" ToolTip="Simulate a 6-light Philips Hue setup to preview controls &amp; AVR automations" />
                                <Button Content="Unlink" Command="{Binding DisconnectBridgeCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,6}" Visibility="{Binding IsPaired, Converter={StaticResource HueBoolToVis}}" Margin="{skin:Space 0,0,0,6}" />
                            </WrapPanel>

                            <!-- Discovered Bridges Pills -->
                            <ItemsControl ItemsSource="{Binding DiscoveredBridges}"
                                          Visibility="{Binding HasDiscoveredBridges, Converter={StaticResource HueBoolToVis}}"
                                          Margin="{skin:Space 0,4,0,4}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectDiscoveredBridgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource HueButton}"
                                                Padding="{skin:Space 10,4}"
                                                Margin="{skin:Space 0,0,6,4}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Bridge " Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize04}" />
                                                <TextBlock Text="{Binding IpAddress}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize05}" />
                                                <TextBlock Text="{Binding Source, StringFormat=' ({0})'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSize03}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Pairing countdown banner -->
                            <Border Background="{DynamicResource AccentAmberSubtleBgBrush}"
                                    BorderBrush="{DynamicResource AccentAmberBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius03}"
                                    Padding="{skin:Space 12,8}"
                                    Margin="{skin:Space 0,4,0,0}"
                                    Visibility="{Binding IsPairing, Converter={StaticResource HueBoolToVis}}">
                                <TextBlock Text="{Binding PairingHintText}" FontSize="{DynamicResource FontSize07}" FontWeight="SemiBold" Foreground="{DynamicResource AccentAmberTextBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= REAL-TIME MUSIC SYNC & ALBUM-ART AMBIENT ================= -->
            <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}">
                <StackPanel>
                    <Grid Margin="{skin:Space 0,0,0,10}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 12}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="REAL-TIME MUSIC SYNC &amp; ALBUM-ART AMBIENT"
                                       Style="{StaticResource HueSectionLabel}"
                                       VerticalAlignment="Center"
                                       Margin="{skin:Space 0,2,10,2}" />
                            <Border Background="{DynamicResource Ink05Brush}" BorderBrush="{DynamicResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}" Margin="{skin:Space 0,2,6,2}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EntertainmentAreaSummary}" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrightBrush}" />
                            </Border>
                            <Border Background="{DynamicResource Ink05Brush}" BorderBrush="{DynamicResource Ink14Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}" Margin="{skin:Space 0,2,0,2}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MusicSyncStatusBadge}" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentAmberBrush}" />
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding DemoBeatButtonLabel}"
                                    Command="{Binding ToggleDemoBeatCommand}"
                                    Style="{StaticResource HueButton}"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize04}"
                                    Margin="{skin:Space 0,0,6,0}"
                                    ToolTip="Generate a 125 BPM test beat to preview FFT meters &amp; beat-reactive lighting live" />
                            <Button Content="{Binding MusicSyncToggleLabel}"
                                    Command="{Binding ToggleMusicSyncCommand}"
                                    Style="{StaticResource HuePrimaryButton}"
                                    Padding="{skin:Space 12,5}"
                                    FontSize="{DynamicResource FontSize05}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="{skin:Size 14}" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Entertainment area + 4 Sync Modes + Sliders -->
                        <StackPanel Grid.Column="0">
                            <!-- The area the 50 Hz stream uses. Disabled when the bridge has no area. -->
                            <StackPanel Margin="{skin:Space 0,0,0,10}">
                                <TextBlock Text="ENTERTAINMENT AREA" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                                <ComboBox ItemsSource="{Binding EntertainmentAreas}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedEntertainmentArea}"
                                          IsEnabled="{Binding HasEntertainmentAreas}"
                                          AutomationProperties.Name="Hue Entertainment area"
                                          AutomationProperties.HelpText="{Binding EntertainmentAreaHint}"
                                          ToolTip="The Hue Entertainment area that Music Sync streams to at 50 Hz"
                                          FontSize="{DynamicResource FontSize05}" />
                                <TextBlock Text="{Binding EntertainmentAreaHint}"
                                           Visibility="{Binding HasEntertainmentAreaHint, Converter={StaticResource HueBoolToVis}}"
                                           FontSize="{DynamicResource FontSize04}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="{skin:Space 0,4,0,0}" />
                            </StackPanel>

                            <WrapPanel Margin="{skin:Space 0,0,0,10}">
                                <Button Content="Bass Pulse" Command="{Binding SetMusicSyncModeCommand}" CommandParameter="BassPulse" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,6}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicSyncModeName}" Value="BassPulse">
                                                    <Setter Property="Background" Value="{DynamicResource AccentAmberSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentAmberBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentAmberTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Spectrum Split" Command="{Binding SetMusicSyncModeCommand}" CommandParameter="SpectrumSplit" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,6}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicSyncModeName}" Value="SpectrumSplit">
                                                    <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrightBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Album-Art Ambient" Command="{Binding SetMusicSyncModeCommand}" CommandParameter="AlbumArtAmbient" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,6}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicSyncModeName}" Value="AlbumArtAmbient">
                                                    <Setter Property="Background" Value="{DynamicResource AccentPinkSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPinkBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentPinkTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Cinema Subtle" Command="{Binding SetMusicSyncModeCommand}" CommandParameter="CinemaSubtle" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,6}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicSyncModeName}" Value="CinemaSubtle">
                                                    <Setter Property="Background" Value="{DynamicResource AccentIndigoSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentIndigoBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentIndigoTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 12}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 12}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel>
                                        <TextBlock Text="SENSITIVITY" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding MusicSyncSensitivityLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="0.5" Maximum="2.5" SmallChange="0.1" LargeChange="0.25" Value="{Binding MusicSyncSensitivity}" Margin="{skin:Space 0,4,0,0}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock Text="MIN BRIGHT" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding MusicSyncMinBrightness, StringFormat='{}{0}%'}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextSoftBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="5" Maximum="80" Value="{Binding MusicSyncMinBrightness}" Margin="{skin:Space 0,4,0,0}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <DockPanel>
                                        <TextBlock Text="MAX BRIGHT" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding MusicSyncMaxBrightness, StringFormat='{}{0}%'}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextSoftBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="25" Maximum="100" Value="{Binding MusicSyncMaxBrightness}" Margin="{skin:Space 0,4,0,0}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Right: Live 3-Band FFT Audio Meter + Beat LED + Album Art Swatch -->
                        <Border Grid.Column="2" Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 12}">
                            <StackPanel>
                                <DockPanel Margin="{skin:Space 0,0,0,8}">
                                    <TextBlock Text="LIVE FFT SPECTRUM" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="{skin:Size 9}" Height="{skin:Size 9}" Margin="{skin:Space 0,0,5,0}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Ink14Brush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LiveBeatFlash}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentAmberBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="BEAT" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentAmberBrush}" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="{skin:Space 0,0,0,5}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{skin:Size 42}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BASS" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentRoseTextBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="{skin:Size 7}" Minimum="0" Maximum="100" Value="{Binding LiveBassPercent, Mode=OneWay}" Foreground="{DynamicResource AccentRoseTextBrush}" Background="{DynamicResource Ink08Brush}" BorderThickness="0" />
                                </Grid>

                                <Grid Margin="{skin:Space 0,0,0,5}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{skin:Size 42}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MIDS" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="{skin:Size 7}" Minimum="0" Maximum="100" Value="{Binding LiveMidPercent, Mode=OneWay}" Foreground="{DynamicResource AccentCyanBrush}" Background="{DynamicResource Ink08Brush}" BorderThickness="0" />
                                </Grid>

                                <Grid Margin="{skin:Space 0,0,0,8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{skin:Size 42}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HIGH" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentIndigoBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="{skin:Size 7}" Minimum="0" Maximum="100" Value="{Binding LiveTreblePercent, Mode=OneWay}" Foreground="{DynamicResource AccentIndigoBrush}" Background="{DynamicResource Ink08Brush}" BorderThickness="0" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="{skin:Size 12}" Height="{skin:Size 12}" Fill="{Binding AlbumArtDominantHex, Converter={StaticResource HexToBrush}}" Stroke="{DynamicResource Ink16Brush}" StrokeThickness="1" Margin="{skin:Space 0,0,4,0}" />
                                    <Ellipse Width="{skin:Size 12}" Height="{skin:Size 12}" Fill="{Binding AlbumArtSecondaryHex, Converter={StaticResource HexToBrush}}" Stroke="{DynamicResource Ink16Brush}" StrokeThickness="1" Margin="{skin:Space 0,0,8,0}" />
                                    <TextBlock Text="{Binding AlbumArtTrackLabel}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= MASTER & ROOM CONTROLS ================= -->
            <Grid Margin="{skin:Space 0,0,0,14}" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="{skin:Size 14}" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Master & Selected Room Control -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <DockPanel Margin="{skin:Space 0,0,0,12}">
                            <TextBlock Text="MASTER &amp; ROOMS" Style="{StaticResource HueSectionLabel}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All On" Command="{Binding AllLightsOnCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" />
                                <Button Content="All Off" Command="{Binding AllLightsOffCommand}" Style="{StaticResource HueButton}" Padding="{skin:Space 10,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,8,0}" />
                                <Button Content="15%" Command="{Binding SetAllBrightnessCommand}" CommandParameter="15" Style="{StaticResource HueButton}" Padding="{skin:Space 8,4}" FontSize="{DynamicResource FontSize03}" Margin="{skin:Space 0,0,4,0}" />
                                <Button Content="50%" Command="{Binding SetAllBrightnessCommand}" CommandParameter="50" Style="{StaticResource HueButton}" Padding="{skin:Space 8,4}" FontSize="{DynamicResource FontSize03}" Margin="{skin:Space 0,0,4,0}" />
                                <Button Content="100%" Command="{Binding SetAllBrightnessCommand}" CommandParameter="100" Style="{StaticResource HueButton}" Padding="{skin:Space 8,4}" FontSize="{DynamicResource FontSize03}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Room Selector Chips -->
                        <ItemsControl ItemsSource="{Binding Rooms}" Margin="{skin:Space 0,0,0,12}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="{skin:Space 0,0,8,8}"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource CardElevatedBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Ink12Brush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Padding" Value="{skin:Space 12,8}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="{DynamicResource Radius04}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize07}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,2,0,0}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentAmberSubtleBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentAmberBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selected Room Dimmer & Mood Swatches -->
                        <Border Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource ControlHoverBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 14}">
                            <StackPanel>
                                <DockPanel Margin="{skin:Space 0,0,0,8}">
                                    <TextBlock Text="{Binding SelectedRoomHeader}" FontSize="{DynamicResource FontSize08}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Content="{Binding SelectedRoomToggleLabel}"
                                            Command="{Binding ToggleSelectedRoomCommand}"
                                            Style="{StaticResource HueButton}"
                                            Padding="{skin:Space 10,4}"
                                            FontSize="{DynamicResource FontSize04}"
                                            HorizontalAlignment="Right" />
                                </DockPanel>

                                <Grid Margin="{skin:Space 0,0,0,10}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{skin:Size 42}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DIMMER" Style="{StaticResource HueSectionLabel}" VerticalAlignment="Center" Margin="{skin:Space 0,0,10,0}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SelectedRoomBrightness}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedRoomBrightness, StringFormat='{}{0}%'}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize06}" Foreground="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="AMBIENCE PRESETS" Style="{StaticResource HueSectionLabel}" Margin="{skin:Space 0,2,0,6}" />
                                <ItemsControl ItemsSource="{Binding MoodPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ApplyMoodPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource HueButton}"
                                                    Padding="{skin:Space 9,5}"
                                                    Margin="{skin:Space 0,0,6,6}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="{skin:Size 10}" Height="{skin:Size 10}" Fill="{Binding HexColor, Converter={StaticResource HexToBrush}}" Margin="{skin:Space 0,0,6,0}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize05}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Hue Bridge Native Scenes -->
                                <StackPanel Margin="{skin:Space 0,8,0,0}" Visibility="{Binding HasVisibleScenes, Converter={StaticResource HueBoolToVis}}">
                                    <TextBlock Text="HUE BRIDGE SCENES" Style="{StaticResource HueSectionLabel}" Margin="{skin:Space 0,0,0,6}" />
                                    <ItemsControl ItemsSource="{Binding VisibleScenes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}"
                                                        Command="{Binding DataContext.ActivateHueSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource HueButton}"
                                                        Padding="{skin:Space 10,4}"
                                                        FontSize="{DynamicResource FontSize04}"
                                                        Margin="{skin:Space 0,0,6,6}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Denon AVR Reactive Automations -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="DENON AVR LIGHTING AUTOMATIONS" Style="{StaticResource HueSectionLabel}" Margin="{skin:Space 0,0,0,6}" />
                        <TextBlock Text="Automatically react when you switch Denon power, trigger Smart Scenes, or pause playback."
                                   FontSize="{DynamicResource FontSize05}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="{skin:Space 0,0,0,12}" />

                        <Border Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource ControlHoverBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 12}" Margin="{skin:Space 0,0,0,12}">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TARGET ROOM" Style="{StaticResource HueSectionLabel}" />
                                    <TextBlock Text="{Binding AutomationTargetRoomLabel}" FontSize="{DynamicResource FontSize08}" FontWeight="SemiBold" Foreground="{DynamicResource AccentAmberBrush}" Margin="{skin:Space 0,2,0,0}" />
                                </StackPanel>
                                <Button Content="Use Selected Room"
                                        Command="{Binding UseSelectedRoomForAutomationCommand}"
                                        Style="{StaticResource HueButton}"
                                        Padding="{skin:Space 10,5}"
                                        FontSize="{DynamicResource FontSize04}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <CheckBox IsChecked="{Binding SyncWithSmartScenes}" Style="{StaticResource HueCheckBox}">
                            <StackPanel>
                                <TextBlock Text="Sync with Denon Smart Scenes" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Movie Night → Cinema Dim • Late Night → Candlelight • Party → Neon" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding TurnOnWithReceiverPower}" Style="{StaticResource HueCheckBox}" Margin="{skin:Space 0,8,0,4}">
                            <StackPanel>
                                <TextBlock Text="Turn on Hue lights when Denon powers ON" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Brings up room ambiance automatically with your receiver" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding TurnOffWithReceiverStandby}" Style="{StaticResource HueCheckBox}" Margin="{skin:Space 0,6,0,4}">
                            <StackPanel>
                                <TextBlock Text="Turn off Hue lights when Denon enters Standby" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="One-button room shutdown when you turn off your AVR" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding CinemaPauseLights}" Style="{StaticResource HueCheckBox}" Margin="{skin:Space 0,6,0,10}">
                            <StackPanel>
                                <TextBlock Text="Cinema Pause Lights (Play / Pause sync)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Gently brightens to 55% on Pause, dims back to 18% on Resume" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius03}" Padding="{skin:Space 10,7}">
                            <TextBlock Text="{Binding LastAutomationEventText}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource AccentCyanBrightBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= INDIVIDUAL LIGHTS GRID ================= -->
            <Border Style="{StaticResource SurfaceCard}" Visibility="{Binding IsConnectedOrDemo, Converter={StaticResource HueBoolToVis}}">
                <StackPanel>
                    <Grid Margin="{skin:Space 0,0,0,12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding IndividualLightsHeader}" Style="{StaticResource HueSectionLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Show All Lights"
                                    Command="{Binding ShowAllLightsCommand}"
                                    Style="{StaticResource HueButton}"
                                    Padding="{skin:Space 9,3}"
                                    FontSize="{DynamicResource FontSize03}"
                                    Margin="{skin:Space 0,0,8,0}"
                                    Visibility="{Binding IsFilteredToSingleRoom, Converter={StaticResource HueBoolToVis}}" />
                            <TextBlock Text="Drag sliders to dim or adjust warmth"
                                       FontSize="{DynamicResource FontSize04}"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding VisibleLights}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardElevatedBrush}"
                                        BorderBrush="{DynamicResource Ink11Brush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius05}"
                                        Padding="{skin:Space 14}"
                                        Width="{skin:Size 310}"
                                        Margin="{skin:Space 0,0,10,10}">
                                    <StackPanel>
                                        <DockPanel Margin="{skin:Space 0,0,0,10}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="{skin:Size 16}" Height="{skin:Size 16}" Fill="{Binding PreviewBrush}" Stroke="{DynamicResource Ink14Brush}" StrokeThickness="1" Margin="{skin:Space 0,0,10,0}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize08}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding StateSummary}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Content="{Binding PowerLabel}"
                                                    Command="{Binding ToggleCommand}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    MinWidth="{skin:Size 54}"
                                                    Padding="{skin:Space 10,4}"
                                                    FontSize="{DynamicResource FontSize04}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource HueButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentAmberSubtleBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentAmberBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentAmberTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DockPanel>

                                        <!-- Brightness Slider -->
                                        <Grid Margin="{skin:Space 0,0,0,6}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{skin:Size 52}" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{skin:Size 38}" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="BRIGHT" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrightnessPercent}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding BrightnessPercent, StringFormat='{}{0}%'}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextSoftBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Color Temp Slider -->
                                        <Grid Margin="{skin:Space 0,0,0,8}" Visibility="{Binding SupportsColorTemp, Converter={StaticResource HueBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{skin:Size 52}" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{skin:Size 46}" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="WARMTH" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="153" Maximum="500" Value="{Binding ColorTempMirek}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ColorTempKelvinLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource AccentAmberTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Quick Color Dots -->
                                        <ItemsControl ItemsSource="{Binding QuickSwatches}"
                                                      Visibility="{Binding SupportsColor, Converter={StaticResource HueBoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.ApplySwatchCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding Name}"
                                                            Width="{skin:Size 20}"
                                                            Height="{skin:Size 20}"
                                                            Margin="{skin:Space 0,0,6,0}"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="{Binding HexColor, Converter={StaticResource HexToBrush}}" Stroke="{DynamicResource Ink16Brush}" StrokeThickness="1.2" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
