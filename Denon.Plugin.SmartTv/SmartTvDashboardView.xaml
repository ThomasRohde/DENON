<UserControl x:Class="Denon.Plugin.SmartTv.SmartTvDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.Plugin.SmartTv"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource DisplayFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="TvBoolToVis" />

        <Style x:Key="TelemetryTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ink08Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius04}" />
            <Setter Property="Padding" Value="{skin:Space 10,8}" />
        </Style>

        <Style x:Key="TvBtn" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="{skin:Space 11,6.5}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="TvPrimaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="{skin:Space 11,6.5}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="TvOledBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentVioletSubtleBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentIndigoDeepBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBlueTextSoftBrush}" />
        </Style>

        <Style x:Key="TvDangerBtn" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Padding" Value="{skin:Space 11,6.5}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="DPadBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Width" Value="{skin:Size 44}" />
            <Setter Property="Height" Value="{skin:Size 36}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize08}" />
        </Style>

        <Style x:Key="TvInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="{skin:Space 9,6}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="TvChipBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Padding" Value="{skin:Space 10,6}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize05}" />
        </Style>

        <Style x:Key="ActiveArcBtn" TargetType="Button" BasedOn="{StaticResource TvChipBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioArcActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentCyanTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveSpeakersBtn" TargetType="Button" BasedOn="{StaticResource TvChipBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioSpeakersActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentCyanTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveOpticalBtn" TargetType="Button" BasedOn="{StaticResource TvChipBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioOpticalActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentCyanTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveBluetoothBtn" TargetType="Button" BasedOn="{StaticResource TvChipBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioBluetoothActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentCyanTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{skin:Space 0,0,4,16}">

            <!-- ======================== CARD 1: CONNECTION & LIVE TELEMETRY ======================== -->
            <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                <StackPanel>
                    <Grid Margin="{skin:Space 0,0,0,12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 12}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 0,0,0,3}">
                                <TextBlock Text="Smart TV Control (LG webOS)" FontSize="{DynamicResource FontSize10}" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Ink05Brush}"
                                        BorderBrush="{Binding ConnectionBadgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius02}"
                                        Padding="{skin:Space 8,2}"
                                        Margin="{skin:Space 10,0,0,0}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectionBadgeText}"
                                               FontSize="{DynamicResource FontSize02}"
                                               FontWeight="Bold"
                                               Foreground="{Binding ConnectionBadgeBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Persistent SSAP WebSocket • Live Subscriptions, Magic Remote, Screen Off, eARC &amp; Installed Apps"
                                       FontSize="{DynamicResource FontSize05}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource TvBtn}" Margin="{skin:Space 0,0,6,4}" ToolTip="Re-sync live TV apps, inputs, audio &amp; power state" />
                            <Button Content="{Binding DemoButtonLabel}" Command="{Binding ToggleDemoCommand}" Style="{StaticResource TvBtn}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="{Binding SetupToggleLabel}" Command="{Binding ToggleSetupCommand}" Style="{StaticResource TvBtn}" Margin="{skin:Space 0,0,6,4}" ToolTip="Show or hide TV IP, MAC &amp; pairing setup fields" />
                            <Button Content="Pair with LG TV" Command="{Binding PairCommand}" Style="{StaticResource TvPrimaryBtn}" Margin="{skin:Space 0,0,0,4}" />
                        </WrapPanel>
                    </Grid>

                    <!-- Collapsible Connection Setup Row (automatically collapses once paired!) -->
                    <Border Background="{DynamicResource Ink03Brush}"
                            BorderBrush="{DynamicResource Ink11Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius04}"
                            Padding="{skin:Space 12,10}"
                            Margin="{skin:Space 0,0,0,12}"
                            Visibility="{Binding IsSetupExpanded, Converter={StaticResource TvBoolToVis}}">
                        <StackPanel>
                            <Grid Margin="{skin:Space 0,0,0,8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.0*" />
                                    <ColumnDefinition Width="{skin:Size 10}" />
                                    <ColumnDefinition Width="0.95*" />
                                    <ColumnDefinition Width="{skin:Size 10}" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TV NAME" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                                    <TextBox Text="{Binding TvName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" Tag="e.g. Living Room OLED TV" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TV LAN IP ADDRESS" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                                    <TextBox Text="{Binding TvIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" FontFamily="{DynamicResource MonoFont}" Tag="192.168.1.28" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="MAC ADDRESS (WAKE-ON-LAN)" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{skin:Size 6}" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" FontFamily="{DynamicResource MonoFont}" Tag="AA:BB:CC:DD:EE:FF" />
                                        <Button Grid.Column="2" Content="Auto-MAC" Command="{Binding AutoMacCommand}" Style="{StaticResource TvBtn}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" ToolTip="Resolve MAC address automatically from the TV IP via ARP" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <Button Content="Auto-Discover TV" Command="{Binding DiscoverCommand}" Style="{StaticResource TvBtn}" Padding="{skin:Space 10,4.5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,0}" ToolTip="Scan LAN via SSDP + ARP to find LG webOS TVs" />
                                <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource TvPrimaryBtn}" Padding="{skin:Space 10,4.5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,0}" />
                                <Button Content="Re-Pair (Full Permissions)" Command="{Binding RePairCommand}" Style="{StaticResource TvBtn}" Padding="{skin:Space 10,4.5}" FontSize="{DynamicResource FontSize05}" ToolTip="Force a fresh LG TV prompt to grant pointer remote &amp; installed-app permissions" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live Telemetry Strip -->
                    <Grid Margin="{skin:Space 0,0,0,10}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 8}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 8}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 8}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource TelemetryTile}">
                            <StackPanel>
                                <TextBlock Text="TV MODEL / WEBOS" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Text="{Binding ModelSummary}" FontSize="{DynamicResource FontSize06}" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" TextTrimming="CharacterEllipsis" Margin="{skin:Space 0,2,0,0}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource TelemetryTile}">
                            <StackPanel>
                                <TextBlock Text="NOW SHOWING" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Text="{Binding NowShowingText}" FontSize="{DynamicResource FontSize06}" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrightBrush}" TextTrimming="CharacterEllipsis" Margin="{skin:Space 0,2,0,0}" ToolTip="{Binding NowShowingText}" />
                                <TextBlock Text="{Binding NowShowingProgramText}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowShowingProgramText}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource TelemetryTile}">
                            <StackPanel>
                                <TextBlock Text="AUDIO OUTPUT" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Text="{Binding SoundOutputText}" FontSize="{DynamicResource FontSize06}" FontWeight="SemiBold" Foreground="{DynamicResource AccentEmeraldBrush}" TextTrimming="CharacterEllipsis" Margin="{skin:Space 0,2,0,0}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource TelemetryTile}">
                            <StackPanel>
                                <TextBlock Text="DISPLAY &amp; VOL" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="{skin:Space 0,2,0,0}">
                                    <TextBlock Text="{Binding ScreenStateText}" FontSize="{DynamicResource FontSize06}" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" />
                                    <TextBlock Text=" • " FontSize="{DynamicResource FontSize06}" Foreground="{DynamicResource TextDisabledBrush}" />
                                    <TextBlock Text="{Binding TvVolumeLabel}" FontSize="{DynamicResource FontSize06}" FontWeight="SemiBold" Foreground="{DynamicResource AccentAmberBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource AccentCyanBrightBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ======================== CARD 2: LIVE TV SCREEN PREVIEW & VIRTUAL TRACKPAD ======================== -->
            <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                <StackPanel>
                    <Grid Margin="{skin:Space 0,0,0,10}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 12}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIVE TV SCREEN &amp; VIRTUAL TRACKPAD" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Ink05Brush}" BorderBrush="{DynamicResource Ink12Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,1.5}" Margin="{skin:Space 8,0,0,0}">
                                    <TextBlock Text="{Binding PreviewStatusText}" FontSize="{DynamicResource FontSize02}" Foreground="{DynamicResource AccentCyanBrightBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="Auto-Refresh"
                                      IsChecked="{Binding AutoRefreshPreview, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextSoftBrush}"
                                      FontSize="{DynamicResource FontSize05}"
                                      VerticalAlignment="Center"
                                      Margin="{skin:Space 0,0,10,0}"
                                      ToolTip="Automatically refresh the live TV preview (1s while actively using the trackpad, 2.5s idle; pauses when tab is hidden)" />
                            <Button Content="TV Settings"
                                    Command="{Binding LaunchAppCommand}"
                                    CommandParameter="settings"
                                    Style="{StaticResource TvChipBtn}"
                                    Margin="{skin:Space 0,0,6,0}"
                                    ToolTip="Open LG webOS TV Settings directly" />
                            <Button Content="Center Cursor"
                                    Command="{Binding RecalibrateCursorCommand}"
                                    Style="{StaticResource TvChipBtn}"
                                    Margin="{skin:Space 0,0,6,0}"
                                    ToolTip="Recalibrate LG Magic Remote pointer to the center of the TV screen" />
                            <Button Content="Snap Now"
                                    Command="{Binding CapturePreviewCommand}"
                                    Style="{StaticResource TvPrimaryBtn}"
                                    Padding="{skin:Space 12,5.5}"
                                    FontSize="{DynamicResource FontSize05}" />
                        </WrapPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.38*" />
                            <ColumnDefinition Width="{skin:Size 14}" />
                            <ColumnDefinition Width="0.62*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Clickable 16:9 Live TV Preview + Browser URL Bar -->
                        <StackPanel Grid.Column="0">
                            <Border x:Name="PreviewSurface"
                                    Background="{DynamicResource ChassisBgBrush}"
                                    BorderBrush="{DynamicResource Ink12Brush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius04}"
                                    ClipToBounds="True"
                                    Height="{skin:Size 236}"
                                    Cursor="Cross"
                                    MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                                    MouseRightButtonDown="PreviewSurface_MouseRightButtonDown"
                                    MouseWheel="PreviewSurface_MouseWheel"
                                    ToolTip="Left-click anywhere to click that spot on your TV • Right-click = Back • Mouse wheel = Scroll">
                                <Grid>
                                    <Image x:Name="PreviewImageControl"
                                           Source="{Binding PreviewImage}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasPreviewImage, Converter={StaticResource TvBoolToVis}}" />

                                    <!-- Click visual feedback marker -->
                                    <Canvas x:Name="ClickOverlayCanvas" IsHitTestVisible="False">
                                        <Ellipse x:Name="ClickMarker"
                                                 Width="{skin:Size 18}"
                                                 Height="{skin:Size 18}"
                                                 Stroke="{DynamicResource AccentCyanBrightBrush}"
                                                 StrokeThickness="2"
                                                 Fill="{DynamicResource AccentCyanGlowBrush}"
                                                 Visibility="Collapsed" />
                                    </Canvas>

                                    <!-- Placeholder before first capture -->
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="{skin:Space 24}"
                                                Visibility="{Binding ShowPreviewPlaceholder, Converter={StaticResource TvBoolToVis}}">
                                        <TextBlock Text="Live LG webOS Screen Preview"
                                                   FontSize="{DynamicResource FontSize08}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="{skin:Space 0,0,0,5}" />
                                        <TextBlock Text="Click Snap Now or enable Auto-Refresh to view your TV screen here. Left-click directly on the image to point &amp; click on the TV."
                                                   FontSize="{DynamicResource FontSize05}"
                                                   Foreground="{DynamicResource TextFaintBrush}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="{skin:Size 380}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Direct LG webOS Web Browser Launcher -->
                            <Grid Margin="{skin:Space 0,9,0,0}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 6}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding BrowserUrlText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TvInput}"
                                         Tag="Open URL in LG webOS Browser (e.g. news.ycombinator.com) &amp; press Enter..."
                                         ToolTip="Launches LG webOS built-in Web Browser straight to this URL and refreshes the preview">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding OpenBrowserUrlCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2"
                                        Content="Open in TV Browser"
                                        Command="{Binding OpenBrowserUrlCommand}"
                                        Style="{StaticResource TvBtn}"
                                        Padding="{skin:Space 11,5.5}" />
                            </Grid>
                        </StackPanel>

                        <!-- Right: Precision Virtual Trackpad + Quick Type -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="{skin:Size 8}" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{skin:Size 8}" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="TrackpadSurface"
                                    Grid.Row="0"
                                    Background="{DynamicResource Ink03Brush}"
                                    BorderBrush="{DynamicResource Ink12Brush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius05}"
                                    Cursor="Hand"
                                    MinHeight="{skin:Size 168}"
                                    MouseLeftButtonDown="Trackpad_MouseLeftButtonDown"
                                    MouseMove="Trackpad_MouseMove"
                                    MouseLeftButtonUp="Trackpad_MouseLeftButtonUp"
                                    MouseRightButtonDown="Trackpad_MouseRightButtonDown"
                                    MouseWheel="Trackpad_MouseWheel"
                                    ToolTip="Drag to steer Magic Remote pointer • Tap to click • Right-click = Back • Wheel = Scroll">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{skin:Space 14}" IsHitTestVisible="False">
                                        <TextBlock Text="VIRTUAL TRACKPAD"
                                                   FontSize="{DynamicResource FontSize04}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentCyanBrightBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="{skin:Space 0,0,0,6}" />
                                        <TextBlock x:Name="TrackpadHintText"
                                                   Text="Hold &amp; drag to move pointer&#x0a;Click to select • Right-click Back&#x0a;Scroll wheel to scroll page"
                                                   FontSize="{DynamicResource FontSize04}"
                                                   Foreground="{DynamicResource TextFaintBrush}"
                                                   TextAlignment="Center"
                                                   LineHeight="17" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Grid.Row="2" Columns="5">
                                <Button Content="Click" Command="{Binding PointerClickCommand}" Style="{StaticResource TvPrimaryBtn}" Padding="{skin:Space 4,5.5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                <Button Content="Back" Command="{Binding SendButtonCommand}" CommandParameter="BACK" Style="{StaticResource TvChipBtn}" Padding="{skin:Space 4,5.5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                <Button Content="Home" Command="{Binding SendButtonCommand}" CommandParameter="HOME" Style="{StaticResource TvChipBtn}" Padding="{skin:Space 4,5.5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                <Button Content="▲" Command="{Binding PointerScrollCommand}" CommandParameter="up" Style="{StaticResource TvChipBtn}" Padding="{skin:Space 4,5.5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" ToolTip="Scroll Up" />
                                <Button Content="▼" Command="{Binding PointerScrollCommand}" CommandParameter="down" Style="{StaticResource TvChipBtn}" Padding="{skin:Space 4,5.5}" FontSize="{DynamicResource FontSize04}" ToolTip="Scroll Down" />
                            </UniformGrid>

                            <!-- Inline Quick Type to TV -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 5}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding KeyboardText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TvInput}"
                                         Padding="{skin:Space 8,5}"
                                         FontSize="{DynamicResource FontSize05}"
                                         Tag="Quick type to TV &amp; Enter...">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SendKeyboardCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2"
                                        Content="Send ↵"
                                        Command="{Binding SendKeyboardCommand}"
                                        Style="{StaticResource TvBtn}"
                                        Padding="{skin:Space 9,5}"
                                        FontSize="{DynamicResource FontSize04}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================== ROW 2: POWER/AUDIO/HDMI + MAGIC REMOTE ======================== -->
            <Grid Margin="{skin:Space 0,0,0,14}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="{skin:Size 14}" />
                    <ColumnDefinition Width="0.92*" />
                </Grid.ColumnDefinitions>

                <!-- Left Stack: Power/OLED/Audio + HDMI Inputs -->
                <StackPanel Grid.Column="0">
                    <!-- Power, OLED & Audio Output Card -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                        <StackPanel>
                            <TextBlock Text="POWER &amp; DISPLAY" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,9}" />
                            <WrapPanel Margin="{skin:Space 0,0,0,10}">
                                <Button Content="Wake TV (WoL)" Command="{Binding RunActionCommand}" CommandParameter="tv.power_on" Style="{StaticResource TvPrimaryBtn}" Margin="{skin:Space 0,0,7,7}" />
                                <Button Content="Power Off" Command="{Binding RunActionCommand}" CommandParameter="tv.power_off" Style="{StaticResource TvDangerBtn}" Margin="{skin:Space 0,0,7,7}" />
                                <Button Content="Screen Off" Command="{Binding RunActionCommand}" CommandParameter="tv.screen_off" Style="{StaticResource TvOledBtn}" Margin="{skin:Space 0,0,7,7}" ToolTip="Blank the TV display while keeping eARC / music audio playing" />
                                <Button Content="Wake Screen" Command="{Binding RunActionCommand}" CommandParameter="tv.screen_on" Style="{StaticResource TvBtn}" Margin="{skin:Space 0,0,7,7}" />
                                <Button Content="Live TV" Command="{Binding RunActionCommand}" CommandParameter="tv.livetv" Style="{StaticResource TvBtn}" Margin="{skin:Space 0,0,7,7}" />
                                <Button Content="Close App" Command="{Binding RunActionCommand}" CommandParameter="tv.close_app" Style="{StaticResource TvBtn}" Margin="{skin:Space 0,0,7,7}" />
                            </WrapPanel>

                            <TextBlock Text="TV AUDIO OUTPUT (DENON AVR SYNERGY)" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,2,0,8}" />
                            <WrapPanel Margin="{skin:Space 0,0,0,10}">
                                <Button Content="HDMI ARC / eARC" Command="{Binding SetAudioOutputCommand}" CommandParameter="external_arc" Style="{StaticResource ActiveArcBtn}" Margin="{skin:Space 0,0,7,6}" />
                                <Button Content="TV Speakers" Command="{Binding SetAudioOutputCommand}" CommandParameter="tv_speaker" Style="{StaticResource ActiveSpeakersBtn}" Margin="{skin:Space 0,0,7,6}" />
                                <Button Content="Optical Out" Command="{Binding SetAudioOutputCommand}" CommandParameter="external_optical" Style="{StaticResource ActiveOpticalBtn}" Margin="{skin:Space 0,0,7,6}" />
                                <Button Content="Bluetooth" Command="{Binding SetAudioOutputCommand}" CommandParameter="bt_soundbar" Style="{StaticResource ActiveBluetoothBtn}" Margin="{skin:Space 0,0,7,6}" />
                            </WrapPanel>

                            <!-- TV Volume Strip -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{skin:Size 6}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 6}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="−" Command="{Binding StepTvVolumeCommand}" CommandParameter="-" Style="{StaticResource TvBtn}" Padding="{skin:Space 10,4}" />
                                <Slider Grid.Column="2"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding TvVolume, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        ToolTip="Internal TV / ARC Volume" />
                                <Button Grid.Column="4" Content="+" Command="{Binding StepTvVolumeCommand}" CommandParameter="+" Style="{StaticResource TvBtn}" Padding="{skin:Space 10,4}" />
                                <Button Grid.Column="6" Content="{Binding MuteButtonLabel}" Command="{Binding ToggleTvMuteCommand}" Style="{StaticResource TvBtn}" Padding="{skin:Space 11,4}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic HDMI Inputs Card -->
                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <Grid Margin="{skin:Space 0,0,0,10}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HDMI &amp; EXTERNAL INPUTS" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Green dot = live signal connected" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Inputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SwitchInputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding AppId}"
                                                Margin="{skin:Space 0,0,8,8}"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="InBd"
                                                            Background="{DynamicResource CardElevatedBrush}"
                                                            BorderBrush="{DynamicResource Ink12Brush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource Radius03}"
                                                            Padding="{skin:Space 12,8}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="SigDot" Width="{skin:Size 7}" Height="{skin:Size 7}" Fill="{DynamicResource Ink16Brush}" Margin="{skin:Space 0,0,8,0}" VerticalAlignment="Center" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSize06}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Id}" FontSize="{DynamicResource FontSize01}" Foreground="{DynamicResource TextFaintBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter TargetName="SigDot" Property="Fill" Value="{DynamicResource AccentEmeraldBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="InBd" Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                                                            <Setter TargetName="InBd" Property="BorderBrush" Value="{DynamicResource AccentCyanBrightBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="InBd" Property="BorderBrush" Value="{DynamicResource AccentCyanBrightBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Card: Virtual Magic Remote + YouTube Caster + TV Keyboard -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="VIRTUAL MAGIC REMOTE (POINTER SOCKET)" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,10}" />

                        <!-- D-Pad + Side Nav Keys -->
                        <Grid Margin="{skin:Space 0,0,0,10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{skin:Size 12}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tactile 3x3 D-Pad -->
                            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink08Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius05}" Padding="{skin:Space 8}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="{skin:Size 5}" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="{skin:Size 5}" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{skin:Size 5}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{skin:Size 5}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="2" Content="▲" Command="{Binding SendButtonCommand}" CommandParameter="UP" Style="{StaticResource DPadBtn}" />
                                    <Button Grid.Row="2" Grid.Column="0" Content="◄" Command="{Binding SendButtonCommand}" CommandParameter="LEFT" Style="{StaticResource DPadBtn}" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="OK" Command="{Binding SendButtonCommand}" CommandParameter="ENTER" Style="{StaticResource TvPrimaryBtn}" Width="{skin:Size 44}" Height="{skin:Size 36}" Padding="0" FontSize="{DynamicResource FontSize05}" />
                                    <Button Grid.Row="2" Grid.Column="4" Content="►" Command="{Binding SendButtonCommand}" CommandParameter="RIGHT" Style="{StaticResource DPadBtn}" />
                                    <Button Grid.Row="4" Grid.Column="2" Content="▼" Command="{Binding SendButtonCommand}" CommandParameter="DOWN" Style="{StaticResource DPadBtn}" />
                                </Grid>
                            </Border>

                            <!-- Quick Remote Keys -->
                            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="Home" Command="{Binding SendButtonCommand}" CommandParameter="HOME" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="Back" Command="{Binding SendButtonCommand}" CommandParameter="BACK" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="Exit" Command="{Binding SendButtonCommand}" CommandParameter="EXIT" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="Settings" Command="{Binding LaunchAppCommand}" CommandParameter="settings" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,6}" ToolTip="Open LG webOS TV Settings" />
                                <Button Content="Info" Command="{Binding SendButtonCommand}" CommandParameter="INFO" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="Guide" Command="{Binding SendButtonCommand}" CommandParameter="GUIDE" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="Ch ▲" Command="{Binding SendButtonCommand}" CommandParameter="CHANNELUP" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,6}" />
                                <Button Content="Ch ▼" Command="{Binding SendButtonCommand}" CommandParameter="CHANNELDOWN" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,6}" />
                            </WrapPanel>
                        </Grid>

                        <!-- Media Transport -->
                        <WrapPanel Margin="{skin:Space 0,0,0,12}">
                            <Button Content="⏮ Rew" Command="{Binding SendMediaCommand}" CommandParameter="rewind" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="▶ Play" Command="{Binding SendMediaCommand}" CommandParameter="play" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="⏸ Pause" Command="{Binding SendMediaCommand}" CommandParameter="pause" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="⏹ Stop" Command="{Binding SendMediaCommand}" CommandParameter="stop" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="⏭ FF" Command="{Binding SendMediaCommand}" CommandParameter="fastforward" Style="{StaticResource TvChipBtn}" Margin="{skin:Space 0,0,0,4}" />
                        </WrapPanel>

                        <!-- Cast YouTube Video to TV -->
                        <TextBlock Text="CAST YOUTUBE URL / VIDEO ID TO TV" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                        <Grid Margin="{skin:Space 0,0,0,10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{skin:Size 6}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding YouTubeUrlOrId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" Tag="Paste YouTube URL or video ID &amp; press Enter..." ToolTip="Paste any YouTube URL or 11-char video ID (leave blank to open YouTube)" >
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding CastYouTubeCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Cast YT" Command="{Binding CastYouTubeCommand}" Style="{StaticResource TvPrimaryBtn}" Padding="{skin:Space 11,5}" />
                        </Grid>

                        <!-- Type to TV Keyboard -->
                        <TextBlock Text="PC KEYBOARD → TV SEARCH / INPUT FIELD" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                        <Grid Margin="{skin:Space 0,0,0,10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{skin:Size 6}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{skin:Size 5}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding KeyboardText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" Tag="Type here &amp; press Enter to send to TV..." ToolTip="Focus any search box on the TV, type here, and press Enter">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendKeyboardCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Send ↵" Command="{Binding SendKeyboardCommand}" Style="{StaticResource TvBtn}" Padding="{skin:Space 10,5}" />
                            <Button Grid.Column="4" Content="⌫" Command="{Binding BackspaceKeyboardCommand}" Style="{StaticResource TvBtn}" Padding="{skin:Space 9,5}" ToolTip="Delete 1 character on TV keyboard" />
                        </Grid>

                        <!-- Custom On-Screen Toast -->
                        <TextBlock Text="ON-SCREEN TV TOAST BANNER" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{skin:Size 6}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ToastText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" Tag="Message to display on TV screen...">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendCustomToastCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Toast" Command="{Binding SendCustomToastCommand}" Style="{StaticResource TvBtn}" Padding="{skin:Space 11,5}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================== ROW 3: INSTALLED APPS + DENON COORDINATION ======================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="{skin:Size 14}" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Dynamic Installed Apps Launcher -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <Grid Margin="{skin:Space 0,0,0,10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{skin:Size 10}" />
                                <ColumnDefinition Width="{skin:Size 180}" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="INSTALLED TV APPS" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Ink08Brush}" BorderBrush="{DynamicResource Ink12Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 6,1.5}" Margin="{skin:Space 8,0,0,0}">
                                    <TextBlock Text="{Binding AppsCountBadge}" FontSize="{DynamicResource FontSize02}" Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBox Grid.Column="2"
                                     Text="{Binding AppSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TvInput}"
                                     Padding="{skin:Space 8,4}"
                                     FontSize="{DynamicResource FontSize05}"
                                     Tag="Filter installed apps..."
                                     ToolTip="Filter installed LG webOS apps by name or ID" />
                        </Grid>

                        <ScrollViewer MaxHeight="{skin:Size 240}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredApps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Margin="{skin:Space 0,0,8,8}"
                                                Cursor="Hand"
                                                ToolTip="{Binding Id}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="AppBd"
                                                            Background="{DynamicResource CardElevatedBrush}"
                                                            BorderBrush="{DynamicResource Ink12Brush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource Radius03}"
                                                            Padding="{skin:Space 10,7}"
                                                            MinWidth="{skin:Size 118}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border x:Name="AppBadge"
                                                                    Background="{DynamicResource Ink05Brush}"
                                                                    BorderBrush="{DynamicResource Ink15Brush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Radius02}"
                                                                    Width="{skin:Size 26}"
                                                                    Height="{skin:Size 24}"
                                                                    Margin="{skin:Space 0,0,8,0}">
                                                                <TextBlock Text="{Binding BadgeText}"
                                                                           FontSize="{DynamicResource FontSize02}"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentCyanBrightBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="{DynamicResource FontSize06}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       MaxWidth="{skin:Size 120}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="AppBd" Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                                                            <Setter TargetName="AppBd" Property="BorderBrush" Value="{DynamicResource AccentCyanBrightBrush}" />
                                                            <Setter TargetName="AppBadge" Property="Background" Value="{DynamicResource AccentSkyDeepBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="AppBd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                            <Setter TargetName="AppBd" Property="BorderBrush" Value="{DynamicResource AccentCyanBrightBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Right: Denon AVR Coordination -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="DENON AVR COORDINATION" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,10}" />
                        <CheckBox Content="Wake TV (WoL) when Denon powers ON" IsChecked="{Binding WakeWithDenon}" Foreground="{DynamicResource TextStrongBrush}" Margin="{skin:Space 0,0,0,8}" />
                        <CheckBox Content="Power off TV when Denon enters Standby" IsChecked="{Binding OffWithStandby}" Foreground="{DynamicResource TextStrongBrush}" Margin="{skin:Space 0,0,0,8}" />
                        <CheckBox Content="Switch TV audio to HDMI ARC/eARC on Denon ON" IsChecked="{Binding SwitchToArcOnDenon}" Foreground="{DynamicResource TextStrongBrush}" Margin="{skin:Space 0,0,0,8}" />
                        <CheckBox Content="Mute internal TV speakers on Denon ON" IsChecked="{Binding MuteSpeakersOnDenon}" Foreground="{DynamicResource TextStrongBrush}" Margin="{skin:Space 0,0,0,8}" />
                        <CheckBox Content="Show on-screen TV toast on Smart Scenes" IsChecked="{Binding ShowSceneToast}" Foreground="{DynamicResource TextStrongBrush}" Margin="{skin:Space 0,0,0,8}" />
                        <CheckBox Content="Turn TV screen off on Music / Listening scenes" IsChecked="{Binding ScreenOffOnMusicScene}" Foreground="{DynamicResource TextStrongBrush}" Margin="{skin:Space 0,0,0,8}" />
                        <CheckBox Content="Show channel logos (downloaded once from tv-logos on GitHub)" IsChecked="{Binding ChannelLogos}" Foreground="{DynamicResource TextStrongBrush}" Margin="{skin:Space 0,0,0,10}"
                                  ToolTip="Live TV shows the channel's logo in the now-playing hero and in Insights. The logos of the whole channel list are fetched in one go, so GitHub never sees which channel you watch." />

                        <TextBlock Text="CHROMECAST ON THIS TV" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                        <ComboBox ItemsSource="{Binding CastDeviceOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedCastDevice}"
                                  AutomationProperties.Name="Chromecast on this TV"
                                  Margin="{skin:Space 0,0,0,4}" />
                        <TextBlock Text="When Wake-on-LAN gets no answer, this Chromecast turns the TV on over HDMI-CEC (SimpLink). Automatic uses the only Chromecast online."
                                   FontSize="{DynamicResource FontSize04}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="{skin:Space 0,0,0,10}" />

                        <TextBlock Text="Changes save automatically. All 24 Smart TV actions (Screen Off, eARC, HDMI 1–4, YouTube, Netflix, Plex, Play/Pause, Toasts) are also available in Smart Scenes 2.0, Global Hotkeys &amp; Couch Phone Remote!"
                                   FontSize="{DynamicResource FontSize04}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
