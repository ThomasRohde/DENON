<UserControl x:Class="Denon.Plugin.SmartTv.SmartTvDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#F1F5F9"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="TvCard" TargetType="Border">
            <Setter Property="Background" Value="#13161E" />
            <Setter Property="BorderBrush" Value="#232836" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="TvBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C202C" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2D3548" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TvPrimaryBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="TvInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0C0F16" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2A3244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,12">
            <Border Style="{StaticResource TvCard}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Smart TV Control (LG webOS + Wake-on-LAN)" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Direct SSAP WebSocket (wss://:3001 &amp; ws://:3000) for Power, HDMI Inputs, Apps &amp; On-Screen Toast Alerts" FontSize="11.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding DemoButtonLabel}" Command="{Binding ToggleDemoCommand}" Style="{StaticResource TvBtn}" Margin="0,0,6,0" />
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource TvBtn}" Margin="0,0,6,0" />
                            <Button Content="Pair with LG TV" Command="{Binding PairCommand}" Style="{StaticResource TvPrimaryBtn}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TV NAME" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TvName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TV LAN IP ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TvIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="MAC ADDRESS (FOR WAKE-ON-LAN)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                            <TextBox Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#38BDF8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TvCard}">
                    <StackPanel>
                        <TextBlock Text="QUICK TV CONTROLS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                        <WrapPanel>
                            <Button Content="Wake TV (WoL)" Command="{Binding RunActionCommand}" CommandParameter="tv.power_on" Style="{StaticResource TvPrimaryBtn}" Margin="0,0,8,8" />
                            <Button Content="Power Off" Command="{Binding RunActionCommand}" CommandParameter="tv.power_off" Style="{StaticResource TvBtn}" Margin="0,0,8,8" />
                            <Button Content="HDMI 1" Command="{Binding RunActionCommand}" CommandParameter="tv.hdmi1" Style="{StaticResource TvBtn}" Margin="0,0,8,8" />
                            <Button Content="HDMI 2 (eARC)" Command="{Binding RunActionCommand}" CommandParameter="tv.hdmi2" Style="{StaticResource TvBtn}" Margin="0,0,8,8" />
                            <Button Content="HDMI 3" Command="{Binding RunActionCommand}" CommandParameter="tv.hdmi3" Style="{StaticResource TvBtn}" Margin="0,0,8,8" />
                            <Button Content="Launch YouTube" Command="{Binding RunActionCommand}" CommandParameter="tv.youtube" Style="{StaticResource TvBtn}" Margin="0,0,8,8" />
                            <Button Content="Launch Plex" Command="{Binding RunActionCommand}" CommandParameter="tv.plex" Style="{StaticResource TvBtn}" Margin="0,0,8,8" />
                            <Button Content="Mute TV Speakers" Command="{Binding RunActionCommand}" CommandParameter="tv.mute" Style="{StaticResource TvBtn}" Margin="0,0,8,8" />
                            <Button Content="Send Test Toast" Command="{Binding RunActionCommand}" CommandParameter="tv.toast" Style="{StaticResource TvBtn}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TvCard}">
                    <StackPanel>
                        <TextBlock Text="DENON AVR COORDINATION" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                        <CheckBox Content="Wake TV (WoL) when Denon powers ON" IsChecked="{Binding WakeWithDenon}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <CheckBox Content="Power off TV when Denon enters Standby" IsChecked="{Binding OffWithStandby}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <CheckBox Content="Show on-screen TV toast on Smart Scenes" IsChecked="{Binding ShowSceneToast}" Foreground="#E2E8F0" Margin="0,0,0,10" />
                        <TextBlock Text="Tip: Chain TV actions (like HDMI 1) directly into Movie Night inside Scenes &amp; Acoustics!" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
