<UserControl x:Class="Denon.Plugin.SmartTv.SmartTvDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#F1F5F9"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="TvBoolToVis" />
        <Style x:Key="TvCard" TargetType="Border">
            <Setter Property="Background" Value="#13161E" />
            <Setter Property="BorderBrush" Value="#232836" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="TelemetryTile" TargetType="Border">
            <Setter Property="Background" Value="#0C0F16" />
            <Setter Property="BorderBrush" Value="#1E2534" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="TvBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C202C" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2D3548" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6.5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3D" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E4B66" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#172033" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TvPrimaryBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="TvOledBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Background" Value="#1A1330" />
            <Setter Property="BorderBrush" Value="#6366F1" />
            <Setter Property="Foreground" Value="#E0E7FF" />
        </Style>

        <Style x:Key="TvDangerBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Background" Value="#261419" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
            <Setter Property="Foreground" Value="#FCA5A5" />
        </Style>

        <Style x:Key="DPadBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="TvInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="TvChipBtn" TargetType="Button" BasedOn="{StaticResource TvBtn}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="ActiveArcBtn" TargetType="Button" BasedOn="{StaticResource TvChipBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioArcActive}" Value="True">
                    <Setter Property="Background" Value="#0B2E3D" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#7DD3FC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveSpeakersBtn" TargetType="Button" BasedOn="{StaticResource TvChipBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioSpeakersActive}" Value="True">
                    <Setter Property="Background" Value="#0B2E3D" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#7DD3FC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveOpticalBtn" TargetType="Button" BasedOn="{StaticResource TvChipBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioOpticalActive}" Value="True">
                    <Setter Property="Background" Value="#0B2E3D" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#7DD3FC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveBluetoothBtn" TargetType="Button" BasedOn="{StaticResource TvChipBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioBluetoothActive}" Value="True">
                    <Setter Property="Background" Value="#0B2E3D" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#7DD3FC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,16">

            <!-- ======================== CARD 1: CONNECTION & LIVE TELEMETRY ======================== -->
            <Border Style="{StaticResource TvCard}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="Smart TV Control (LG webOS)" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="#0C1420"
                                        BorderBrush="{Binding ConnectionBadgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectionBadgeText}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{Binding ConnectionBadgeBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Persistent SSAP WebSocket (wss://:3001 &amp; ws://:3000) • Live Subscriptions, Magic Remote, OLED Screen Off, eARC &amp; Installed Apps"
                                       FontSize="11.5"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource TvBtn}" Margin="0,0,6,4" ToolTip="Re-sync live TV apps, inputs, audio &amp; power state" />
                            <Button Content="{Binding DemoButtonLabel}" Command="{Binding ToggleDemoCommand}" Style="{StaticResource TvBtn}" Margin="0,0,6,4" />
                            <Button Content="{Binding SetupToggleLabel}" Command="{Binding ToggleSetupCommand}" Style="{StaticResource TvBtn}" Margin="0,0,6,4" ToolTip="Show or hide TV IP, MAC &amp; pairing setup fields" />
                            <Button Content="Pair with LG TV" Command="{Binding PairCommand}" Style="{StaticResource TvPrimaryBtn}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Collapsible Connection Setup Row (automatically collapses once paired!) -->
                    <Border Background="#0D111A"
                            BorderBrush="#1F2739"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            Visibility="{Binding IsSetupExpanded, Converter={StaticResource TvBoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.0*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.95*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TV NAME" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TvName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" Tag="e.g. Living Room OLED TV" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TV LAN IP ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TvIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" FontFamily="Cascadia Mono, Consolas" Tag="192.168.1.28" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="MAC ADDRESS (WAKE-ON-LAN)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" FontFamily="Cascadia Mono, Consolas" Tag="AA:BB:CC:DD:EE:FF" />
                                        <Button Grid.Column="2" Content="Auto-MAC" Command="{Binding AutoMacCommand}" Style="{StaticResource TvBtn}" Padding="9,5" FontSize="11" ToolTip="Resolve MAC address automatically from the TV IP via ARP" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <Button Content="Auto-Discover TV" Command="{Binding DiscoverCommand}" Style="{StaticResource TvBtn}" Padding="10,4.5" FontSize="11.5" Margin="0,0,6,0" ToolTip="Scan LAN via SSDP + ARP to find LG webOS TVs" />
                                <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource TvPrimaryBtn}" Padding="10,4.5" FontSize="11.5" Margin="0,0,6,0" />
                                <Button Content="Re-Pair (Full Permissions)" Command="{Binding RePairCommand}" Style="{StaticResource TvBtn}" Padding="10,4.5" FontSize="11.5" ToolTip="Force a fresh LG TV prompt to grant pointer remote &amp; installed-app permissions" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live Telemetry Strip -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource TelemetryTile}">
                            <StackPanel>
                                <TextBlock Text="TV MODEL / WEBOS" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding ModelSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource TelemetryTile}">
                            <StackPanel>
                                <TextBlock Text="NOW SHOWING" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding NowShowingText}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource TelemetryTile}">
                            <StackPanel>
                                <TextBlock Text="AUDIO OUTPUT" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding SoundOutputText}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource TelemetryTile}">
                            <StackPanel>
                                <TextBlock Text="OLED PANEL &amp; VOL" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ScreenStateText}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                    <TextBlock Text=" • " FontSize="12" Foreground="#475569" />
                                    <TextBlock Text="{Binding TvVolumeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#38BDF8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ======================== CARD 2: LIVE TV SCREEN PREVIEW & VIRTUAL TRACKPAD ======================== -->
            <Border Style="{StaticResource TvCard}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIVE TV SCREEN &amp; VIRTUAL TRACKPAD" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                <Border Background="#0E1726" BorderBrush="#243248" BorderThickness="1" CornerRadius="5" Padding="7,1.5" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding PreviewStatusText}" FontSize="10" Foreground="#38BDF8" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="Auto-Refresh"
                                      IsChecked="{Binding AutoRefreshPreview, Mode=TwoWay}"
                                      Foreground="#CBD5E1"
                                      FontSize="11.5"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      ToolTip="Automatically refresh the live TV preview every 2 seconds while this tab is open" />
                            <Button Content="Center Cursor"
                                    Command="{Binding RecalibrateCursorCommand}"
                                    Style="{StaticResource TvChipBtn}"
                                    Margin="0,0,6,0"
                                    ToolTip="Recalibrate LG Magic Remote pointer to the center of the TV screen" />
                            <Button Content="Snap Now"
                                    Command="{Binding CapturePreviewCommand}"
                                    Style="{StaticResource TvPrimaryBtn}"
                                    Padding="12,5.5"
                                    FontSize="11.5" />
                        </WrapPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.38*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="0.62*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Clickable 16:9 Live TV Preview + Browser URL Bar -->
                        <StackPanel Grid.Column="0">
                            <Border x:Name="PreviewSurface"
                                    Background="#080B11"
                                    BorderBrush="#243044"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    Height="236"
                                    Cursor="Cross"
                                    MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                                    MouseRightButtonDown="PreviewSurface_MouseRightButtonDown"
                                    MouseWheel="PreviewSurface_MouseWheel"
                                    ToolTip="Left-click anywhere to click that spot on your TV • Right-click = Back • Mouse wheel = Scroll">
                                <Grid>
                                    <Image x:Name="PreviewImageControl"
                                           Source="{Binding PreviewImage}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasPreviewImage, Converter={StaticResource TvBoolToVis}}" />

                                    <!-- Click visual feedback marker -->
                                    <Canvas x:Name="ClickOverlayCanvas" IsHitTestVisible="False">
                                        <Ellipse x:Name="ClickMarker"
                                                 Width="18"
                                                 Height="18"
                                                 Stroke="#38BDF8"
                                                 StrokeThickness="2"
                                                 Fill="#4438BDF8"
                                                 Visibility="Collapsed" />
                                    </Canvas>

                                    <!-- Placeholder before first capture -->
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="24"
                                                Visibility="{Binding ShowPreviewPlaceholder, Converter={StaticResource TvBoolToVis}}">
                                        <TextBlock Text="Live LG webOS Screen Preview"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,5" />
                                        <TextBlock Text="Click Snap Now or enable Auto-Refresh to view your TV screen here. Left-click directly on the image to point &amp; click on the TV."
                                                   FontSize="11.5"
                                                   Foreground="#64748B"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="380" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Direct LG webOS Web Browser Launcher -->
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding BrowserUrlText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TvInput}"
                                         Tag="Open URL in LG webOS Browser (e.g. news.ycombinator.com) &amp; press Enter..."
                                         ToolTip="Launches LG webOS built-in Web Browser straight to this URL and refreshes the preview">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding OpenBrowserUrlCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2"
                                        Content="Open in TV Browser"
                                        Command="{Binding OpenBrowserUrlCommand}"
                                        Style="{StaticResource TvBtn}"
                                        Padding="11,5.5" />
                            </Grid>
                        </StackPanel>

                        <!-- Right: Precision Virtual Trackpad -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="9" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="TrackpadSurface"
                                    Grid.Row="0"
                                    Background="#0B0F18"
                                    BorderBrush="#27344A"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Cursor="Hand"
                                    MinHeight="200"
                                    MouseLeftButtonDown="Trackpad_MouseLeftButtonDown"
                                    MouseMove="Trackpad_MouseMove"
                                    MouseLeftButtonUp="Trackpad_MouseLeftButtonUp"
                                    MouseRightButtonDown="Trackpad_MouseRightButtonDown"
                                    MouseWheel="Trackpad_MouseWheel"
                                    ToolTip="Drag to steer Magic Remote pointer • Tap to click • Right-click = Back • Wheel = Scroll">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14" IsHitTestVisible="False">
                                        <TextBlock Text="VIRTUAL TRACKPAD"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#38BDF8"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6" />
                                        <TextBlock x:Name="TrackpadHintText"
                                                   Text="Hold &amp; drag to move pointer&#x0a;Click to select • Right-click Back&#x0a;Scroll wheel to scroll page"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   TextAlignment="Center"
                                                   LineHeight="17" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Grid.Row="2" Columns="5">
                                <Button Content="Click" Command="{Binding PointerClickCommand}" Style="{StaticResource TvPrimaryBtn}" Padding="4,5.5" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="Back" Command="{Binding SendButtonCommand}" CommandParameter="BACK" Style="{StaticResource TvChipBtn}" Padding="4,5.5" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="Home" Command="{Binding SendButtonCommand}" CommandParameter="HOME" Style="{StaticResource TvChipBtn}" Padding="4,5.5" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="▲" Command="{Binding PointerScrollCommand}" CommandParameter="up" Style="{StaticResource TvChipBtn}" Padding="4,5.5" FontSize="11" Margin="0,0,4,0" ToolTip="Scroll Up" />
                                <Button Content="▼" Command="{Binding PointerScrollCommand}" CommandParameter="down" Style="{StaticResource TvChipBtn}" Padding="4,5.5" FontSize="11" ToolTip="Scroll Down" />
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================== ROW 2: POWER/AUDIO/HDMI + MAGIC REMOTE ======================== -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.92*" />
                </Grid.ColumnDefinitions>

                <!-- Left Stack: Power/OLED/Audio + HDMI Inputs -->
                <StackPanel Grid.Column="0">
                    <!-- Power, OLED & Audio Output Card -->
                    <Border Style="{StaticResource TvCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="POWER &amp; OLED PANEL" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,9" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Wake TV (WoL)" Command="{Binding RunActionCommand}" CommandParameter="tv.power_on" Style="{StaticResource TvPrimaryBtn}" Margin="0,0,7,7" />
                                <Button Content="Power Off" Command="{Binding RunActionCommand}" CommandParameter="tv.power_off" Style="{StaticResource TvDangerBtn}" Margin="0,0,7,7" />
                                <Button Content="OLED Screen Off" Command="{Binding RunActionCommand}" CommandParameter="tv.screen_off" Style="{StaticResource TvOledBtn}" Margin="0,0,7,7" ToolTip="Blank the OLED screen while keeping eARC / music audio playing (zero burn-in!)" />
                                <Button Content="Wake Screen" Command="{Binding RunActionCommand}" CommandParameter="tv.screen_on" Style="{StaticResource TvBtn}" Margin="0,0,7,7" />
                                <Button Content="Live TV" Command="{Binding RunActionCommand}" CommandParameter="tv.livetv" Style="{StaticResource TvBtn}" Margin="0,0,7,7" />
                                <Button Content="Close App" Command="{Binding RunActionCommand}" CommandParameter="tv.close_app" Style="{StaticResource TvBtn}" Margin="0,0,7,7" />
                            </WrapPanel>

                            <TextBlock Text="TV AUDIO OUTPUT (DENON AVR SYNERGY)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,2,0,8" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="HDMI ARC / eARC" Command="{Binding SetAudioOutputCommand}" CommandParameter="external_arc" Style="{StaticResource ActiveArcBtn}" Margin="0,0,7,6" />
                                <Button Content="TV Speakers" Command="{Binding SetAudioOutputCommand}" CommandParameter="tv_speaker" Style="{StaticResource ActiveSpeakersBtn}" Margin="0,0,7,6" />
                                <Button Content="Optical Out" Command="{Binding SetAudioOutputCommand}" CommandParameter="external_optical" Style="{StaticResource ActiveOpticalBtn}" Margin="0,0,7,6" />
                                <Button Content="Bluetooth" Command="{Binding SetAudioOutputCommand}" CommandParameter="bt_soundbar" Style="{StaticResource ActiveBluetoothBtn}" Margin="0,0,7,6" />
                            </WrapPanel>

                            <!-- TV Volume Strip -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="−" Command="{Binding StepTvVolumeCommand}" CommandParameter="-" Style="{StaticResource TvBtn}" Padding="10,4" />
                                <Slider Grid.Column="2"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding TvVolume, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        ToolTip="Internal TV / ARC Volume" />
                                <Button Grid.Column="4" Content="+" Command="{Binding StepTvVolumeCommand}" CommandParameter="+" Style="{StaticResource TvBtn}" Padding="10,4" />
                                <Button Grid.Column="6" Content="{Binding MuteButtonLabel}" Command="{Binding ToggleTvMuteCommand}" Style="{StaticResource TvBtn}" Padding="11,4" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic HDMI Inputs Card -->
                    <Border Style="{StaticResource TvCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HDMI &amp; EXTERNAL INPUTS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Green dot = live signal connected" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Inputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SwitchInputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding AppId}"
                                                Margin="0,0,8,8"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="InBd"
                                                            Background="#181D29"
                                                            BorderBrush="#2A3244"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="12,8">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="SigDot" Width="7" Height="7" Fill="#475569" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                                <TextBlock Text="{Binding Id}" FontSize="9.5" Foreground="#64748B" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter TargetName="SigDot" Property="Fill" Value="#10B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="InBd" Property="Background" Value="#0C2E3D" />
                                                            <Setter TargetName="InBd" Property="BorderBrush" Value="#38BDF8" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="InBd" Property="BorderBrush" Value="#38BDF8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Card: Virtual Magic Remote + YouTube Caster + TV Keyboard -->
                <Border Grid.Column="2" Style="{StaticResource TvCard}">
                    <StackPanel>
                        <TextBlock Text="VIRTUAL MAGIC REMOTE (POINTER SOCKET)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />

                        <!-- D-Pad + Side Nav Keys -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tactile 3x3 D-Pad -->
                            <Border Grid.Column="0" Background="#0C0F16" BorderBrush="#1E2534" BorderThickness="1" CornerRadius="12" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="2" Content="▲" Command="{Binding SendButtonCommand}" CommandParameter="UP" Style="{StaticResource DPadBtn}" />
                                    <Button Grid.Row="2" Grid.Column="0" Content="◄" Command="{Binding SendButtonCommand}" CommandParameter="LEFT" Style="{StaticResource DPadBtn}" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="OK" Command="{Binding SendButtonCommand}" CommandParameter="ENTER" Style="{StaticResource TvPrimaryBtn}" Width="44" Height="36" Padding="0" FontSize="11.5" />
                                    <Button Grid.Row="2" Grid.Column="4" Content="►" Command="{Binding SendButtonCommand}" CommandParameter="RIGHT" Style="{StaticResource DPadBtn}" />
                                    <Button Grid.Row="4" Grid.Column="2" Content="▼" Command="{Binding SendButtonCommand}" CommandParameter="DOWN" Style="{StaticResource DPadBtn}" />
                                </Grid>
                            </Border>

                            <!-- Quick Remote Keys -->
                            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="Home" Command="{Binding SendButtonCommand}" CommandParameter="HOME" Style="{StaticResource TvChipBtn}" Margin="0,0,6,6" />
                                <Button Content="Back" Command="{Binding SendButtonCommand}" CommandParameter="BACK" Style="{StaticResource TvChipBtn}" Margin="0,0,6,6" />
                                <Button Content="Exit" Command="{Binding SendButtonCommand}" CommandParameter="EXIT" Style="{StaticResource TvChipBtn}" Margin="0,0,6,6" />
                                <Button Content="Settings" Command="{Binding LaunchAppCommand}" CommandParameter="settings" Style="{StaticResource TvChipBtn}" Margin="0,0,6,6" ToolTip="Open LG webOS TV Settings" />
                                <Button Content="Info" Command="{Binding SendButtonCommand}" CommandParameter="INFO" Style="{StaticResource TvChipBtn}" Margin="0,0,6,6" />
                                <Button Content="Guide" Command="{Binding SendButtonCommand}" CommandParameter="GUIDE" Style="{StaticResource TvChipBtn}" Margin="0,0,6,6" />
                                <Button Content="Ch ▲" Command="{Binding SendButtonCommand}" CommandParameter="CHANNELUP" Style="{StaticResource TvChipBtn}" Margin="0,0,6,6" />
                                <Button Content="Ch ▼" Command="{Binding SendButtonCommand}" CommandParameter="CHANNELDOWN" Style="{StaticResource TvChipBtn}" Margin="0,0,6,6" />
                            </WrapPanel>
                        </Grid>

                        <!-- Media Transport -->
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="⏮ Rew" Command="{Binding SendMediaCommand}" CommandParameter="rewind" Style="{StaticResource TvChipBtn}" Margin="0,0,6,4" />
                            <Button Content="▶ Play" Command="{Binding SendMediaCommand}" CommandParameter="play" Style="{StaticResource TvChipBtn}" Margin="0,0,6,4" />
                            <Button Content="⏸ Pause" Command="{Binding SendMediaCommand}" CommandParameter="pause" Style="{StaticResource TvChipBtn}" Margin="0,0,6,4" />
                            <Button Content="⏹ Stop" Command="{Binding SendMediaCommand}" CommandParameter="stop" Style="{StaticResource TvChipBtn}" Margin="0,0,6,4" />
                            <Button Content="⏭ FF" Command="{Binding SendMediaCommand}" CommandParameter="fastforward" Style="{StaticResource TvChipBtn}" Margin="0,0,0,4" />
                        </WrapPanel>

                        <!-- Cast YouTube Video to TV -->
                        <TextBlock Text="CAST YOUTUBE URL / VIDEO ID TO TV" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding YouTubeUrlOrId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" Tag="Paste YouTube URL or video ID &amp; press Enter..." ToolTip="Paste any YouTube URL or 11-char video ID (leave blank to open YouTube)" >
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding CastYouTubeCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Cast YT" Command="{Binding CastYouTubeCommand}" Style="{StaticResource TvPrimaryBtn}" Padding="11,5" />
                        </Grid>

                        <!-- Type to TV Keyboard -->
                        <TextBlock Text="PC KEYBOARD → TV SEARCH / INPUT FIELD" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding KeyboardText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" Tag="Type here &amp; press Enter to send to TV..." ToolTip="Focus any search box on the TV, type here, and press Enter">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendKeyboardCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Send ↵" Command="{Binding SendKeyboardCommand}" Style="{StaticResource TvBtn}" Padding="10,5" />
                            <Button Grid.Column="4" Content="⌫" Command="{Binding BackspaceKeyboardCommand}" Style="{StaticResource TvBtn}" Padding="9,5" ToolTip="Delete 1 character on TV keyboard" />
                        </Grid>

                        <!-- Custom On-Screen Toast -->
                        <TextBlock Text="ON-SCREEN TV TOAST BANNER" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ToastText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TvInput}" Tag="Message to display on TV screen...">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendCustomToastCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Toast" Command="{Binding SendCustomToastCommand}" Style="{StaticResource TvBtn}" Padding="11,5" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================== ROW 3: INSTALLED APPS + DENON COORDINATION ======================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Dynamic Installed Apps Launcher -->
                <Border Grid.Column="0" Style="{StaticResource TvCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="INSTALLED TV APPS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                <Border Background="#172030" BorderBrush="#263348" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding AppsCountBadge}" FontSize="10" Foreground="#94A3B8" />
                                </Border>
                            </StackPanel>
                            <TextBox Grid.Column="2"
                                     Text="{Binding AppSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TvInput}"
                                     Padding="8,4"
                                     FontSize="11.5"
                                     Tag="Filter installed apps..."
                                     ToolTip="Filter installed LG webOS apps by name or ID" />
                        </Grid>

                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredApps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Margin="0,0,8,8"
                                                Cursor="Hand"
                                                ToolTip="{Binding Id}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="AppBd"
                                                            Background="#181D29"
                                                            BorderBrush="#2A3244"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="10,7"
                                                            MinWidth="118">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border x:Name="AppBadge"
                                                                    Background="#0E1726"
                                                                    BorderBrush="#2C3E57"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Width="26"
                                                                    Height="24"
                                                                    Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding BadgeText}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#38BDF8"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#F1F5F9"
                                                                       VerticalAlignment="Center"
                                                                       MaxWidth="120"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="AppBd" Property="Background" Value="#0C2E3D" />
                                                            <Setter TargetName="AppBd" Property="BorderBrush" Value="#38BDF8" />
                                                            <Setter TargetName="AppBadge" Property="Background" Value="#0284C7" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="AppBd" Property="Background" Value="#212839" />
                                                            <Setter TargetName="AppBd" Property="BorderBrush" Value="#38BDF8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Right: Denon AVR Coordination -->
                <Border Grid.Column="2" Style="{StaticResource TvCard}">
                    <StackPanel>
                        <TextBlock Text="DENON AVR COORDINATION" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                        <CheckBox Content="Wake TV (WoL) when Denon powers ON" IsChecked="{Binding WakeWithDenon}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <CheckBox Content="Power off TV when Denon enters Standby" IsChecked="{Binding OffWithStandby}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <CheckBox Content="Switch TV audio to HDMI ARC/eARC on Denon ON" IsChecked="{Binding SwitchToArcOnDenon}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <CheckBox Content="Mute internal TV speakers on Denon ON" IsChecked="{Binding MuteSpeakersOnDenon}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <CheckBox Content="Show on-screen TV toast on Smart Scenes" IsChecked="{Binding ShowSceneToast}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <CheckBox Content="OLED Screen Off on Music / Listening scenes" IsChecked="{Binding ScreenOffOnMusicScene}" Foreground="#E2E8F0" Margin="0,0,0,10" />

                        <TextBlock Text="Changes save automatically. All 24 Smart TV actions (OLED Screen Off, eARC, HDMI 1–4, YouTube, Netflix, Plex, Play/Pause, Toasts) are also available in Smart Scenes 2.0, Global Hotkeys &amp; Couch Phone Remote!"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
