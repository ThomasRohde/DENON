{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denon-desktop.local/schemas/receiver-profile.schema.json",
  "title": "Denon Desktop receiver profile",
  "description": "Recommended settings for one receiver family. The app compares the receiver with it and sends only the commands it describes, with values from its own lists.",
  "type": "object",
  "required": ["id", "name", "models", "settings"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .\\-]{1,40}$" }
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/setting" }
    },
    "modelOverrides": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/modelOverride" }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9.+\\-]{1,16}$" },
    "settingId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,39}$" },
    "useKey": { "enum": ["films", "music", "lateNight", "tv"] },
    "recommended": {
      "oneOf": [
        { "$ref": "#/$defs/token" },
        { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
      ]
    },
    "recommend": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/useKey" },
      "additionalProperties": { "$ref": "#/$defs/recommended" }
    },
    "modelOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/settingId" } },
        "recommend": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/settingId" },
          "additionalProperties": { "$ref": "#/$defs/recommend" }
        }
      }
    },
    "setting": {
      "type": "object",
      "required": ["id", "label", "group", "scope", "tier", "why"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/settingId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "group": { "type": "string", "minLength": 1, "maxLength": 40 },
        "scope": { "enum": ["global", "perInput", "perSoundMode"] },
        "tier": { "enum": ["apply", "confirm", "advice"] },
        "read": { "type": "string", "pattern": "^[A-Z][A-Z0-9 :.]{0,38}\\?$" },
        "readParse": { "type": "string", "minLength": 1, "maxLength": 200 },
        "decode": { "enum": ["none", "offset50"] },
        "write": { "type": "string", "pattern": "^[A-Z][A-Z0-9 :.]{0,38}\\{value\\}$" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": ["token"],
            "additionalProperties": false,
            "properties": {
              "token": { "$ref": "#/$defs/token" },
              "label": { "type": "string", "minLength": 1, "maxLength": 60 }
            }
          }
        },
        "unit": { "type": "string", "maxLength": 8 },
        "blockedWhen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "soundModes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 40 } }
          }
        },
        "requires": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/settingId" },
          "additionalProperties": { "$ref": "#/$defs/token" }
        },
        "recommend": { "$ref": "#/$defs/recommend" },
        "warnWhen": {
          "type": "object",
          "required": ["message"],
          "additionalProperties": false,
          "properties": {
            "atLimits": {
              "type": "object",
              "required": ["min", "max"],
              "additionalProperties": false,
              "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }
            },
            "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
            "message": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "anyOf": [{ "required": ["atLimits"] }, { "required": ["values"] }]
        },
        "advice": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "why": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sources": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      },
      "allOf": [
        {
          "if": { "properties": { "tier": { "const": "advice" } }, "required": ["tier"] },
          "then": {
            "allOf": [
              { "not": { "required": ["write"] } },
              { "not": { "required": ["values"] } },
              { "not": { "required": ["recommend"] } },
              { "anyOf": [{ "required": ["advice"] }, { "required": ["warnWhen"] }] }
            ]
          },
          "else": {
            "required": ["read", "readParse", "write", "values", "recommend"],
            "not": { "required": ["warnWhen"] }
          }
        },
        {
          "if": { "required": ["read"] },
          "then": { "required": ["readParse"] }
        },
        {
          "if": { "required": ["readParse"] },
          "then": { "required": ["read"] }
        }
      ]
    }
  }
}
