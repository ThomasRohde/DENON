<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Denon.App.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP App views, served as ui:// resources (DenonMcpServer.Apps.cs). -->
    <EmbeddedResource Include="Mcp\Apps\*.html;Mcp\Apps\*.css;Mcp\Apps\*.js" LogicalName="Denon.App.Core.Mcp.Apps.%(Filename)%(Extension)" />
    <!-- Receiver setup check: the profile schema and the bundled receiver profiles (Setup\ReceiverProfileLibrary.cs). -->
    <EmbeddedResource Include="Setup\receiver-profile.schema.json" LogicalName="Denon.App.Core.Setup.receiver-profile.schema.json" />
    <EmbeddedResource Include="Setup\Profiles\*.json" LogicalName="Denon.App.Core.Setup.Profiles.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Denon.App.PluginSdk\Denon.App.PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" />
    <PackageReference Include="YoutubeExplode" />
  </ItemGroup>

</Project>
