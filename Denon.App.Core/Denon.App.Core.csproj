<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.13.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Denon.App.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP App views, served as ui:// resources (DenonMcpServer.Apps.cs). -->
    <EmbeddedResource Include="Mcp\Apps\*.html;Mcp\Apps\*.css;Mcp\Apps\*.js" LogicalName="Denon.App.Core.Mcp.Apps.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Denon.App.PluginSdk\Denon.App.PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" Version="2.4.0" />
    <PackageReference Include="YoutubeExplode" Version="6.6.3" />
  </ItemGroup>

</Project>
