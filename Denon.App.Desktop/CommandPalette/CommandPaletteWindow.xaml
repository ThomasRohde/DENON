<Window x:Class="Denon.App.Desktop.CommandPalette.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
        Title="Command palette"
        AutomationProperties.Name="Command palette"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}"
        Width="{skin:Size 640}"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyboardNavigation.TabNavigation="Cycle"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- One result row: a cyan bar and tint on the chosen row (it stays visible while the search box has focus),
             and a cyan outline on the row that has keyboard focus. -->
        <Style x:Key="PaletteResultItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="{skin:Space 10,7}" />
            <Setter Property="Margin" Value="{skin:Space 0,1}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius03}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{skin:Size 3}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar"
                                        Grid.Column="0"
                                        Margin="{skin:Space 0,6}"
                                        Background="Transparent"
                                        CornerRadius="{DynamicResource Radius01}" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="{skin:Space 12}"
            Background="{DynamicResource Ink03Brush}"
            BorderBrush="{DynamicResource Ink12Brush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius07}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.6" />
        </Border.Effect>

        <DockPanel>
            <!-- Search box -->
            <Grid DockPanel.Dock="Top" Margin="{skin:Space 14,14,14,10}">
                <TextBox x:Name="SearchBox"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search pages, scenes, stations, inputs, sound modes, plugins..."
                         FontSize="{DynamicResource FontSize09}"
                         Padding="{skin:Space 36,10,12,10}"
                         AutomationProperties.Name="Search commands"
                         AutomationProperties.HelpText="Type to search. Up and Down choose a result, Enter runs it, Escape closes." />
                <Path Data="{DynamicResource IconChevronRight}"
                      Fill="{DynamicResource AccentCyanBrush}"
                      Width="{skin:Size 12}"
                      Height="{skin:Size 12}"
                      Stretch="Uniform"
                      Margin="{skin:Space 14,0,0,0}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False" />
            </Grid>

            <!-- Footer: key hints and the live status line -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="{skin:Space 14,8}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="↑ ↓ choose   ·   Enter run   ·   Esc close"
                               FontSize="{DynamicResource FontSize03}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="{skin:Space 12,0,0,0}"
                               AutomationProperties.Name="Up and Down choose, Enter runs, Escape closes" />
                    <TextBlock x:Name="StatusLine"
                               Text="{Binding StatusText}"
                               FontSize="{DynamicResource FontSize03}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="{Binding StatusText}" />
                </DockPanel>
            </Border>

            <!-- Results -->
            <ListBox x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource PaletteResultItem}"
                     MaxHeight="{skin:Size 430}"
                     Margin="{skin:Space 8,0,8,8}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     AutomationProperties.Name="Results"
                     PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                     Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  x:Name="RowIcon"
                                  Data="{Binding Icon}"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  Width="{skin:Size 16}"
                                  Height="{skin:Size 16}"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="{skin:Space 2,0,12,0}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{DynamicResource FontSize07}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="{DynamicResource FontSize03}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="{skin:Space 0,2,0,0}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 10,0,0,0}">
                                <TextBlock Text="{Binding Badge}"
                                           FontSize="{DynamicResource FontSize02}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentEmeraldTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="{skin:Space 0,0,8,0}"
                                           Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}" />
                                <Border Background="{DynamicResource ControlBgBrush}"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius02}"
                                        Padding="{skin:Space 7,2}">
                                    <TextBlock Text="{Binding CategoryLabel}"
                                               FontSize="{DynamicResource FontSize02}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="RowIcon" Property="Fill" Value="{DynamicResource AccentCyanBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
