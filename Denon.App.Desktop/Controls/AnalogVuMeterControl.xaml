<UserControl x:Class="Denon.App.Desktop.Controls.AnalogVuMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls"
             Height="{skin:Size 136}"
             UseLayoutRounding="True">
    <!-- Machined deck panel holding two backlit VU windows (left amber, right cyan). -->
    <Border CornerRadius="{DynamicResource Radius06}"
            BorderBrush="{DynamicResource Ink11Brush}"
            Background="{DynamicResource MeterPanelGradient}"
            BorderThickness="1"
            Padding="{skin:Space 6}">

        <Grid>
            <!-- Top bevel highlight of the panel -->
            <Border CornerRadius="{DynamicResource Radius04}" BorderThickness="0,1,0,0" Margin="{skin:Space -5,-5,-5,0}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource BevelHighlightGradient}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{skin:Size 8}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Recessed window wells give the glass a seat in the panel -->
                <Border Grid.Column="0" CornerRadius="{DynamicResource Radius05}" Background="{DynamicResource OledBgBrush}" Padding="{skin:Space 1.5}" VerticalAlignment="Center">
                    <controls:VuDial x:Name="LeftDial" Channel="L" ChannelName="LEFT" />
                </Border>

                <!-- Center seam: a fine vertical groove between the windows -->
                <Rectangle Grid.Column="1" Width="1" Margin="{skin:Space 0,10}" Fill="{DynamicResource Ink08Brush}" HorizontalAlignment="Center" />

                <Border Grid.Column="2" CornerRadius="{DynamicResource Radius05}" Background="{DynamicResource OledBgBrush}" Padding="{skin:Space 1.5}" VerticalAlignment="Center">
                    <controls:VuDial x:Name="RightDial" Channel="R" ChannelName="RIGHT" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
