<UserControl x:Class="Denon.App.Desktop.Controls.AnalogVuMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="92">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT CHANNEL VU DIAL -->
        <Border Grid.Column="0"
                CornerRadius="10"
                BorderBrush="#273245"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#141822" Offset="0" />
                    <GradientStop Color="#0B0E15" Offset="0.6" />
                    <GradientStop Color="#17130C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Subtle warm backlight glow -->
                <Ellipse Width="170" Height="90" VerticalAlignment="Bottom" Margin="0,0,0,-44" Opacity="0.22">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#F59E0B" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Scale Arc & Labels -->
                <Viewbox Stretch="Uniform" Margin="8,4,8,2">
                    <Canvas Width="200" Height="86">
                        <!-- Main scale arc (-20 to 0 dB) -->
                        <Path Data="M 24,68 A 86,86 0 0,1 142,24"
                              Stroke="#D99B38"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" />
                        <!-- Red overload zone (0 to +3 dB) -->
                        <Path Data="M 142,24 A 86,86 0 0,1 176,68"
                              Stroke="#EF4444"
                              StrokeThickness="2.8"
                              StrokeEndLineCap="Round" />

                        <!-- Tick Labels -->
                        <TextBlock Canvas.Left="16" Canvas.Top="44" Text="-20" FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="#94A3B8" />
                        <TextBlock Canvas.Left="46" Canvas.Top="20" Text="-10" FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="#CBD5E1" />
                        <TextBlock Canvas.Left="84" Canvas.Top="8" Text="-5" FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="#F59E0B" />
                        <TextBlock Canvas.Left="118" Canvas.Top="10" Text="-3" FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="#F59E0B" />
                        <TextBlock Canvas.Left="146" Canvas.Top="19" Text="0" FontSize="9.5" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="#F87171" />
                        <TextBlock Canvas.Left="169" Canvas.Top="44" Text="+3" FontSize="9" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="#EF4444" />

                        <TextBlock Canvas.Left="87" Canvas.Top="36" Text="VU" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Opacity="0.85" />
                        <TextBlock Canvas.Left="10" Canvas.Top="6" Text="CH L" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />

                        <!-- Peak LED -->
                        <Ellipse x:Name="PeakLedLeft" Canvas.Left="180" Canvas.Top="8" Width="7" Height="7" Fill="#3B1518" />

                        <!-- Hardware-accelerated Dual-Stroke Needle (zero DropShadowEffect lag) -->
                        <Canvas RenderTransformOrigin="0,0">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="LeftNeedleTransform" CenterX="100" CenterY="94" Angle="-44" />
                            </Canvas.RenderTransform>
                            <Line X1="100" Y1="94" X2="100" Y2="14"
                                  Stroke="#66F59E0B"
                                  StrokeThickness="5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Line X1="100" Y1="94" X2="100" Y2="14"
                                  Stroke="#F8FAFC"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>

                        <!-- Pivot Cap -->
                        <Ellipse Canvas.Left="88" Canvas.Top="78" Width="24" Height="24" Fill="#1E2433" Stroke="#3B455E" StrokeThickness="1" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>

        <!-- RIGHT CHANNEL VU DIAL -->
        <Border Grid.Column="2"
                CornerRadius="10"
                BorderBrush="#273245"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#141822" Offset="0" />
                    <GradientStop Color="#0B0E15" Offset="0.6" />
                    <GradientStop Color="#17130C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Ellipse Width="170" Height="90" VerticalAlignment="Bottom" Margin="0,0,0,-44" Opacity="0.22">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#00D4FF" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Viewbox Stretch="Uniform" Margin="8,4,8,2">
                    <Canvas Width="200" Height="86">
                        <Path Data="M 24,68 A 86,86 0 0,1 142,24"
                              Stroke="#38BDF8"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" />
                        <Path Data="M 142,24 A 86,86 0 0,1 176,68"
                              Stroke="#EF4444"
                              StrokeThickness="2.8"
                              StrokeEndLineCap="Round" />

                        <TextBlock Canvas.Left="16" Canvas.Top="44" Text="-20" FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="#94A3B8" />
                        <TextBlock Canvas.Left="46" Canvas.Top="20" Text="-10" FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="#CBD5E1" />
                        <TextBlock Canvas.Left="84" Canvas.Top="8" Text="-5" FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="#38BDF8" />
                        <TextBlock Canvas.Left="118" Canvas.Top="10" Text="-3" FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="#38BDF8" />
                        <TextBlock Canvas.Left="146" Canvas.Top="19" Text="0" FontSize="9.5" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="#F87171" />
                        <TextBlock Canvas.Left="169" Canvas.Top="44" Text="+3" FontSize="9" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="#EF4444" />

                        <TextBlock Canvas.Left="87" Canvas.Top="36" Text="VU" FontSize="12" FontWeight="Bold" Foreground="#00D4FF" Opacity="0.85" />
                        <TextBlock Canvas.Left="10" Canvas.Top="6" Text="CH R" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="ModeBadgeText" Canvas.Left="134" Canvas.Top="6" Text="SYNC" FontSize="8" FontWeight="Bold" Foreground="#10B981" />

                        <Ellipse x:Name="PeakLedRight" Canvas.Left="180" Canvas.Top="8" Width="7" Height="7" Fill="#3B1518" />

                        <Canvas RenderTransformOrigin="0,0">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="RightNeedleTransform" CenterX="100" CenterY="94" Angle="-44" />
                            </Canvas.RenderTransform>
                            <Line X1="100" Y1="94" X2="100" Y2="14"
                                  Stroke="#6600D4FF"
                                  StrokeThickness="5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Line X1="100" Y1="94" X2="100" Y2="14"
                                  Stroke="#F8FAFC"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>

                        <Ellipse Canvas.Left="88" Canvas.Top="78" Width="24" Height="24" Fill="#1E2433" Stroke="#3B455E" StrokeThickness="1" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
