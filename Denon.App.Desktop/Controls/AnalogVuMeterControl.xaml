<UserControl x:Class="Denon.App.Desktop.Controls.AnalogVuMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls"
             Height="136"
             UseLayoutRounding="True">
    <!-- Machined deck panel holding two backlit VU windows (left amber, right cyan). -->
    <Border CornerRadius="14"
            BorderBrush="{StaticResource Ink11Brush}"
            BorderThickness="1"
            Padding="6">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource Ink06Color}" Offset="0" />
                <GradientStop Color="{StaticResource Ink02Color}" Offset="0.5" />
                <GradientStop Color="{StaticResource Ink01Color}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Top bevel highlight of the panel -->
            <Border CornerRadius="10" BorderThickness="0,1,0,0" Margin="-5,-5,-5,0" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource OverlayWhiteClearColor}" Offset="0" />
                        <GradientStop Color="{StaticResource OverlayWhiteSoftColor}" Offset="0.5" />
                        <GradientStop Color="{StaticResource OverlayWhiteClearColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Recessed window wells give the glass a seat in the panel -->
                <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource OledBgBrush}" Padding="1.5" VerticalAlignment="Center">
                    <controls:VuDial x:Name="LeftDial" Accent="{StaticResource AccentAmberColor}" Channel="L" ChannelName="LEFT" />
                </Border>

                <!-- Center seam: a fine vertical groove between the windows -->
                <Rectangle Grid.Column="1" Width="1" Margin="0,10" Fill="{StaticResource Ink08Brush}" HorizontalAlignment="Center" />

                <Border Grid.Column="2" CornerRadius="12" Background="{StaticResource OledBgBrush}" Padding="1.5" VerticalAlignment="Center">
                    <controls:VuDial x:Name="RightDial" Accent="{StaticResource AccentTealColor}" Channel="R" ChannelName="RIGHT" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
