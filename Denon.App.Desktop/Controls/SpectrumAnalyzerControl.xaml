<UserControl x:Class="Denon.App.Desktop.Controls.SpectrumAnalyzerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="138"
             MinWidth="260">
    <Border Background="#07090F"
            BorderBrush="#1F2A3C"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12,8,12,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="31-BAND REAL-TIME FFT SPECTRUM (RTA)"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="#64748B"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SignalModeLabel"
                           Text="STANDBY"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="#00D4FF"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Canvas x:Name="BarsCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="BarsCanvas_SizeChanged" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="31Hz" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#475569" />
                <TextBlock Grid.Column="1" Text="125Hz" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#475569" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="500Hz" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#475569" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="1kHz" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#475569" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="4kHz" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#475569" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="16kHz" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#475569" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
