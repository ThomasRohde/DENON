<UserControl x:Class="Denon.App.Desktop.Controls.SpectrumAnalyzerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls"
             Height="138"
             MinWidth="260"
             UseLayoutRounding="True">
    <!-- Same machined deck panel as the VU pair, holding a recessed LED screen. -->
    <Border CornerRadius="14"
            BorderBrush="{StaticResource Ink11Brush}"
            BorderThickness="1"
            Padding="10,6,10,6">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource Ink06Color}" Offset="0" />
                <GradientStop Color="{StaticResource Ink02Color}" Offset="0.5" />
                <GradientStop Color="{StaticResource Ink01Color}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="2,0,2,5" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SPECTRUM" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="  31-BAND RTA  ·  25 Hz – 16 kHz" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextDisabledBrush}" />
                </StackPanel>

                <Border x:Name="SourcePill"
                        DockPanel.Dock="Right"
                        CornerRadius="6"
                        BorderThickness="1"
                        Padding="7,1,7,1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SignalModeLabel"
                               Text="STANDBY"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="8.5"
                               FontWeight="Bold" />
                </Border>
            </DockPanel>

            <!-- Recessed LED screen -->
            <Border Grid.Row="1" CornerRadius="10" Background="{StaticResource OledBgBrush}" BorderBrush="{StaticResource Ink05Brush}" BorderThickness="1" Padding="9,7,9,2" ClipToBounds="True">
                <Grid>
                    <controls:SpectrumLedView x:Name="BarsView" />
                    <!-- Bloom: the lit segments again, blurred, over the grille. -->
                    <controls:SpectrumLedView x:Name="GlowView" GlowOnly="True" Opacity="0.5" IsHitTestVisible="False">
                        <controls:SpectrumLedView.Effect>
                            <BlurEffect Radius="9" RenderingBias="Performance" KernelType="Gaussian" />
                        </controls:SpectrumLedView.Effect>
                    </controls:SpectrumLedView>
                    <!-- Screen glass: soft top sheen -->
                    <Border IsHitTestVisible="False" CornerRadius="8" Margin="-9,-7,-9,-2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{StaticResource OverlayWhiteFaintColor}" Offset="0" />
                                <GradientStop Color="{StaticResource OverlayWhiteClearColor}" Offset="0.35" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
