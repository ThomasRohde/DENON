<UserControl x:Class="Denon.App.Desktop.Controls.SpectrumAnalyzerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls"
             Height="{skin:Size 138}"
             MinWidth="{skin:Size 260}"
             UseLayoutRounding="True">
    <!-- Same machined deck panel as the VU pair, holding a recessed LED screen. -->
    <Border CornerRadius="{DynamicResource Radius06}"
            BorderBrush="{DynamicResource Ink11Brush}"
            Background="{DynamicResource MeterPanelGradient}"
            BorderThickness="1"
            Padding="{skin:Space 10,6,10,6}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="{skin:Space 2,0,2,5}" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SPECTRUM" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="  31-BAND RTA  ·  25 Hz – 16 kHz" FontSize="{DynamicResource FontSize00}" FontWeight="SemiBold" Foreground="{DynamicResource TextDisabledBrush}" />
                </StackPanel>

                <Border x:Name="SourcePill"
                        DockPanel.Dock="Right"
                        CornerRadius="{DynamicResource Radius02}"
                        BorderThickness="1"
                        Padding="{skin:Space 7,1,7,1}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SignalModeLabel"
                               Text="STANDBY"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{DynamicResource FontSize00}"
                               FontWeight="Bold" />
                </Border>
            </DockPanel>

            <!-- Recessed LED screen: meter material (MeterPalette), the skin's dark or light set like the VU dials. -->
            <Border x:Name="LedScreen" Grid.Row="1" CornerRadius="{DynamicResource Radius04}" BorderThickness="1" Padding="{skin:Space 9,7,9,2}" ClipToBounds="True">
                <Grid>
                    <controls:SpectrumLedView x:Name="BarsView" />
                    <!-- Bloom: the lit segments again, blurred, over the grille. -->
                    <controls:SpectrumLedView x:Name="GlowView" GlowOnly="True" Opacity="0.5" IsHitTestVisible="False">
                        <controls:SpectrumLedView.Effect>
                            <BlurEffect Radius="9" RenderingBias="Performance" KernelType="Gaussian" />
                        </controls:SpectrumLedView.Effect>
                    </controls:SpectrumLedView>
                    <!-- Screen glass: soft top sheen -->
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource Radius03}" Margin="{skin:Space -9,-7,-9,-2}"
                            Background="{DynamicResource ScreenSheenGradient}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
