<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Denon.App.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Denon.App.Core\Denon.App.Core.csproj" />
    <ProjectReference Include="..\Denon.App.PluginSdk\Denon.App.PluginSdk.csproj" />
    <ProjectReference Include="..\Denon.Plugin.PhilipsHue\Denon.Plugin.PhilipsHue.csproj" />
    <ProjectReference Include="..\Denon.Plugin.SmartTv\Denon.Plugin.SmartTv.csproj" />
    <ProjectReference Include="..\Denon.Plugin.HomeAssistant\Denon.Plugin.HomeAssistant.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>2.10.23</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>denon_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Themes\Fonts\ShareTechMono-Regular.ttf" />
    <Resource Include="denon_icon.ico" />
    <Resource Include="denon_icon.png" />
    <Resource Include="Assets\Icons\denon_tray.ico" />
    <Resource Include="Assets\Icons\variants\active.ico" />
    <Resource Include="Assets\Icons\variants\muted.ico" />
    <Resource Include="Assets\Icons\variants\power.ico" />
  </ItemGroup>

  <!-- The Insights page (Services/InsightsServer.cs serves these to the browser). -->
  <ItemGroup>
    <EmbeddedResource Include="Insights\index.html" LogicalName="Insights.index.html" />
    <EmbeddedResource Include="Insights\insights.css" LogicalName="Insights.insights.css" />
    <EmbeddedResource Include="Insights\insights.js" LogicalName="Insights.insights.js" />
    <!-- The automation node editor, served by the same server (Services/AutomationEditorApi.cs, docs/automation-graphs.md). -->
    <EmbeddedResource Include="Automations\index.html" LogicalName="Automations.index.html" />
    <EmbeddedResource Include="Automations\editor.css" LogicalName="Automations.editor.css" />
    <EmbeddedResource Include="Automations\editor.js" LogicalName="Automations.editor.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
  </ItemGroup>

</Project>
