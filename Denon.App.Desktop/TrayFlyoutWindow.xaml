<Window x:Class="Denon.App.Desktop.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
        Title="Denon Quick Control"
        Width="368"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="10"
            Background="{StaticResource Ink03Brush}"
            BorderBrush="{StaticResource Ink12Brush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="6" Opacity="0.65" />
        </Border.Effect>

        <StackPanel>
            <!-- Top Row: Brand, Status, Power, Open Full App -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBadgeBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ReceiverTitle}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="165" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding TogglePowerCommand}"
                            Content="{Binding PowerStateLabel}"
                            Padding="9,4"
                            FontSize="10.5"
                            Margin="0,0,6,0"
                            Style="{StaticResource SuccessChipButton}"
                            infra:Chip.IsActive="{Binding PowerStateLabel, Converter={StaticResource EqualityConverter}, ConverterParameter=ACTIVE}" />
                    <Button Content="Open ↗"
                            Click="OpenFullWindowButton_Click"
                            Style="{StaticResource PrimaryButton}"
                            Padding="10,4"
                            FontSize="11" />
                </StackPanel>
            </DockPanel>

            <!-- Compact OLED Now Playing + Transport -->
            <Border Background="{StaticResource OledBgBrush}"
                    BorderBrush="{StaticResource Ink08Brush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding InputSourceDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding NowPlayingDetail}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PlayPauseCommand}"
                                Style="{StaticResource HeroPlayCircleButton}"
                                Width="38"
                                Height="38"
                                Margin="0,0,6,0"
                                ToolTip="Play / Pause">
                            <Grid>
                                <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                      Fill="{StaticResource AccentCyanInkBrush}"
                                      Width="14"
                                      Height="14"
                                      Margin="2,0,0,0"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsTransportPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <Path Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                                      Fill="{StaticResource AccentCyanInkBrush}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsTransportPlaying, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                        <Button Command="{Binding StopCommand}"
                                Style="{StaticResource TransportCircleButton}"
                                Width="34"
                                Height="34"
                                ToolTip="Stop">
                            <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource TextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live Volume Control -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource ControlHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    PreviewMouseWheel="VolumeArea_PreviewMouseWheel">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="VOLUME" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PrimaryVolumeText}"
                                       Style="{StaticResource OledMonoText}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button Command="{Binding ToggleMuteCommand}"
                                    Content="{Binding MuteButtonText}"
                                    Padding="8,3"
                                    FontSize="10.5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentCrimsonBgStrongBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentCrimsonBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentCrimsonTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Slider Style="{StaticResource VolumeSliderStyle}"
                            Minimum="0"
                            Maximum="{Binding MaxVolume}"
                            Value="{Binding TargetVolume, Mode=TwoWay}"
                            Thumb.DragStarted="VolumeSlider_DragStarted"
                            Thumb.DragCompleted="VolumeSlider_DragCompleted" />
                </StackPanel>
            </Border>

            <!-- Quick Input Pills -->
            <TextBlock Text="QUICK INPUTS" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,6" />
            <WrapPanel Margin="0,0,0,10">
                <Button Content="HEOS" Command="{Binding SelectInputCommand}" CommandParameter="NET" Style="{StaticResource HardwareChipButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" />
                <Button Content="TV" Command="{Binding SelectInputCommand}" CommandParameter="TV" Style="{StaticResource HardwareChipButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" />
                <Button Content="Game" Command="{Binding SelectInputCommand}" CommandParameter="GAME" Style="{StaticResource HardwareChipButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" />
                <Button Content="Blu-ray" Command="{Binding SelectInputCommand}" CommandParameter="BD" Style="{StaticResource HardwareChipButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" />
                <Button Content="BT" Command="{Binding SelectInputCommand}" CommandParameter="BT" Style="{StaticResource HardwareChipButton}" Padding="10,5" FontSize="11" Margin="0,0,0,6" />
            </WrapPanel>

            <!-- Quick Stations (Internally Scrollable) -->
            <TextBlock Text="PRESET STATIONS" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,6" />
            <ScrollViewer MaxHeight="140"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding StationPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.PlayPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Padding="10,6"
                                    FontSize="11"
                                    Margin="0,0,6,6"
                                    Style="{StaticResource ChipButton}"
                                    infra:Chip.IsActive="{Binding IsCurrentlyPlaying}">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
