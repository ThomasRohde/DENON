<Window x:Class="Denon.App.Desktop.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
        Title="Denon Quick Control"
        Width="368"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="{skin:Space 10}"
            Background="{DynamicResource Ink03Brush}"
            BorderBrush="{DynamicResource Ink12Brush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius07}"
            Padding="{skin:Space 16}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="6" Opacity="0.65" />
        </Border.Effect>

        <StackPanel>
            <!-- Top Row: Brand, Status, Power, Open Full App -->
            <DockPanel Margin="{skin:Space 0,0,0,12}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="{skin:Size 8}" Height="{skin:Size 8}" Fill="{Binding ConnectionBadgeBrush}" Margin="{skin:Space 0,0,8,0}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ReceiverTitle}" FontSize="{DynamicResource FontSize08}" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="{skin:Size 165}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding TogglePowerCommand}"
                            Content="{Binding PowerStateLabel}"
                            Padding="{skin:Space 9,4}"
                            FontSize="{DynamicResource FontSize03}"
                            Margin="{skin:Space 0,0,6,0}"
                            Style="{StaticResource SuccessChipButton}"
                            infra:Chip.IsActive="{Binding PowerStateLabel, Converter={StaticResource EqualityConverter}, ConverterParameter=ACTIVE}" />
                    <Button Content="Open ↗"
                            Click="OpenFullWindowButton_Click"
                            Style="{StaticResource PrimaryButton}"
                            Padding="{skin:Space 10,4}"
                            FontSize="{DynamicResource FontSize04}" />
                </StackPanel>
            </DockPanel>

            <!-- Compact OLED Now Playing + Transport -->
            <Border Background="{DynamicResource OledBgBrush}"
                    BorderBrush="{DynamicResource Ink08Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius04}"
                    Padding="{skin:Space 12}"
                    Margin="{skin:Space 0,0,0,12}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="{skin:Space 0,0,10,0}">
                        <TextBlock Text="{Binding InputSourceDisplay}" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="{DynamicResource FontSize09}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="{skin:Space 0,2,0,0}" />
                        <TextBlock Text="{Binding NowPlayingDetail}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="{skin:Space 0,1,0,0}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PlayPauseCommand}"
                                Style="{StaticResource HeroPlayCircleButton}"
                                Width="{skin:Size 38}"
                                Height="{skin:Size 38}"
                                Margin="{skin:Space 0,0,6,0}"
                                ToolTip="Play / Pause">
                            <Grid>
                                <Path Data="{DynamicResource IconPlay}"
                                      Fill="{DynamicResource AccentCyanInkBrush}"
                                      Width="{skin:Size 14}"
                                      Height="{skin:Size 14}"
                                      Margin="{skin:Space 2,0,0,0}"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsTransportPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <Path Data="{DynamicResource IconPause}"
                                      Fill="{DynamicResource AccentCyanInkBrush}"
                                      Width="{skin:Size 13}"
                                      Height="{skin:Size 13}"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsTransportPlaying, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                        <Button Command="{Binding StopCommand}"
                                Style="{StaticResource TransportCircleButton}"
                                Width="{skin:Size 34}"
                                Height="{skin:Size 34}"
                                ToolTip="Stop">
                            <Rectangle Width="{skin:Size 9}" Height="{skin:Size 9}" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource TextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live Volume Control -->
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource ControlHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius04}"
                    Padding="{skin:Space 12,10}"
                    Margin="{skin:Space 0,0,0,12}"
                    PreviewMouseWheel="VolumeArea_PreviewMouseWheel">
                <StackPanel>
                    <DockPanel Margin="{skin:Space 0,0,0,6}">
                        <TextBlock Text="VOLUME" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PrimaryVolumeText}"
                                       Style="{StaticResource OledMonoText}"
                                       FontSize="{DynamicResource FontSize10}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="{skin:Space 0,0,8,0}" />
                            <Button Command="{Binding ToggleMuteCommand}"
                                    Content="{Binding MuteButtonText}"
                                    Padding="{skin:Space 8,3}"
                                    FontSize="{DynamicResource FontSize03}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentCrimsonBgStrongBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentCrimsonBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentCrimsonTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Slider Style="{StaticResource VolumeSliderStyle}"
                            Minimum="0"
                            Maximum="{Binding MaxVolume}"
                            Value="{Binding TargetVolume, Mode=TwoWay}"
                            Thumb.DragStarted="VolumeSlider_DragStarted"
                            Thumb.DragCompleted="VolumeSlider_DragCompleted" />
                </StackPanel>
            </Border>

            <!-- Quick Input Pills -->
            <TextBlock Text="QUICK INPUTS" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 2,0,0,6}" />
            <WrapPanel Margin="{skin:Space 0,0,0,10}">
                <Button Content="HEOS" Command="{Binding SelectInputCommand}" CommandParameter="NET" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,6}" />
                <Button Content="TV" Command="{Binding SelectInputCommand}" CommandParameter="TV" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,6}" />
                <Button Content="Game" Command="{Binding SelectInputCommand}" CommandParameter="GAME" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,6}" />
                <Button Content="Blu-ray" Command="{Binding SelectInputCommand}" CommandParameter="BD" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,6}" />
                <Button Content="BT" Command="{Binding SelectInputCommand}" CommandParameter="BT" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,0,6}" />
            </WrapPanel>

            <!-- Quick Stations (Internally Scrollable) -->
            <TextBlock Text="PRESET STATIONS" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 2,0,0,6}" />
            <ScrollViewer MaxHeight="{skin:Size 140}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding StationPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.PlayPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Padding="{skin:Space 10,6}"
                                    FontSize="{DynamicResource FontSize04}"
                                    Margin="{skin:Space 0,0,6,6}"
                                    Style="{StaticResource ChipButton}"
                                    infra:Chip.IsActive="{Binding IsCurrentlyPlaying}">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
