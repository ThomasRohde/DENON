<Window x:Class="Denon.App.Desktop.SplashWindow"
        Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
        Title="Denon Desktop"
        Width="660"
        Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        WindowStartupLocation="CenterScreen"
        Icon="denon_icon.ico">

    <!--
        First start after an install, upgrade or reinstall (App.ShowSplashIfNew). Theme brushes and skin tokens only,
        so the splash matches Dark, Light and every skin. The bars are built and animated in code.
    -->
    <Window.Resources>
        <LinearGradientBrush x:Key="SplashFaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Ink04Color}" Offset="0" />
            <GradientStop Color="{DynamicResource Ink01Color}" Offset="0.55" />
            <GradientStop Color="{DynamicResource Ink00Color}" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="SplashGlowBrush">
            <GradientStop Color="{DynamicResource AccentCyanGlowColor}" Offset="0" />
            <GradientStop Color="{DynamicResource OverlayHighlightClearColor}" Offset="1" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="SplashBarBrush" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="{DynamicResource AccentSkyDeepColor}" Offset="0" />
            <GradientStop Color="{DynamicResource AccentCyanColor}" Offset="0.6" />
            <GradientStop Color="{DynamicResource AccentCyanBrightColor}" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="Card"
            Margin="{skin:Space 24}"
            CornerRadius="{DynamicResource Radius08}"
            Background="{StaticResource SplashFaceBrush}"
            BorderBrush="{DynamicResource BorderHairlineBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource OverlayScrimColor}" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.55" />
        </Border.Effect>

        <Grid Margin="{skin:Space 34,30,34,22}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="{skin:Size 128}" Height="{skin:Size 128}" Margin="{skin:Space 0,0,26,0}">
                    <Ellipse Fill="{StaticResource SplashGlowBrush}" Margin="{skin:Space -18}" Opacity="0.9" />
                    <Image x:Name="Logo"
                           Source="pack://application:,,,/denon_icon.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.86" ScaleY="0.86" />
                        </Image.RenderTransform>
                    </Image>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="KindPill"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentCyanSubtleBgBrush}"
                            BorderBrush="{DynamicResource AccentCyanBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius07}"
                            Padding="{skin:Space 10,3}"
                            Margin="{skin:Space 0,0,0,10}">
                        <TextBlock x:Name="KindText"
                                   Text="Welcome"
                                   FontSize="{DynamicResource FontSize03}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentCyanTextBrush}" />
                    </Border>
                    <TextBlock Text="Denon Desktop"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="{DynamicResource FontSize14}"
                               FontWeight="Bold" />
                    <TextBlock x:Name="Tagline"
                               Text="Your Denon or Marantz receiver, on your PC."
                               FontSize="{DynamicResource FontSize09}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="{skin:Space 0,4,0,0}" />
                </StackPanel>
            </Grid>

            <!-- Animated spectrum: one bar per band, heights in code. -->
            <Grid x:Name="Bars" Grid.Row="1" Margin="{skin:Space 0,24,0,14}" VerticalAlignment="Stretch" />

            <DockPanel Grid.Row="2" LastChildFill="True">
                <TextBlock x:Name="VersionText"
                           DockPanel.Dock="Right"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="{DynamicResource FontSize03}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text="Starting…"
                           FontSize="{DynamicResource FontSize04}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
