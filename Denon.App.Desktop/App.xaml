<Application x:Class="Denon.App.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    The theme stack (docs/theming.md). The slot order is a contract: ThemeManager replaces a slot by index.
                    0 palette and 1 brushes (theme, live), 2 skin tokens (live), 3 icons, 4 control styles (shared by all skins).
                -->
                <ResourceDictionary Source="Themes/Palettes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Brushes.xaml" />
                <ResourceDictionary Source="Themes/Skins/Default.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
