<Window x:Class="Denon.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Denon.App.Desktop.Controls"
        xmlns:views="clr-namespace:Denon.App.Desktop.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="920"
        MinWidth="960"
        MinHeight="580"
        Background="{StaticResource ChassisBgBrush}"
        Icon="denon_icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <!-- Root Border handles maximized margin compensation cleanly -->
    <Border x:Name="WindowRootBorder"
            Background="{StaticResource ChassisBgBrush}"
            BorderBrush="{StaticResource Ink08Brush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================== CUSTOM INTEGRATED TITLE BAR ======================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Emblem -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/denon_icon.png"
                               Width="28"
                               Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BrandName}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{StaticResource Ink08Brush}"
                                BorderBrush="{StaticResource Ink12Brush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Auto-detected Denon / Marantz receiver model">
                            <TextBlock Text="{Binding DetectedModelBadge}"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrightBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Center Receiver Status Pill -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource ControlHoverBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding ConnectionBadgeBrush}"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReceiverTitle}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="  •  "
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionBadgeText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding ConnectionBadgeBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FirmwareVersion, StringFormat='  •  {0}'}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding FirmwareVersion, Converter={StaticResource StringToVis}}"
                                           VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentEmeraldSubtleBgBrush}"
                                        BorderBrush="{StaticResource AccentEmeraldBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6,1.5"
                                        Margin="9,0,0,0"
                                        ToolTip="Subscribed to real-time HEOS change events (&lt;50ms zero-lag volume &amp; play state sync)"
                                        Visibility="{Binding IsLivePushConnected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="LIVE PUSH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Quick Controls + Window Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Mcp"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="11"
                                Margin="0,0,6,0"
                                ToolTip="Open Streamable HTTP MCP Server, Room Doctor &amp; Habits Memory">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6.5" Height="6.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMcpRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentEmeraldBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding McpTitleBarBadge}" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenContextHelpCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="11"
                                Margin="0,0,6,0"
                                ToolTip="Open Context-Aware Help &amp; Interactive Guide for this screen (F1)">
                            <TextBlock Text="? Help" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="CastRemote"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="11"
                                Margin="0,0,6,0"
                                ToolTip="Open Couch Phone Remote QR Code, PC Audio Cast &amp; Local FLAC Jukebox">
                            <TextBlock Text="Phone QR" Foreground="{StaticResource AccentCyanBrightBrush}" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Refresh Receiver (F5)"
                                Margin="0,0,4,0">
                            <Path Data="M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12H4A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Command="{Binding TogglePowerCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Toggle Receiver Power / Standby"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="Padding" Value="11,0" />
                                    <Setter Property="Background" Value="{StaticResource ControlBgBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSpecBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="15"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="M11,2H13V12H11V2M16.24,4.76L14.83,6.17C16.17,7.27 17,8.94 17,10.8C17,14.11 14.31,16.8 11,16.8C7.69,16.8 5,14.11 5,10.8C5,8.94 5.83,7.27 7.17,6.17L5.76,4.76C4.07,6.23 3,8.39 3,10.8C3,15.22 6.58,18.8 11,18.8C15.42,18.8 19,15.22 19,10.8C19,8.39 17.93,6.23 16.24,4.76Z"
                                                              Fill="{TemplateBinding Foreground}"
                                                              Width="12"
                                                              Height="12"
                                                              Stretch="Uniform"
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding PowerStateLabel}"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PowerStateLabel}" Value="ACTIVE">
                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Width="1" Height="18" Background="{StaticResource BorderHairlineBrush}" Margin="0,0,6,0" />

                        <Button Click="MinimizeButton_Click" Style="{StaticResource TitleBarButton}" ToolTip="Minimize">
                            <Rectangle Width="10" Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Click="MaximizeRestoreButton_Click" Style="{StaticResource TitleBarButton}" ToolTip="Maximize / Restore">
                            <Border Width="10" Height="10" BorderThickness="1.3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" CornerRadius="1.5" />
                        </Button>
                        <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close">
                            <Path Data="M1,1 L9,9 M9,1 L1,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Width="10"
                                  Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== MAIN APP SHELL ======================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT NAVIGATION SIDEBAR -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBgBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16,12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="NAVIGATION" Style="{StaticResource SectionLabelStyle}" Margin="10,0,0,10" />

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Control}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Control">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,13H11V3H3V13M3,21H11V15H3V21M13,21H21V11H13V21M13,3V9H21V3H13Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Control Deck" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=YouTube}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="YouTube">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,15L15.19,12L10,9V15M21.56,7.17C21.69,7.64 21.78,8.27 21.84,9.07C21.91,9.87 21.94,10.56 21.94,11.16L22,12C22,14.19 21.84,15.8 21.56,16.83C21.31,17.73 20.73,18.31 19.83,18.56C19.36,18.69 18.5,18.78 17.18,18.84C15.88,18.91 14.69,18.94 13.59,18.94L12,19C7.81,19 5.2,18.84 4.17,18.56C3.27,18.31 2.69,17.73 2.44,16.83C2.31,16.36 2.22,15.73 2.16,14.93C2.09,14.13 2.06,13.44 2.06,12.84L2,12C2,9.81 2.16,8.2 2.44,7.17C2.69,6.27 3.27,5.69 4.17,5.44C4.64,5.31 5.5,5.22 6.82,5.16C8.12,5.09 9.31,5.06 10.41,5.06L12,5C16.19,5 18.8,5.16 19.83,5.44C20.73,5.69 21.31,6.27 21.56,7.17Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="YouTube &amp; Music" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Acoustics}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Acoustics">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Scenes &amp; Acoustics" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=CastRemote}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="CastRemote">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M1,18V21H4A3,3 0 0,0 1,18M1,14V16A5,5 0 0,1 6,21H8A7,7 0 0,0 1,14M1,10V12A9,9 0 0,1 10,21H12C12,14.92 7.07,10 1,10M21,3H3C1.89,3 1,3.89 1,5V8H3V5H21V19H14V21H21A2,2 0 0,0 23,19V5C23,3.89 22.1,3 21,3Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Cast &amp; Remote" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Stations}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Stations">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M20,6H8.3L16.56,2.59L15.81,0.74L3.24,5.96C2.5,6.27 2,7 2,7.8V20A2,2 0 0,0 4,22H20A2,2 0 0,0 22,20V8A2,2 0 0,0 20,6M7,20A3,3 0 0,1 4,17A3,3 0 0,1 7,14A3,3 0 0,1 10,17A3,3 0 0,1 7,20M20,12H18V10H16V12H4V8H20V12Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Stations &amp; Streams" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Plugins}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Plugins">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right"
                                            Background="{StaticResource Ink08Brush}"
                                            BorderBrush="{StaticResource Ink12Brush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActivePluginsBadgeText}"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentAmberBrush}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M20.5,11H19V7C19,5.89 18.1,5 17,5H13V3.5A2.5,2.5 0 0,0 10.5,1A2.5,2.5 0 0,0 8,3.5V5H4A2,2 0 0,0 2,7V10.8H3.5C5,10.8 6.2,12 6.2,13.5C6.2,15 5,16.2 3.5,16.2H2V20A2,2 0 0,0 4,22H7.8V20.5C7.8,19 9,17.8 10.5,17.8C12,17.8 13.2,19 13.2,20.5V22H17A2,2 0 0,0 19,20V16H20.5A2.5,2.5 0 0,0 23,13.5A2.5,2.5 0 0,0 20.5,11Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              Width="15"
                                              Height="15"
                                              Stretch="Uniform"
                                              Margin="0,0,11,0" />
                                        <TextBlock Text="Plugins" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Mcp}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Mcp"
                                         ToolTip="Streamable HTTP MCP Server, Self-Healing Room Doctor, Snapshot Undo &amp; Local Habits Memory">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="MCP &amp; Room Brain" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Diagnostics}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Diagnostics">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Health &amp; Support" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Help}"
                                         Command="{Binding OpenContextHelpCommand}"
                                         ToolTip="Interactive Help, Setup Checklist, Shortcuts &amp; Troubleshooting (F1)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M11,18H13V16H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,6A4,4 0 0,0 8,10H10A2,2 0 0,1 12,8A2,2 0 0,1 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10A4,4 0 0,0 12,6Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Help &amp; Guide" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Live Smart-Home Ecosystem Quick-Jump Pills -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
                            <StackPanel>
                                <TextBlock Text="LIVE ECOSYSTEM" Style="{StaticResource SectionLabelStyle}" Margin="10,0,0,7" />
                                <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenPluginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,0,5"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding StatusText}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="PillBd"
                                                                Background="{StaticResource CardBgBrush}"
                                                                BorderBrush="{StaticResource Ink08Brush}"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="9,6.5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Width="26"
                                                                        Height="20"
                                                                        CornerRadius="5"
                                                                        Background="{StaticResource SidebarBgBrush}"
                                                                        BorderBrush="{Binding AccentBrush}"
                                                                        BorderThickness="1"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IconGlyph}"
                                                                               FontSize="8.5"
                                                                               FontWeight="Black"
                                                                               Foreground="{Binding AccentBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ShortName}"
                                                                               FontSize="11.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding StatusText}"
                                                                               FontSize="9.5"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Ellipse Grid.Column="2"
                                                                         Width="7"
                                                                         Height="7"
                                                                         Fill="{Binding HealthBadgeBrush}"
                                                                         Margin="6,0,0,0"
                                                                         VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PillBd" Property="Background" Value="{StaticResource Ink08Brush}" />
                                                                <Setter TargetName="PillBd" Property="BorderBrush" Value="{StaticResource Ink15Brush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Hardware Telemetry Card in Sidebar -->
                        <Border Grid.Row="2"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="TELEMETRY" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Text="{Binding ReceiverDetails}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentCyanBrightBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding LastUpdatedText}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding LastError}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource AccentCrimsonBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding LastError, Converter={StaticResource StringToVis}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ======================== CONTENT STAGE ======================== -->
                <Grid Grid.Column="1" Background="{StaticResource ChassisBgBrush}">

                    <!-- ==================== VIEW 1: CONTROL DECK ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Control}">
                        <views:ControlDeckView x:Name="ControlDeckPage" />
                    </Grid>

                    <!-- ==================== VIEW 1B: YOUTUBE & MUSIC ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=YouTube}">
                        <views:YouTubeMusicView />
                    </Grid>

                    <!-- ==================== VIEW 1C: SCENES & ACOUSTICS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Acoustics}">
                        <views:ScenesAcousticsView />
                    </Grid>

                    <!-- ==================== VIEW 1D: CAST & REMOTE ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=CastRemote}">
                        <views:CastRemoteView />
                    </Grid>

                    <!-- ==================== VIEW 2: STATIONS & STREAMS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Stations}">
                        <views:StationsStreamsView />
                    </Grid>

                    <!-- ==================== VIEW 3: SETTINGS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Settings}">
                        <views:SettingsView />
                    </Grid>

                    <!-- ==================== VIEW 4: HEALTH & SUPPORT ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Diagnostics}">
                        <views:HealthSupportView />
                    </Grid>

                    <!-- ==================== VIEW 8: PLUGINS & EXTENSIONS ==================== -->
                    <Grid Margin="20,14" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Plugins}">
                        <views:PluginsView />
                    </Grid>

                    <!-- ==================== VIEW 9: HELP & INTERACTIVE GUIDE ==================== -->
                    <Grid Margin="20,14" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Help}">
                        <views:HelpGuideView />
                    </Grid>

                    <!-- ==================== VIEW 10: STREAMABLE HTTP MCP SERVER & ROOM BRAIN ==================== -->
                    <Grid Margin="20,14" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Mcp}">
                        <views:McpIntelligenceView />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
