<Window x:Class="Denon.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Denon.App.Desktop.Controls"
        xmlns:views="clr-namespace:Denon.App.Desktop.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="920"
        MinWidth="960"
        MinHeight="580"
        Background="{DynamicResource ChassisBgBrush}"
        Icon="denon_icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      CornerRadius="{DynamicResource Radius05}"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <!-- Root Border handles maximized margin compensation cleanly -->
    <Border x:Name="WindowRootBorder"
            Background="{DynamicResource ChassisBgBrush}"
            BorderBrush="{DynamicResource Ink08Brush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{skin:Size 48}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================== CUSTOM INTEGRATED TITLE BAR ======================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="{skin:Space 14,0,8,0}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Emblem -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/denon_icon.png"
                               Width="{skin:Size 28}"
                               Height="{skin:Size 28}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="{skin:Space 0,0,10,0}"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BrandName}"
                                   FontSize="{DynamicResource FontSize09}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Ink08Brush}"
                                BorderBrush="{DynamicResource Ink12Brush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius02}"
                                Padding="{skin:Space 6,2}"
                                Margin="{skin:Space 8,0,0,0}"
                                VerticalAlignment="Center"
                                ToolTip="Auto-detected Denon / Marantz receiver model">
                            <TextBlock Text="{Binding DetectedModelBadge}"
                                       FontSize="{DynamicResource FontSize01}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentCyanBrightBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Center Receiver Status Pill -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource ControlHoverBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius06}"
                                Padding="{skin:Space 12,5}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="{skin:Size 8}"
                                         Height="{skin:Size 8}"
                                         Fill="{Binding ConnectionBadgeBrush}"
                                         Margin="{skin:Space 0,0,8,0}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReceiverTitle}"
                                           FontSize="{DynamicResource FontSize06}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="  •  "
                                           FontSize="{DynamicResource FontSize04}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionBadgeText}"
                                           FontSize="{DynamicResource FontSize04}"
                                           FontWeight="Bold"
                                           Foreground="{Binding ConnectionBadgeBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FirmwareVersion, StringFormat='  •  {0}'}"
                                           FontSize="{DynamicResource FontSize04}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding FirmwareVersion, Converter={StaticResource StringToVis}}"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentEmeraldSubtleBgBrush}"
                                        BorderBrush="{DynamicResource AccentEmeraldBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius02}"
                                        Padding="{skin:Space 6,1.5}"
                                        Margin="{skin:Space 9,0,0,0}"
                                        ToolTip="Subscribed to real-time HEOS change events (&lt;50ms zero-lag volume &amp; play state sync)"
                                        Visibility="{Binding IsLivePushConnected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="LIVE PUSH" FontSize="{DynamicResource FontSize00}" FontWeight="Bold" Foreground="{DynamicResource AccentEmeraldBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Quick Controls + Window Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Mcp"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 9,4}"
                                FontSize="{DynamicResource FontSize04}"
                                Margin="{skin:Space 0,0,6,0}"
                                ToolTip="Open Streamable HTTP MCP Server, Room Doctor &amp; Habits Memory">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="{skin:Size 6.5}" Height="{skin:Size 6.5}" Margin="{skin:Space 0,0,6,0}" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMcpRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentEmeraldBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding McpTitleBarBadge}" Foreground="{DynamicResource AccentEmeraldBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="CastRemote"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 9,4}"
                                FontSize="{DynamicResource FontSize04}"
                                Margin="{skin:Space 0,0,6,0}"
                                ToolTip="Open Couch Phone Remote QR Code, PC Audio Cast &amp; Local FLAC Jukebox">
                            <TextBlock Text="Phone QR" Foreground="{DynamicResource AccentCyanBrightBrush}" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Refresh Receiver (F5)"
                                Margin="{skin:Space 0,0,4,0}">
                            <Path Data="{DynamicResource IconRefresh}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="{skin:Size 13}"
                                  Height="{skin:Size 13}"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Command="{Binding TogglePowerCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Toggle Receiver Power / Standby"
                                Cursor="Hand"
                                Margin="{skin:Space 0,0,10,0}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="{skin:Size 30}" />
                                    <Setter Property="Padding" Value="{skin:Space 11,0}" />
                                    <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSpecBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="{DynamicResource Radius06}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{DynamicResource IconPower}"
                                                              Fill="{TemplateBinding Foreground}"
                                                              Width="{skin:Size 12}"
                                                              Height="{skin:Size 12}"
                                                              Stretch="Uniform"
                                                              Margin="{skin:Space 0,0,6,0}" />
                                                        <TextBlock Text="{Binding PowerStateLabel}"
                                                                   FontSize="{DynamicResource FontSize03}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PowerStateLabel}" Value="ACTIVE">
                                            <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Width="1" Height="{skin:Size 18}" Background="{DynamicResource BorderHairlineBrush}" Margin="{skin:Space 0,0,6,0}" />

                        <Button Click="MinimizeButton_Click" Style="{StaticResource TitleBarButton}" ToolTip="Minimize">
                            <Rectangle Width="{skin:Size 10}" Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Click="MaximizeRestoreButton_Click" Style="{StaticResource TitleBarButton}" ToolTip="Maximize / Restore">
                            <Border Width="{skin:Size 10}" Height="{skin:Size 10}" BorderThickness="1.3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" CornerRadius="{DynamicResource Radius00}" />
                        </Button>
                        <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close">
                            <Path Data="{DynamicResource IconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Width="{skin:Size 10}"
                                  Height="{skin:Size 10}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== MAIN APP SHELL ======================== -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{skin:Size 84}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ICON RAIL: listen, room and system groups; connected devices at the bottom -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" Margin="{skin:Space 0,12}">
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Control}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Control"
                                     ToolTip="Control Deck">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconNavControlDeck}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Deck"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=YouTube}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="YouTube"
                                     ToolTip="YouTube &amp; Music">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconNavYouTube}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Music"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Stations}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Stations"
                                     ToolTip="Stations &amp; Streams">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconRadio}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Stations"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=CastRemote}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="CastRemote"
                                     ToolTip="Cast &amp; Remote">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconNavCast}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Cast"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <Border Width="{skin:Size 40}" Height="1" Background="{DynamicResource BorderHairlineBrush}" Margin="{skin:Space 0,8}" HorizontalAlignment="Center" />
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Acoustics}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Acoustics"
                                     ToolTip="Scenes &amp; Acoustics">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconNavScenes}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Scenes"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Plugins}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Plugins"
                                     ToolTip="Plugins">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{DynamicResource IconNavPlugins}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="{skin:Size 18}"
                                          Height="{skin:Size 18}"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="Plugins"
                                               Margin="{skin:Space 0,5,0,0}"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                                <Border Background="{DynamicResource Ink08Brush}"
                                        BorderBrush="{DynamicResource Ink12Brush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius03}"
                                        Padding="{skin:Space 4,0}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="{skin:Space 0,-6,-14,0}">
                                    <TextBlock Text="{Binding ActivePluginsBadgeText}"
                                               FontSize="{DynamicResource FontSize00}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentAmberBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>
                        <Border Width="{skin:Size 40}" Height="1" Background="{DynamicResource BorderHairlineBrush}" Margin="{skin:Space 0,8}" HorizontalAlignment="Center" />
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Mcp}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Mcp"
                                     ToolTip="MCP Server &amp; Room Brain">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconNavMcp}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Brain"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings"
                                     ToolTip="Settings">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconNavSettings}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Settings"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Diagnostics}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Diagnostics"
                                     ToolTip="Health &amp; Support">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconNavHealth}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Health"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Help}"
                                     Command="{Binding OpenContextHelpCommand}"
                                     ToolTip="Help &amp; Guide (F1)">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{DynamicResource IconNavHelp}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Help"
                                           Margin="{skin:Space 0,5,0,0}"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <Border Width="{skin:Size 40}" Height="1" Background="{DynamicResource BorderHairlineBrush}" Margin="{skin:Space 0,8}" HorizontalAlignment="Center" />
                        <!-- Connected devices: one badge per plugin; click opens it -->
                        <ItemsControl ItemsSource="{Binding InstalledPlugins}" Margin="{skin:Space 0,6,0,0}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenPluginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="{skin:Space 0,4}"
                                            Cursor="Hand">
                                        <Button.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Button.ToolTip>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Width="{skin:Size 48}" Height="{skin:Size 30}">
                                                    <Border x:Name="Badge"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderSpecBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource Radius02}"
                                                            Margin="{skin:Space 2,4,4,0}">
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   FontSize="{DynamicResource FontSize00}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Ellipse Width="{skin:Size 9}"
                                                             Height="{skin:Size 9}"
                                                             Fill="{Binding HealthBadgeBrush}"
                                                             Stroke="{DynamicResource SidebarBgBrush}"
                                                             StrokeThickness="2"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Top" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource CardElevatedBrush}" />
                                                        <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Ink15Brush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ======================== CONTENT STAGE ======================== -->
                <Grid Grid.Column="1" Background="{DynamicResource ChassisBgBrush}">

                    <!-- ==================== VIEW 1: CONTROL DECK ==================== -->
                    <Grid Margin="{skin:Space 20,16}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Control}">
                        <views:ControlDeckView x:Name="ControlDeckPage" />
                    </Grid>

                    <!-- ==================== VIEW 1B: YOUTUBE & MUSIC ==================== -->
                    <Grid Margin="{skin:Space 20,16}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=YouTube}">
                        <views:YouTubeMusicView />
                    </Grid>

                    <!-- ==================== VIEW 1C: SCENES & ACOUSTICS ==================== -->
                    <Grid Margin="{skin:Space 20,16}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Acoustics}">
                        <views:ScenesAcousticsView />
                    </Grid>

                    <!-- ==================== VIEW 1D: CAST & REMOTE ==================== -->
                    <Grid Margin="{skin:Space 20,16}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=CastRemote}">
                        <views:CastRemoteView />
                    </Grid>

                    <!-- ==================== VIEW 2: STATIONS & STREAMS ==================== -->
                    <Grid Margin="{skin:Space 20,16}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Stations}">
                        <views:StationsStreamsView />
                    </Grid>

                    <!-- ==================== VIEW 3: SETTINGS ==================== -->
                    <Grid Margin="{skin:Space 20,16}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Settings}">
                        <views:SettingsView />
                    </Grid>

                    <!-- ==================== VIEW 4: HEALTH & SUPPORT ==================== -->
                    <Grid Margin="{skin:Space 20,16}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Diagnostics}">
                        <views:HealthSupportView />
                    </Grid>

                    <!-- ==================== VIEW 8: PLUGINS & EXTENSIONS ==================== -->
                    <Grid Margin="{skin:Space 20,14}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Plugins}">
                        <views:PluginsView />
                    </Grid>

                    <!-- ==================== VIEW 9: HELP & INTERACTIVE GUIDE ==================== -->
                    <Grid Margin="{skin:Space 20,14}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Help}">
                        <views:HelpGuideView />
                    </Grid>

                    <!-- ==================== VIEW 10: STREAMABLE HTTP MCP SERVER & ROOM BRAIN ==================== -->
                    <Grid Margin="{skin:Space 20,14}" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Mcp}">
                        <views:McpIntelligenceView />
                    </Grid>
                </Grid>
                <!-- STATUS LINE: receiver, last action, last sync (was the sidebar telemetry card) -->
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="{skin:Space 16,6}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding LastUpdatedText}"
                                   FontSize="{DynamicResource FontSize03}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="{skin:Space 16,0,0,0}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ReceiverDetails}"
                                       FontSize="{DynamicResource FontSize03}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding StatusMessage, StringFormat='   ·   {0}'}"
                                       FontSize="{DynamicResource FontSize03}"
                                       Foreground="{DynamicResource AccentCyanBrightBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LastError, StringFormat='   ·   {0}'}"
                                       FontSize="{DynamicResource FontSize03}"
                                       Foreground="{DynamicResource AccentCrimsonBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding LastError, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
