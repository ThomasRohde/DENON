<Window x:Class="Denon.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Denon.App.Desktop.Controls"
        xmlns:views="clr-namespace:Denon.App.Desktop.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="920"
        MinWidth="960"
        MinHeight="580"
        Background="{StaticResource ChassisBgBrush}"
        Icon="denon_icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      CornerRadius="{StaticResource Radius05}"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <!-- Root Border handles maximized margin compensation cleanly -->
    <Border x:Name="WindowRootBorder"
            Background="{StaticResource ChassisBgBrush}"
            BorderBrush="{StaticResource Ink08Brush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================== CUSTOM INTEGRATED TITLE BAR ======================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Emblem -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/denon_icon.png"
                               Width="28"
                               Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BrandName}"
                                   FontSize="{StaticResource FontSize09}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{StaticResource Ink08Brush}"
                                BorderBrush="{StaticResource Ink12Brush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius02}"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Auto-detected Denon / Marantz receiver model">
                            <TextBlock Text="{Binding DetectedModelBadge}"
                                       FontSize="{StaticResource FontSize01}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrightBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Center Receiver Status Pill -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource ControlHoverBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius06}"
                                Padding="12,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding ConnectionBadgeBrush}"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReceiverTitle}"
                                           FontSize="{StaticResource FontSize06}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="  •  "
                                           FontSize="{StaticResource FontSize04}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionBadgeText}"
                                           FontSize="{StaticResource FontSize04}"
                                           FontWeight="Bold"
                                           Foreground="{Binding ConnectionBadgeBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FirmwareVersion, StringFormat='  •  {0}'}"
                                           FontSize="{StaticResource FontSize04}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding FirmwareVersion, Converter={StaticResource StringToVis}}"
                                           VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentEmeraldSubtleBgBrush}"
                                        BorderBrush="{StaticResource AccentEmeraldBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius02}"
                                        Padding="6,1.5"
                                        Margin="9,0,0,0"
                                        ToolTip="Subscribed to real-time HEOS change events (&lt;50ms zero-lag volume &amp; play state sync)"
                                        Visibility="{Binding IsLivePushConnected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="LIVE PUSH" FontSize="{StaticResource FontSize00}" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Quick Controls + Window Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Mcp"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0"
                                ToolTip="Open Streamable HTTP MCP Server, Room Doctor &amp; Habits Memory">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6.5" Height="6.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMcpRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentEmeraldBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding McpTitleBarBadge}" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="CastRemote"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0"
                                ToolTip="Open Couch Phone Remote QR Code, PC Audio Cast &amp; Local FLAC Jukebox">
                            <TextBlock Text="Phone QR" Foreground="{StaticResource AccentCyanBrightBrush}" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Refresh Receiver (F5)"
                                Margin="0,0,4,0">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Command="{Binding TogglePowerCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Toggle Receiver Power / Standby"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="Padding" Value="11,0" />
                                    <Setter Property="Background" Value="{StaticResource ControlBgBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSpecBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="{StaticResource Radius06}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconPower}"
                                                              Fill="{TemplateBinding Foreground}"
                                                              Width="12"
                                                              Height="12"
                                                              Stretch="Uniform"
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding PowerStateLabel}"
                                                                   FontSize="{StaticResource FontSize03}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PowerStateLabel}" Value="ACTIVE">
                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Width="1" Height="18" Background="{StaticResource BorderHairlineBrush}" Margin="0,0,6,0" />

                        <Button Click="MinimizeButton_Click" Style="{StaticResource TitleBarButton}" ToolTip="Minimize">
                            <Rectangle Width="10" Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Click="MaximizeRestoreButton_Click" Style="{StaticResource TitleBarButton}" ToolTip="Maximize / Restore">
                            <Border Width="10" Height="10" BorderThickness="1.3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" CornerRadius="{StaticResource Radius00}" />
                        </Button>
                        <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Width="10"
                                  Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== MAIN APP SHELL ======================== -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ICON RAIL: listen, room and system groups; connected devices at the bottom -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBgBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" Margin="0,12">
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Control}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Control"
                                     ToolTip="Control Deck">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconNavControlDeck}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Deck"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=YouTube}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="YouTube"
                                     ToolTip="YouTube &amp; Music">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconNavYouTube}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Music"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Stations}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Stations"
                                     ToolTip="Stations &amp; Streams">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconRadio}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Stations"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=CastRemote}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="CastRemote"
                                     ToolTip="Cast &amp; Remote">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconNavCast}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Cast"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <Border Width="40" Height="1" Background="{StaticResource BorderHairlineBrush}" Margin="0,8" HorizontalAlignment="Center" />
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Acoustics}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Acoustics"
                                     ToolTip="Scenes &amp; Acoustics">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconNavScenes}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Scenes"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Plugins}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Plugins"
                                     ToolTip="Plugins">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconNavPlugins}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="18"
                                          Height="18"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="Plugins"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                                <Border Background="{StaticResource Ink08Brush}"
                                        BorderBrush="{StaticResource Ink12Brush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius03}"
                                        Padding="4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-6,-14,0">
                                    <TextBlock Text="{Binding ActivePluginsBadgeText}"
                                               FontSize="{StaticResource FontSize00}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentAmberBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>
                        <Border Width="40" Height="1" Background="{StaticResource BorderHairlineBrush}" Margin="0,8" HorizontalAlignment="Center" />
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Mcp}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Mcp"
                                     ToolTip="MCP Server &amp; Room Brain">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconNavMcp}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Brain"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings"
                                     ToolTip="Settings">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconNavSettings}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Settings"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Diagnostics}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Diagnostics"
                                     ToolTip="Health &amp; Support">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconNavHealth}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Health"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavRail"
                                     Style="{StaticResource NavRailIconItem}"
                                     IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Help}"
                                     Command="{Binding OpenContextHelpCommand}"
                                     ToolTip="Help &amp; Guide (F1)">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconNavHelp}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Help"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <Border Width="40" Height="1" Background="{StaticResource BorderHairlineBrush}" Margin="0,8" HorizontalAlignment="Center" />
                        <!-- Connected devices: one badge per plugin; click opens it -->
                        <ItemsControl ItemsSource="{Binding InstalledPlugins}" Margin="0,6,0,0" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenPluginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,4"
                                            Cursor="Hand">
                                        <Button.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Button.ToolTip>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Width="48" Height="30">
                                                    <Border x:Name="Badge"
                                                            Background="Transparent"
                                                            BorderBrush="{StaticResource BorderSpecBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource Radius02}"
                                                            Margin="2,4,4,0">
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   FontSize="{StaticResource FontSize00}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Ellipse Width="9"
                                                             Height="9"
                                                             Fill="{Binding HealthBadgeBrush}"
                                                             Stroke="{StaticResource SidebarBgBrush}"
                                                             StrokeThickness="2"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Top" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource CardElevatedBrush}" />
                                                        <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Ink15Brush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ======================== CONTENT STAGE ======================== -->
                <Grid Grid.Column="1" Background="{StaticResource ChassisBgBrush}">

                    <!-- ==================== VIEW 1: CONTROL DECK ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Control}">
                        <views:ControlDeckView x:Name="ControlDeckPage" />
                    </Grid>

                    <!-- ==================== VIEW 1B: YOUTUBE & MUSIC ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=YouTube}">
                        <views:YouTubeMusicView />
                    </Grid>

                    <!-- ==================== VIEW 1C: SCENES & ACOUSTICS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Acoustics}">
                        <views:ScenesAcousticsView />
                    </Grid>

                    <!-- ==================== VIEW 1D: CAST & REMOTE ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=CastRemote}">
                        <views:CastRemoteView />
                    </Grid>

                    <!-- ==================== VIEW 2: STATIONS & STREAMS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Stations}">
                        <views:StationsStreamsView />
                    </Grid>

                    <!-- ==================== VIEW 3: SETTINGS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Settings}">
                        <views:SettingsView />
                    </Grid>

                    <!-- ==================== VIEW 4: HEALTH & SUPPORT ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Diagnostics}">
                        <views:HealthSupportView />
                    </Grid>

                    <!-- ==================== VIEW 8: PLUGINS & EXTENSIONS ==================== -->
                    <Grid Margin="20,14" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Plugins}">
                        <views:PluginsView />
                    </Grid>

                    <!-- ==================== VIEW 9: HELP & INTERACTIVE GUIDE ==================== -->
                    <Grid Margin="20,14" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Help}">
                        <views:HelpGuideView />
                    </Grid>

                    <!-- ==================== VIEW 10: STREAMABLE HTTP MCP SERVER & ROOM BRAIN ==================== -->
                    <Grid Margin="20,14" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Mcp}">
                        <views:McpIntelligenceView />
                    </Grid>
                </Grid>
                <!-- STATUS LINE: receiver, last action, last sync (was the sidebar telemetry card) -->
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Background="{StaticResource SidebarBgBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,6">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding LastUpdatedText}"
                                   FontSize="{StaticResource FontSize03}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="16,0,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ReceiverDetails}"
                                       FontSize="{StaticResource FontSize03}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding StatusMessage, StringFormat='   ·   {0}'}"
                                       FontSize="{StaticResource FontSize03}"
                                       Foreground="{StaticResource AccentCyanBrightBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LastError, StringFormat='   ·   {0}'}"
                                       FontSize="{StaticResource FontSize03}"
                                       Foreground="{StaticResource AccentCrimsonBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding LastError, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
