<Window x:Class="Denon.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Denon.App.Desktop.Controls"
        xmlns:views="clr-namespace:Denon.App.Desktop.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="920"
        MinWidth="960"
        MinHeight="580"
        Background="{StaticResource ChassisBgBrush}"
        Icon="denon_icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      CornerRadius="{StaticResource Radius05}"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <!-- Root Border handles maximized margin compensation cleanly -->
    <Border x:Name="WindowRootBorder"
            Background="{StaticResource ChassisBgBrush}"
            BorderBrush="{StaticResource Ink08Brush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================== CUSTOM INTEGRATED TITLE BAR ======================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Emblem -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/denon_icon.png"
                               Width="28"
                               Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BrandName}"
                                   FontSize="{StaticResource FontSize09}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{StaticResource Ink08Brush}"
                                BorderBrush="{StaticResource Ink12Brush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius02}"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Auto-detected Denon / Marantz receiver model">
                            <TextBlock Text="{Binding DetectedModelBadge}"
                                       FontSize="{StaticResource FontSize01}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrightBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Center Receiver Status Pill -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource ControlHoverBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius06}"
                                Padding="12,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding ConnectionBadgeBrush}"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReceiverTitle}"
                                           FontSize="{StaticResource FontSize06}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="  •  "
                                           FontSize="{StaticResource FontSize04}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionBadgeText}"
                                           FontSize="{StaticResource FontSize04}"
                                           FontWeight="Bold"
                                           Foreground="{Binding ConnectionBadgeBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FirmwareVersion, StringFormat='  •  {0}'}"
                                           FontSize="{StaticResource FontSize04}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding FirmwareVersion, Converter={StaticResource StringToVis}}"
                                           VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentEmeraldSubtleBgBrush}"
                                        BorderBrush="{StaticResource AccentEmeraldBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius02}"
                                        Padding="6,1.5"
                                        Margin="9,0,0,0"
                                        ToolTip="Subscribed to real-time HEOS change events (&lt;50ms zero-lag volume &amp; play state sync)"
                                        Visibility="{Binding IsLivePushConnected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="LIVE PUSH" FontSize="{StaticResource FontSize00}" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Quick Controls + Window Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="Mcp"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0"
                                ToolTip="Open Streamable HTTP MCP Server, Room Doctor &amp; Habits Memory">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6.5" Height="6.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMcpRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentEmeraldBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding McpTitleBarBadge}" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenContextHelpCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0"
                                ToolTip="Open Context-Aware Help &amp; Interactive Guide for this screen (F1)">
                            <TextBlock Text="? Help" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="CastRemote"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0"
                                ToolTip="Open Couch Phone Remote QR Code, PC Audio Cast &amp; Local FLAC Jukebox">
                            <TextBlock Text="Phone QR" Foreground="{StaticResource AccentCyanBrightBrush}" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="Refresh Receiver (F5)"
                                Margin="0,0,4,0">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Command="{Binding TogglePowerCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Toggle Receiver Power / Standby"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="Padding" Value="11,0" />
                                    <Setter Property="Background" Value="{StaticResource ControlBgBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSpecBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="{StaticResource Radius06}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconPower}"
                                                              Fill="{TemplateBinding Foreground}"
                                                              Width="12"
                                                              Height="12"
                                                              Stretch="Uniform"
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding PowerStateLabel}"
                                                                   FontSize="{StaticResource FontSize03}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PowerStateLabel}" Value="ACTIVE">
                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Width="1" Height="18" Background="{StaticResource BorderHairlineBrush}" Margin="0,0,6,0" />

                        <Button Click="MinimizeButton_Click" Style="{StaticResource TitleBarButton}" ToolTip="Minimize">
                            <Rectangle Width="10" Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Click="MaximizeRestoreButton_Click" Style="{StaticResource TitleBarButton}" ToolTip="Maximize / Restore">
                            <Border Width="10" Height="10" BorderThickness="1.3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" CornerRadius="{StaticResource Radius00}" />
                        </Button>
                        <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Width="10"
                                  Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== MAIN APP SHELL ======================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT NAVIGATION SIDEBAR -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBgBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16,12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="NAVIGATION" Style="{StaticResource SectionLabelStyle}" Margin="10,0,0,10" />

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Control}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Control">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNavControlDeck}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Control Deck" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=YouTube}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="YouTube">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNavYouTube}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="YouTube &amp; Music" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Acoustics}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Acoustics">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNavScenes}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Scenes &amp; Acoustics" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=CastRemote}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="CastRemote">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNavCast}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Cast &amp; Remote" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Stations}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Stations">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRadio}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Stations &amp; Streams" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Plugins}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Plugins">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right"
                                            Background="{StaticResource Ink08Brush}"
                                            BorderBrush="{StaticResource Ink12Brush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius03}"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActivePluginsBadgeText}"
                                                   FontSize="{StaticResource FontSize01}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentAmberBrush}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconNavPlugins}"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              Width="15"
                                              Height="15"
                                              Stretch="Uniform"
                                              Margin="0,0,11,0" />
                                        <TextBlock Text="Plugins" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Mcp}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Mcp"
                                         ToolTip="Streamable HTTP MCP Server, Self-Healing Room Doctor, Snapshot Undo &amp; Local Habits Memory">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNavMcp}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="MCP &amp; Room Brain" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNavSettings}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Diagnostics}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Diagnostics">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNavHealth}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Health &amp; Support" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="NavRail"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EqualityConverter}, ConverterParameter=Help}"
                                         Command="{Binding OpenContextHelpCommand}"
                                         ToolTip="Interactive Help, Setup Checklist, Shortcuts &amp; Troubleshooting (F1)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconNavHelp}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,11,0" />
                                    <TextBlock Text="Help &amp; Guide" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Live Smart-Home Ecosystem Quick-Jump Pills -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
                            <StackPanel>
                                <TextBlock Text="LIVE ECOSYSTEM" Style="{StaticResource SectionLabelStyle}" Margin="10,0,0,7" />
                                <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenPluginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,0,5"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding StatusText}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="PillBd"
                                                                Background="{StaticResource CardBgBrush}"
                                                                BorderBrush="{StaticResource Ink08Brush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius03}"
                                                                Padding="9,6.5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Width="26"
                                                                        Height="20"
                                                                        CornerRadius="{StaticResource Radius02}"
                                                                        Background="{StaticResource SidebarBgBrush}"
                                                                        BorderBrush="{Binding AccentBrush}"
                                                                        BorderThickness="1"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IconGlyph}"
                                                                               FontSize="{StaticResource FontSize00}"
                                                                               FontWeight="Black"
                                                                               Foreground="{Binding AccentBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ShortName}"
                                                                               FontSize="{StaticResource FontSize05}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding StatusText}"
                                                                               FontSize="{StaticResource FontSize01}"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Ellipse Grid.Column="2"
                                                                         Width="7"
                                                                         Height="7"
                                                                         Fill="{Binding HealthBadgeBrush}"
                                                                         Margin="6,0,0,0"
                                                                         VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PillBd" Property="Background" Value="{StaticResource Ink08Brush}" />
                                                                <Setter TargetName="PillBd" Property="BorderBrush" Value="{StaticResource Ink15Brush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Hardware Telemetry Card in Sidebar -->
                        <Border Grid.Row="2"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius05}"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="TELEMETRY" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Text="{Binding ReceiverDetails}"
                                           FontSize="{StaticResource FontSize05}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontSize="{StaticResource FontSize04}"
                                           Foreground="{StaticResource AccentCyanBrightBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding LastUpdatedText}"
                                           FontSize="{StaticResource FontSize03}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding LastError}"
                                           FontSize="{StaticResource FontSize03}"
                                           Foreground="{StaticResource AccentCrimsonBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding LastError, Converter={StaticResource StringToVis}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ======================== CONTENT STAGE ======================== -->
                <Grid Grid.Column="1" Background="{StaticResource ChassisBgBrush}">

                    <!-- ==================== VIEW 1: CONTROL DECK ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Control}">
                        <views:ControlDeckView x:Name="ControlDeckPage" />
                    </Grid>

                    <!-- ==================== VIEW 1B: YOUTUBE & MUSIC ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=YouTube}">
                        <views:YouTubeMusicView />
                    </Grid>

                    <!-- ==================== VIEW 1C: SCENES & ACOUSTICS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Acoustics}">
                        <views:ScenesAcousticsView />
                    </Grid>

                    <!-- ==================== VIEW 1D: CAST & REMOTE ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=CastRemote}">
                        <views:CastRemoteView />
                    </Grid>

                    <!-- ==================== VIEW 2: STATIONS & STREAMS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Stations}">
                        <views:StationsStreamsView />
                    </Grid>

                    <!-- ==================== VIEW 3: SETTINGS ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Settings}">
                        <views:SettingsView />
                    </Grid>

                    <!-- ==================== VIEW 4: HEALTH & SUPPORT ==================== -->
                    <Grid Margin="20,16" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Diagnostics}">
                        <views:HealthSupportView />
                    </Grid>

                    <!-- ==================== VIEW 8: PLUGINS & EXTENSIONS ==================== -->
                    <Grid Margin="20,14" Visibility="{Binding ActiveSection, Converter={StaticResource EqualityToVis}, ConverterParameter=Plugins}">
                        <views:PluginsView />
                    </Grid>

