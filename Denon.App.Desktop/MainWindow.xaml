<Window x:Class="Denon.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Denon Desktop"
        Width="1220"
        Height="840"
        MinWidth="1040"
        MinHeight="720"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#134E6F" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D7DEE5" />
        <SolidColorBrush x:Key="CardBrush" Color="White" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#5C6B78" />
        <SolidColorBrush x:Key="DangerBrush" Color="#8A2B2B" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Denon Desktop" FontSize="32" FontWeight="Bold" Foreground="#16212B" />
                    <TextBlock Text="{Binding ReceiverTitle}" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ReceiverDetails}" Margin="0,6,0,0" Foreground="{StaticResource SubtleBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#243442" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border Background="{Binding ConnectionBadgeBrush}" CornerRadius="18" Padding="14,8">
                        <TextBlock Text="{Binding ConnectionBadgeText}" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding LastUpdatedText}" Margin="0,12,0,0" Foreground="{StaticResource SubtleBrush}" TextAlignment="Right" />
                    <TextBlock Text="{Binding LastError}" Width="280" Margin="0,10,0,0" Foreground="{StaticResource DangerBrush}" TextAlignment="Right" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,18,0,0" BorderThickness="0">
            <TabItem Header="Dashboard">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Now Playing" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NowPlayingTitle}" Margin="0,10,0,0" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NowPlayingDetail}" Margin="0,8,0,0" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Play State" Foreground="{StaticResource SubtleBrush}" />
                                        <TextBlock Text="{Binding PlayState}" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Live Volume" Foreground="{StaticResource SubtleBrush}" />
                                        <TextBlock Text="{Binding LiveVolume}" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Mute" Foreground="{StaticResource SubtleBrush}" />
                                        <TextBlock Text="{Binding MuteButtonText}" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Connection" Foreground="{StaticResource SubtleBrush}" />
                                        <TextBlock Text="{Binding ConnectionBadgeText}" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Transport" FontSize="20" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                                    <Button Content="Play" Command="{Binding PlayCommand}" />
                                    <Button Content="Pause" Command="{Binding PauseCommand}" />
                                    <Button Content="Stop" Command="{Binding StopCommand}" />
                                    <Button Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}" />
                                    <Button Content="Low Volume" Command="{Binding SetLowVolumeCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Volume" FontSize="20" FontWeight="SemiBold" />
                                <Slider Margin="0,18,0,8" Minimum="0" Maximum="100" Value="{Binding TargetVolume, Mode=TwoWay}" />
                                <TextBlock Text="{Binding VolumeLabel}" Margin="0,0,0,14" FontSize="26" FontWeight="Bold" />
                                <WrapPanel>
                                    <Button Content="-5" Width="72" Command="{Binding VolumeDownCommand}" />
                                    <Button Content="+5" Width="72" Command="{Binding VolumeUpCommand}" />
                                    <Button Content="Apply Volume" Command="{Binding ApplyVolumeCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Custom Stream" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="URL" Margin="0,16,0,6" Foreground="{StaticResource SubtleBrush}" />
                                <TextBox Text="{Binding CustomStreamUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Use low volume before playback" IsChecked="{Binding UseLowVolumeForStreams}" Margin="0,0,0,10" />
                                <CheckBox Content="Unmute before playback" IsChecked="{Binding UnmuteBeforePlay}" Margin="0,0,0,10" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Play URL" Command="{Binding PlayCustomStreamCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Stations">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Quick radio presets. Play uses your current playback options; Play Low always uses the configured low-volume launch."
                               Margin="0,0,0,14"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SubtleBrush}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding StationPresets}" SelectedItem="{Binding SelectedStationPreset}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="160" />
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="240" />
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                            <DataGridTemplateColumn Header="Actions" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Play"
                                                    Command="{Binding DataContext.PlayPresetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Play Low"
                                                    Command="{Binding DataContext.PlayPresetLowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="Receiver Connection" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Host" Margin="0,16,0,6" Foreground="{StaticResource SubtleBrush}" />
                            <TextBox Text="{Binding SettingsHost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Port" Margin="0,0,0,6" Foreground="{StaticResource SubtleBrush}" />
                            <TextBox Text="{Binding SettingsPort, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Player Name" Margin="0,0,0,6" Foreground="{StaticResource SubtleBrush}" />
                            <TextBox Text="{Binding SettingsPlayerName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Poll Interval Seconds" Margin="0,0,0,6" Foreground="{StaticResource SubtleBrush}" />
                            <TextBox Text="{Binding SettingsPollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Low Volume" Margin="0,0,0,6" Foreground="{StaticResource SubtleBrush}" />
                            <TextBox Text="{Binding SettingsLowVolume, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Start minimized to tray" IsChecked="{Binding SettingsStartMinimizedToTray}" Margin="0,6,0,6" />
                            <CheckBox Content="Minimize to tray" IsChecked="{Binding SettingsMinimizeToTray}" Margin="0,0,0,6" />
                            <CheckBox Content="Close window to tray" IsChecked="{Binding SettingsCloseToTray}" Margin="0,0,0,6" />
                            <CheckBox Content="Show tray notifications" IsChecked="{Binding SettingsShowNotifications}" Margin="0,0,0,12" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" />
                                <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Preset Editor" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Edit station aliases, display names, and URLs here. Save settings to persist changes."
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SubtleBrush}" />
                            </StackPanel>

                            <DataGrid Grid.Row="1" Margin="0,18,0,18" ItemsSource="{Binding StationPresets}" SelectedItem="{Binding SelectedStationPreset}" AutoGenerateColumns="False" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                    <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                                    <DataGridTextColumn Header="URL" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="2">
                                <Button Content="Add Station" Command="{Binding AddStationCommand}" />
                                <Button Content="Remove Selected" Command="{Binding RemoveSelectedStationCommand}" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Logs">
                <Grid Margin="0,18,0,0">
                    <DataGrid ItemsSource="{Binding LogEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
