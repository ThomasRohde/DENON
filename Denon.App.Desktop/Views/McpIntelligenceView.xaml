<UserControl x:Class="Denon.App.Desktop.Views.McpIntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="TierPillBtn" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,7,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,16">

            <!-- ======================== HEADER & STATUS CARD ======================== -->
            <Border Style="{StaticResource SurfaceCard}" Padding="16,13" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="Streamable HTTP MCP Server &amp; Living-Room Brain" FontSize="16.5" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="#0B1F19" BorderBrush="{StaticResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding McpStatusBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding McpToolsSummaryText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Run Room Doctor" Command="{Binding RunRoomDoctorCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5.5" FontSize="11.5" Margin="0,0,6,4" />
                            <Button Content="Copy Endpoint" Command="{Binding CopyMcpEndpointCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5.5" FontSize="11.5" Margin="0,0,6,4" />
                            <Button Content="Copy MCP Config JSON" Command="{Binding CopyMcpConfigCommand}" Style="{StaticResource PrimaryButton}" Padding="11,5.5" FontSize="11.5" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Endpoint & Bearer Token Bar -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0C0F16" BorderBrush="#1F2739" BorderThickness="1" CornerRadius="9" Padding="10,7">
                            <StackPanel>
                                <TextBlock Text="STREAMABLE HTTP ENDPOINT (POST + SSE)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding McpEndpointText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource AccentCyanBrightBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0C0F16" BorderBrush="#1F2739" BorderThickness="1" CornerRadius="9" Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="BEARER AUTH TOKEN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding McpBearerToken}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#E2E8F0" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Content="Copy" Command="{Binding CopyMcpTokenCommand}" Style="{StaticResource SecondaryButton}" Padding="9,4" FontSize="11" Margin="0,0,5,0" />
                                    <Button Content="Regenerate" Command="{Binding RegenerateMcpTokenCommand}" Style="{StaticResource SecondaryButton}" Padding="9,4" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding McpStatusMessage}" FontSize="11.5" Foreground="{StaticResource AccentCyanBrightBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ======================== MAIN 2-COLUMN WORKSPACE ======================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.0*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: SAFETY GUARDRAILS, SERVER CONFIG & JSON SNIPPET -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SERVER SETTINGS &amp; SAFETY GUARDRAILS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Save &amp; Apply" Command="{Binding SaveAndRestartMcpCommand}" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="11.5" />
                            </Grid>

                            <CheckBox Content="Enable Streamable HTTP MCP Server"
                                      IsChecked="{Binding McpEnabled}"
                                      Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HTTP PORT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding McpPortText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Padding="9,6" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="HARD MAX SAFE VOLUME CEILING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding McpMaxSafeVolumeLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="20" Maximum="95" Value="{Binding McpMaxSafeVolume, Mode=TwoWay}" ToolTip="AI agents can never raise Denon AVR volume above this hard safety limit" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="PERMISSION TIER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Observer (Read-Only)" Command="{Binding SetMcpTierCommand}" CommandParameter="Observer">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TierPillBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding McpPermissionTierName}" Value="Observer">
                                                    <Setter Property="Background" Value="#0C2E3D" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Safe Control (No Power Off)" Command="{Binding SetMcpTierCommand}" CommandParameter="SafeControl">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TierPillBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding McpPermissionTierName}" Value="SafeControl">
                                                    <Setter Property="Background" Value="#261C0A" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                                    <Setter Property="Foreground" Value="#FDE68A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Full Orchestration" Command="{Binding SetMcpTierCommand}" CommandParameter="FullOrchestration">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TierPillBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding McpPermissionTierName}" Value="FullOrchestration">
                                                    <Setter Property="Background" Value="#0B2E24" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                                    <Setter Property="Foreground" Value="#6EE7B7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <CheckBox Content="Require Authorization: Bearer token on all /mcp requests" IsChecked="{Binding McpRequireAuth}" Margin="0,0,0,8" />
                            <CheckBox Content="Allow LAN connections (off = strict 127.0.0.1 localhost only)" IsChecked="{Binding McpAllowLan}" Margin="0,0,0,8" />
                            <CheckBox Content="Show live Room Doctor auto-fix insights on Control Deck" IsChecked="{Binding McpEnableRoomDoctor}" Margin="0,0,0,2" />
                        </StackPanel>
                    </Border>

                    <!-- Ready-to-Paste MCP Client Configuration JSON -->
                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="CLIENT CONFIG (ANTIGRAVITY / CLAUDE / CURSOR / VS CODE)" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Content="Copy JSON" Command="{Binding CopyMcpConfigCommand}" Style="{StaticResource SecondaryButton}" Padding="9,3.5" FontSize="11" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Background="#0A0D13" BorderBrush="#1E2534" BorderThickness="1" CornerRadius="9" Padding="12,10">
                                <TextBox Text="{Binding McpClientConfigPreview, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="11"
                                         Foreground="#93C5FD"
                                         TextWrapping="Wrap"
                                         Padding="0" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: LIVING-ROOM BRAIN (ROOM DOCTOR + UNDO + HABITS) & ACTIVITY LOG -->
                <StackPanel Grid.Column="2">

                    <!-- Self-Healing Room Doctor Card -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="SELF-HEALING ROOM DOCTOR (CROSS-DEVICE INTELLIGENCE)" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Content="Rescan" Command="{Binding RunRoomDoctorCommand}" Style="{StaticResource SecondaryButton}" Padding="9,3.5" FontSize="11" HorizontalAlignment="Right" />
                            </DockPanel>

                            <!-- Healthy empty state -->
                            <Border Background="#0B221A" BorderBrush="#174D3A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRoomInsights}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="✓ All connected devices (Denon AVR, Hue, LG webOS TV, Audio Routing) look healthy with zero mismatches."
                                           FontSize="12"
                                           Foreground="#6EE7B7"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Actionable Insights List -->
                            <ItemsControl ItemsSource="{Binding RoomInsights}" Visibility="{Binding HasRoomInsights, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0E121B" BorderBrush="#283247" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <WrapPanel Margin="0,0,0,3">
                                                        <Border Background="#261C0A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="0,0,7,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="#FDE68A" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Explanation}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding FixLabel}"
                                                            Command="{Binding DataContext.ExecuteRoomInsightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="10,5"
                                                            FontSize="11"
                                                            Margin="0,0,5,0" />
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.DismissRoomInsightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="7,5"
                                                            FontSize="10.5"
                                                            ToolTip="Dismiss suggestion" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Room State Snapshot Undo + Local Habits Memory -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ROOM STATE UNDO &amp; LOCAL HABITS MEMORY (denon://memory/habits)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />

                            <Border Background="#0E121B" BorderBrush="#232B3D" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="1-CLICK UNDO SNAPSHOT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding LastRoomSnapshotLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Restore Previous State"
                                            Command="{Binding RestorePreviousRoomStateCommand}"
                                            IsEnabled="{Binding CanUndoRoomState}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,5"
                                            FontSize="11.5"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="#0C1722" BorderBrush="#1C3752" BorderThickness="1" CornerRadius="10" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="LEARNED LOCAL PREFERENCES (100% ON-DEVICE)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" />
                                    <TextBlock Text="{Binding LearnedHabitsSummary}" FontSize="11.5" Foreground="#DBEAFE" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Live MCP Activity Feed -->
                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="LIVE MCP ACTIVITY FEED" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Content="Clear" Command="{Binding ClearMcpActivityCommand}" Style="{StaticResource SecondaryButton}" Padding="9,3" FontSize="11" HorizontalAlignment="Right" />
                            </DockPanel>

                            <Border Background="#0C0F16" BorderBrush="#1E2534" BorderThickness="1" CornerRadius="9" Padding="12,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMcpActivity}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Waiting for MCP clients... Copy the JSON config on the left into Antigravity, Claude Desktop, Cursor, or VS Code to connect."
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasMcpActivity, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding McpActivityFeed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0D1119" BorderBrush="#1D2434" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="105" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Method}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrightBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0" />
                                                    <TextBlock Grid.Column="3" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center">
                                                        <Run Text="{Binding Outcome, Mode=OneWay}" />
                                                        <Run Text=" (" />
                                                        <Run Text="{Binding DurationMs, Mode=OneWay}" />
                                                        <Run Text="ms)" />
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
