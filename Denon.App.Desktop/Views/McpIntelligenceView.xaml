<UserControl x:Class="Denon.App.Desktop.Views.McpIntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource DisplayFont}">
    <UserControl.Resources>
        <Style x:Key="TierPillBtn" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="{skin:Space 11,6}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize05}" />
            <Setter Property="Margin" Value="{skin:Space 0,0,7,6}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{skin:Space 0,0,4,16}">

            <!-- ======================== HEADER & STATUS CARD ======================== -->
            <Border Style="{StaticResource SurfaceCard}" Padding="{skin:Space 16,13}" Margin="{skin:Space 0,0,0,14}">
                <StackPanel>
                    <Grid Margin="{skin:Space 0,0,0,10}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 12}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <WrapPanel VerticalAlignment="Center" Margin="{skin:Space 0,0,0,3}">
                                <TextBlock Text="Streamable HTTP MCP Server &amp; Living-Room Brain" FontSize="{DynamicResource FontSize10}" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentEmeraldSubtleBgDeepBrush}" BorderBrush="{DynamicResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 8,2}" Margin="{skin:Space 10,0,0,0}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding McpStatusBadgeText}" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentEmeraldBrush}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding McpToolsSummaryText}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Run Room Doctor" Command="{Binding RunRoomDoctorCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 10,5.5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="Copy Endpoint" Command="{Binding CopyMcpEndpointCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 10,5.5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="Copy MCP Config JSON" Command="{Binding CopyMcpConfigCommand}" Style="{StaticResource PrimaryButton}" Padding="{skin:Space 11,5.5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,0,4}" />
                        </WrapPanel>
                    </Grid>

                    <!-- Endpoint & Bearer Token Bar -->
                    <Grid Margin="{skin:Space 0,0,0,8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="{skin:Size 10}" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius03}" Padding="{skin:Space 10,7}">
                            <StackPanel>
                                <TextBlock Text="STREAMABLE HTTP ENDPOINT (MCP 2026-07-28)" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding McpEndpointText}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize06}" Foreground="{DynamicResource AccentCyanBrightBrush}" Margin="{skin:Space 0,2,0,0}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius03}" Padding="{skin:Space 10,7}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="BEARER AUTH TOKEN" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding McpBearerTokenDisplay}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource TextStrongBrush}" Margin="{skin:Space 0,2,0,0}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 8,0,0,0}">
                                    <Button Content="{Binding SecretsToggleLabel}" Command="{Binding ToggleSecretsCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}"
                                            ToolTip="Show or hide the token and the client config. It hides again when you leave the page." />
                                    <Button Content="Copy" Command="{Binding CopyMcpTokenCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" />
                                    <Button Content="Regenerate" Command="{Binding RegenerateMcpTokenCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding McpStatusMessage}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource AccentCyanBrightBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ======================== MAIN 2-COLUMN WORKSPACE ======================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.0*" />
                    <ColumnDefinition Width="{skin:Size 14}" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: SAFETY GUARDRAILS, SERVER CONFIG & JSON SNIPPET -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                        <StackPanel>
                            <Grid Margin="{skin:Space 0,0,0,12}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SERVER SETTINGS &amp; SAFETY GUARDRAILS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Save &amp; Apply" Command="{Binding SaveAndRestartMcpCommand}" Style="{StaticResource PrimaryButton}" Padding="{skin:Space 12,5}" FontSize="{DynamicResource FontSize05}" />
                            </Grid>

                            <CheckBox Content="Enable Streamable HTTP MCP Server"
                                      IsChecked="{Binding McpEnabled}"
                                      Margin="{skin:Space 0,0,0,10}" />

                            <Grid Margin="{skin:Space 0,0,0,12}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{skin:Size 110}" />
                                    <ColumnDefinition Width="{skin:Size 12}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HTTP PORT" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,4}" />
                                    <TextBox Text="{Binding McpPortText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="{skin:Space 0,0,0,4}">
                                        <TextBlock Text="HARD MAX SAFE VOLUME CEILING" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding McpMaxSafeVolumeLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize04}" FontWeight="Bold" Foreground="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="20" Maximum="95" Value="{Binding McpMaxSafeVolume, Mode=TwoWay}" ToolTip="AI agents can never raise Denon AVR volume above this hard safety limit" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="PERMISSION TIER" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,6}" />
                            <WrapPanel Margin="{skin:Space 0,0,0,10}">
                                <Button Content="Observer (Read-Only)" Command="{Binding SetMcpTierCommand}" CommandParameter="Observer">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TierPillBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding McpPermissionTierName}" Value="Observer">
                                                    <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrightBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Safe Control (No Power Off)" Command="{Binding SetMcpTierCommand}" CommandParameter="SafeControl">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TierPillBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding McpPermissionTierName}" Value="SafeControl">
                                                    <Setter Property="Background" Value="{DynamicResource AccentAmberSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentAmberBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentAmberTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Full Orchestration" Command="{Binding SetMcpTierCommand}" CommandParameter="FullOrchestration">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TierPillBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding McpPermissionTierName}" Value="FullOrchestration">
                                                    <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <CheckBox Content="Require Authorization: Bearer token on all /mcp requests" IsChecked="{Binding McpRequireAuth}" Margin="{skin:Space 0,0,0,8}" />
                            <CheckBox Content="Allow LAN connections (off = strict 127.0.0.1 localhost only)" IsChecked="{Binding McpAllowLan}" Margin="{skin:Space 0,0,0,8}" />
                            <CheckBox Content="Show live Room Doctor auto-fix insights on Control Deck" IsChecked="{Binding McpEnableRoomDoctor}" Margin="{skin:Space 0,0,0,2}" />
                        </StackPanel>
                    </Border>

                    <!-- Ready-to-Paste MCP Client Configuration JSON -->
                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <DockPanel Margin="{skin:Space 0,0,0,8}">
                                <TextBlock Text="CLIENT CONFIG (ANTIGRAVITY / CLAUDE / CURSOR / VS CODE)" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Content="Copy JSON" Command="{Binding CopyMcpConfigCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,3.5}" FontSize="{DynamicResource FontSize04}" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink08Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius03}" Padding="{skin:Space 12,10}">
                                <TextBox Text="{Binding McpClientConfigPreviewDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="{DynamicResource MonoFont}"
                                         FontSize="{DynamicResource FontSize04}"
                                         Foreground="{DynamicResource AccentBlueTextBrush}"
                                         TextWrapping="Wrap"
                                         Padding="0" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: LIVING-ROOM BRAIN (ROOM DOCTOR + UNDO + HABITS) & ACTIVITY LOG -->
                <StackPanel Grid.Column="2">

                    <!-- Self-Healing Room Doctor Card -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                        <StackPanel>
                            <DockPanel Margin="{skin:Space 0,0,0,10}">
                                <TextBlock Text="SELF-HEALING ROOM DOCTOR (CROSS-DEVICE INTELLIGENCE)" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Content="Rescan" Command="{Binding RunRoomDoctorCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,3.5}" FontSize="{DynamicResource FontSize04}" HorizontalAlignment="Right" />
                            </DockPanel>

                            <!-- Healthy empty state -->
                            <Border Background="{DynamicResource AccentEmeraldSubtleBgDeepBrush}" BorderBrush="{DynamicResource AccentEmeraldBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 12,10}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRoomInsights}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="✓ All connected devices (Denon AVR, Hue, LG webOS TV, Audio Routing) look healthy with zero mismatches."
                                           FontSize="{DynamicResource FontSize06}"
                                           Foreground="{DynamicResource AccentEmeraldTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Actionable Insights List -->
                            <ItemsControl ItemsSource="{Binding RoomInsights}" Visibility="{Binding HasRoomInsights, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource Ink12Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 12,10}" Margin="{skin:Space 0,0,0,8}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{skin:Size 10}" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <WrapPanel Margin="{skin:Space 0,0,0,3}">
                                                        <Border Background="{DynamicResource AccentAmberSubtleBgBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 6,1}" Margin="{skin:Space 0,0,7,0}">
                                                            <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FontSize00}" FontWeight="Bold" Foreground="{DynamicResource AccentAmberTextBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize07}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Explanation}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding FixLabel}"
                                                            Command="{Binding DataContext.ExecuteRoomInsightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="{skin:Space 10,5}"
                                                            FontSize="{DynamicResource FontSize04}"
                                                            Margin="{skin:Space 0,0,5,0}" />
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.DismissRoomInsightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="{skin:Space 7,5}"
                                                            FontSize="{DynamicResource FontSize03}"
                                                            ToolTip="Dismiss suggestion" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Room State Snapshot Undo + Local Habits Memory -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                        <StackPanel>
                            <TextBlock Text="ROOM STATE UNDO &amp; LOCAL HABITS MEMORY (denon://memory/habits)" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,10}" />

                            <Border Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 12,9}" Margin="{skin:Space 0,0,0,10}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{skin:Size 10}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="1-CLICK UNDO SNAPSHOT" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding LastRoomSnapshotLabel}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="{skin:Space 0,2,0,0}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Restore Previous State"
                                            Command="{Binding RestorePreviousRoomStateCommand}"
                                            IsEnabled="{Binding CanUndoRoomState}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="{skin:Space 10,5}"
                                            FontSize="{DynamicResource FontSize05}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource Ink05Brush}" BorderBrush="{DynamicResource AccentBlueSubtleBgBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 12,9}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{skin:Size 10}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="LEARNED LOCAL PREFERENCES (100% ON-DEVICE)" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrightBrush}" />
                                        <TextBlock Text="{Binding LearnedHabitsSummary}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource AccentBlueTextSoftBrush}" TextWrapping="Wrap" Margin="{skin:Space 0,3,0,0}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Open Insights ↗"
                                            Command="{Binding OpenInsightsCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="{skin:Space 10,5}"
                                            FontSize="{DynamicResource FontSize05}"
                                            VerticalAlignment="Center"
                                            ToolTip="Open your watch and listen statistics in the browser (this PC only)" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Live MCP Activity Feed -->
                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <DockPanel Margin="{skin:Space 0,0,0,8}">
                                <TextBlock Text="LIVE MCP ACTIVITY FEED" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Content="Clear" Command="{Binding ClearMcpActivityCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,3}" FontSize="{DynamicResource FontSize04}" HorizontalAlignment="Right" />
                            </DockPanel>

                            <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink08Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius03}" Padding="{skin:Space 12,10}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMcpActivity}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Waiting for MCP clients... Copy the JSON config on the left into Antigravity, Claude Desktop, Cursor, or VS Code to connect."
                                           FontSize="{DynamicResource FontSize05}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ScrollViewer MaxHeight="{skin:Size 200}" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasMcpActivity, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding McpActivityFeed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource Ink08Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 9,6}" Margin="{skin:Space 0,0,0,5}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{skin:Size 62}" />
                                                        <ColumnDefinition Width="{skin:Size 105}" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Method}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrightBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{skin:Space 6,0}" />
                                                    <TextBlock Grid.Column="3" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize02}" Foreground="{DynamicResource AccentEmeraldBrush}" VerticalAlignment="Center">
                                                        <Run Text="{Binding Outcome, Mode=OneWay}" />
                                                        <Run Text=" (" />
                                                        <Run Text="{Binding DurationMs, Mode=OneWay}" />
                                                        <Run Text="ms)" />
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
