<!-- YouTube &amp; Music page: search, results, queue and history. -->
<UserControl x:Class="Denon.App.Desktop.Views.YouTubeMusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top YouTube Search & LAN Audio Relay Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeroOledCard}" Padding="{skin:Space 16,14}" Margin="{skin:Space 0,0,0,14}">
            <StackPanel>
                <DockPanel Margin="{skin:Space 0,0,0,10}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentCrimsonBgBrush}" BorderBrush="{DynamicResource AccentCrimsonBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}" Margin="{skin:Space 0,0,8,0}">
                            <TextBlock Text="YOUTUBE CAST" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource AccentCrimsonTextBrush}" />
                        </Border>
                        <TextBlock Text="Direct LAN Stream Bridge to Denon HEOS"
                                   FontSize="{DynamicResource FontSize07}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentCyanSubtleBgDeepBrush}" BorderBrush="{DynamicResource AccentCyanBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 8,3}" Margin="{skin:Space 0,0,8,0}">
                            <TextBlock Text="{Binding RelayCodecBadge}" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentCyanBrush}" />
                        </Border>
                        <TextBlock Text="{Binding RelayStreamStateText}"
                                   FontSize="{DynamicResource FontSize04}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   Foreground="{DynamicResource AccentEmeraldBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{skin:Size 8}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{skin:Size 8}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox AutomationProperties.Name="Search YouTube or paste a link" Grid.Column="0"
                             Text="{Binding YouTubeSearchInput, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="YouTubeSearchInput_KeyDown"
                             Tag="Search YouTube Music, songs, videos, or paste any YouTube / playlist URL..."
                             ToolTip="Press Enter to search or resolve any YouTube / YouTube Music URL or playlist" />
                    <Button Grid.Column="2"
                            Content="Paste &amp; Go"
                            Command="{Binding PasteAndSearchYouTubeCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Paste URL or query from clipboard and search immediately" />
                    <Button Grid.Column="4"
                            Content="Search / Load"
                            Command="{Binding SearchYouTubeCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>

                <Grid Margin="{skin:Space 0,10,0,0}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 0,0,12,0}">
                        <Button Content="Music"
                                Command="{Binding SetYouTubeSearchModeCommand}"
                                CommandParameter="Music"
                                Padding="{skin:Space 11,5}"
                                FontSize="{DynamicResource FontSize05}"
                                Margin="{skin:Space 0,0,6,0}"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding YouTubeSearchModeName, Converter={StaticResource EqualityConverter}, ConverterParameter=Music}" />
                        <Button Content="Videos"
                                Command="{Binding SetYouTubeSearchModeCommand}"
                                CommandParameter="Videos"
                                Padding="{skin:Space 11,5}"
                                FontSize="{DynamicResource FontSize05}"
                                Margin="{skin:Space 0,0,6,0}"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding YouTubeSearchModeName, Converter={StaticResource EqualityConverter}, ConverterParameter=Videos}" />
                        <Button Content="Playlists"
                                Command="{Binding SetYouTubeSearchModeCommand}"
                                CommandParameter="Playlists"
                                Padding="{skin:Space 11,5}"
                                FontSize="{DynamicResource FontSize05}"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding YouTubeSearchModeName, Converter={StaticResource EqualityConverter}, ConverterParameter=Playlists}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding YouTubeStatusText}"
                               ToolTip="{Binding YouTubeStatusText}"
                               FontSize="{DynamicResource FontSize05}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="{skin:Space 0,0,12,0}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RelayEndpointText}"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSize03}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="{skin:Space 0,0,8,0}" />
                        <Button Content="Allow Firewall"
                                Command="{Binding AllowRelayFirewallCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 8,4}"
                                FontSize="{DynamicResource FontSize03}"
                                ToolTip="Add a Private LAN Windows Firewall inbound rule for the Denon Audio Relay port" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Split Stage: Results (Left) + Queue & History (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.28*" />
                <ColumnDefinition Width="{skin:Size 14}" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Search / Playlist Results -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,10}">
                        <TextBlock Text="RESULTS &amp; TRACKS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="▶ Play All"
                                    Command="{Binding PlayAllYouTubeResultsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize04}"
                                    Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="+ Queue All"
                                    Command="{Binding EnqueueAllYouTubeResultsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize04}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{skin:Space 0,0,6,0}">
                        <StackPanel>
                            <!-- Playlist Results (when searching playlists) -->
                            <ItemsControl ItemsSource="{Binding YouTubePlaylistResults}"
                                          Visibility="{Binding IsPlaylistResultsVisible, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardElevatedBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 10}" Margin="{skin:Space 0,0,0,8}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{skin:Size 72}" />
                                                    <ColumnDefinition Width="{skin:Size 12}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{skin:Size 10}" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="{skin:Size 72}" Height="{skin:Size 44}" CornerRadius="{DynamicResource Radius02}" Background="{DynamicResource SidebarBgBrush}" ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource SafeImageSource}}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize07}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author, StringFormat='Playlist • {0}'}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,2,0,0}" />
                                                </StackPanel>
                                                <Button Grid.Column="4"
                                                        Content="Open Tracks →"
                                                        Command="{Binding DataContext.OpenYouTubePlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="{skin:Space 10,6}"
                                                        FontSize="{DynamicResource FontSize04}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Track / Video Results -->
                            <ItemsControl ItemsSource="{Binding YouTubeSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardElevatedBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 9}" Margin="{skin:Space 0,0,0,8}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{skin:Size 76}" />
                                                    <ColumnDefinition Width="{skin:Size 12}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{skin:Size 10}" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="{skin:Size 76}" Height="{skin:Size 46}" CornerRadius="{DynamicResource Radius02}" Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" ClipToBounds="True">
                                                    <Grid>
                                                        <Path Data="{DynamicResource IconMusicNote}"
                                                              Fill="{DynamicResource Ink12Brush}"
                                                              Width="{skin:Size 18}"
                                                              Height="{skin:Size 18}"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource SafeImageSource}}" Stretch="UniformToFill" />
                                                        <Border Background="{DynamicResource OverlayScrimBrush}" CornerRadius="{DynamicResource Radius01}" Padding="{skin:Space 4,1}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{skin:Space 3}">
                                                            <TextBlock Text="{Binding DurationDisplay}" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextOnScrimBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize07}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="{skin:Space 0,2,0,0}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="▶ Play"
                                                            Command="{Binding DataContext.PlayYouTubeTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="{skin:Space 10,6}"
                                                            FontSize="{DynamicResource FontSize04}"
                                                            Margin="{skin:Space 0,0,5,0}"
                                                            ToolTip="Cast audio directly to Denon AVR" />
                                                    <Button Content="Video"
                                                            Command="{Binding DataContext.PlayYouTubeTrackAndWatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="{skin:Space 9,6}"
                                                            FontSize="{DynamicResource FontSize04}"
                                                            Margin="{skin:Space 0,0,5,0}"
                                                            ToolTip="Cast audio to Denon + open synced Cinema Video window" />
                                                    <Button AutomationProperties.Name="Add to Up Next" Content="+ Q"
                                                            Command="{Binding DataContext.EnqueueYouTubeTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="{skin:Space 8,6}"
                                                            FontSize="{DynamicResource FontSize04}"
                                                            ToolTip="Add to Up Next queue" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Up Next Queue + Recent History -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,10}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="UP NEXT QUEUE" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding YouTubeQueueCountLabel, StringFormat='  •  {0}'}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Clear"
                                HorizontalAlignment="Right"
                                Command="{Binding ClearYouTubeQueueCommand}"
                                Style="{StaticResource DangerButton}"
                                Padding="{skin:Space 8,4}"
                                FontSize="{DynamicResource FontSize03}" />
                    </DockPanel>

                    <!-- Queue Controls Bar -->
                    <WrapPanel Grid.Row="1" Margin="{skin:Space 0,0,0,10}">
                        <Button Content="Shuffle"
                                Command="{Binding ToggleYouTubeShuffleCommand}"
                                Padding="{skin:Space 9,5}"
                                FontSize="{DynamicResource FontSize04}"
                                Margin="{skin:Space 0,0,6,6}"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding IsYouTubeShuffleEnabled}" />
                        <Button Content="{Binding YouTubeRepeatLabel}"
                                Command="{Binding CycleYouTubeRepeatCommand}"
                                Style="{StaticResource HardwareChipButton}"
                                Padding="{skin:Space 9,5}"
                                FontSize="{DynamicResource FontSize04}"
                                Margin="{skin:Space 0,0,6,6}" />
                        <Button Content="Cinema Window"
                                Command="{Binding OpenCinemaForCurrentTrackCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 9,5}"
                                FontSize="{DynamicResource FontSize04}"
                                Margin="{skin:Space 0,0,0,6}"
                                ToolTip="Open floating YouTube video window synced to Denon audio" />
                    </WrapPanel>

                    <!-- Queue List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{skin:Space 0,0,4,0}">
                        <ItemsControl ItemsSource="{Binding YouTubeQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource Radius03}" Padding="{skin:Space 8,7}" Margin="{skin:Space 0,0,0,6}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardElevatedBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgDeepBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{skin:Size 24}" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding PositionLabel}"
                                                       FontSize="{DynamicResource FontSize04}"
                                                       FontWeight="Bold"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       Foreground="{DynamicResource AccentCyanBrush}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{skin:Space 0,0,6,0}">
                                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize05}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="{DynamicResource FontSize02}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Author, Mode=OneWay}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding DurationDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button AutomationProperties.Name="Play this track now" Content="▶"
                                                        Command="{Binding DataContext.PlayYouTubeQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="{skin:Space 7,4}"
                                                        FontSize="{DynamicResource FontSize02}"
                                                        Margin="{skin:Space 0,0,3,0}"
                                                        ToolTip="Jump to track" />
                                                <Button AutomationProperties.Name="Move up in the queue" ToolTip="Move up" Content="↑"
                                                        Command="{Binding DataContext.MoveYouTubeQueueUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="{skin:Space 6,4}"
                                                        FontSize="{DynamicResource FontSize02}"
                                                        Margin="{skin:Space 0,0,3,0}" />
                                                <Button AutomationProperties.Name="Move down in the queue" ToolTip="Move down" Content="↓"
                                                        Command="{Binding DataContext.MoveYouTubeQueueDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="{skin:Space 6,4}"
                                                        FontSize="{DynamicResource FontSize02}"
                                                        Margin="{skin:Space 0,0,3,0}" />
                                                <Button AutomationProperties.Name="Remove from the queue" ToolTip="Remove from the queue" Content="✕"
                                                        Command="{Binding DataContext.RemoveYouTubeQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        Padding="{skin:Space 6,4}"
                                                        FontSize="{DynamicResource FontSize02}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Recent Played YouTube Tracks -->
                    <StackPanel Grid.Row="3" Margin="{skin:Space 0,10,0,0}" Visibility="{Binding HasYouTubeHistory, Converter={StaticResource BoolToVis}}">
                        <Border Height="1" Background="{DynamicResource BorderHairlineBrush}" Margin="{skin:Space 0,0,0,8}" />
                        <TextBlock Text="RECENTLY CAST" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,6}" />
                        <ScrollViewer MaxHeight="{skin:Size 72}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding YouTubeHistory}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button AutomationProperties.Name="{Binding Title}" Command="{Binding DataContext.PlayYouTubeTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource HardwareChipButton}"
                                                Padding="{skin:Space 8,4}"
                                                FontSize="{DynamicResource FontSize03}"
                                                Margin="{skin:Space 0,0,5,5}"
                                                MaxWidth="{skin:Size 190}"
                                                ToolTip="{Binding Title}">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
