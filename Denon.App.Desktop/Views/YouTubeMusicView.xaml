<!-- YouTube &amp; Music page: search, results, queue and history. -->
<UserControl x:Class="Denon.App.Desktop.Views.YouTubeMusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top YouTube Search & LAN Audio Relay Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeroOledCard}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentCrimsonBgBrush}" BorderBrush="{StaticResource AccentCrimsonBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
                            <TextBlock Text="YOUTUBE CAST" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCrimsonTextBrush}" />
                        </Border>
                        <TextBlock Text="Direct LAN Stream Bridge to Denon HEOS"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentCyanSubtleBgDeepBrush}" BorderBrush="{StaticResource AccentCyanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock Text="{Binding RelayCodecBadge}" FontSize="10" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentCyanBrush}" />
                        </Border>
                        <TextBlock Text="{Binding RelayStreamStateText}"
                                   FontSize="11"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{StaticResource AccentEmeraldBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding YouTubeSearchInput, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="YouTubeSearchInput_KeyDown"
                             Tag="Search YouTube Music, songs, videos, or paste any YouTube / playlist URL..."
                             ToolTip="Press Enter to search or resolve any YouTube / YouTube Music URL or playlist" />
                    <Button Grid.Column="2"
                            Content="Paste &amp; Go"
                            Command="{Binding PasteAndSearchYouTubeCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Paste URL or query from clipboard and search immediately" />
                    <Button Grid.Column="4"
                            Content="Search / Load"
                            Command="{Binding SearchYouTubeCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Content="Music"
                                Command="{Binding SetYouTubeSearchModeCommand}"
                                CommandParameter="Music"
                                Padding="11,5"
                                FontSize="11.5"
                                Margin="0,0,6,0"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding YouTubeSearchModeName, Converter={StaticResource EqualityConverter}, ConverterParameter=Music}" />
                        <Button Content="Videos"
                                Command="{Binding SetYouTubeSearchModeCommand}"
                                CommandParameter="Videos"
                                Padding="11,5"
                                FontSize="11.5"
                                Margin="0,0,6,0"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding YouTubeSearchModeName, Converter={StaticResource EqualityConverter}, ConverterParameter=Videos}" />
                        <Button Content="Playlists"
                                Command="{Binding SetYouTubeSearchModeCommand}"
                                CommandParameter="Playlists"
                                Padding="11,5"
                                FontSize="11.5"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding YouTubeSearchModeName, Converter={StaticResource EqualityConverter}, ConverterParameter=Playlists}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding YouTubeStatusText}"
                               ToolTip="{Binding YouTubeStatusText}"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RelayEndpointText}"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,8,0" />
                        <Button Content="Allow Firewall"
                                Command="{Binding AllowRelayFirewallCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4"
                                FontSize="10.5"
                                ToolTip="Add a Private LAN Windows Firewall inbound rule for the Denon Audio Relay port" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Split Stage: Results (Left) + Queue & History (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.28*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Search / Playlist Results -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="RESULTS &amp; TRACKS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="▶ Play All"
                                    Command="{Binding PlayAllYouTubeResultsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="+ Queue All"
                                    Command="{Binding EnqueueAllYouTubeResultsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Playlist Results (when searching playlists) -->
                            <ItemsControl ItemsSource="{Binding YouTubePlaylistResults}"
                                          Visibility="{Binding IsPlaylistResultsVisible, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="72" Height="44" CornerRadius="6" Background="{StaticResource SidebarBgBrush}" ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource SafeImageSource}}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author, StringFormat='Playlist • {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="4"
                                                        Content="Open Tracks →"
                                                        Command="{Binding DataContext.OpenYouTubePlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="10,6"
                                                        FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Track / Video Results -->
                            <ItemsControl ItemsSource="{Binding YouTubeSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="76" Height="46" CornerRadius="7" Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" ClipToBounds="True">
                                                    <Grid>
                                                        <Path Data="M12,3V13.55C11.41,13.21 10.73,13 10,13A4,4 0 0,0 6,17A4,4 0 0,0 10,21A4,4 0 0,0 14,17V7H18V3H12Z"
                                                              Fill="{StaticResource Ink12Brush}"
                                                              Width="18"
                                                              Height="18"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource SafeImageSource}}" Stretch="UniformToFill" />
                                                        <Border Background="{StaticResource OverlayScrimBrush}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3">
                                                            <TextBlock Text="{Binding DurationDisplay}" FontSize="9.5" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="▶ Play"
                                                            Command="{Binding DataContext.PlayYouTubeTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="10,6"
                                                            FontSize="11"
                                                            Margin="0,0,5,0"
                                                            ToolTip="Cast audio directly to Denon AVR" />
                                                    <Button Content="Video"
                                                            Command="{Binding DataContext.PlayYouTubeTrackAndWatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="9,6"
                                                            FontSize="11"
                                                            Margin="0,0,5,0"
                                                            ToolTip="Cast audio to Denon + open synced Cinema Video window" />
                                                    <Button Content="+ Q"
                                                            Command="{Binding DataContext.EnqueueYouTubeTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="8,6"
                                                            FontSize="11"
                                                            ToolTip="Add to Up Next queue" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Up Next Queue + Recent History -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="UP NEXT QUEUE" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding YouTubeQueueCountLabel, StringFormat='  •  {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Clear"
                                HorizontalAlignment="Right"
                                Command="{Binding ClearYouTubeQueueCommand}"
                                Style="{StaticResource DangerButton}"
                                Padding="8,4"
                                FontSize="10.5" />
                    </DockPanel>

                    <!-- Queue Controls Bar -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="Shuffle"
                                Command="{Binding ToggleYouTubeShuffleCommand}"
                                Padding="9,5"
                                FontSize="11"
                                Margin="0,0,6,6"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding IsYouTubeShuffleEnabled}" />
                        <Button Content="{Binding YouTubeRepeatLabel}"
                                Command="{Binding CycleYouTubeRepeatCommand}"
                                Style="{StaticResource HardwareChipButton}"
                                Padding="9,5"
                                FontSize="11"
                                Margin="0,0,6,6" />
                        <Button Content="Cinema Window"
                                Command="{Binding OpenCinemaForCurrentTrackCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,5"
                                FontSize="11"
                                Margin="0,0,0,6"
                                ToolTip="Open floating YouTube video window synced to Denon audio" />
                    </WrapPanel>

                    <!-- Queue List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <ItemsControl ItemsSource="{Binding YouTubeQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,7" Margin="0,0,0,6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource CardElevatedBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ControlHoverBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgDeepBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding PositionLabel}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{StaticResource AccentCyanBrush}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Author, Mode=OneWay}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding DurationDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶"
                                                        Command="{Binding DataContext.PlayYouTubeQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="7,4"
                                                        FontSize="10"
                                                        Margin="0,0,3,0"
                                                        ToolTip="Jump to track" />
                                                <Button Content="↑"
                                                        Command="{Binding DataContext.MoveYouTubeQueueUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="6,4"
                                                        FontSize="10"
                                                        Margin="0,0,3,0" />
                                                <Button Content="↓"
                                                        Command="{Binding DataContext.MoveYouTubeQueueDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="6,4"
                                                        FontSize="10"
                                                        Margin="0,0,3,0" />
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.RemoveYouTubeQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        Padding="6,4"
                                                        FontSize="10" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Recent Played YouTube Tracks -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding HasYouTubeHistory, Converter={StaticResource BoolToVis}}">
                        <Border Height="1" Background="{StaticResource BorderHairlineBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="RECENTLY CAST" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                        <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding YouTubeHistory}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PlayYouTubeTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource HardwareChipButton}"
                                                Padding="8,4"
                                                FontSize="10.5"
                                                Margin="0,0,5,5"
                                                MaxWidth="190"
                                                ToolTip="{Binding Title}">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
