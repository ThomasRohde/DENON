<!-- Stations &amp; Streams page: presets, HEOS favorites and the global radio explorer. -->
<UserControl x:Class="Denon.App.Desktop.Views.StationsStreamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sub-Tab Switcher: Saved Presets vs Global Radio Explorer (40,000+) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Saved Presets &amp; Direct Stream"
                    Command="{Binding SetStationsSubTabCommand}"
                    CommandParameter="Presets"
                    Padding="14,7"
                    FontSize="12"
                    Margin="0,0,8,0"
                    Style="{StaticResource ChipButton}"
                    infra:Chip.IsActive="{Binding StationsSubTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Presets}" />
            <Button Content="Global Radio Explorer (40,000+)"
                    Command="{Binding SetStationsSubTabCommand}"
                    CommandParameter="Explorer"
                    Padding="14,7"
                    FontSize="12"
                    Style="{StaticResource ChipButton}"
                    infra:Chip.IsActive="{Binding StationsSubTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Explorer}" />
        </StackPanel>

        <!-- SUB-TAB A: SAVED PRESETS & HEOS FAVORITES -->
        <Grid Grid.Row="1" Visibility="{Binding StationsSubTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Presets}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Direct Stream Launcher -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="DIRECT STREAM LAUNCHER" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomStreamUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Enter stream URL (e.g. http://live-icy.dr.dk/A/A08L.mp3)..."
                                 ToolTip="Enter any HTTP/HTTPS MP3, AAC, or Icecast stream URL" />
                        <Button Grid.Column="2"
                                Content="Test URL"
                                Command="{Binding TestCustomStreamCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="4"
                                Content="▶  Stream Now"
                                Command="{Binding PlayCustomStreamCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="Apply safety low volume on stream launch"
                                  IsChecked="{Binding UseLowVolumeForStreams}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Margin="0,0,28,0" />
                        <CheckBox Content="Auto-unmute receiver before playback"
                                  IsChecked="{Binding UnmuteBeforePlay}"
                                  Style="{StaticResource ToggleSwitchStyle}" />
                    </StackPanel>

                    <TextBlock Text="{Binding CustomStreamProbeStatus}"
                               Foreground="{Binding CustomStreamProbeSuccess, Converter={StaticResource NullableBoolToBrush}}"
                               FontSize="12"
                               FontFamily="Cascadia Mono, Consolas"
                               Margin="0,8,0,0"
                               Visibility="{Binding CustomStreamProbeStatus, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>

            <!-- Preset Manager (Internally Scrollable List) -->
            <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="PRESET STATIONS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Width="210"
                                     Text="{Binding StationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Filter stations..."
                                     ToolTip="Filter stations by name, alias, or URL"
                                     Margin="0,0,10,0"
                                     Padding="10,6" />
                            <Button Content="+ Add Station"
                                    Command="{Binding AddStationCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0" />
                            <Button Content="Save Changes"
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding FilteredStationPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource ControlHoverBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,9"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="34"
                                                        Height="34"
                                                        CornerRadius="8"
                                                        Background="{Binding BadgeBrush}"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Monogram}" FontSize="12" FontWeight="Black" Foreground="{StaticResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <TextBox Grid.Column="1" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" ToolTip="Alias" Padding="8,6" />
                                                <TextBox Grid.Column="3" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Display Name" Padding="8,6" />
                                                <TextBox Grid.Column="5" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" ToolTip="Stream URL" Padding="8,6" FontFamily="Cascadia Mono, Consolas" FontSize="12" />

                                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="▶"
                                                            Command="{Binding DataContext.PlayPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="10,6"
                                                            Margin="0,0,5,0"
                                                            ToolTip="Play Station" />
                                                    <Button Content="Test"
                                                            Command="{Binding DataContext.TestPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="9,6"
                                                            Margin="0,0,5,0"
                                                            ToolTip="Verify Stream HTTP Health &amp; Bitrate" />
                                                    <Button Content="↑"
                                                            Command="{Binding DataContext.MoveStationUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="8,6"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Move Up" />
                                                    <Button Content="↓"
                                                            Command="{Binding DataContext.MoveStationDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="8,6"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Move Down" />
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.RemoveStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButton}"
                                                            Padding="8,6"
                                                            ToolTip="Remove Station" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding ProbeStatusText}"
                                                       Foreground="{Binding ProbeSucceeded, Converter={StaticResource NullableBoolToBrush}}"
                                                       FontSize="11"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Margin="44,6,0,0"
                                                       Visibility="{Binding ProbeStatusText, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- HEOS Receiver Favorites -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="RECEIVER HEOS FAVORITES" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <Button Content="Load from Receiver"
                                HorizontalAlignment="Right"
                                Command="{Binding LoadFavoritesCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,6" />
                    </DockPanel>
                    <TextBlock Text="{Binding FavoritesStatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                    <ScrollViewer MaxHeight="110"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HeosFavorites}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PlayFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource HardwareChipButton}"
                                            Margin="0,0,8,8"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PresetIndex, StringFormat='#{0}  '}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SUB-TAB B: GLOBAL RADIO EXPLORER (40,000+ STATIONS) -->
        <Grid Grid.Row="1" Visibility="{Binding StationsSubTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Explorer}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="RADIO BROWSER DIRECTORY (40,000+ LIVE STATIONS)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding RadioBrowserQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="RadioBrowserSearch_KeyDown" Tag="Station name (e.g. BBC, SomaFM, Paradise)..." />
                        <TextBox Grid.Column="2" Text="{Binding RadioBrowserTag, UpdateSourceTrigger=PropertyChanged}" KeyDown="RadioBrowserSearch_KeyDown" Tag="Genre / Tag (jazz, lofi)..." />
                        <TextBox Grid.Column="4" Text="{Binding RadioBrowserCountry, UpdateSourceTrigger=PropertyChanged}" KeyDown="RadioBrowserSearch_KeyDown" Tag="Country (Denmark, UK)..." />
                        <Button Grid.Column="6" Content="Search Directory" Command="{Binding SearchRadioBrowserCommand}" Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <DockPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Content="FLAC / Hi-Res" Command="{Binding QuickRadioTagCommand}" CommandParameter="FLAC" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Denmark" Command="{Binding QuickRadioTagCommand}" CommandParameter="Denmark" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Jazz" Command="{Binding QuickRadioTagCommand}" CommandParameter="jazz" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Lo-Fi" Command="{Binding QuickRadioTagCommand}" CommandParameter="lofi" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Electronic" Command="{Binding QuickRadioTagCommand}" CommandParameter="electronic" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Classical" Command="{Binding QuickRadioTagCommand}" CommandParameter="classical" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Rock" Command="{Binding QuickRadioTagCommand}" CommandParameter="rock" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,12,0" />
                        </WrapPanel>

                        <CheckBox HorizontalAlignment="Right" Content="Hi-Res (256k+ / FLAC) only" IsChecked="{Binding RadioBrowserHiResOnly}" Style="{StaticResource ToggleSwitchStyle}" Margin="0" />
                    </DockPanel>

                    <TextBlock Text="{Binding RadioBrowserStatusText}" FontSize="11.5" Foreground="{StaticResource AccentCyanBrightBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SurfaceCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <ItemsControl ItemsSource="{Binding RadioBrowserResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{StaticResource Ink05Brush}" BorderBrush="{StaticResource Ink12Brush}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Path Data="M20,6H8.3L16.56,2.59L15.81,0.74L3.24,5.96C2.5,6.27 2,7 2,7.8V20A2,2 0 0,0 4,22H20A2,2 0 0,0 22,20V8A2,2 0 0,0 20,6M7,20A3,3 0 0,1 4,17A3,3 0 0,1 7,14A3,3 0 0,1 10,17A3,3 0 0,1 7,20M20,12H18V10H16V12H4V8H20V12Z"
                                                      Fill="{StaticResource AccentBlueSubtleBgBrush}"
                                                      Width="16"
                                                      Height="16"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                                <Image Source="{Binding Favicon, Converter={StaticResource SafeImageSource}}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubtitleLine}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="4" Background="{StaticResource Ink08Brush}" BorderBrush="{StaticResource Ink15Brush}" BorderThickness="1" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CodecBadge}" FontSize="10" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentAmberBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Play"
                                                    Command="{Binding DataContext.PlayRadioBrowserStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="10,6"
                                                    FontSize="11"
                                                    Margin="0,0,5,0" />
                                            <Button Content="+ Save"
                                                    Command="{Binding DataContext.SaveRadioBrowserStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,6"
                                                    FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
