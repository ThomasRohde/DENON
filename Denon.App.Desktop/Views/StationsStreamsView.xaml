<!-- Stations &amp; Streams page: presets, HEOS favorites and the global radio explorer. -->
<UserControl x:Class="Denon.App.Desktop.Views.StationsStreamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sub-Tab Switcher: Saved Presets vs Global Radio Explorer (40,000+) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{skin:Space 0,0,0,12}">
            <Button Content="Saved Presets &amp; Direct Stream"
                    Command="{Binding SetStationsSubTabCommand}"
                    CommandParameter="Presets"
                    Padding="{skin:Space 14,7}"
                    FontSize="{DynamicResource FontSize06}"
                    Margin="{skin:Space 0,0,8,0}"
                    Style="{StaticResource ChipButton}"
                    infra:Chip.IsActive="{Binding StationsSubTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Presets}" />
            <Button Content="Global Radio Explorer (40,000+)"
                    Command="{Binding SetStationsSubTabCommand}"
                    CommandParameter="Explorer"
                    Padding="{skin:Space 14,7}"
                    FontSize="{DynamicResource FontSize06}"
                    Style="{StaticResource ChipButton}"
                    infra:Chip.IsActive="{Binding StationsSubTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Explorer}" />
        </StackPanel>

        <!-- SUB-TAB A: SAVED PRESETS & HEOS FAVORITES -->
        <Grid Grid.Row="1" Visibility="{Binding StationsSubTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Presets}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Direct Stream Launcher -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                <StackPanel>
                    <TextBlock Text="DIRECT STREAM LAUNCHER" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,12}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 10}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{skin:Size 8}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomStreamUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Enter stream URL (e.g. http://live-icy.dr.dk/A/A08L.mp3)..."
                                 ToolTip="Enter any HTTP/HTTPS MP3, AAC, or Icecast stream URL" />
                        <Button Grid.Column="2"
                                Content="Test URL"
                                Command="{Binding TestCustomStreamCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="4"
                                Content="▶  Stream Now"
                                Command="{Binding PlayCustomStreamCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="{skin:Space 0,12,0,0}">
                        <CheckBox Content="Apply safety low volume on stream launch"
                                  IsChecked="{Binding UseLowVolumeForStreams}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Margin="{skin:Space 0,0,28,0}" />
                        <CheckBox Content="Auto-unmute receiver before playback"
                                  IsChecked="{Binding UnmuteBeforePlay}"
                                  Style="{StaticResource ToggleSwitchStyle}" />
                    </StackPanel>

                    <TextBlock Text="{Binding CustomStreamProbeStatus}"
                               Foreground="{Binding CustomStreamProbeSuccess, Converter={StaticResource NullableBoolToBrush}}"
                               FontSize="{DynamicResource FontSize06}"
                               FontFamily="{DynamicResource MonoFont}"
                               Margin="{skin:Space 0,8,0,0}"
                               Visibility="{Binding CustomStreamProbeStatus, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>

            <!-- Preset Manager (Internally Scrollable List) -->
            <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,12}">
                        <TextBlock Text="PRESET STATIONS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Width="{skin:Size 210}"
                                     Text="{Binding StationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Filter stations..."
                                     ToolTip="Filter stations by name, alias, or URL"
                                     Margin="{skin:Space 0,0,10,0}"
                                     Padding="{skin:Space 10,6}" />
                            <Button Content="+ Add Station"
                                    Command="{Binding AddStationCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="{skin:Space 0,0,8,0}" />
                            <Button Content="Save Changes"
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <!-- Why the last save did not save (shortcut collision, error); also in the log and the status line. -->
                        <TextBlock Text="{Binding SettingsSaveProblem}"
                                   Foreground="{DynamicResource AccentCrimsonBrush}"
                                   FontSize="{DynamicResource FontSize05}"
                                   TextWrapping="Wrap"
                                   Margin="{skin:Space 0,0,0,10}"
                                   Visibility="{Binding SettingsSaveProblem, Converter={StaticResource StringToVis}}" />
                        <!-- Unsaved station edits (#76); it hides itself when there are none. -->
                        <controls:UnsavedChangesBanner Message="{Binding StationsDirtyText}"
                                                       Area="Stations"
                                                       SaveLabel="Save Changes"
                                                       Margin="{skin:Space 0,0,0,10}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="{skin:Space 0,0,6,0}">
                        <ItemsControl ItemsSource="{Binding FilteredStationPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardElevatedBrush}"
                                            BorderBrush="{DynamicResource ControlHoverBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius04}"
                                            Padding="{skin:Space 10,9}"
                                            Margin="{skin:Space 0,0,0,8}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="{skin:Size 125}" />
                                                    <ColumnDefinition Width="{skin:Size 8}" />
                                                    <ColumnDefinition Width="{skin:Size 170}" />
                                                    <ColumnDefinition Width="{skin:Size 8}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{skin:Size 10}" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="{skin:Size 34}"
                                                        Height="{skin:Size 34}"
                                                        CornerRadius="{DynamicResource Radius03}"
                                                        Background="{Binding BadgeBrush}"
                                                        Margin="{skin:Space 0,0,10,0}">
                                                    <TextBlock Text="{Binding Monogram}" FontSize="{DynamicResource FontSize06}" FontWeight="Black" Foreground="{Binding BadgeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <TextBox Grid.Column="1" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" ToolTip="Alias" Padding="{skin:Space 8,6}" />
                                                <TextBox Grid.Column="3" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Display Name" Padding="{skin:Space 8,6}" />
                                                <TextBox Grid.Column="5" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" ToolTip="Stream URL" Padding="{skin:Space 8,6}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize06}" />

                                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="▶"
                                                            Command="{Binding DataContext.PlayPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="{skin:Space 10,6}"
                                                            Margin="{skin:Space 0,0,5,0}"
                                                            ToolTip="Play Station" />
                                                    <Button Content="Test"
                                                            Command="{Binding DataContext.TestPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="{skin:Space 9,6}"
                                                            Margin="{skin:Space 0,0,5,0}"
                                                            ToolTip="Verify Stream HTTP Health &amp; Bitrate" />
                                                    <Button Content="↑"
                                                            Command="{Binding DataContext.MoveStationUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="{skin:Space 8,6}"
                                                            Margin="{skin:Space 0,0,4,0}"
                                                            ToolTip="Move Up" />
                                                    <Button Content="↓"
                                                            Command="{Binding DataContext.MoveStationDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="{skin:Space 8,6}"
                                                            Margin="{skin:Space 0,0,4,0}"
                                                            ToolTip="Move Down" />
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.RemoveStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButton}"
                                                            Padding="{skin:Space 8,6}"
                                                            ToolTip="Remove Station" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding ProbeStatusText}"
                                                       Foreground="{Binding ProbeSucceeded, Converter={StaticResource NullableBoolToBrush}}"
                                                       FontSize="{DynamicResource FontSize04}"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       Margin="{skin:Space 44,6,0,0}"
                                                       Visibility="{Binding ProbeStatusText, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- HEOS Receiver Favorites -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <DockPanel Margin="{skin:Space 0,0,0,8}">
                        <TextBlock Text="RECEIVER HEOS FAVORITES" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <Button Content="Load from Receiver"
                                HorizontalAlignment="Right"
                                Command="{Binding LoadFavoritesCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 12,6}" />
                    </DockPanel>
                    <TextBlock Text="{Binding FavoritesStatusText}" FontSize="{DynamicResource FontSize06}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="{skin:Space 0,0,0,8}" />

                    <ScrollViewer MaxHeight="{skin:Size 110}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HeosFavorites}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PlayFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource HardwareChipButton}"
                                            Margin="{skin:Space 0,0,8,8}"
                                            Padding="{skin:Space 14,8}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PresetIndex, StringFormat='#{0}  '}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SUB-TAB B: GLOBAL RADIO EXPLORER (40,000+ STATIONS) -->
        <Grid Grid.Row="1" Visibility="{Binding StationsSubTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Explorer}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,12}">
                <StackPanel>
                    <TextBlock Text="RADIO BROWSER DIRECTORY (40,000+ LIVE STATIONS)" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,10}" />

                    <Grid Margin="{skin:Space 0,0,0,10}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="{skin:Size 8}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 8}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 8}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding RadioBrowserQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="RadioBrowserSearch_KeyDown" Tag="Station name (e.g. BBC, SomaFM, Paradise)..." />
                        <TextBox Grid.Column="2" Text="{Binding RadioBrowserTag, UpdateSourceTrigger=PropertyChanged}" KeyDown="RadioBrowserSearch_KeyDown" Tag="Genre / Tag (jazz, lofi)..." />
                        <TextBox Grid.Column="4" Text="{Binding RadioBrowserCountry, UpdateSourceTrigger=PropertyChanged}" KeyDown="RadioBrowserSearch_KeyDown" Tag="Country (Denmark, UK)..." />
                        <Button Grid.Column="6" Content="Search Directory" Command="{Binding SearchRadioBrowserCommand}" Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <DockPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Content="FLAC / Hi-Res" Command="{Binding QuickRadioTagCommand}" CommandParameter="FLAC" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Denmark" Command="{Binding QuickRadioTagCommand}" CommandParameter="Denmark" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Jazz" Command="{Binding QuickRadioTagCommand}" CommandParameter="jazz" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Lo-Fi" Command="{Binding QuickRadioTagCommand}" CommandParameter="lofi" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Electronic" Command="{Binding QuickRadioTagCommand}" CommandParameter="electronic" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Classical" Command="{Binding QuickRadioTagCommand}" CommandParameter="classical" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Rock" Command="{Binding QuickRadioTagCommand}" CommandParameter="rock" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,12,0}" />
                        </WrapPanel>

                        <CheckBox HorizontalAlignment="Right" Content="Hi-Res (256k+ / FLAC) only" IsChecked="{Binding RadioBrowserHiResOnly}" Style="{StaticResource ToggleSwitchStyle}" Margin="0" />
                    </DockPanel>

                    <TextBlock Text="{Binding RadioBrowserStatusText}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource AccentCyanBrightBrush}" Margin="{skin:Space 0,8,0,0}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SurfaceCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{skin:Space 0,0,6,0}">
                    <ItemsControl ItemsSource="{Binding RadioBrowserResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardElevatedBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 10,8}" Margin="{skin:Space 0,0,0,7}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{skin:Size 36}" />
                                            <ColumnDefinition Width="{skin:Size 10}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{skin:Size 10}" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{skin:Size 10}" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="{skin:Size 36}" Height="{skin:Size 36}" CornerRadius="{DynamicResource Radius03}" Background="{DynamicResource Ink05Brush}" BorderBrush="{DynamicResource Ink12Brush}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Path Data="{DynamicResource IconRadio}"
                                                      Fill="{DynamicResource AccentBlueSubtleBgBrush}"
                                                      Width="{skin:Size 16}"
                                                      Height="{skin:Size 16}"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                                <Image Source="{Binding Favicon, Converter={StaticResource SafeImageSource}}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize07}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubtitleLine}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="{skin:Space 0,2,0,0}" />
                                        </StackPanel>

                                        <Border Grid.Column="4" Background="{DynamicResource Ink08Brush}" BorderBrush="{DynamicResource Ink15Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,3}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CodecBadge}" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentAmberBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Play"
                                                    Command="{Binding DataContext.PlayRadioBrowserStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="{skin:Space 10,6}"
                                                    FontSize="{DynamicResource FontSize04}"
                                                    Margin="{skin:Space 0,0,5,0}" />
                                            <Button Content="+ Save"
                                                    Command="{Binding DataContext.SaveRadioBrowserStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="{skin:Space 10,6}"
                                                    FontSize="{DynamicResource FontSize04}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
