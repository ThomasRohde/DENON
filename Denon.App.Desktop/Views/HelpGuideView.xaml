<UserControl x:Class="Denon.App.Desktop.Views.HelpGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="HelpFilterChip" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,4.5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== ROW 0: HERO SEARCH & CATEGORY BAR ======================== -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="310" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Help &amp; Interactive Guide" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="{StaticResource AccentCyanSubtleBgDeepBrush}" BorderBrush="{StaticResource AccentSkyDeepBrush}" BorderThickness="1" CornerRadius="6" Padding="7,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="F1 CONTEXT HELP" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" />
                            </Border>
                            <Button Content="{Binding HelpReturnLabel}"
                                    Command="{Binding ReturnFromHelpCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,3"
                                    FontSize="11"
                                    Margin="10,0,0,0"
                                    Visibility="{Binding HasHelpReturnSection, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>
                        <TextBlock Text="Step-by-step setup guides, live readiness checklist, keyboard shortcuts, network ports &amp; troubleshooting."
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding HelpSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,6"
                                 FontSize="12"
                                 Tag="Search Hue, LG TV, eARC, lyrics, ports, keys..." />
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding ClearHelpSearchCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,5"
                                FontSize="11"
                                Margin="6,0,0,0"
                                Visibility="{Binding HasHelpSearchQuery, Converter={StaticResource BoolToVis}}"
                                ToolTip="Clear search" />
                    </Grid>
                </Grid>

                <!-- Category Filter Pills -->
                <WrapPanel>
                    <Button Content="All Guides" Command="{Binding SetHelpCategoryCommand}" CommandParameter="All">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HelpFilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HelpCategoryFilter}" Value="All">
                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Getting Started" Command="{Binding SetHelpCategoryCommand}" CommandParameter="Getting Started">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HelpFilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HelpCategoryFilter}" Value="Getting Started">
                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Audio &amp; Media" Command="{Binding SetHelpCategoryCommand}" CommandParameter="Audio &amp; Media">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HelpFilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HelpCategoryFilter}" Value="Audio &amp; Media">
                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Scenes &amp; Acoustics" Command="{Binding SetHelpCategoryCommand}" CommandParameter="Scenes &amp; Acoustics">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HelpFilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HelpCategoryFilter}" Value="Scenes &amp; Acoustics">
                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Plugins" Command="{Binding SetHelpCategoryCommand}" CommandParameter="Plugins">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HelpFilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HelpCategoryFilter}" Value="Plugins">
                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Reference" Command="{Binding SetHelpCategoryCommand}" CommandParameter="Reference">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HelpFilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HelpCategoryFilter}" Value="Reference">
                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Troubleshooting" Command="{Binding SetHelpCategoryCommand}" CommandParameter="Troubleshooting">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HelpFilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HelpCategoryFilter}" Value="Troubleshooting">
                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ======================== ROW 1: LIVE SETUP READINESS CHECKLIST ======================== -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="LIVE SETUP CHECKLIST" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="2" Height="7" Minimum="0" Maximum="100" Value="{Binding SetupChecklistPercent, Mode=OneWay}" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding SetupChecklistProgressText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="5" Content="{Binding SetupChecklistToggleLabel}" Command="{Binding ToggleSetupChecklistCommand}" Style="{StaticResource SecondaryButton}" Padding="9,3.5" FontSize="11" />
                </Grid>

                <ItemsControl ItemsSource="{Binding SetupChecklistItems}"
                              Margin="0,10,0,0"
                              Visibility="{Binding IsSetupChecklistExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ExecuteHelpJumpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding JumpTarget}"
                                    Margin="0,0,8,8"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ChkBd" Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="9" Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource AccentAmberBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StatusSummary}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="14,2,0,0" />
                                                </StackPanel>
                                                <Border x:Name="Pill" Grid.Column="1" Background="{StaticResource AccentAmberSubtleBgDeepBrush}" BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PillTxt" Text="{Binding ActionLabel}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentAmberTextBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentEmeraldBrush}" />
                                                <Setter TargetName="ChkBd" Property="BorderBrush" Value="{StaticResource AccentEmeraldBorderBrush}" />
                                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                                <Setter TargetName="PillTxt" Property="Text" Value="✓ READY" />
                                                <Setter TargetName="PillTxt" Property="Foreground" Value="{StaticResource AccentEmeraldTextBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ChkBd" Property="Background" Value="{StaticResource ControlBgBrush}" />
                                                <Setter TargetName="ChkBd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ======================== ROW 2: 2-COLUMN GUIDE READER ======================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Rail: Guide Topics List -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="TOPICS &amp; GUIDES" Style="{StaticResource SectionLabelStyle}" Margin="6,2,0,8" />

                        <ItemsControl ItemsSource="{Binding FilteredHelpTopics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectHelpTopicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,0,6"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Ink11Brush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ItemBd"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="10"
                                                                    Padding="10,8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource Ink08Brush}" />
                                                                    <Setter TargetName="ItemBd" Property="BorderBrush" Value="{StaticResource Ink15Brush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Ink08Brush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="44"
                                                    Height="24"
                                                    CornerRadius="6"
                                                    Background="{StaticResource SidebarBgBrush}"
                                                    BorderBrush="{Binding AccentBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,9,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="8.5" FontWeight="Black" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,4,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilteredHelpTopics}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="No guides matched your search." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Button Content="Reset Search &amp; Filters" Command="{Binding ClearHelpSearchCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Reading Canvas -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedHelpTopic}" Margin="0,0,4,16">

                    <!-- Topic Hero Card -->
                    <Border Style="{StaticResource SurfaceCard}" Padding="18,15" Margin="0,0,0,12">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                <Border Background="{StaticResource Ink03Brush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Black" Foreground="{Binding AccentBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource AccentCyanBrightBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <TextBlock Text="{Binding Overview}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" />

                            <!-- 1-Click Quick-Jump Buttons -->
                            <ItemsControl ItemsSource="{Binding QuickJumps}" Margin="0,12,0,0" Visibility="{Binding HasQuickJumps, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                Command="{Binding DataContext.ExecuteHelpJumpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="12,5.5"
                                                FontSize="11.5"
                                                Margin="0,0,8,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Step-by-Step Guide Cards -->
                    <Border Style="{StaticResource SurfaceCard}" Padding="18,15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="STEP-BY-STEP GUIDE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentCyanSubtleBgDeepBrush}" BorderBrush="{StaticResource AccentSkyDeepBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding StepNumber}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Keyboard Shortcuts Reference Table (shown on Shortcuts guide) -->
                    <Border Style="{StaticResource SurfaceCard}" Padding="18,15" Margin="0,0,0,12" Visibility="{Binding ShowShortcutsTable, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="COMPLETE KEYBOARD &amp; GLOBAL HOTKEY REFERENCE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding DataContext.HelpShortcutsReference, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink08Brush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="155" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource Ink08Brush}" BorderBrush="{StaticResource AccentBlueSubtleBgBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Keys}" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Scope}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Action}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- LAN Network Ports Reference Table (shown on Troubleshooting guide) -->
                    <Border Style="{StaticResource SurfaceCard}" Padding="18,15" Margin="0,0,0,12" Visibility="{Binding ShowPortsTable, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="LOCAL NETWORK PORTS &amp; PROTOCOLS REFERENCE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding DataContext.HelpPortsReference, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink08Brush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource AccentVioletSubtleBgBrush}" BorderBrush="{StaticResource AccentVioletBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProtocolPort}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentVioletTextBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Service}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Purpose}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Pro Tips Callout -->
                    <Border Background="{StaticResource Ink05Brush}" BorderBrush="{StaticResource AccentCyanBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,12" Visibility="{Binding HasProTips, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="PRO TIPS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding ProTips}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="✦ " Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource AccentBlueTextSoftBrush}" TextWrapping="Wrap" MaxWidth="760" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Troubleshooting & FAQ -->
                    <Border Style="{StaticResource SurfaceCard}" Padding="18,15" Visibility="{Binding HasTroubleshooting, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="COMMON QUESTIONS &amp; TROUBLESHOOTING" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Troubleshooting}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Question}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Answer}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
