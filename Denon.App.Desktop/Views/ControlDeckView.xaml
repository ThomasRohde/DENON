<!-- Control Deck page: now-playing hero, meters, inputs, sound modes, volume and quick presets. -->
<UserControl x:Class="Denon.App.Desktop.Views.ControlDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Zero-Clutter Live Room Brain Insight Strip (only visible when Room Doctor spots an actionable fix!) -->
        <Border Grid.Row="0"
                Background="{StaticResource CardElevatedBrush}"
                BorderBrush="{StaticResource AccentAmberBrush}"
                BorderThickness="1"
                CornerRadius="11"
                Padding="12,8"
                Margin="0,0,0,10"
                Visibility="{Binding ShowControlDeckInsights, Converter={StaticResource BoolToVis}}">
            <Grid DataContext="{Binding PrimaryRoomInsight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource AccentAmberSubtleBgBrush}" BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="ROOM BRAIN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentAmberTextBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Explanation}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="{Binding FixLabel}"
                            Command="{Binding DataContext.ExecuteRoomInsightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="10,4.5"
                            FontSize="11"
                            Margin="0,0,6,0" />
                    <Button Content="Undo"
                            Command="{Binding DataContext.RestorePreviousRoomStateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="9,4.5"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Visibility="{Binding DataContext.CanUndoRoomState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    <Button Content="✕"
                            Command="{Binding DataContext.DismissRoomInsightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="7,4.5"
                            FontSize="10.5"
                            ToolTip="Dismiss insight" />
                </StackPanel>
            </Grid>
        </Border>

            <!-- HERO OLED NOW PLAYING DECK -->
            <Border Grid.Row="1" Style="{StaticResource HeroOledCard}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Artwork / Hi-Fi Vinyl Emblem -->
                    <Border Grid.Column="0"
                            Width="88"
                            Height="88"
                            CornerRadius="14"
                            Background="{StaticResource SidebarBgBrush}"
                            BorderBrush="{StaticResource Ink12Brush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Margin="0,0,20,0">
                        <Grid>
                            <!-- Default Hi-Fi Disc Emblem -->
                            <Grid Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Ellipse Width="60" Height="60" Stroke="{StaticResource AccentBlueBorderSoftBrush}" StrokeThickness="2" Fill="{StaticResource Ink05Brush}" />
                                <Ellipse Width="38" Height="38" Stroke="{StaticResource AccentCyanBorderBrush}" StrokeThickness="1.2" />
                                <Ellipse Width="16" Height="16" Fill="{StaticResource AccentCyanBrush}" Opacity="0.85" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource OledBgBrush}" />
                            </Grid>

                            <!-- Live Album/Station Artwork -->
                            <Image Source="{Binding NowPlayingImageUrl, Converter={StaticResource SafeImageSource}}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- OLED Track Metadata & Live Equalizer -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Animated 5-bar Audio Visualizer when actively playing -->
                            <StackPanel Orientation="Horizontal"
                                        Height="16"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsActiveAndPlaying, Converter={StaticResource BoolToVis}}">
                                <StackPanel.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="Eq1" Storyboard.TargetProperty="Height" From="4" To="15" Duration="0:0:0.42" />
                                                <DoubleAnimation Storyboard.TargetName="Eq2" Storyboard.TargetProperty="Height" From="13" To="5" Duration="0:0:0.35" />
                                                <DoubleAnimation Storyboard.TargetName="Eq3" Storyboard.TargetProperty="Height" From="6" To="16" Duration="0:0:0.51" />
                                                <DoubleAnimation Storyboard.TargetName="Eq4" Storyboard.TargetProperty="Height" From="14" To="4" Duration="0:0:0.38" />
                                                <DoubleAnimation Storyboard.TargetName="Eq5" Storyboard.TargetProperty="Height" From="5" To="12" Duration="0:0:0.46" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </StackPanel.Triggers>
                                <Border x:Name="Eq1" Style="{StaticResource EqBarStyle}" Height="6" />
                                <Border x:Name="Eq2" Style="{StaticResource EqBarStyle}" Height="12" />
                                <Border x:Name="Eq3" Style="{StaticResource EqBarStyle}" Height="8" />
                                <Border x:Name="Eq4" Style="{StaticResource EqBarStyle}" Height="14" />
                                <Border x:Name="Eq5" Style="{StaticResource EqBarStyle}" Height="6" />
                            </StackPanel>

                            <Border Background="{StaticResource AccentCyanSubtleBgDeepBrush}" CornerRadius="5" Padding="7,2.5" Margin="0,0,6,0">
                                <TextBlock Text="{Binding InputSourceDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                            </Border>
                            <Border Background="{StaticResource ControlBgBrush}" CornerRadius="5" Padding="7,2.5" Margin="0,0,6,0">
                                <TextBlock Text="{Binding PlayState}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{StaticResource ControlBgBrush}" CornerRadius="5" Padding="7,2.5" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SoundMode}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentAmberBrush}" />
                            </Border>
                            <Border Background="{StaticResource ControlBgBrush}" CornerRadius="5" Padding="7,2.5" Margin="0,0,6,0"
                                    Visibility="{Binding HasSleepTimer, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SleepTimerDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}" />
                            </Border>
                            <Border Background="{StaticResource AccentCrimsonBgBrush}" BorderBrush="{StaticResource AccentCrimsonBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,0"
                                    Visibility="{Binding IsYouTubeActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="YOUTUBE CAST" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCrimsonTextBrush}" />
                            </Border>
                            <Button Content="Watch Video"
                                    Command="{Binding OpenCinemaForCurrentTrackCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,2.5"
                                    FontSize="10.5"
                                    Margin="0,0,6,0"
                                    ToolTip="Open synchronized YouTube Cinema Companion window"
                                    Visibility="{Binding IsYouTubeActive, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{Binding MeterModeButtonLabel}"
                                    Command="{Binding CycleMeterDisplayModeCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,2.5"
                                    FontSize="10"
                                    Margin="0,0,5,0"
                                    ToolTip="Cycle studio meter mode: Analog VU → 31-Band RTA Spectrum → Both" />
                            <Button Content="{Binding LyricsToggleLabel}"
                                    Command="{Binding ToggleLiveLyricsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,2.5"
                                    FontSize="10"
                                    Margin="0,0,5,0"
                                    ToolTip="Show synced live lyrics (LRCLIB) for the currently playing track" />
                            <Button Content="{Binding VuToggleLabel}"
                                    Command="{Binding ToggleVuMetersCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,2.5"
                                    FontSize="10"
                                    ToolTip="Show or hide audio meters" />
                        </StackPanel>

                        <TextBlock Text="{Binding NowPlayingTitle}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding NowPlayingDetail}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Circular Transport Deck -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousTrackCommand}"
                                Style="{StaticResource TransportCircleButton}"
                                ToolTip="Previous Track"
                                Margin="0,0,8,0">
                            <Path Data="M6,6H8V18H6M9.5,12L18,18V6"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Command="{Binding PlayPauseCommand}"
                                Style="{StaticResource HeroPlayCircleButton}"
                                ToolTip="Play / Pause (Space)"
                                Margin="0,0,8,0">
                            <Grid>
                                <!-- Play Icon -->
                                <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                      Fill="{StaticResource AccentCyanInkBrush}"
                                      Width="20"
                                      Height="20"
                                      Margin="3,0,0,0"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsTransportPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <!-- Pause Icon -->
                                <Path Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                                      Fill="{StaticResource AccentCyanInkBrush}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsTransportPlaying, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding StopCommand}"
                                Style="{StaticResource TransportCircleButton}"
                                ToolTip="Stop Playback"
                                Margin="0,0,8,0">
                            <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{StaticResource TextPrimaryBrush}" />
                        </Button>

                        <Button Command="{Binding NextTrackCommand}"
                                Style="{StaticResource TransportCircleButton}"
                                ToolTip="Next Track">
                            <Path Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Toggleable Large Retro Hi-Fi Analog VU Meters -->
                <controls:AnalogVuMeterControl x:Name="HeroVuMeter"
                                               Margin="0,14,0,0"
                                               Height="138"
                                               LeftLevel="{Binding VuLeftLevel}"
                                               RightLevel="{Binding VuRightLevel}"
                                               IsLiveSignal="{Binding IsVuLiveSignal}"
                                               Visibility="{Binding ShowAnalogVu, Converter={StaticResource BoolToVis}}" />

                <!-- Toggleable 31-Band Live OLED FFT Spectrum Analyzer (RTA) -->
                <controls:SpectrumAnalyzerControl x:Name="HeroSpectrumAnalyzer"
                                                  Margin="0,12,0,0"
                                                  Height="138"
                                                  Visibility="{Binding ShowRtaSpectrum, Converter={StaticResource BoolToVis}}" />

                <!-- Toggleable Synced Live Lyrics Bar (LRCLIB) -->
                <Border Background="{StaticResource SidebarBgBrush}"
                        BorderBrush="{StaticResource Ink11Brush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8"
                        Margin="0,10,0,0"
                        Visibility="{Binding ShowLiveLyrics, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Ink08Brush}" BorderBrush="{StaticResource AccentBlueSubtleBgBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding LyricsStatusBadge}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentLyricLine}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NextLyricLine}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding NextLyricLine, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                </StackPanel>
            </Border>

            <!-- MIDDLE CONTROL GRID: INPUTS/MODES + MASTER VOLUME -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.82*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: INPUT SELECTOR + SOUND MODES & UTILITIES -->
                <StackPanel Grid.Column="0">
                    <!-- Input Source Matrix -->
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="INPUT SOURCE" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InputSourceDisplay}"
                                           HorizontalAlignment="Right"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentCyanBrightBrush}" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding InputSources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}"
                                                Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                Command="{Binding DataContext.SelectInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,8"
                                                MinWidth="84" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Sound Modes + Sleep / ECO / Zone 2 -->
                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="SOUND MODE &amp; DSP" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SoundMode}"
                                           HorizontalAlignment="Right"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentAmberBrush}" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding SoundModes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}"
                                                Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                Command="{Binding DataContext.SelectSoundModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="11,6"
                                                FontSize="11.5"
                                                Margin="0,0,7,7" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Background="{StaticResource BorderHairlineBrush}" Margin="0,10,0,12" />

                            <!-- Utility Strip: Sleep Timer, ECO Mode, Zone 2 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SLEEP TIMER" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,7" />
                                    <ItemsControl ItemsSource="{Binding SleepTimerOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}"
                                                        Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                        Command="{Binding DataContext.SetSleepTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="9,5"
                                                        FontSize="11"
                                                        Margin="0,0,6,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="ECO / ZONE 2" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="ECO Auto"
                                                Command="{Binding SetEcoModeCommand}"
                                                CommandParameter="AUTO"
                                                Padding="9,5"
                                                FontSize="11"
                                                Margin="0,0,6,0"
                                                Style="{StaticResource ChipButton}"
                                                infra:Chip.IsActive="{Binding EcoMode, Converter={StaticResource EqualityConverter}, ConverterParameter=AUTO}" />
                                        <Button Content="ECO On"
                                                Command="{Binding SetEcoModeCommand}"
                                                CommandParameter="ON"
                                                Padding="9,5"
                                                FontSize="11"
                                                Margin="0,0,6,0"
                                                Style="{StaticResource ChipButton}"
                                                infra:Chip.IsActive="{Binding EcoMode, Converter={StaticResource EqualityConverter}, ConverterParameter=ON}" />
                                        <Button Content="ECO Off"
                                                Command="{Binding SetEcoModeCommand}"
                                                CommandParameter="OFF"
                                                Padding="9,5"
                                                FontSize="11"
                                                Margin="0,0,6,0"
                                                Style="{StaticResource ChipButton}"
                                                infra:Chip.IsActive="{Binding EcoMode, Converter={StaticResource EqualityConverter}, ConverterParameter=OFF}" />
                                        <Button Command="{Binding ToggleZone2Command}"
                                                Padding="10,5"
                                                FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource HardwareChipButton}">
                                                    <Setter Property="Content" Value="Zone 2: Off" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsZone2On}" Value="True">
                                                            <Setter Property="Content" Value="Zone 2: ON" />
                                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: PRECISION MASTER VOLUME DECK -->
                <Border Grid.Column="2"
                        Style="{StaticResource SurfaceCard}"
                        PreviewMouseWheel="VolumeCard_PreviewMouseWheel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="MASTER VOLUME" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Scroll wheel enabled"
                                       ToolTip="Scroll your mouse wheel anywhere over this volume card to adjust volume ±2 steps"
                                       HorizontalAlignment="Right"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </DockPanel>

                        <!-- Clickable OLED Readout (click to swap dB vs Absolute) -->
                        <Button Grid.Row="1"
                                Command="{Binding ToggleVolumeDisplayModeCommand}"
                                Cursor="Hand"
                                ToolTip="Click to switch primary display between dB and 0-98 scale"
                                Margin="0,0,0,14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{StaticResource OledBgBrush}"
                                            BorderBrush="{StaticResource Ink08Brush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding PrimaryVolumeText}"
                                                       FontSize="38"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Style="{StaticResource OledMonoText}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="{StaticResource AccentCyanColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SecondaryVolumeText}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Precision Live Volume Slider -->
                        <Slider Grid.Row="2"
                                Style="{StaticResource VolumeSliderStyle}"
                                Minimum="0"
                                Maximum="{Binding MaxVolume}"
                                Value="{Binding TargetVolume, Mode=TwoWay}"
                                Thumb.DragStarted="VolumeSlider_DragStarted"
                                Thumb.DragCompleted="VolumeSlider_DragCompleted"
                                Margin="0,0,0,14" />

                        <!-- Fine / Coarse Steps + Mute -->
                        <Grid Grid.Row="3" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="-5" Command="{Binding VolumeDownCommand}" Style="{StaticResource SecondaryButton}" Padding="0,9" />
                            <Button Grid.Column="2" Content="-1" Command="{Binding VolumeFineDownCommand}" Style="{StaticResource SecondaryButton}" Padding="0,9" />
                            <Button Grid.Column="4" Command="{Binding ToggleMuteCommand}" Content="{Binding MuteButtonText}" Padding="0,9" ToolTip="Toggle Mute (M)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentCrimsonBgStrongBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentCrimsonBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentCrimsonTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="6" Content="+1" Command="{Binding VolumeFineUpCommand}" Style="{StaticResource SecondaryButton}" Padding="0,9" />
                            <Button Grid.Column="8" Content="+5" Command="{Binding VolumeUpCommand}" Style="{StaticResource SecondaryButton}" Padding="0,9" />
                        </Grid>

                        <!-- One-Tap Volume Presets -->
                        <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                            <TextBlock Text="QUICK LEVELS" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding VolumePresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                Command="{Binding DataContext.SetVolumePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0"
                                                Padding="6,8">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="{Binding LevelLabel}" FontSize="12" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- QUICK-PLAY PRESET STATIONS SHELF (Internally Scrollable) -->
            <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" MinHeight="155">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="QUICK SCENES &amp; STATIONS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="  •  One-click AVR macros &amp; HEOS radio" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Scenes &amp; EQ →"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Acoustics"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11.5"
                                    Margin="0,0,6,0" />
                            <Button Content="YouTube →"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="YouTube"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11.5"
                                    Margin="0,0,6,0" />
                            <Button Content="Stations →"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Stations"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11.5" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel>
                            <!-- One-Click Scenes Strip -->
                            <ItemsControl ItemsSource="{Binding ScenePresets}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ActivateSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource HardwareChipButton}"
                                                ToolTip="{Binding Description}"
                                                Padding="10,6"
                                                Margin="0,0,7,7">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding AccentBrush}" CornerRadius="4" Padding="5,1.5" Margin="0,0,7,0">
                                                    <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Black" Foreground="{StaticResource TextOnAccentBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding StationPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="206"
                                            CornerRadius="11"
                                            Padding="10"
                                            Margin="0,0,9,9"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource CardElevatedBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Ink11Brush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgDeepBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        CornerRadius="8"
                                                        Background="{Binding BadgeBrush}"
                                                        Margin="0,0,9,0">
                                                    <TextBlock Text="{Binding Monogram}"
                                                               FontSize="12"
                                                               FontWeight="Black"
                                                               Foreground="{StaticResource TextOnAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <TextBlock Text="ON AIR"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentEmeraldBrush}"
                                                                   Margin="0,0,5,0"
                                                                   Visibility="{Binding IsCurrentlyPlaying, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Alias}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Content="▶  Play"
                                                        Command="{Binding DataContext.PlayPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="8,5"
                                                        FontSize="11" />
                                                <Button Grid.Column="2"
                                                        Content="Low Vol"
                                                        Command="{Binding DataContext.PlayPresetLowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="9,5"
                                                        FontSize="11"
                                                        ToolTip="Play at safety low volume" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
    </Grid>
</UserControl>
