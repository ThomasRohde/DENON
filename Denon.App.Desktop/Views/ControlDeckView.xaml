<!-- Control Deck page: now-playing hero, meters, inputs, sound modes, volume and quick presets. -->
<UserControl x:Class="Denon.App.Desktop.Views.ControlDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{skin:Size 16}" />
            <ColumnDefinition Width="{skin:Size 344}" />
        </Grid.ColumnDefinitions>

        <!-- LISTENING STAGE: what plays, the meters, one-click scenes -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Zero-Clutter Live Room Brain Insight Strip (only visible when Room Doctor spots an actionable fix!) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardElevatedBrush}"
                    BorderBrush="{DynamicResource AccentAmberBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius04}"
                    Padding="{skin:Space 12,8}"
                    Margin="{skin:Space 0,0,0,10}"
                    Visibility="{Binding ShowControlDeckInsights, Converter={StaticResource BoolToVis}}">
                <Grid DataContext="{Binding PrimaryRoomInsight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource AccentAmberSubtleBgBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}" Margin="{skin:Space 0,0,10,0}" VerticalAlignment="Center">
                        <TextBlock Text="ROOM BRAIN" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentAmberTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize06}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Explanation}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 10,0,0,0}">
                        <Button Content="{Binding FixLabel}"
                                Command="{Binding DataContext.ExecuteRoomInsightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="{skin:Space 10,4.5}"
                                FontSize="{DynamicResource FontSize04}"
                                Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Undo"
                                Command="{Binding DataContext.RestorePreviousRoomStateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 9,4.5}"
                                FontSize="{DynamicResource FontSize04}"
                                Margin="{skin:Space 0,0,6,0}"
                                Visibility="{Binding DataContext.CanUndoRoomState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        <Button Content="✕"
                                Command="{Binding DataContext.DismissRoomInsightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 7,4.5}"
                                FontSize="{DynamicResource FontSize03}"
                                ToolTip="Dismiss insight" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HERO OLED NOW PLAYING DECK -->
            <Border Grid.Row="1" Style="{StaticResource HeroOledCard}" Padding="{skin:Space 16,14}" Margin="{skin:Space 0,0,0,14}">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Artwork / Hi-Fi Vinyl Emblem -->
                    <Border Grid.Column="0"
                            Width="{skin:Size 88}"
                            Height="{skin:Size 88}"
                            CornerRadius="{DynamicResource Radius06}"
                            Background="{DynamicResource SidebarBgBrush}"
                            BorderBrush="{DynamicResource Ink12Brush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Margin="{skin:Space 0,0,20,0}">
                        <Grid>
                            <!-- Default Hi-Fi Disc Emblem -->
                            <Grid Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Ellipse Width="{skin:Size 60}" Height="{skin:Size 60}" Stroke="{DynamicResource AccentBlueBorderSoftBrush}" StrokeThickness="2" Fill="{DynamicResource Ink05Brush}" />
                                <Ellipse Width="{skin:Size 38}" Height="{skin:Size 38}" Stroke="{DynamicResource AccentCyanBorderBrush}" StrokeThickness="1.2" />
                                <Ellipse Width="{skin:Size 16}" Height="{skin:Size 16}" Fill="{DynamicResource AccentCyanBrush}" Opacity="0.85" />
                                <Ellipse Width="{skin:Size 5}" Height="{skin:Size 5}" Fill="{DynamicResource OledBgBrush}" />
                            </Grid>

                            <!-- Live Album/Station Artwork -->
                            <Image Source="{Binding NowPlayingImageUrl, Converter={StaticResource SafeImageSource}}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- OLED Track Metadata & Live Equalizer -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{skin:Space 0,0,16,0}">
                        <!-- Wraps on a narrow window, so no chip hides under the transport buttons. -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Animated 5-bar Audio Visualizer when actively playing -->
                            <!-- Started and stopped by MainWindow.UpdateAnimations: it runs only while it shows on screen. -->
                            <StackPanel x:Name="EqBars"
                                        Orientation="Horizontal"
                                        Height="{skin:Size 16}"
                                        Margin="{skin:Space 0,0,10,0}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsActiveAndPlaying, Converter={StaticResource BoolToVis}}">
                                <StackPanel.Resources>
                                    <Storyboard x:Key="EqBarsStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Eq1" Storyboard.TargetProperty="Height" From="4" To="15" Duration="0:0:0.42" />
                                        <DoubleAnimation Storyboard.TargetName="Eq2" Storyboard.TargetProperty="Height" From="13" To="5" Duration="0:0:0.35" />
                                        <DoubleAnimation Storyboard.TargetName="Eq3" Storyboard.TargetProperty="Height" From="6" To="16" Duration="0:0:0.51" />
                                        <DoubleAnimation Storyboard.TargetName="Eq4" Storyboard.TargetProperty="Height" From="14" To="4" Duration="0:0:0.38" />
                                        <DoubleAnimation Storyboard.TargetName="Eq5" Storyboard.TargetProperty="Height" From="5" To="12" Duration="0:0:0.46" />
                                    </Storyboard>
                                </StackPanel.Resources>
                                <Border x:Name="Eq1" Style="{StaticResource EqBarStyle}" Height="{skin:Size 6}" />
                                <Border x:Name="Eq2" Style="{StaticResource EqBarStyle}" Height="{skin:Size 12}" />
                                <Border x:Name="Eq3" Style="{StaticResource EqBarStyle}" Height="{skin:Size 8}" />
                                <Border x:Name="Eq4" Style="{StaticResource EqBarStyle}" Height="{skin:Size 14}" />
                                <Border x:Name="Eq5" Style="{StaticResource EqBarStyle}" Height="{skin:Size 6}" />
                            </StackPanel>

                            <Border Background="{DynamicResource AccentCyanSubtleBgDeepBrush}" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2.5}" Margin="{skin:Space 0,0,6,0}">
                                <TextBlock Text="{Binding InputSourceDisplay}" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                            </Border>
                            <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2.5}" Margin="{skin:Space 0,0,6,0}">
                                <TextBlock Text="{Binding PlayState}" FontSize="{DynamicResource FontSize03}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2.5}" Margin="{skin:Space 0,0,6,0}">
                                <TextBlock Text="{Binding SoundMode}" FontSize="{DynamicResource FontSize03}" FontWeight="SemiBold" Foreground="{DynamicResource AccentAmberBrush}" />
                            </Border>
                            <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2.5}" Margin="{skin:Space 0,0,6,0}"
                                    Visibility="{Binding HasSleepTimer, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SleepTimerDisplay}" FontSize="{DynamicResource FontSize03}" FontWeight="SemiBold" Foreground="{DynamicResource AccentVioletBrush}" />
                            </Border>
                            <Border Background="{DynamicResource AccentCrimsonBgBrush}" BorderBrush="{DynamicResource AccentCrimsonBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}" Margin="{skin:Space 0,0,6,0}"
                                    Visibility="{Binding IsYouTubeActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="YOUTUBE CAST" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentCrimsonTextBrush}" />
                            </Border>
                            <Button Content="Watch Video"
                                    Command="{Binding OpenCinemaForCurrentTrackCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 8,2.5}"
                                    FontSize="{DynamicResource FontSize03}"
                                    Margin="{skin:Space 0,0,6,0}"
                                    ToolTip="Open synchronized YouTube Cinema Companion window"
                                    Visibility="{Binding IsYouTubeActive, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{Binding MeterModeButtonLabel}"
                                    Command="{Binding CycleMeterDisplayModeCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 8,2.5}"
                                    FontSize="{DynamicResource FontSize02}"
                                    Margin="{skin:Space 0,0,5,0}"
                                    ToolTip="Cycle studio meter mode: Analog VU → 31-Band RTA Spectrum → Both" />
                            <Button Content="{Binding LyricsToggleLabel}"
                                    Command="{Binding ToggleLiveLyricsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 8,2.5}"
                                    FontSize="{DynamicResource FontSize02}"
                                    Margin="{skin:Space 0,0,5,0}"
                                    ToolTip="Show synced live lyrics (LRCLIB) for the currently playing track" />
                            <Button Content="{Binding VuToggleLabel}"
                                    Command="{Binding ToggleVuMetersCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 8,2.5}"
                                    FontSize="{DynamicResource FontSize02}"
                                    ToolTip="Show or hide audio meters" />
                        </WrapPanel>

                        <TextBlock Text="{Binding NowPlayingTitle}"
                                   FontSize="{DynamicResource FontSize13}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="{skin:Space 0,8,0,0}" />
                        <TextBlock Text="{Binding NowPlayingDetail}"
                                   FontSize="{DynamicResource FontSize08}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="{skin:Space 0,4,0,0}" />
                    </StackPanel>

                    <!-- Circular Transport Deck -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousTrackCommand}"
                                Style="{StaticResource TransportCircleButton}"
                                ToolTip="Previous Track"
                                Margin="{skin:Space 0,0,8,0}">
                            <Path Data="{DynamicResource IconPrevious}"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Width="{skin:Size 14}"
                                  Height="{skin:Size 14}"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Command="{Binding PlayPauseCommand}"
                                Style="{StaticResource HeroPlayCircleButton}"
                                ToolTip="{Binding PlayPauseToolTip}"
                                ToolTipService.ShowOnDisabled="True"
                                Margin="{skin:Space 0,0,8,0}">
                            <Grid>
                                <!-- Play Icon -->
                                <Path Data="{DynamicResource IconPlay}"
                                      Fill="{DynamicResource AccentCyanInkBrush}"
                                      Width="{skin:Size 20}"
                                      Height="{skin:Size 20}"
                                      Margin="{skin:Space 3,0,0,0}"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsTransportPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <!-- Pause Icon -->
                                <Path Data="{DynamicResource IconPause}"
                                      Fill="{DynamicResource AccentCyanInkBrush}"
                                      Width="{skin:Size 18}"
                                      Height="{skin:Size 18}"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsTransportPlaying, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding StopCommand}"
                                Style="{StaticResource TransportCircleButton}"
                                ToolTip="Stop Playback"
                                Margin="{skin:Space 0,0,8,0}">
                            <Rectangle Width="{skin:Size 11}" Height="{skin:Size 11}" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextPrimaryBrush}" />
                        </Button>

                        <Button Command="{Binding NextTrackCommand}"
                                Style="{StaticResource TransportCircleButton}"
                                ToolTip="Next Track">
                            <Path Data="{DynamicResource IconNext}"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Width="{skin:Size 14}"
                                  Height="{skin:Size 14}"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Toggleable Large Retro Hi-Fi Analog VU Meters -->
                <controls:AnalogVuMeterControl x:Name="HeroVuMeter"
                                               Margin="{skin:Space 0,14,0,0}"
                                               Height="{skin:Size 138}"
                                               LeftLevel="{Binding VuLeftLevel}"
                                               RightLevel="{Binding VuRightLevel}"
                                               IsLiveSignal="{Binding IsVuLiveSignal}"
                                               Visibility="{Binding ShowAnalogVu, Converter={StaticResource BoolToVis}}" />

                <!-- Toggleable 31-Band Live OLED FFT Spectrum Analyzer (RTA) -->
                <controls:SpectrumAnalyzerControl x:Name="HeroSpectrumAnalyzer"
                                                  Margin="{skin:Space 0,12,0,0}"
                                                  Height="{skin:Size 138}"
                                                  Visibility="{Binding ShowRtaSpectrum, Converter={StaticResource BoolToVis}}" />

                <!-- Toggleable Synced Live Lyrics Bar (LRCLIB) -->
                <Border Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource Ink11Brush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius04}"
                        Padding="{skin:Space 12,8}"
                        Margin="{skin:Space 0,10,0,0}"
                        Visibility="{Binding ShowLiveLyrics, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Ink08Brush}" BorderBrush="{DynamicResource AccentBlueSubtleBgBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}" VerticalAlignment="Center" Margin="{skin:Space 10,0,0,0}">
                            <TextBlock Text="{Binding LyricsStatusBadge}" FontSize="{DynamicResource FontSize00}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrightBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentLyricLine}"
                                       FontSize="{DynamicResource FontSize08}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NextLyricLine}"
                                       FontSize="{DynamicResource FontSize04}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="{skin:Space 0,2,0,0}"
                                       Visibility="{Binding NextLyricLine, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                </StackPanel>
            </Border>

            <!-- QUICK-PLAY PRESET STATIONS SHELF (Internally Scrollable) -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" MinHeight="{skin:Size 155}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,10}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="{skin:Space 8,0,0,0}">
                            <Button Content="Scenes &amp; EQ →"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Acoustics"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize05}"
                                    Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="YouTube →"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="YouTube"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize05}"
                                    Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Stations →"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Stations"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize05}" />
                        </StackPanel>
                        <!-- The buttons dock first, so on a narrow window the subtitle shortens instead of running under them. -->
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Left" Text="QUICK SCENES &amp; STATIONS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="  •  One-click AVR macros &amp; HEOS radio" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="{skin:Space 0,0,6,0}">
                        <StackPanel>
                            <!-- One-Click Scenes Strip -->
                            <ItemsControl ItemsSource="{Binding ScenePresets}" Margin="{skin:Space 0,0,0,10}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ActivateSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource HardwareChipButton}"
                                                Padding="{skin:Space 10,6}"
                                                Margin="{skin:Space 0,0,7,7}">
                                            <Button.ToolTip>
                                                <StackPanel MaxWidth="{skin:Size 320}">
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SummaryLine, StringFormat='One click runs this scene now: {0}'}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="{skin:Space 0,6,0,0}" />
                                                </StackPanel>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding AccentBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius01}" Padding="{skin:Space 5,1.5}" Margin="{skin:Space 0,0,7,0}">
                                                    <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSize01}" FontWeight="Black" Foreground="{Binding BadgeForegroundBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize06}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding StationPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{skin:Size 206}"
                                            CornerRadius="{DynamicResource Radius04}"
                                            Padding="{skin:Space 10}"
                                            Margin="{skin:Space 0,0,9,9}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardElevatedBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Ink11Brush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgDeepBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="{skin:Space 0,0,0,8}" Background="Transparent"
                                                  ToolTip="Play starts this station on the receiver (HEOS). Low Vol starts it at the safety low volume.">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="{skin:Size 32}"
                                                        Height="{skin:Size 32}"
                                                        CornerRadius="{DynamicResource Radius03}"
                                                        Background="{Binding BadgeBrush}"
                                                        Margin="{skin:Space 0,0,9,0}">
                                                    <TextBlock Text="{Binding Monogram}"
                                                               FontSize="{DynamicResource FontSize06}"
                                                               FontWeight="Black"
                                                               Foreground="{Binding BadgeForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="{DynamicResource FontSize07}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="{skin:Space 0,1,0,0}">
                                                        <TextBlock Text="ON AIR"
                                                                   FontSize="{DynamicResource FontSize00}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentEmeraldBrush}"
                                                                   Margin="{skin:Space 0,0,5,0}"
                                                                   Visibility="{Binding IsCurrentlyPlaying, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Alias}"
                                                                   FontSize="{DynamicResource FontSize02}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{skin:Size 6}" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Content="▶  Play"
                                                        Command="{Binding DataContext.PlayPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="{skin:Space 8,5}"
                                                        FontSize="{DynamicResource FontSize04}" />
                                                <Button Grid.Column="2"
                                                        Content="Low Vol"
                                                        Command="{Binding DataContext.PlayPresetLowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="{skin:Space 9,5}"
                                                        FontSize="{DynamicResource FontSize04}"
                                                        ToolTip="Play at safety low volume" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- CONTROL RAIL: everything that changes the receiver -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Volume -->
                <Border Margin="{skin:Space 0,0,0,12}"
                        Style="{StaticResource SurfaceCard}"
                        PreviewMouseWheel="VolumeCard_PreviewMouseWheel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,10}">
                            <TextBlock Text="MASTER VOLUME" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Scroll wheel enabled"
                                       ToolTip="Scroll your mouse wheel anywhere over this volume card to adjust volume ±2 steps"
                                       HorizontalAlignment="Right"
                                       FontSize="{DynamicResource FontSize03}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </DockPanel>

                        <!-- Clickable OLED Readout (click to swap dB vs Absolute) -->
                        <Button Grid.Row="1"
                                Command="{Binding ToggleVolumeDisplayModeCommand}"
                                Cursor="Hand"
                                ToolTip="Click to switch primary display between dB and 0-98 scale"
                                Margin="{skin:Space 0,0,0,14}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource OledBgBrush}"
                                            BorderBrush="{DynamicResource Ink08Brush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius05}"
                                            Padding="{skin:Space 16,14}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding PrimaryVolumeText}"
                                                       FontSize="{DynamicResource FontSize14}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Style="{StaticResource OledMonoText}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="{DynamicResource AccentCyanColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SecondaryVolumeText}"
                                                       FontSize="{DynamicResource FontSize06}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       HorizontalAlignment="Center"
                                                       Margin="{skin:Space 0,2,0,0}" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Precision Live Volume Slider -->
                        <Slider Grid.Row="2"
                                Style="{StaticResource VolumeSliderStyle}"
                                Minimum="0"
                                Maximum="{Binding MaxVolume}"
                                Value="{Binding TargetVolume, Mode=TwoWay}"
                                Thumb.DragStarted="VolumeSlider_DragStarted"
                                Thumb.DragCompleted="VolumeSlider_DragCompleted"
                                Margin="{skin:Space 0,0,0,14}" />

                        <!-- Fine / Coarse Steps + Mute -->
                        <Grid Grid.Row="3" Margin="{skin:Space 0,0,0,16}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{skin:Size 6}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{skin:Size 6}" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="{skin:Size 6}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{skin:Size 6}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="-5" Command="{Binding VolumeDownCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 0,9}" />
                            <Button Grid.Column="2" Content="-1" Command="{Binding VolumeFineDownCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 0,9}" />
                            <Button Grid.Column="4" Command="{Binding ToggleMuteCommand}" Content="{Binding MuteButtonText}" Padding="{skin:Space 0,9}" ToolTip="Toggle Mute (M)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentCrimsonBgStrongBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentCrimsonBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentCrimsonTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="6" Content="+1" Command="{Binding VolumeFineUpCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 0,9}" />
                            <Button Grid.Column="8" Content="+5" Command="{Binding VolumeUpCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 0,9}" />
                        </Grid>

                        <!-- One-Tap Volume Presets -->
                        <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                            <TextBlock Text="QUICK LEVELS" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,8}" />
                            <ItemsControl ItemsSource="{Binding VolumePresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                Command="{Binding DataContext.SetVolumePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="{skin:Space 0,0,6,0}"
                                                Padding="{skin:Space 6,8}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize04}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="{Binding LevelLabel}" FontSize="{DynamicResource FontSize06}" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Center" Margin="{skin:Space 0,2,0,0}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Source -->
                <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,12}">
                    <StackPanel>
                        <DockPanel Margin="{skin:Space 0,0,0,12}">
                            <TextBlock Text="INPUT SOURCE" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding InputSourceDisplay}"
                                       HorizontalAlignment="Right"
                                       FontSize="{DynamicResource FontSize05}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentCyanBrightBrush}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding InputSources}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}"
                                            Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                            Command="{Binding DataContext.SelectInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="{skin:Space 0,0,8,8}"
                                            MinWidth="{skin:Size 84}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Sound mode -->
                <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,12}">
                    <StackPanel>
                        <DockPanel Margin="{skin:Space 0,0,0,12}">
                            <TextBlock Text="SOUND MODE &amp; DSP" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SoundMode}"
                                       HorizontalAlignment="Right"
                                       FontSize="{DynamicResource FontSize05}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentAmberBrush}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding SoundModes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}"
                                            Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                            Command="{Binding DataContext.SelectSoundModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="{skin:Space 11,6}"
                                            FontSize="{DynamicResource FontSize05}"
                                            Margin="{skin:Space 0,0,7,7}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- Power &amp; zones: sleep timer, ECO, Zone 2 -->
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="POWER &amp; ZONES" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,12}" />
                        <StackPanel>

                            <StackPanel Margin="{skin:Space 0,0,0,14}">
                                <TextBlock Text="SLEEP TIMER" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,7}" />
                                <ItemsControl ItemsSource="{Binding SleepTimerOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}"
                                                    Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                    Command="{Binding DataContext.SetSleepTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="{skin:Space 9,5}"
                                                    FontSize="{DynamicResource FontSize04}"
                                                    Margin="{skin:Space 0,0,6,0}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="ECO &amp; ZONE 2" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,7}" />
                                <WrapPanel>
                                    <Button Content="ECO Auto"
                                            Command="{Binding SetEcoModeCommand}"
                                            CommandParameter="AUTO"
                                            Padding="{skin:Space 9,5}"
                                            FontSize="{DynamicResource FontSize04}"
                                            Margin="{skin:Space 0,0,6,0}"
                                            Style="{StaticResource ChipButton}"
                                            infra:Chip.IsActive="{Binding EcoMode, Converter={StaticResource EqualityConverter}, ConverterParameter=AUTO}" />
                                    <Button Content="ECO On"
                                            Command="{Binding SetEcoModeCommand}"
                                            CommandParameter="ON"
                                            Padding="{skin:Space 9,5}"
                                            FontSize="{DynamicResource FontSize04}"
                                            Margin="{skin:Space 0,0,6,0}"
                                            Style="{StaticResource ChipButton}"
                                            infra:Chip.IsActive="{Binding EcoMode, Converter={StaticResource EqualityConverter}, ConverterParameter=ON}" />
                                    <Button Content="ECO Off"
                                            Command="{Binding SetEcoModeCommand}"
                                            CommandParameter="OFF"
                                            Padding="{skin:Space 9,5}"
                                            FontSize="{DynamicResource FontSize04}"
                                            Margin="{skin:Space 0,0,6,0}"
                                            Style="{StaticResource ChipButton}"
                                            infra:Chip.IsActive="{Binding EcoMode, Converter={StaticResource EqualityConverter}, ConverterParameter=OFF}" />
                                    <Button Command="{Binding ToggleZone2Command}"
                                            Padding="{skin:Space 10,5}"
                                            FontSize="{DynamicResource FontSize04}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource HardwareChipButton}">
                                                <Setter Property="Content" Value="Zone 2: Off" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsZone2On}" Value="True">
                                                        <Setter Property="Content" Value="Zone 2: ON" />
                                                        <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
