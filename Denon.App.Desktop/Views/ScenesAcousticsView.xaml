<!-- Scenes &amp; Acoustics page: Smart Scenes, acoustic tuning and automation rules. -->
<UserControl x:Class="Denon.App.Desktop.Views.ScenesAcousticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sub-Tab Bar: Smart Scenes & Acoustics vs Automation Rules -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Padding="{skin:Space 12,8}" Margin="{skin:Space 0,0,0,12}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Smart Scenes &amp; Acoustics"
                            Command="{Binding SetAcousticsSubTabCommand}"
                            CommandParameter="Scenes"
                            Padding="{skin:Space 12,6}"
                            FontSize="{DynamicResource FontSize06}"
                            Margin="{skin:Space 0,0,8,0}"
                            Style="{StaticResource ChipButton}"
                            infra:Chip.IsActive="{Binding AcousticsSubTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Scenes}" />

                    <Button Command="{Binding SetAcousticsSubTabCommand}"
                            CommandParameter="Automations"
                            Padding="{skin:Space 12,6}"
                            FontSize="{DynamicResource FontSize06}"
                            Style="{StaticResource ChipButton}"
                            infra:Chip.IsActive="{Binding AcousticsSubTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Automations}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Automation Rules" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Ink08Brush}" BorderBrush="{DynamicResource AccentBlueSubtleBgBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 6,1}" Margin="{skin:Space 8,0,0,0}" VerticalAlignment="Center"
                                    ToolTip="Rules switched on, of all rules">
                                <TextBlock Text="{Binding EnabledAutomationsBadge}" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentEmeraldBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="Chain plugin actions onto Smart Scenes, and run them on app launches, schedules, room events or webhooks"
                           FontSize="{DynamicResource FontSize04}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Sub-View 1: Smart Scenes & Live Acoustic Tuning -->
        <Grid Grid.Row="1" Visibility="{Binding AcousticsSubTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Scenes}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{skin:Size 14}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- Top Split: Smart Scenes Deck (Left) + Scene Macro Editor (Right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="{skin:Size 14}" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!-- Smart Scenes Cards -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,12}">
                        <TextBlock Text="SMART SCENES &amp; MACROS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Capture Live"
                                    Command="{Binding CaptureCurrentStateToSceneCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 9,5}"
                                    FontSize="{DynamicResource FontSize04}"
                                    Margin="{skin:Space 0,0,6,0}"
                                    ToolTip="Save current receiver input, sound mode, volume &amp; acoustics as a new scene" />
                            <Button Content="+ New"
                                    Command="{Binding AddSceneCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 9,5}"
                                    FontSize="{DynamicResource FontSize04}"
                                    Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Save Scenes"
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize04}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{skin:Space 0,0,6,0}">
                        <ItemsControl ItemsSource="{Binding ScenePresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardElevatedBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 12,10}" Margin="{skin:Space 0,0,0,9}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="{skin:Size 44}"
                                                    Height="{skin:Size 44}"
                                                    CornerRadius="{DynamicResource Radius04}"
                                                    Background="{Binding AccentBrush}"
                                                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                                                    BorderThickness="1"
                                                    Margin="{skin:Space 0,0,12,0}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSize04}" FontWeight="Black" Foreground="{Binding BadgeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{skin:Space 0,0,10,0}">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize08}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="{skin:Space 0,2,0,3}" />
                                                <TextBlock Text="{Binding SummaryLine}" FontSize="{DynamicResource FontSize03}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentCyanBrightBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶ Activate"
                                                        Command="{Binding DataContext.ActivateSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="{skin:Space 11,7}"
                                                        FontSize="{DynamicResource FontSize05}"
                                                        Margin="{skin:Space 0,0,6,0}" />
                                                <Button Content="Edit"
                                                        Command="{Binding DataContext.SelectSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="{skin:Space 9,7}"
                                                        FontSize="{DynamicResource FontSize04}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Scene Editor Panel -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <Grid DataContext="{Binding SelectedScene}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,10}">
                        <TextBlock Text="SCENE EDITOR" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Duplicate"
                                    Command="{Binding DataContext.DuplicateSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="{skin:Space 8,4}"
                                    FontSize="{DynamicResource FontSize03}"
                                    Margin="{skin:Space 0,0,5,0}" />
                            <Button Content="Delete"
                                    Command="{Binding DataContext.RemoveSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="{skin:Space 8,4}"
                                    FontSize="{DynamicResource FontSize03}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{skin:Space 0,0,6,0}">
                        <StackPanel>
                            <Grid Margin="{skin:Space 0,0,0,8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Name" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Badge" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding Badge, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Accent Hex" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" FontFamily="{DynamicResource MonoFont}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Description" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" Margin="{skin:Space 0,0,0,8}" />

                            <Grid Margin="{skin:Space 0,0,0,8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Input (TV/NET/BD)" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding InputSource, UpdateSourceTrigger=PropertyChanged}" Tag="Leave blank" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sound Mode" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding SoundMode, UpdateSourceTrigger=PropertyChanged}" Tag="MOVIE / STEREO" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Target Vol (0-98)" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding TargetVolumeText, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 42" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="{skin:Space 0,0,0,8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DynVol (OFF/LIT/HEV)" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding DynamicVolume, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dimmer (BRI/DIM/OFF)" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding Dimmer, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="DynEQ (ON/OFF)" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding DynamicEqChoice, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="{skin:Space 0,0,0,8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{skin:Size 8}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sub Trim (-12..12)" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding SubwooferTrimText, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dialog (-12..12)" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding DialogTrimText, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Sleep (min)" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding SleepTimerText, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Optional Auto-Play Stream URL" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                            <TextBox Text="{Binding StreamUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Optional http:// stream URL..." Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize05}" FontFamily="{DynamicResource MonoFont}" Margin="{skin:Space 0,0,0,6}" />

                            <CheckBox Content="Smooth gentle volume ramp" IsChecked="{Binding SmoothVolumeRamp}" Style="{StaticResource ToggleSwitchStyle}" />
                            <CheckBox Content="Power on AVR" IsChecked="{Binding PowerOn}" Style="{StaticResource ToggleSwitchStyle}" />
                            <CheckBox Content="Auto-unmute AVR" IsChecked="{Binding Unmute}" Style="{StaticResource ToggleSwitchStyle}" />

                            <!-- Smart Scenes 2.0: Plugin Action Chain -->
                            <Border Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 10}" Margin="{skin:Space 0,10,0,0}">
                                <StackPanel>
                                    <TextBlock Text="PLUGIN ACTION CHAIN" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,6}" />
                                    <Grid Margin="{skin:Space 0,0,0,8}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{skin:Size 6}" />
                                            <ColumnDefinition Width="{skin:Size 62}" />
                                            <ColumnDefinition Width="{skin:Size 6}" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding DataContext.AvailablePluginActions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.SelectedScenePluginAction, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="FullLabel"
                                                  FontSize="{DynamicResource FontSize05}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding DataContext.SceneActionDelayMsText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="{skin:Space 6,5}"
                                                 FontSize="{DynamicResource FontSize04}"
                                                 ToolTip="Optional delay in ms before running this plugin step" />
                                        <Button Grid.Column="4"
                                                Content="+ Step"
                                                Command="{Binding DataContext.AddPluginActionToSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="{skin:Space 9,5}"
                                                FontSize="{DynamicResource FontSize04}" />
                                    </Grid>

                                    <!-- Declared action parameters for the selected action before adding (+ Step) -->
                                    <Border Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource Ink11Brush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius03}"
                                            Padding="{skin:Space 8,6}"
                                            Margin="{skin:Space 0,0,0,8}"
                                            Visibility="{Binding DataContext.HasPendingSceneActionParameters, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="ACTION PARAMETERS" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,5}" />
                                            <ItemsControl ItemsSource="{Binding DataContext.PendingSceneActionParameters, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="{skin:Space 0,0,0,6}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 0,0,0,2}">
                                                                <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" VerticalAlignment="Center" />
                                                                <Border Background="{DynamicResource AccentAmberSubtleBgBrush}"
                                                                        BorderBrush="{DynamicResource AccentAmberBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Radius01}"
                                                                        Padding="{skin:Space 5,0.5}"
                                                                        Margin="{skin:Space 6,0,0,0}"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding Required, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="REQUIRED" FontSize="{DynamicResource FontSize00}" FontWeight="Bold" Foreground="{DynamicResource AccentAmberTextBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="{DynamicResource FontSize02}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="{skin:Space 0,0,0,3}"
                                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                     Tag="{Binding PlaceholderText}"
                                                                     FontFamily="{DynamicResource MonoFont}"
                                                                     Padding="{skin:Space 7,4}"
                                                                     FontSize="{DynamicResource FontSize04}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding PluginActions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardElevatedBrush}" BorderBrush="{DynamicResource Ink12Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 8,6}" Margin="{skin:Space 0,0,0,6}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="✕"
                                                                    Command="{Binding DataContext.RemovePluginActionFromSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource DangerButton}"
                                                                    Padding="{skin:Space 6,2}"
                                                                    FontSize="{DynamicResource FontSize02}" />
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="⚡ " Foreground="{DynamicResource AccentAmberBrush}" FontSize="{DynamicResource FontSize04}" />
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSize05}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding DelayMs, StringFormat=' (+{0}ms)'}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <!-- Editable parameters persisted on this scene step -->
                                                        <ItemsControl ItemsSource="{Binding Parameters}"
                                                                      Margin="{skin:Space 0,6,0,0}"
                                                                      Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="{skin:Space 0,0,0,5}">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 0,0,0,2}">
                                                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize02}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                            <Border CornerRadius="{DynamicResource Radius01}"
                                                                                    BorderThickness="1"
                                                                                    Padding="{skin:Space 5,0.5}"
                                                                                    Margin="{skin:Space 6,0,0,0}"
                                                                                    VerticalAlignment="Center"
                                                                                    Visibility="{Binding Required, Converter={StaticResource BoolToVis}}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBorderBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsMissingRequired}" Value="True">
                                                                                                <Setter Property="Background" Value="{DynamicResource AccentCrimsonBgBrush}" />
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentCrimsonBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="REQUIRED" FontSize="{DynamicResource FontSize00}" FontWeight="Bold">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsMissingRequired}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentCrimsonTextBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Description}"
                                                                                   FontSize="{DynamicResource FontSize01}"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="{skin:Space 0,0,0,2}"
                                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Tag="{Binding PlaceholderText}"
                                                                                 FontFamily="{DynamicResource MonoFont}"
                                                                                 Padding="{skin:Space 7,4}"
                                                                                 FontSize="{DynamicResource FontSize04}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom: Live Acoustic Tuning Console (Telnet :23) -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}">
            <StackPanel>
                <DockPanel Margin="{skin:Space 0,0,0,12}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LIVE ACOUSTIC TUNING &amp; AUDYSSEY" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AcousticsStatusText, StringFormat='  •  {0}'}"
                                   FontSize="{DynamicResource FontSize05}"
                                   Foreground="{DynamicResource AccentCyanBrightBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Reset Trims (0 dB)"
                                Command="{Binding ResetAcousticTrimsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 10,5}"
                                FontSize="{DynamicResource FontSize04}"
                                Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Sync from AVR"
                                Command="{Binding RefreshAcousticsCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="{skin:Space 11,5}"
                                FontSize="{DynamicResource FontSize04}" />
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="{skin:Size 16}" />
                        <ColumnDefinition Width="0.88*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Acoustic Column: Audyssey, Restorer & Dimmer -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="{skin:Space 0,0,0,10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AUDYSSEY MULTEQ" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,6}" />
                                <ItemsControl ItemsSource="{Binding MultEqModes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                    Command="{Binding DataContext.SetMultEqCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="{skin:Space 10,5}"
                                                    FontSize="{DynamicResource FontSize04}"
                                                    Margin="{skin:Space 0,0,6,0}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="{skin:Space 10,0,0,0}">
                                <TextBlock Text="DYNAMIC EQ" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,6}" />
                                <Button Content="{Binding DynamicEqLabel}"
                                        Command="{Binding ToggleDynamicEqCommand}"
                                        Padding="{skin:Space 11,5}"
                                        FontSize="{DynamicResource FontSize04}"
                                        Style="{StaticResource SuccessChipButton}"
                                        infra:Chip.IsActive="{Binding DynamicEqEnabled}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="{skin:Space 0,0,0,10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{skin:Size 12}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DYNAMIC VOLUME (NIGHT COMPRESSION)" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,6}" />
                                <ItemsControl ItemsSource="{Binding DynamicVolumeModes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                    Command="{Binding DataContext.SetDynamicVolumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="{skin:Space 9,5}"
                                                    FontSize="{DynamicResource FontSize04}"
                                                    Margin="{skin:Space 0,0,5,5}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="AUDIO RESTORER (STREAMS)" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,6}" />
                                <ItemsControl ItemsSource="{Binding RestorerModes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                    Command="{Binding DataContext.SetRestorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="{skin:Space 9,5}"
                                                    FontSize="{DynamicResource FontSize04}"
                                                    Margin="{skin:Space 0,0,5,5}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="FRONT PANEL DISPLAY DIMMER" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,6}" />
                            <ItemsControl ItemsSource="{Binding DimmerModes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}"
                                                Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                Command="{Binding DataContext.SetDimmerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="{skin:Space 11,5}"
                                                FontSize="{DynamicResource FontSize04}"
                                                Margin="{skin:Space 0,0,6,0}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Acoustic Column: Sub Trim, Dialog Enhancer & Bass/Treble -->
                    <StackPanel Grid.Column="2">
                        <!-- Subwoofer Level Adjust -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource ControlHoverBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 11,8}" Margin="{skin:Space 0,0,0,8}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Button Content="{Binding SubwooferTrimToggleLabel}"
                                            Command="{Binding ToggleSubwooferTrimCommand}"
                                            Style="{StaticResource HardwareChipButton}"
                                            HorizontalAlignment="Left"
                                            Padding="{skin:Space 8,3}"
                                            FontSize="{DynamicResource FontSize03}" />
                                    <TextBlock Text="{Binding SubwooferTrimDisplay}" Style="{StaticResource OledMonoText}" FontSize="{DynamicResource FontSize11}" FontWeight="Bold" Margin="{skin:Space 2,3,0,0}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="-3" Command="{Binding StepSubwooferTrimCommand}" CommandParameter="-3" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                    <Button Content="-1" Command="{Binding StepSubwooferTrimCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                    <Button Content="+1" Command="{Binding StepSubwooferTrimCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                    <Button Content="+3" Command="{Binding StepSubwooferTrimCommand}" CommandParameter="3" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize04}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Dialog Level Adjust -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource ControlHoverBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 11,8}" Margin="{skin:Space 0,0,0,8}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Button Content="{Binding DialogTrimToggleLabel}"
                                            Command="{Binding ToggleDialogTrimCommand}"
                                            Style="{StaticResource HardwareChipButton}"
                                            HorizontalAlignment="Left"
                                            Padding="{skin:Space 8,3}"
                                            FontSize="{DynamicResource FontSize03}" />
                                    <TextBlock Text="{Binding DialogTrimDisplay}" Style="{StaticResource OledMonoText}" FontSize="{DynamicResource FontSize11}" FontWeight="Bold" Margin="{skin:Space 2,3,0,0}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="-3" Command="{Binding StepDialogTrimCommand}" CommandParameter="-3" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                    <Button Content="-1" Command="{Binding StepDialogTrimCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                    <Button Content="+1" Command="{Binding StepDialogTrimCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,4,0}" />
                                    <Button Content="+3" Command="{Binding StepDialogTrimCommand}" CommandParameter="3" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,6}" FontSize="{DynamicResource FontSize04}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tone Control (Bass & Treble) -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource ControlHoverBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 11,8}">
                            <StackPanel>
                                <DockPanel Margin="{skin:Space 0,0,0,6}">
                                    <Button Content="{Binding ToneControlToggleLabel}"
                                            Command="{Binding ToggleToneControlCommand}"
                                            Style="{StaticResource HardwareChipButton}"
                                            Padding="{skin:Space 8,3}"
                                            FontSize="{DynamicResource FontSize03}" />
                                    <TextBlock Text="Note: disabled when Dynamic EQ is ON"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSize02}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{skin:Size 10}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0">
                                        <TextBlock Text="{Binding BassDisplay, StringFormat='Bass {0}'}" FontSize="{DynamicResource FontSize05}" FontWeight="SemiBold" Foreground="{DynamicResource AccentAmberBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="-1" Command="{Binding StepBassCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 8,4}" FontSize="{DynamicResource FontSize03}" Margin="{skin:Space 0,0,3,0}" />
                                            <Button Content="+1" Command="{Binding StepBassCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 8,4}" FontSize="{DynamicResource FontSize03}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Grid.Column="2">
                                        <TextBlock Text="{Binding TrebleDisplay, StringFormat='Treble {0}'}" FontSize="{DynamicResource FontSize05}" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrightBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="-1" Command="{Binding StepTrebleCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 8,4}" FontSize="{DynamicResource FontSize03}" Margin="{skin:Space 0,0,3,0}" />
                                            <Button Content="+1" Command="{Binding StepTrebleCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 8,4}" FontSize="{DynamicResource FontSize03}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        </Grid>

        <!-- Sub-View 2: Smart Automation Rules (App Launch Watchers & Schedules) -->
        <Grid Grid.Row="1" Visibility="{Binding AcousticsSubTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Automations}">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{skin:Size 12}" />
                <RowDefinition Height="{skin:Size 130}" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="{skin:Size 14}" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Automation Rules List -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="{skin:Space 0,0,0,12}">
                            <DockPanel Margin="{skin:Space 0,0,0,8}">
                                <Button DockPanel.Dock="Right" Content="Save Automations" Command="{Binding SaveAutomationsCommand}" Style="{StaticResource PrimaryButton}" Padding="{skin:Space 11,5}" FontSize="{DynamicResource FontSize04}" />
                                <TextBlock Text="AUTOMATION TRIGGERS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="+ App Trigger" Command="{Binding AddAppLaunchRuleCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,5}" ToolTip="Run when a program starts on this PC" />
                                <Button Content="+ Schedule" Command="{Binding AddScheduleRuleCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,5}" ToolTip="Run at a time of day" />
                                <Button Content="+ Room Event" Command="{Binding AddRoomEventRuleCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,5}" ToolTip="Run when something happens in the room, e.g. the receiver turns on or a cast starts" />
                                <Button Content="+ Webhook" Command="{Binding AddWebhookRuleCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,5}" ToolTip="Run when an iPhone Shortcut or another device calls a URL" />
                            </WrapPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AutomationRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardElevatedBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius05}" Padding="{skin:Space 12}" Margin="{skin:Space 0,0,0,8}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsEnabled}" Style="{StaticResource ToggleSwitchStyle}" Margin="{skin:Space 0,0,8,0}" ToolTip="Enable or pause this automation rule (click Save Automations to persist)" />
                                                    <Button Content="Test"
                                                            Command="{Binding DataContext.TestAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="{skin:Space 9,4}"
                                                            FontSize="{DynamicResource FontSize03}"
                                                            Margin="{skin:Space 0,0,5,0}" />
                                                    <Button Content="Edit"
                                                            Command="{Binding DataContext.SelectAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="{skin:Space 9,4}"
                                                            FontSize="{DynamicResource FontSize03}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="{skin:Space 0,0,0,3}">
                                                        <Border Background="{DynamicResource Ink11Brush}" BorderBrush="{DynamicResource Ink14Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 6,1.5}" Margin="{skin:Space 0,0,8,0}">
                                                            <TextBlock Text="{Binding TriggerBadge}" FontSize="{DynamicResource FontSize00}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrightBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize08}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SummaryLine}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: Selected Rule Editor -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                    <Grid DataContext="{Binding SelectedAutomationRule}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,10}">
                            <TextBlock Text="RULE EDITOR" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <Button Content="Delete Rule"
                                    Command="{Binding DataContext.RemoveAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="{skin:Space 8,4}"
                                    FontSize="{DynamicResource FontSize03}"
                                    HorizontalAlignment="Right" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{skin:Space 0,0,6,0}">
                            <StackPanel>
                                <TextBlock Text="Rule Name" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" Margin="{skin:Space 0,0,0,8}" />

                                <CheckBox Content="Rule enabled" IsChecked="{Binding IsEnabled}" Style="{StaticResource ToggleSwitchStyle}" Margin="{skin:Space 0,0,0,8}" />

                                <!-- AppLaunch Fields -->
                                <StackPanel Visibility="{Binding IsAppLaunchTrigger, Converter={StaticResource BoolToVis}}" Margin="{skin:Space 0,0,0,8}">
                                    <TextBlock Text="Watched Process Names (comma-separated, without .exe)" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding ProcessNames, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize05}" />
                                </StackPanel>

                                <!-- Room Event Fields -->
                                <StackPanel Visibility="{Binding IsRoomEventTrigger, Converter={StaticResource BoolToVis}}" Margin="{skin:Space 0,0,0,8}">
                                    <TextBlock Text="Event name (pick one or type it; cast.* matches every cast event)" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <ComboBox IsEditable="True"
                                              ItemsSource="{Binding DataContext.KnownRoomEventNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}"
                                              FontFamily="{DynamicResource MonoFont}"
                                              FontSize="{DynamicResource FontSize05}"
                                              Margin="{skin:Space 0,0,0,6}" />
                                    <TextBlock Text="Changes made by an automation never trigger a room event rule, so a rule cannot start itself."
                                               TextWrapping="Wrap" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,6}" />
                                    <Border Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 8}">
                                        <StackPanel>
                                            <DockPanel Margin="{skin:Space 0,0,0,4}">
                                                <Button DockPanel.Dock="Right" Content="Refresh"
                                                        Command="{Binding DataContext.RefreshRecentRoomEventsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Style="{StaticResource SecondaryButton}" Padding="{skin:Space 8,3}" FontSize="{DynamicResource FontSize03}" />
                                                <TextBlock Text="RECENT ROOM EVENTS (click one to use it)" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding DataContext.RecentRoomEvents, RelativeSource={RelativeSource AncestorType=Window}}" MaxHeight="{skin:Size 180}">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.UseRecentRoomEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                HorizontalContentAlignment="Left"
                                                                Padding="{skin:Space 6,3}"
                                                                Margin="{skin:Space 0,0,0,3}">
                                                            <TextBlock Text="{Binding Line}" ToolTip="{Binding Line}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Webhook Fields -->
                                <StackPanel Visibility="{Binding IsWebhookTrigger, Converter={StaticResource BoolToVis}}" Margin="{skin:Space 0,0,0,8}">
                                    <TextBlock Text="Hook name (letters, digits, '-' or '_')" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding WebhookName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBlock Text="{Binding WebhookNameError}" Foreground="{DynamicResource AccentAmberTextBrush}" FontSize="{DynamicResource FontSize03}" TextWrapping="Wrap" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="{skin:Space 0,0,0,6}">
                                        <Run Text="POST " /><Run Text="{Binding DataContext.WebhookBaseUrl, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" /><Run Text="{Binding WebhookName, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="{skin:Space 0,0,0,6}">
                                        <Button Content="Copy URL" Command="{Binding DataContext.CopyWebhookUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize03}" Margin="{skin:Space 0,0,5,0}" />
                                        <Button Content="Copy owner token" Command="{Binding DataContext.CopyWebhookTokenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize03}" />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="iPhone: Shortcuts → Automation → pick a trigger (join home Wi-Fi, a Focus, NFC tag) → Get Contents of URL → Method POST, header Authorization: Bearer &lt;owner token&gt;. A JSON body adds data you can filter on, e.g. {&quot;focus&quot;:&quot;Sleep&quot;} and focus=Sleep." />
                                </StackPanel>

                                <!-- Data filter (room events and webhooks) -->
                                <StackPanel Visibility="{Binding UsesDataFilter, Converter={StaticResource BoolToVis}}" Margin="{skin:Space 0,0,0,8}">
                                    <TextBlock Text="Only when (optional key=value terms, comma-separated; key!=value for 'not')" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding DataFilter, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBlock Visibility="{Binding IsRoomEventTrigger, Converter={StaticResource BoolToVis}}"
                                               Text="Examples: stream=avr, to=on   ·   device=lg-tv   ·   to=TV   ·   origin!=desktop_ui" TextWrapping="Wrap" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Visibility="{Binding IsWebhookTrigger, Converter={StaticResource BoolToVis}}"
                                               Text="Tests the fields of the JSON body, e.g. focus=Sleep or who!=guest. Leave empty to run on every call." TextWrapping="Wrap" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- Cooldown (all but schedules) -->
                                <StackPanel Visibility="{Binding UsesCooldown, Converter={StaticResource BoolToVis}}" Margin="{skin:Space 0,0,0,8}">
                                    <TextBlock Text="Cooldown (seconds between runs; room events wait at least 10)" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                    <TextBox Text="{Binding CooldownSecondsText, UpdateSourceTrigger=PropertyChanged}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize05}" Width="{skin:Size 100}" HorizontalAlignment="Left" />
                                </StackPanel>

                                <!-- TimeOfDay Schedule Fields -->
                                <Grid Visibility="{Binding IsTimeScheduleTrigger, Converter={StaticResource BoolToVis}}" Margin="{skin:Space 0,0,0,8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{skin:Size 10}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Local Time (24h HH:mm)" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                        <TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" Padding="{skin:Space 8,6}" FontSize="{DynamicResource FontSize06}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Days" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                        <ComboBox ItemsSource="{Binding DataContext.ScheduleDayOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DaysFilter}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Activate Smart Scene (optional Scene ID, e.g. movie-night, late-night)" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,3}" />
                                <ComboBox ItemsSource="{Binding DataContext.ScenePresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding TargetSceneId}"
                                          Margin="{skin:Space 0,0,0,10}" />

                                <Border Background="{DynamicResource Ink03Brush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 10}">
                                    <StackPanel>
                                        <TextBlock Text="EXTRA PLUGIN ACTIONS" Style="{StaticResource SectionLabelStyle}" Margin="{skin:Space 0,0,0,6}" />
                                        <Grid Margin="{skin:Space 0,0,0,8}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{skin:Size 6}" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding DataContext.AvailablePluginActions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding DataContext.SelectedRulePluginAction, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="FullLabel"
                                                      FontSize="{DynamicResource FontSize05}" />
                                            <Button Grid.Column="2"
                                                    Content="+ Add"
                                                    Command="{Binding DataContext.AddPluginActionToRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="{skin:Space 10,5}"
                                                    FontSize="{DynamicResource FontSize04}" />
                                        </Grid>
                                        <!-- Declared action parameters for the selected automation action -->
                                        <Border Background="{DynamicResource CardBgBrush}"
                                                BorderBrush="{DynamicResource Ink11Brush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius03}"
                                                Padding="{skin:Space 8,6}"
                                                Margin="{skin:Space 0,0,0,8}"
                                                Visibility="{Binding DataContext.HasPendingRuleActionParameters, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="ACTION PARAMETERS" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,5}" />
                                                <ItemsControl ItemsSource="{Binding DataContext.PendingRuleActionParameters, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="{skin:Space 0,0,0,6}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 0,0,0,2}">
                                                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" VerticalAlignment="Center" />
                                                                    <Border Background="{DynamicResource AccentAmberSubtleBgBrush}"
                                                                            BorderBrush="{DynamicResource AccentAmberBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="{DynamicResource Radius01}"
                                                                            Padding="{skin:Space 5,0.5}"
                                                                            Margin="{skin:Space 6,0,0,0}"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding Required, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="REQUIRED" FontSize="{DynamicResource FontSize00}" FontWeight="Bold" Foreground="{DynamicResource AccentAmberTextBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="{DynamicResource FontSize02}"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="{skin:Space 0,0,0,3}"
                                                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                         Tag="{Binding PlaceholderText}"
                                                                         FontFamily="{DynamicResource MonoFont}"
                                                                         Padding="{skin:Space 7,4}"
                                                                         FontSize="{DynamicResource FontSize04}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding PluginActions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardElevatedBrush}" BorderBrush="{DynamicResource Ink12Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 8,6}" Margin="{skin:Space 0,0,0,6}">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right"
                                                                        Content="✕"
                                                                        Command="{Binding DataContext.RemovePluginActionFromRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Padding="{skin:Space 6,2}"
                                                                        FontSize="{DynamicResource FontSize02}" />
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSize05}" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <ItemsControl ItemsSource="{Binding Parameters}"
                                                                          Margin="{skin:Space 0,6,0,0}"
                                                                          Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="{skin:Space 0,0,0,5}">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 0,0,0,2}">
                                                                                <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize02}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                                <Border CornerRadius="{DynamicResource Radius01}"
                                                                                        BorderThickness="1"
                                                                                        Padding="{skin:Space 5,0.5}"
                                                                                        Margin="{skin:Space 6,0,0,0}"
                                                                                        VerticalAlignment="Center"
                                                                                        Visibility="{Binding Required, Converter={StaticResource BoolToVis}}">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBorderBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsMissingRequired}" Value="True">
                                                                                                    <Setter Property="Background" Value="{DynamicResource AccentCrimsonBgBrush}" />
                                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentCrimsonBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <TextBlock Text="REQUIRED" FontSize="{DynamicResource FontSize00}" FontWeight="Bold">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsMissingRequired}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentCrimsonTextBrush}" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Description}"
                                                                                       FontSize="{DynamicResource FontSize01}"
                                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       Margin="{skin:Space 0,0,0,2}"
                                                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Tag="{Binding PlaceholderText}"
                                                                                     FontFamily="{DynamicResource MonoFont}"
                                                                                     Padding="{skin:Space 7,4}"
                                                                                     FontSize="{DynamicResource FontSize04}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom: Live Automation Activity Feed -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="{skin:Space 14,10}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,6}">
                        <TextBlock Text="AUTOMATION ACTIVITY LOG" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AutomationsStatusText}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource AccentCyanBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AutomationActivityLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="{skin:Space 0,0,0,3}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
