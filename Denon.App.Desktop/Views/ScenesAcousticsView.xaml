<!-- Scenes &amp; Acoustics page: Smart Scenes, acoustic tuning and automation rules. -->
<UserControl x:Class="Denon.App.Desktop.Views.ScenesAcousticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sub-Tab Bar: Smart Scenes & Acoustics vs Automation Rules -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Padding="12,8" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Smart Scenes &amp; Acoustics"
                            Command="{Binding SetAcousticsSubTabCommand}"
                            CommandParameter="Scenes"
                            Padding="12,6"
                            FontSize="{StaticResource FontSize06}"
                            Margin="0,0,8,0"
                            Style="{StaticResource ChipButton}"
                            infra:Chip.IsActive="{Binding AcousticsSubTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Scenes}" />

                    <Button Command="{Binding SetAcousticsSubTabCommand}"
                            CommandParameter="Automations"
                            Padding="12,6"
                            FontSize="{StaticResource FontSize06}"
                            Style="{StaticResource ChipButton}"
                            infra:Chip.IsActive="{Binding AcousticsSubTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Automations}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Automation Rules" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Ink08Brush}" BorderBrush="{StaticResource AccentBlueSubtleBgBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EnabledAutomationsBadge}" FontSize="{StaticResource FontSize01}" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="Chain Philips Hue &amp; plugin actions onto Smart Scenes, or auto-trigger on App Launch &amp; Night Guard schedules"
                           FontSize="{StaticResource FontSize04}"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Sub-View 1: Smart Scenes & Live Acoustic Tuning -->
        <Grid Grid.Row="1" Visibility="{Binding AcousticsSubTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Scenes}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- Top Split: Smart Scenes Deck (Left) + Scene Macro Editor (Right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!-- Smart Scenes Cards -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="SMART SCENES &amp; MACROS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Capture Live"
                                    Command="{Binding CaptureCurrentStateToSceneCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,5"
                                    FontSize="{StaticResource FontSize04}"
                                    Margin="0,0,6,0"
                                    ToolTip="Save current receiver input, sound mode, volume &amp; acoustics as a new scene" />
                            <Button Content="+ New"
                                    Command="{Binding AddSceneCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,5"
                                    FontSize="{StaticResource FontSize04}"
                                    Margin="0,0,6,0" />
                            <Button Content="Save Scenes"
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,5"
                                    FontSize="{StaticResource FontSize04}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding ScenePresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius04}" Padding="12,10" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="{StaticResource Radius04}"
                                                    Background="{Binding AccentBrush}"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="{StaticResource FontSize04}" FontWeight="Black" Foreground="{StaticResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize08}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,3" />
                                                <TextBlock Text="{Binding SummaryLine}" FontSize="{StaticResource FontSize03}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentCyanBrightBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶ Activate"
                                                        Command="{Binding DataContext.ActivateSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="11,7"
                                                        FontSize="{StaticResource FontSize05}"
                                                        Margin="0,0,6,0" />
                                                <Button Content="Edit"
                                                        Command="{Binding DataContext.SelectSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="9,7"
                                                        FontSize="{StaticResource FontSize04}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Scene Editor Panel -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <Grid DataContext="{Binding SelectedScene}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="SCENE EDITOR" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Duplicate"
                                    Command="{Binding DataContext.DuplicateSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4"
                                    FontSize="{StaticResource FontSize03}"
                                    Margin="0,0,5,0" />
                            <Button Content="Delete"
                                    Command="{Binding DataContext.RemoveSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="8,4"
                                    FontSize="{StaticResource FontSize03}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Name" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Badge" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Badge, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Accent Hex" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Description" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Input (TV/NET/BD)" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding InputSource, UpdateSourceTrigger=PropertyChanged}" Tag="Leave blank" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sound Mode" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding SoundMode, UpdateSourceTrigger=PropertyChanged}" Tag="MOVIE / STEREO" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Target Vol (0-98)" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding TargetVolumeText, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 42" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DynVol (OFF/LIT/HEV)" FontSize="{StaticResource FontSize03}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding DynamicVolume, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dimmer (BRI/DIM/OFF)" FontSize="{StaticResource FontSize03}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Dimmer, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="DynEQ (ON/OFF)" FontSize="{StaticResource FontSize03}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding DynamicEqChoice, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sub Trim (-12..12)" FontSize="{StaticResource FontSize03}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding SubwooferTrimText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dialog (-12..12)" FontSize="{StaticResource FontSize03}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding DialogTrimText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Sleep (min)" FontSize="{StaticResource FontSize03}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding SleepTimerText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Optional Auto-Play Stream URL" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding StreamUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Optional http:// stream URL..." Padding="8,6" FontSize="{StaticResource FontSize05}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,6" />

                            <CheckBox Content="Smooth gentle volume ramp" IsChecked="{Binding SmoothVolumeRamp}" Style="{StaticResource ToggleSwitchStyle}" />
                            <CheckBox Content="Power on AVR" IsChecked="{Binding PowerOn}" Style="{StaticResource ToggleSwitchStyle}" />
                            <CheckBox Content="Auto-unmute AVR" IsChecked="{Binding Unmute}" Style="{StaticResource ToggleSwitchStyle}" />

                            <!-- Smart Scenes 2.0: Plugin Action Chain -->
                            <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius04}" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="PLUGIN ACTION CHAIN" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding DataContext.AvailablePluginActions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.SelectedScenePluginAction, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="FullLabel"
                                                  FontSize="{StaticResource FontSize05}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding DataContext.SceneActionDelayMsText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,5"
                                                 FontSize="{StaticResource FontSize04}"
                                                 ToolTip="Optional delay in ms before running this plugin step" />
                                        <Button Grid.Column="4"
                                                Content="+ Step"
                                                Command="{Binding DataContext.AddPluginActionToSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="9,5"
                                                FontSize="{StaticResource FontSize04}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding PluginActions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource Ink12Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="8,5" Margin="0,0,0,5">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Content="✕"
                                                                Command="{Binding DataContext.RemovePluginActionFromSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource DangerButton}"
                                                                Padding="6,2"
                                                                FontSize="{StaticResource FontSize02}" />
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⚡ " Foreground="{StaticResource AccentAmberBrush}" FontSize="{StaticResource FontSize04}" />
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontSize05}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding DelayMs, StringFormat=' (+{0}ms)'}" FontSize="{StaticResource FontSize03}" Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom: Live Acoustic Tuning Console (Telnet :23) -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LIVE ACOUSTIC TUNING &amp; AUDYSSEY" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AcousticsStatusText, StringFormat='  •  {0}'}"
                                   FontSize="{StaticResource FontSize05}"
                                   Foreground="{StaticResource AccentCyanBrightBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Reset Trims (0 dB)"
                                Command="{Binding ResetAcousticTrimsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,5"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0" />
                        <Button Content="Sync from AVR"
                                Command="{Binding RefreshAcousticsCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="11,5"
                                FontSize="{StaticResource FontSize04}" />
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.88*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Acoustic Column: Audyssey, Restorer & Dimmer -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AUDYSSEY MULTEQ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding MultEqModes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                    Command="{Binding DataContext.SetMultEqCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,5"
                                                    FontSize="{StaticResource FontSize04}"
                                                    Margin="0,0,6,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="DYNAMIC EQ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                <Button Content="{Binding DynamicEqLabel}"
                                        Command="{Binding ToggleDynamicEqCommand}"
                                        Padding="11,5"
                                        FontSize="{StaticResource FontSize04}"
                                        Style="{StaticResource SuccessChipButton}"
                                        infra:Chip.IsActive="{Binding DynamicEqEnabled}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DYNAMIC VOLUME (NIGHT COMPRESSION)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding DynamicVolumeModes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                    Command="{Binding DataContext.SetDynamicVolumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="9,5"
                                                    FontSize="{StaticResource FontSize04}"
                                                    Margin="0,0,5,5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="AUDIO RESTORER (STREAMS)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding RestorerModes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                    Command="{Binding DataContext.SetRestorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="9,5"
                                                    FontSize="{StaticResource FontSize04}"
                                                    Margin="0,0,5,5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="FRONT PANEL DISPLAY DIMMER" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding DimmerModes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}"
                                                Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsActive}"
                                                Command="{Binding DataContext.SetDimmerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="11,5"
                                                FontSize="{StaticResource FontSize04}"
                                                Margin="0,0,6,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Acoustic Column: Sub Trim, Dialog Enhancer & Bass/Treble -->
                    <StackPanel Grid.Column="2">
                        <!-- Subwoofer Level Adjust -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource ControlHoverBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius04}" Padding="11,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Button Content="{Binding SubwooferTrimToggleLabel}"
                                            Command="{Binding ToggleSubwooferTrimCommand}"
                                            Style="{StaticResource HardwareChipButton}"
                                            HorizontalAlignment="Left"
                                            Padding="8,3"
                                            FontSize="{StaticResource FontSize03}" />
                                    <TextBlock Text="{Binding SubwooferTrimDisplay}" Style="{StaticResource OledMonoText}" FontSize="{StaticResource FontSize11}" FontWeight="Bold" Margin="2,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="-3" Command="{Binding StepSubwooferTrimCommand}" CommandParameter="-3" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" />
                                    <Button Content="-1" Command="{Binding StepSubwooferTrimCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" />
                                    <Button Content="+1" Command="{Binding StepSubwooferTrimCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" />
                                    <Button Content="+3" Command="{Binding StepSubwooferTrimCommand}" CommandParameter="3" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="{StaticResource FontSize04}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Dialog Level Adjust -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource ControlHoverBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius04}" Padding="11,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Button Content="{Binding DialogTrimToggleLabel}"
                                            Command="{Binding ToggleDialogTrimCommand}"
                                            Style="{StaticResource HardwareChipButton}"
                                            HorizontalAlignment="Left"
                                            Padding="8,3"
                                            FontSize="{StaticResource FontSize03}" />
                                    <TextBlock Text="{Binding DialogTrimDisplay}" Style="{StaticResource OledMonoText}" FontSize="{StaticResource FontSize11}" FontWeight="Bold" Margin="2,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="-3" Command="{Binding StepDialogTrimCommand}" CommandParameter="-3" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" />
                                    <Button Content="-1" Command="{Binding StepDialogTrimCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" />
                                    <Button Content="+1" Command="{Binding StepDialogTrimCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" />
                                    <Button Content="+3" Command="{Binding StepDialogTrimCommand}" CommandParameter="3" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="{StaticResource FontSize04}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tone Control (Bass & Treble) -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource ControlHoverBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius04}" Padding="11,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button Content="{Binding ToneControlToggleLabel}"
                                            Command="{Binding ToggleToneControlCommand}"
                                            Style="{StaticResource HardwareChipButton}"
                                            Padding="8,3"
                                            FontSize="{StaticResource FontSize03}" />
                                    <TextBlock Text="Note: disabled when Dynamic EQ is ON"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSize02}"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0">
                                        <TextBlock Text="{Binding BassDisplay, StringFormat='Bass {0}'}" FontSize="{StaticResource FontSize05}" FontWeight="SemiBold" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="-1" Command="{Binding StepBassCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSize03}" Margin="0,0,3,0" />
                                            <Button Content="+1" Command="{Binding StepBassCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSize03}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Grid.Column="2">
                                        <TextBlock Text="{Binding TrebleDisplay, StringFormat='Treble {0}'}" FontSize="{StaticResource FontSize05}" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrightBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="-1" Command="{Binding StepTrebleCommand}" CommandParameter="-1" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSize03}" Margin="0,0,3,0" />
                                            <Button Content="+1" Command="{Binding StepTrebleCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSize03}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        </Grid>

        <!-- Sub-View 2: Smart Automation Rules (App Launch Watchers & Schedules) -->
        <Grid Grid.Row="1" Visibility="{Binding AcousticsSubTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Automations}">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="130" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Automation Rules List -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="AUTOMATION TRIGGERS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ App Trigger" Command="{Binding AddAppLaunchRuleCommand}" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,5,0" />
                                <Button Content="+ Schedule" Command="{Binding AddScheduleRuleCommand}" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,5,0" />
                                <Button Content="Save Automations" Command="{Binding SaveAutomationsCommand}" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="{StaticResource FontSize04}" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AutomationRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius05}" Padding="12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsEnabled}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,8,0" ToolTip="Enable or pause this automation rule (click Save Automations to persist)" />
                                                    <Button Content="Test"
                                                            Command="{Binding DataContext.TestAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="9,4"
                                                            FontSize="{StaticResource FontSize03}"
                                                            Margin="0,0,5,0" />
                                                    <Button Content="Edit"
                                                            Command="{Binding DataContext.SelectAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="9,4"
                                                            FontSize="{StaticResource FontSize03}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <Border Background="{StaticResource Ink11Brush}" BorderBrush="{StaticResource Ink14Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="6,1.5" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding TriggerBadge}" FontSize="{StaticResource FontSize00}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize08}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SummaryLine}" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: Selected Rule Editor -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                    <Grid DataContext="{Binding SelectedAutomationRule}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="RULE EDITOR" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <Button Content="Delete Rule"
                                    Command="{Binding DataContext.RemoveAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="8,4"
                                    FontSize="{StaticResource FontSize03}"
                                    HorizontalAlignment="Right" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Rule Name" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize06}" Margin="0,0,0,8" />

                                <CheckBox Content="Rule enabled" IsChecked="{Binding IsEnabled}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,8" />

                                <!-- AppLaunch Fields -->
                                <StackPanel Visibility="{Binding IsAppLaunchTrigger, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="Watched Process Names (comma-separated, without .exe)" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding ProcessNames, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Padding="8,6" FontSize="{StaticResource FontSize05}" Margin="0,0,0,6" />
                                    <TextBlock Text="Cooldown (seconds)" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding CooldownSecondsText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="{StaticResource FontSize05}" Width="100" HorizontalAlignment="Left" />
                                </StackPanel>

                                <!-- TimeOfDay Schedule Fields -->
                                <Grid Visibility="{Binding IsTimeScheduleTrigger, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Local Time (24h HH:mm)" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Padding="8,6" FontSize="{StaticResource FontSize06}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Days" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding DataContext.ScheduleDayOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DaysFilter}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Activate Smart Scene (optional Scene ID, e.g. movie-night, late-night)" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding DataContext.ScenePresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding TargetSceneId}"
                                          Margin="0,0,0,10" />

                                <Border Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius04}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="EXTRA PLUGIN ACTIONS" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding DataContext.AvailablePluginActions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding DataContext.SelectedRulePluginAction, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="FullLabel"
                                                      FontSize="{StaticResource FontSize05}" />
                                            <Button Grid.Column="2"
                                                    Content="+ Add"
                                                    Command="{Binding DataContext.AddPluginActionToRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,5"
                                                    FontSize="{StaticResource FontSize04}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding PluginActions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource Ink12Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="8,5" Margin="0,0,0,5">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="✕"
                                                                    Command="{Binding DataContext.RemovePluginActionFromRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource DangerButton}"
                                                                    Padding="6,2"
                                                                    FontSize="{StaticResource FontSize02}" />
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontSize05}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom: Live Automation Activity Feed -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="AUTOMATION ACTIVITY LOG" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AutomationsStatusText}" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource AccentCyanBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AutomationActivityLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
