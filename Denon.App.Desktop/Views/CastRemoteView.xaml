<!-- Cast &amp; Remote page: phone remote, PC audio cast and the local jukebox. -->
<UserControl x:Class="Denon.App.Desktop.Views.CastRemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Split: Couch Phone Remote QR (Left) + Cast PC Audio WASAPI (Right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Couch Phone Remote & Party Jukebox -->
            <Border Grid.Column="0" Style="{StaticResource HeroOledCard}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="148"
                            Height="148"
                            CornerRadius="{StaticResource Radius05}"
                            Background="{StaticResource SidebarBgBrush}"
                            BorderBrush="{StaticResource AccentBlueBorderSoftBrush}"
                            BorderThickness="1"
                            Padding="8"
                            VerticalAlignment="Center">
                        <Image Source="{Binding RemoteQrImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{StaticResource AccentCyanSubtleBgBrush}" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="7,2" Margin="0,0,8,0">
                                <TextBlock Text="PHONE REMOTE" FontSize="{StaticResource FontSize01}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                            </Border>
                            <Border Background="{StaticResource AccentVioletSubtleBgBrush}" BorderBrush="{StaticResource AccentVioletBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="7,2">
                                <TextBlock Text="PARTY JUKEBOX" FontSize="{StaticResource FontSize01}" FontWeight="Bold" Foreground="{StaticResource AccentVioletTextBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding RemoteQrRoleCaption}" FontSize="{StaticResource FontSize09}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="Scan to pair securely. Owner gets full room controls; Guest can search &amp; queue YouTube tracks only."
                                   FontSize="{StaticResource FontSize05}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8" />

                        <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="9,6" Margin="0,0,0,8">
                            <TextBlock Text="{Binding RemoteWebUrl}"
                                       FontSize="{StaticResource FontSize05}"
                                       FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Owner QR" Command="{Binding SetRemoteQrRoleCommand}" CommandParameter="owner" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,6,4" />
                            <Button Content="Guest QR" Command="{Binding SetRemoteQrRoleCommand}" CommandParameter="guest" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,6,4" />
                            <Button Content="{Binding PhoneRemoteToggleLabel}" Command="{Binding TogglePhoneRemoteEnabledCommand}" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,6,4" />
                            <Button Content="Revoke &amp; Rotate" Command="{Binding RotateRemoteTokensCommand}" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,0,4" />
                        </WrapPanel>

                        <WrapPanel>
                            <Button Content="Copy Paired URL" Command="{Binding CopyRemoteUrlCommand}" Style="{StaticResource PrimaryButton}" Padding="10,6" FontSize="{StaticResource FontSize04}" Margin="0,0,6,0" />
                            <Button Content="Open Browser" Command="{Binding OpenRemoteInBrowserCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="{StaticResource FontSize04}" Margin="0,0,6,0" />
                            <Button Content="Allow Firewall" Command="{Binding AllowRelayFirewallCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="{StaticResource FontSize04}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Cast Any PC Audio (WASAPI Loopback -> Denon LAN) -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CAST PC AUDIO TO DENON" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource AccentEmeraldSubtleBgBrush}" BorderBrush="{StaticResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="6,1.5" Margin="8,0,0,0"
                                    Visibility="{Binding IsPcCastActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ON AIR" FontSize="{StaticResource FontSize00}" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Content="Refresh Devices"
                                HorizontalAlignment="Right"
                                Command="{Binding RefreshAudioDevicesCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4"
                                FontSize="{StaticResource FontSize03}" />
                    </DockPanel>

                    <TextBlock Text="Windows Audio Output Source (WASAPI Loopback)" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding AudioOutputDevices}"
                             SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                             MaxHeight="68"
                             Background="{StaticResource SidebarBgBrush}"
                             BorderBrush="{StaticResource Ink11Brush}"
                             BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" FontSize="{StaticResource FontSize05}" Padding="4,2" Foreground="{StaticResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="MP3 320 kbps"
                                    Command="{Binding SetPcCastFormatCommand}"
                                    CommandParameter="Mp3_320k"
                                    Padding="10,5"
                                    FontSize="{StaticResource FontSize04}"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource ChipButton}"
                                    infra:Chip.IsActive="{Binding SelectedPcCastFormatName, Converter={StaticResource EqualityConverter}, ConverterParameter=Mp3_320k}" />
                            <Button Content="PCM 16-bit WAV"
                                    Command="{Binding SetPcCastFormatCommand}"
                                    CommandParameter="Wav_Lossless"
                                    Padding="10,5"
                                    FontSize="{StaticResource FontSize04}"
                                    Style="{StaticResource ChipButton}"
                                    infra:Chip.IsActive="{Binding SelectedPcCastFormatName, Converter={StaticResource EqualityConverter}, ConverterParameter=Wav_Lossless}" />
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                Content="{Binding PcCastButtonText}"
                                Command="{Binding TogglePcCastCommand}"
                                Padding="14,7"
                                FontSize="{StaticResource FontSize06}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPcCastActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentCrimsonBgStrongBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentCrimsonBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentCrimsonTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>

                    <TextBlock Text="{Binding PcCastStatusText}"
                               FontSize="{StaticResource FontSize04}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom: Drag-and-Drop Local Hi-Res FLAC / WAV / MP3 Jukebox -->
        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCard}"
                AllowDrop="True"
                DragOver="LocalDropZone_DragOver"
                Drop="LocalDropZone_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL HI-RES / FLAC JUKEBOX" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocalTrackCountLabel, StringFormat='  •  {0}'}" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource Ink08Brush}" CornerRadius="{StaticResource Radius02}" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="DRAG &amp; DROP FILES OR FOLDERS HERE" FontSize="{StaticResource FontSize01}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrightBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ Add Files" Command="{Binding AddLocalFilesCommand}" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,5,0" />
                        <Button Content="+ Add Folder" Command="{Binding AddLocalFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,5,0" />
                        <Button Content="▶ Play All" Command="{Binding PlayAllLocalTracksCommand}" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="{StaticResource FontSize04}" Margin="0,0,5,0" />
                        <Button Content="Shuffle" Command="{Binding ToggleLocalShuffleCommand}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,5,0" Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsLocalShuffleEnabled}" />
                        <Button Content="{Binding LocalRepeatLabel}" Command="{Binding CycleLocalRepeatCommand}" Style="{StaticResource HardwareChipButton}" Padding="9,5" FontSize="{StaticResource FontSize04}" Margin="0,0,5,0" />
                        <Button Content="Clear" Command="{Binding ClearLocalTracksCommand}" Style="{StaticResource DangerButton}" Padding="8,5" FontSize="{StaticResource FontSize04}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding LocalJukeboxStatusText}"
                           FontSize="{StaticResource FontSize05}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <ItemsControl ItemsSource="{Binding LocalTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource Radius03}" Padding="10,7" Margin="0,0,0,6" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource CardElevatedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource ControlHoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgDeepBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding PositionLabel}" FontSize="{StaticResource FontSize05}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize07}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artist}" FontSize="{StaticResource FontSize04}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource Ink08Brush}" BorderBrush="{StaticResource AccentBlueSubtleBgBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding CodecBadge}" FontSize="{StaticResource FontSize02}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentAmberBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="{StaticResource FontSize04}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Play"
                                                    Command="{Binding DataContext.PlayLocalTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="10,5"
                                                    FontSize="{StaticResource FontSize04}"
                                                    Margin="0,0,5,0" />
                                            <Button Content="✕"
                                                    Command="{Binding DataContext.RemoveLocalTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="7,5"
                                                    FontSize="{StaticResource FontSize04}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
