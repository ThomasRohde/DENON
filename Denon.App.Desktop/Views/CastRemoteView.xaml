<!-- Cast &amp; Remote page: phone remote, PC audio cast and the local jukebox. -->
<UserControl x:Class="Denon.App.Desktop.Views.CastRemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{skin:Size 14}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Split: Couch Phone Remote QR (Left) + Cast PC Audio WASAPI (Right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{skin:Size 14}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Couch Phone Remote & Party Jukebox -->
            <Border Grid.Column="0" Style="{StaticResource HeroOledCard}" Padding="{skin:Space 16}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{skin:Size 16}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="{skin:Size 148}"
                            Height="{skin:Size 148}"
                            CornerRadius="{DynamicResource Radius05}"
                            Background="{DynamicResource SidebarBgBrush}"
                            BorderBrush="{DynamicResource AccentBlueBorderSoftBrush}"
                            BorderThickness="1"
                            Padding="{skin:Space 8}"
                            VerticalAlignment="Center">
                        <Image Source="{Binding RemoteQrImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="{skin:Space 0,0,0,6}">
                            <Border Background="{DynamicResource AccentCyanSubtleBgBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}" Margin="{skin:Space 0,0,8,0}">
                                <TextBlock Text="PHONE REMOTE" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                            </Border>
                            <Border Background="{DynamicResource AccentVioletSubtleBgBrush}" BorderBrush="{DynamicResource AccentVioletBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}">
                                <TextBlock Text="PARTY JUKEBOX" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentVioletTextBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding RemoteQrRoleCaption}" FontSize="{DynamicResource FontSize09}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="Scan to pair securely. Owner gets full room controls; Guest can search &amp; queue YouTube tracks only."
                                   FontSize="{DynamicResource FontSize05}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="{skin:Space 0,4,0,8}" />

                        <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 9,6}" Margin="{skin:Space 0,0,0,8}">
                            <TextBlock Text="{Binding RemoteWebUrl}"
                                       FontSize="{DynamicResource FontSize05}"
                                       FontWeight="Bold"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource AccentCyanBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <WrapPanel Margin="{skin:Space 0,0,0,6}">
                            <Button Content="Owner QR" Command="{Binding SetRemoteQrRoleCommand}" CommandParameter="owner" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="Guest QR" Command="{Binding SetRemoteQrRoleCommand}" CommandParameter="guest" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="{Binding PhoneRemoteToggleLabel}" Command="{Binding TogglePhoneRemoteEnabledCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="Revoke &amp; Rotate" Command="{Binding RotateRemoteTokensCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,0,4}" />
                        </WrapPanel>

                        <WrapPanel>
                            <Button Content="Copy Paired URL" Command="{Binding CopyRemoteUrlCommand}" Style="{StaticResource PrimaryButton}" Padding="{skin:Space 10,6}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Open Browser" Command="{Binding OpenRemoteInBrowserCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 10,6}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                            <Button Content="Allow Firewall" Command="{Binding AllowRelayFirewallCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 10,6}" FontSize="{DynamicResource FontSize04}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Cast Any PC Audio (WASAPI Loopback -> Denon LAN) -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <DockPanel Margin="{skin:Space 0,0,0,8}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CAST PC AUDIO TO DENON" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentEmeraldSubtleBgBrush}" BorderBrush="{DynamicResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 6,1.5}" Margin="{skin:Space 8,0,0,0}"
                                    Visibility="{Binding IsPcCastActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ON AIR" FontSize="{DynamicResource FontSize00}" FontWeight="Bold" Foreground="{DynamicResource AccentEmeraldBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Content="Refresh Devices"
                                HorizontalAlignment="Right"
                                Command="{Binding RefreshAudioDevicesCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 8,4}"
                                FontSize="{DynamicResource FontSize03}" />
                    </DockPanel>

                    <TextBlock Text="Windows Audio Output Source (WASAPI Loopback)" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,4}" />
                    <ListBox ItemsSource="{Binding AudioOutputDevices}"
                             SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                             MaxHeight="{skin:Size 68}"
                             Background="{DynamicResource SidebarBgBrush}"
                             BorderBrush="{DynamicResource Ink11Brush}"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Margin="{skin:Space 0,0,0,10}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" FontSize="{DynamicResource FontSize05}" Padding="{skin:Space 4,2}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Margin="{skin:Space 0,0,0,8}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="MP3 320 kbps"
                                    Command="{Binding SetPcCastFormatCommand}"
                                    CommandParameter="Mp3_320k"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize04}"
                                    Margin="{skin:Space 0,0,6,0}"
                                    Style="{StaticResource ChipButton}"
                                    infra:Chip.IsActive="{Binding SelectedPcCastFormatName, Converter={StaticResource EqualityConverter}, ConverterParameter=Mp3_320k}" />
                            <Button Content="PCM 16-bit WAV"
                                    Command="{Binding SetPcCastFormatCommand}"
                                    CommandParameter="Wav_Lossless"
                                    Padding="{skin:Space 10,5}"
                                    FontSize="{DynamicResource FontSize04}"
                                    Style="{StaticResource ChipButton}"
                                    infra:Chip.IsActive="{Binding SelectedPcCastFormatName, Converter={StaticResource EqualityConverter}, ConverterParameter=Wav_Lossless}" />
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                Content="{Binding PcCastButtonText}"
                                Command="{Binding TogglePcCastCommand}"
                                Padding="{skin:Space 14,7}"
                                FontSize="{DynamicResource FontSize06}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPcCastActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentCrimsonBgStrongBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentCrimsonBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentCrimsonTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>

                    <TextBlock Text="{Binding PcCastStatusText}"
                               FontSize="{DynamicResource FontSize04}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom: Drag-and-Drop Local Hi-Res FLAC / WAV / MP3 Jukebox -->
        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCard}"
                AllowDrop="True"
                DragOver="LocalDropZone_DragOver"
                Drop="LocalDropZone_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,8}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL HI-RES / FLAC JUKEBOX" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocalTrackCountLabel, StringFormat='  •  {0}'}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Ink08Brush}" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 6,2}" Margin="{skin:Space 10,0,0,0}">
                            <TextBlock Text="DRAG &amp; DROP FILES OR FOLDERS HERE" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrightBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ Add Files" Command="{Binding AddLocalFilesCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" />
                        <Button Content="+ Add Folder" Command="{Binding AddLocalFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" />
                        <Button Content="▶ Play All" Command="{Binding PlayAllLocalTracksCommand}" Style="{StaticResource PrimaryButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" />
                        <Button Content="Shuffle" Command="{Binding ToggleLocalShuffleCommand}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding IsLocalShuffleEnabled}" />
                        <Button Content="{Binding LocalRepeatLabel}" Command="{Binding CycleLocalRepeatCommand}" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,5}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" />
                        <Button Content="Clear" Command="{Binding ClearLocalTracksCommand}" Style="{StaticResource DangerButton}" Padding="{skin:Space 8,5}" FontSize="{DynamicResource FontSize04}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding LocalJukeboxStatusText}"
                           FontSize="{DynamicResource FontSize05}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="{skin:Space 0,0,0,10}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{skin:Space 0,0,6,0}">
                    <ItemsControl ItemsSource="{Binding LocalTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource Radius03}" Padding="{skin:Space 10,7}" Margin="{skin:Space 0,0,0,6}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardElevatedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentCyanSubtleBgDeepBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{skin:Size 28}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{skin:Size 12}" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding PositionLabel}" FontSize="{DynamicResource FontSize05}" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize07}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artist}" FontSize="{DynamicResource FontSize04}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Ink08Brush}" BorderBrush="{DynamicResource AccentBlueSubtleBgBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 6,2}" Margin="{skin:Space 0,0,8,0}">
                                                <TextBlock Text="{Binding CodecBadge}" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentAmberBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="{DynamicResource FontSize04}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Play"
                                                    Command="{Binding DataContext.PlayLocalTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="{skin:Space 10,5}"
                                                    FontSize="{DynamicResource FontSize04}"
                                                    Margin="{skin:Space 0,0,5,0}" />
                                            <Button Content="✕"
                                                    Command="{Binding DataContext.RemoveLocalTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="{skin:Space 7,5}"
                                                    FontSize="{DynamicResource FontSize04}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
