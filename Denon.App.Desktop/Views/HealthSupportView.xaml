<!-- Health &amp; Support page: guided health check, activity history and the power-user console. -->
<UserControl x:Class="Denon.App.Desktop.Views.HealthSupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.App.Desktop.Infrastructure.Theming"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Denon.App.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Guided Receiver Health Check & One-Click Fixes -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
            <StackPanel>
                <Grid Margin="{skin:Space 0,0,0,12}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="{skin:Space 0,0,16,0}">
                        <TextBlock Text="RECEIVER HEALTH CHECK" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{Binding HealthSummaryText}"
                                   Foreground="{Binding HealthSummaryBrush}"
                                   FontSize="{DynamicResource FontSize07}"
                                   FontWeight="SemiBold"
                                   Margin="{skin:Space 0,4,0,0}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Run Health Check"
                                Command="{Binding RunHealthCheckCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="{skin:Space 12,7}"
                                Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Fix Silent Audio"
                                Command="{Binding FixSilentAudioCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 11,7}"
                                ToolTip="Wakes receiver, switches to HEOS, unmutes both AVR and HEOS, and sets an audible volume"
                                Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Reset Links"
                                Command="{Binding ResetConnectionsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 11,7}"
                                ToolTip="Drops and reconnects fresh sessions to the receiver"
                                Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Copy Report"
                                Command="{Binding CopyDiagnosticReportCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="{skin:Space 11,7}"
                                ToolTip="Copies a plain-English health summary and recent activity to your clipboard" />
                    </WrapPanel>
                </Grid>

                <!-- 5 Plain-English Health Check Cards -->
                <ScrollViewer MaxHeight="{skin:Size 255}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="{skin:Space 0,0,4,0}">
                    <ItemsControl ItemsSource="{Binding DiagnosticChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardElevatedBrush}"
                                        BorderBrush="{DynamicResource ControlHoverBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius04}"
                                        Padding="{skin:Space 12,9}"
                                        Margin="{skin:Space 0,0,0,7}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="{skin:Size 28}"
                                                Height="{skin:Size 28}"
                                                CornerRadius="{DynamicResource Radius06}"
                                                Background="{Binding StatusBackgroundBrush}"
                                                BorderBrush="{Binding StatusBrush}"
                                                BorderThickness="1"
                                                Margin="{skin:Space 0,0,12,0}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusGlyph}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontSize="{DynamicResource FontSize08}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize08}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource FontSize06}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="{skin:Space 0,2,0,0}" />
                                            <TextBlock Text="{Binding Advice, StringFormat='Tip: {0}'}"
                                                       FontSize="{DynamicResource FontSize05}"
                                                       Foreground="{DynamicResource AccentAmberBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="{skin:Space 0,4,0,0}"
                                                       Visibility="{Binding Advice, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{Binding StatusBackgroundBrush}"
                                                BorderBrush="{Binding StatusBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius02}"
                                                Padding="{skin:Space 8,3}"
                                                VerticalAlignment="Top"
                                                Margin="{skin:Space 10,0,0,0}">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontSize="{DynamicResource FontSize02}"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Activity History (Internally Scrollable) -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,12}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="{skin:Space 0,0,0,10}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVITY HISTORY" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="{skin:Space 0,0,14,0}" />
                        <Button Content="All" Command="{Binding SetLogFilterCommand}" CommandParameter="All" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding LogFilterLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=All}" />
                        <Button Content="Info" Command="{Binding SetLogFilterCommand}" CommandParameter="Info" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding LogFilterLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=Info}" />
                        <Button Content="Warnings" Command="{Binding SetLogFilterCommand}" CommandParameter="Warning" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,5,0}" Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding LogFilterLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=Warning}" />
                        <Button Content="Errors" Command="{Binding SetLogFilterCommand}" CommandParameter="Error" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Style="{StaticResource ChipButton}" infra:Chip.IsActive="{Binding LogFilterLevel, Converter={StaticResource EqualityConverter}, ConverterParameter=Error}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Width="{skin:Size 170}"
                                 Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search activity..."
                                 Padding="{skin:Space 8,5}"
                                 FontSize="{DynamicResource FontSize06}"
                                 Margin="{skin:Space 0,0,8,0}" />
                        <Button Content="Copy" Command="{Binding CopyLogsCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Open Folder" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource DangerButton}" Padding="{skin:Space 10,5}" FontSize="{DynamicResource FontSize05}" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource OledBgBrush}"
                        BorderBrush="{DynamicResource Ink08Brush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius03}"
                        Padding="{skin:Space 8}">
                    <ListBox ItemsSource="{Binding FilteredLogEntries}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{skin:Size 145}" />
                                        <ColumnDefinition Width="{skin:Size 72}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="{DynamicResource FontSize05}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Level}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="{DynamicResource FontSize05}"
                                               FontWeight="Bold"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="{DynamicResource FontSize05}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>

        <!-- Collapsible Advanced Power-User Console -->
        <Expander Grid.Row="2" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ADVANCED TOOLS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="  •  Send raw AVR Telnet or HEOS commands manually (for power users)"
                               FontSize="{DynamicResource FontSize05}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <StackPanel>
                <DockPanel Margin="{skin:Space 0,4,0,10}">
                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Check Power" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="AVR:PW?" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Check Input" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="AVR:SI?" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Check Volume" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="AVR:MV?" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="Check Sound Mode" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="AVR:MS?" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" Margin="{skin:Space 0,0,6,0}" />
                        <Button Content="List HEOS Players" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="HEOS:heos://player/get_players" Style="{StaticResource HardwareChipButton}" Padding="{skin:Space 9,4}" FontSize="{DynamicResource FontSize04}" />
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="AVR (:23)"
                                Command="{Binding SetConsoleProtocolCommand}"
                                CommandParameter="AVR"
                                Margin="{skin:Space 0,0,6,0}"
                                Padding="{skin:Space 9,4}"
                                FontSize="{DynamicResource FontSize04}"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding ConsoleProtocol, Converter={StaticResource EqualityConverter}, ConverterParameter=AVR}" />
                        <Button Content="HEOS (:1255)"
                                Command="{Binding SetConsoleProtocolCommand}"
                                CommandParameter="HEOS"
                                Padding="{skin:Space 9,4}"
                                FontSize="{DynamicResource FontSize04}"
                                Style="{StaticResource ChipButton}"
                                infra:Chip.IsActive="{Binding ConsoleProtocol, Converter={StaticResource EqualityConverter}, ConverterParameter=HEOS}" />
                    </StackPanel>
                </DockPanel>

                <Grid Margin="{skin:Space 0,0,0,8}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{skin:Size 8}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ConsoleCommandInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{DynamicResource MonoFont}"
                             Padding="{skin:Space 9,6}"
                             KeyDown="ConsoleInput_KeyDown" />
                    <Button Grid.Column="2"
                            Content="Send"
                            Command="{Binding SendConsoleCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="{skin:Space 14,6}" />
                </Grid>

                <Border Background="{DynamicResource OledBgBrush}"
                        BorderBrush="{DynamicResource Ink08Brush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius03}"
                        Padding="{skin:Space 10}"
                        MaxHeight="{skin:Size 96}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource AccentCyanBrightBrush}"
                                 FontFamily="{DynamicResource MonoFont}"
                                 FontSize="{DynamicResource FontSize05}"
                                 TextWrapping="Wrap"
                                 Padding="0" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
