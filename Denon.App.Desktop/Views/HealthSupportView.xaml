<!-- Health &amp; Support page: guided health check, activity history and the power-user console. -->
<UserControl x:Class="Denon.App.Desktop.Views.HealthSupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Denon.App.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Guided Receiver Health Check & One-Click Fixes -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="RECEIVER HEALTH CHECK" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="{Binding HealthSummaryText}"
                                   Foreground="{Binding HealthSummaryBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Run Health Check"
                                Command="{Binding RunHealthCheckCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,7"
                                Margin="0,0,6,0" />
                        <Button Content="Fix Silent Audio"
                                Command="{Binding FixSilentAudioCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="11,7"
                                ToolTip="Wakes receiver, switches to HEOS, unmutes both AVR and HEOS, and sets an audible volume"
                                Margin="0,0,6,0" />
                        <Button Content="Reset Links"
                                Command="{Binding ResetConnectionsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="11,7"
                                ToolTip="Drops and reconnects fresh sessions to the receiver"
                                Margin="0,0,6,0" />
                        <Button Content="Copy Report"
                                Command="{Binding CopyDiagnosticReportCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="11,7"
                                ToolTip="Copies a plain-English health summary and recent activity to your clipboard" />
                    </WrapPanel>
                </Grid>

                <!-- 5 Plain-English Health Check Cards -->
                <ScrollViewer MaxHeight="255"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding DiagnosticChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardElevatedBrush}"
                                        BorderBrush="{StaticResource ControlHoverBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,9"
                                        Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{Binding StatusBackgroundBrush}"
                                                BorderBrush="{Binding StatusBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusGlyph}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Advice, StringFormat='Tip: {0}'}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource AccentAmberBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding Advice, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{Binding StatusBackgroundBrush}"
                                                BorderBrush="{Binding StatusBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                VerticalAlignment="Top"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Activity History (Internally Scrollable) -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVITY HISTORY" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="All" Command="{Binding SetLogFilterCommand}" CommandParameter="All" Padding="9,4" FontSize="11" Margin="0,0,5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HardwareChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogFilterLevel}" Value="All">
                                            <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Info" Command="{Binding SetLogFilterCommand}" CommandParameter="Info" Padding="9,4" FontSize="11" Margin="0,0,5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HardwareChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogFilterLevel}" Value="Info">
                                            <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Warnings" Command="{Binding SetLogFilterCommand}" CommandParameter="Warning" Padding="9,4" FontSize="11" Margin="0,0,5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HardwareChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogFilterLevel}" Value="Warning">
                                            <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Errors" Command="{Binding SetLogFilterCommand}" CommandParameter="Error" Padding="9,4" FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HardwareChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogFilterLevel}" Value="Error">
                                            <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Width="170"
                                 Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search activity..."
                                 Padding="8,5"
                                 FontSize="12"
                                 Margin="0,0,8,0" />
                        <Button Content="Copy" Command="{Binding CopyLogsCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" />
                        <Button Content="Open Folder" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" />
                        <Button Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource DangerButton}" Padding="10,5" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{StaticResource OledBgBrush}"
                        BorderBrush="{StaticResource Ink08Brush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <ListBox ItemsSource="{Binding FilteredLogEntries}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Level}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>

        <!-- Collapsible Advanced Power-User Console -->
        <Expander Grid.Row="2" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ADVANCED TOOLS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="  •  Send raw AVR Telnet or HEOS commands manually (for power users)"
                               FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <StackPanel>
                <DockPanel Margin="0,4,0,10">
                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Check Power" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="AVR:PW?" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="Check Input" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="AVR:SI?" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="Check Volume" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="AVR:MV?" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="Check Sound Mode" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="AVR:MS?" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="List HEOS Players" Command="{Binding RunQuickDiagnosticCommand}" CommandParameter="HEOS:heos://player/get_players" Style="{StaticResource HardwareChipButton}" Padding="9,4" FontSize="11" />
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="AVR (:23)"
                                Command="{Binding SetConsoleProtocolCommand}"
                                CommandParameter="AVR"
                                Margin="0,0,6,0"
                                Padding="9,4"
                                FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HardwareChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConsoleProtocol}" Value="AVR">
                                            <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="HEOS (:1255)"
                                Command="{Binding SetConsoleProtocolCommand}"
                                CommandParameter="HEOS"
                                Padding="9,4"
                                FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HardwareChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConsoleProtocol}" Value="HEOS">
                                            <Setter Property="Background" Value="{StaticResource AccentCyanSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ConsoleCommandInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Cascadia Mono, Consolas"
                             Padding="9,6"
                             KeyDown="ConsoleInput_KeyDown" />
                    <Button Grid.Column="2"
                            Content="Send"
                            Command="{Binding SendConsoleCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,6" />
                </Grid>

                <Border Background="{StaticResource OledBgBrush}"
                        BorderBrush="{StaticResource Ink08Brush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        MaxHeight="96">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource AccentCyanBrightBrush}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11.5"
                                 TextWrapping="Wrap"
                                 Padding="0" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
