<!--
    Compact skin: a smaller type scale, smaller radii and tighter spacing, so more fits in a small window or
    on a second screen. Same keys as Default.xaml (docs/theming.md).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Font families -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Type scale (device-independent pixels) -->
    <sys:Double x:Key="FontSize00">8.5</sys:Double>
    <sys:Double x:Key="FontSize01">9</sys:Double>
    <sys:Double x:Key="FontSize02">9</sys:Double>
    <sys:Double x:Key="FontSize03">9.5</sys:Double>
    <sys:Double x:Key="FontSize04">10</sys:Double>
    <sys:Double x:Key="FontSize05">10.5</sys:Double>
    <sys:Double x:Key="FontSize06">11</sys:Double>
    <sys:Double x:Key="FontSize07">11.5</sys:Double>
    <sys:Double x:Key="FontSize08">12</sys:Double>
    <sys:Double x:Key="FontSize09">13</sys:Double>
    <sys:Double x:Key="FontSize10">14.5</sys:Double>
    <sys:Double x:Key="FontSize11">15.5</sys:Double>
    <sys:Double x:Key="FontSize12">17</sys:Double>
    <sys:Double x:Key="FontSize13">21.5</sys:Double>
    <sys:Double x:Key="FontSize14">34</sys:Double>

    <!-- Corner-radius scale -->
    <CornerRadius x:Key="Radius00">2</CornerRadius>
    <CornerRadius x:Key="Radius01">3</CornerRadius>
    <CornerRadius x:Key="Radius02">4</CornerRadius>
    <CornerRadius x:Key="Radius03">6</CornerRadius>
    <CornerRadius x:Key="Radius04">8</CornerRadius>
    <CornerRadius x:Key="Radius05">9</CornerRadius>
    <CornerRadius x:Key="Radius06">10</CornerRadius>
    <CornerRadius x:Key="Radius07">12</CornerRadius>
    <CornerRadius x:Key="Radius08">15</CornerRadius>
    <CornerRadius x:Key="Radius09">20</CornerRadius>

    <!-- Spacing and size scales (multiply the Default pixels in the views) -->
    <sys:Double x:Key="SpaceScale">0.75</sys:Double>
    <sys:Double x:Key="SizeScale">0.88</sys:Double>

</ResourceDictionary>
