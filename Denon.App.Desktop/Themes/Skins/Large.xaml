<!--
    Large (living room) skin: a larger type scale, larger icons and controls and more spacing, so the app
    reads from the sofa or on a touch screen. Same keys as Default.xaml (docs/theming.md).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Font families -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Type scale (device-independent pixels) -->
    <sys:Double x:Key="FontSize00">11</sys:Double>
    <sys:Double x:Key="FontSize01">11.5</sys:Double>
    <sys:Double x:Key="FontSize02">12</sys:Double>
    <sys:Double x:Key="FontSize03">12.5</sys:Double>
    <sys:Double x:Key="FontSize04">13</sys:Double>
    <sys:Double x:Key="FontSize05">14</sys:Double>
    <sys:Double x:Key="FontSize06">14.5</sys:Double>
    <sys:Double x:Key="FontSize07">15</sys:Double>
    <sys:Double x:Key="FontSize08">15.5</sys:Double>
    <sys:Double x:Key="FontSize09">17</sys:Double>
    <sys:Double x:Key="FontSize10">19</sys:Double>
    <sys:Double x:Key="FontSize11">20.5</sys:Double>
    <sys:Double x:Key="FontSize12">23</sys:Double>
    <sys:Double x:Key="FontSize13">29</sys:Double>
    <sys:Double x:Key="FontSize14">46</sys:Double>

    <!-- Corner-radius scale -->
    <CornerRadius x:Key="Radius00">3</CornerRadius>
    <CornerRadius x:Key="Radius01">5</CornerRadius>
    <CornerRadius x:Key="Radius02">7</CornerRadius>
    <CornerRadius x:Key="Radius03">10</CornerRadius>
    <CornerRadius x:Key="Radius04">12</CornerRadius>
    <CornerRadius x:Key="Radius05">14</CornerRadius>
    <CornerRadius x:Key="Radius06">17</CornerRadius>
    <CornerRadius x:Key="Radius07">19</CornerRadius>
    <CornerRadius x:Key="Radius08">24</CornerRadius>
    <CornerRadius x:Key="Radius09">32</CornerRadius>

    <!-- Spacing and size scales (multiply the Default pixels in the views) -->
    <sys:Double x:Key="SpaceScale">1.25</sys:Double>
    <sys:Double x:Key="SizeScale">1.2</sys:Double>

</ResourceDictionary>
