<!--
    Hi-Fi skin: the look of a rack receiver. Square corners, a condensed display face and a fluorescent-display
    face for numbers; the meters are amber-backlit dials and a fluorescent-display spectrum
    (MeterPalette.HiFi). Same keys as Default.xaml (docs/theming.md).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Font families -->
    <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Themes/Fonts/#Share Tech Mono, Consolas</FontFamily>

    <!-- Type scale (device-independent pixels) -->
    <sys:Double x:Key="FontSize00">9</sys:Double>
    <sys:Double x:Key="FontSize01">9.5</sys:Double>
    <sys:Double x:Key="FontSize02">10</sys:Double>
    <sys:Double x:Key="FontSize03">10.5</sys:Double>
    <sys:Double x:Key="FontSize04">11</sys:Double>
    <sys:Double x:Key="FontSize05">11.5</sys:Double>
    <sys:Double x:Key="FontSize06">12</sys:Double>
    <sys:Double x:Key="FontSize07">12.5</sys:Double>
    <sys:Double x:Key="FontSize08">13</sys:Double>
    <sys:Double x:Key="FontSize09">14</sys:Double>
    <sys:Double x:Key="FontSize10">16</sys:Double>
    <sys:Double x:Key="FontSize11">17</sys:Double>
    <sys:Double x:Key="FontSize12">19</sys:Double>
    <sys:Double x:Key="FontSize13">24</sys:Double>
    <sys:Double x:Key="FontSize14">38</sys:Double>

    <!-- Corner-radius scale -->
    <CornerRadius x:Key="Radius00">0</CornerRadius>
    <CornerRadius x:Key="Radius01">1</CornerRadius>
    <CornerRadius x:Key="Radius02">1.5</CornerRadius>
    <CornerRadius x:Key="Radius03">2</CornerRadius>
    <CornerRadius x:Key="Radius04">2</CornerRadius>
    <CornerRadius x:Key="Radius05">3</CornerRadius>
    <CornerRadius x:Key="Radius06">3</CornerRadius>
    <CornerRadius x:Key="Radius07">4</CornerRadius>
    <CornerRadius x:Key="Radius08">4</CornerRadius>
    <CornerRadius x:Key="Radius09">5</CornerRadius>

    <!-- Spacing and size scales (multiply the Default pixels in the views) -->
    <sys:Double x:Key="SpaceScale">1</sys:Double>
    <sys:Double x:Key="SizeScale">1</sys:Double>

</ResourceDictionary>
