<!--
    Default skin: the skin tokens (docs/theming.md). Every skin in Themes/Skins defines exactly these keys
    (test: SkinTests). Views use the tokens instead of literal numbers, so a skin changes the look live:
    - fonts: DisplayFont, UiFont, MonoFont;
    - the type scale FontSize00 (smallest) ... FontSize14 (largest);
    - the corner-radius scale Radius00 ... Radius09;
    - SpaceScale and SizeScale: views write margins, padding and sizes in Default pixels with {skin:Space} and
      {skin:Size}, and the skin multiplies them.
    The meter materials of a skin are in code (Controls/MeterPalette.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Font families -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Type scale (device-independent pixels) -->
    <sys:Double x:Key="FontSize00">9</sys:Double>
    <sys:Double x:Key="FontSize01">9.5</sys:Double>
    <sys:Double x:Key="FontSize02">10</sys:Double>
    <sys:Double x:Key="FontSize03">10.5</sys:Double>
    <sys:Double x:Key="FontSize04">11</sys:Double>
    <sys:Double x:Key="FontSize05">11.5</sys:Double>
    <sys:Double x:Key="FontSize06">12</sys:Double>
    <sys:Double x:Key="FontSize07">12.5</sys:Double>
    <sys:Double x:Key="FontSize08">13</sys:Double>
    <sys:Double x:Key="FontSize09">14</sys:Double>
    <sys:Double x:Key="FontSize10">16</sys:Double>
    <sys:Double x:Key="FontSize11">17</sys:Double>
    <sys:Double x:Key="FontSize12">19</sys:Double>
    <sys:Double x:Key="FontSize13">24</sys:Double>
    <sys:Double x:Key="FontSize14">38</sys:Double>

    <!-- Corner-radius scale -->
    <CornerRadius x:Key="Radius00">2</CornerRadius>
    <CornerRadius x:Key="Radius01">4</CornerRadius>
    <CornerRadius x:Key="Radius02">6</CornerRadius>
    <CornerRadius x:Key="Radius03">8</CornerRadius>
    <CornerRadius x:Key="Radius04">10</CornerRadius>
    <CornerRadius x:Key="Radius05">12</CornerRadius>
    <CornerRadius x:Key="Radius06">14</CornerRadius>
    <CornerRadius x:Key="Radius07">16</CornerRadius>
    <CornerRadius x:Key="Radius08">20</CornerRadius>
    <CornerRadius x:Key="Radius09">27</CornerRadius>

    <!-- Spacing and size scales (multiply the Default pixels in the views) -->
    <sys:Double x:Key="SpaceScale">1</sys:Double>
    <sys:Double x:Key="SizeScale">1</sys:Double>

</ResourceDictionary>
