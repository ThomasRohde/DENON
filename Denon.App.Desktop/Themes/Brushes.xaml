    <!-- Role names for ramp steps (used across the app before the ramp existed). -->
    <SolidColorBrush po:Freeze="True" x:Key="OledBgBrush" Color="{StaticResource Ink00Color}" />
    <SolidColorBrush po:Freeze="True" x:Key="ChassisBgBrush" Color="{StaticResource Ink01Color}" />
    <SolidColorBrush po:Freeze="True" x:Key="SidebarBgBrush" Color="{StaticResource Ink02Color}" />
    <SolidColorBrush po:Freeze="True" x:Key="CardBgBrush" Color="{StaticResource Ink04Color}" />
    <SolidColorBrush po:Freeze="True" x:Key="CardElevatedBrush" Color="{StaticResource Ink06Color}" />
