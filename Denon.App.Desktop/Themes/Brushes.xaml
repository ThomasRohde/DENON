    <SolidColorBrush po:Freeze="True" x:Key="BorderSpecBrush" Color="{StaticResource Ink13Color}" />

    <!-- Gradients -->
    <LinearGradientBrush po:Freeze="True" x:Key="HeroCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Ink06Color}" Offset="0" />
        <GradientStop Color="{StaticResource Ink02Color}" Offset="0.65" />
        <GradientStop Color="{StaticResource TextOnAccentColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush po:Freeze="True" x:Key="CyanAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentSkyDeepColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentCyanColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush po:Freeze="True" x:Key="VolumeTrackGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentSkyColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentCyanVividColor}" Offset="0.72" />
        <GradientStop Color="{StaticResource AccentAmberColor}" Offset="0.92" />
        <GradientStop Color="{StaticResource AccentCrimsonColor}" Offset="1" />
    </LinearGradientBrush>

