<!--
    Light palette. Same keys as Dark.xaml (ThemePaletteTests); see docs/theming.md for the contract.
    The ramp runs from the page (Ink00-Ink03) to white cards (Ink04) and tinted inner panels; Ink09 and up are lines.
    Accent text colors are darker than in Dark and subtle backgrounds are light tints, so both read on white.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral ramp. Ink00 is the deepest background; higher steps stand out more against it. Here the page is gray and cards are white. -->
    <Color x:Key="Ink00Color">#E2E7EE</Color>
    <Color x:Key="Ink01Color">#E9EDF2</Color>
    <Color x:Key="Ink02Color">#F2F4F7</Color>
    <Color x:Key="Ink03Color">#F5F7FA</Color>
    <Color x:Key="Ink04Color">#FFFFFF</Color>
    <Color x:Key="Ink05Color">#EEF3F9</Color>
    <Color x:Key="Ink06Color">#F4F6F9</Color>
    <Color x:Key="Ink07Color">#EDF0F4</Color>
    <Color x:Key="Ink08Color">#E7ECF2</Color>
    <Color x:Key="Ink09Color">#DCE2E9</Color>
    <Color x:Key="Ink10Color">#E1E6ED</Color>
    <Color x:Key="Ink11Color">#D2D9E2</Color>
    <Color x:Key="Ink12Color">#C9D1DB</Color>
    <Color x:Key="Ink13Color">#BBC4D0</Color>
    <Color x:Key="Ink14Color">#ACB7C5</Color>
    <Color x:Key="Ink15Color">#A1ADBC</Color>
    <Color x:Key="Ink16Color">#8D9BAE</Color>

    <!-- Text levels, from most to least prominent. -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextStrongColor">#1E293B</Color>
    <Color x:Key="TextSoftColor">#334155</Color>
    <Color x:Key="TextSecondaryColor">#404F63</Color>
    <Color x:Key="TextMutedColor">#556377</Color>
    <Color x:Key="TextFaintColor">#6B7A8E</Color>
    <Color x:Key="TextDisabledColor">#A0ABBA</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- Cyan and sky: the primary accent. -->
    <Color x:Key="AccentCyanColor">#087A9C</Color>
    <Color x:Key="AccentCyanVividColor">#06B6D4</Color>
    <Color x:Key="AccentCyanInkColor">#FFFFFF</Color>
    <Color x:Key="AccentCyanBrightColor">#0E7490</Color>
    <Color x:Key="AccentSkyColor">#0EA5E9</Color>
    <Color x:Key="AccentSkyDeepColor">#0369A1</Color>
    <Color x:Key="AccentCyanTextColor">#0E7490</Color>
    <Color x:Key="AccentCyanDimColor">#D3EEF6</Color>
    <Color x:Key="AccentCyanSubtleBgColor">#E0F3F9</Color>
    <Color x:Key="AccentCyanSubtleBgDeepColor">#EDF8FB</Color>
    <Color x:Key="AccentCyanBorderColor">#A6DBEA</Color>
    <Color x:Key="AccentCyanBorderStrongColor">#7CC8DF</Color>
    <Color x:Key="AccentCyanGlowColor">#33087A9C</Color>

    <!-- Blue: information. -->
    <Color x:Key="AccentBlueTextColor">#1D4ED8</Color>
    <Color x:Key="AccentBlueTextSoftColor">#1E3A8A</Color>
    <Color x:Key="AccentBlueBorderColor">#93C5FD</Color>
    <Color x:Key="AccentBlueBorderSoftColor">#BFDBFE</Color>
    <Color x:Key="AccentBlueSubtleBgColor">#BFD7F5</Color>

    <!-- Emerald: success, "on". -->
    <Color x:Key="AccentEmeraldColor">#047F5E</Color>
    <Color x:Key="AccentEmeraldBrightColor">#047F5E</Color>
    <Color x:Key="AccentEmeraldDeepColor">#047857</Color>
    <Color x:Key="AccentEmeraldDeeperColor">#D1F2E4</Color>
    <Color x:Key="AccentEmeraldTextColor">#047857</Color>
    <Color x:Key="AccentEmeraldSubtleBgColor">#E2F5EC</Color>
    <Color x:Key="AccentEmeraldSubtleBgDeepColor">#EEF9F4</Color>
    <Color x:Key="AccentEmeraldBorderColor">#A7DFC6</Color>

    <!-- Amber: warning; the left VU channel. -->
    <Color x:Key="AccentAmberColor">#A84D07</Color>
    <Color x:Key="AccentAmberBrightColor">#D97706</Color>
    <Color x:Key="AccentAmberDeepColor">#92400E</Color>
    <Color x:Key="AccentAmberTextColor">#92400E</Color>
    <Color x:Key="AccentAmberSubtleBgColor">#FDF2D8</Color>
    <Color x:Key="AccentAmberSubtleBgDeepColor">#FEF8EA</Color>
    <Color x:Key="AccentAmberBgColor">#FCE9C0</Color>

    <!-- Crimson and rose: danger, errors, "off". -->
    <Color x:Key="AccentCrimsonColor">#C81E1E</Color>
    <Color x:Key="AccentCrimsonBrightColor">#C81E1E</Color>
    <Color x:Key="AccentCrimsonDeepColor">#B91C1C</Color>
    <Color x:Key="AccentCrimsonTextColor">#B91C1C</Color>
    <Color x:Key="AccentRoseTextColor">#BE123C</Color>
    <Color x:Key="AccentCrimsonBgColor">#FDE6E6</Color>
    <Color x:Key="AccentCrimsonBgDeepColor">#FEF0F0</Color>
    <Color x:Key="AccentCrimsonBgStrongColor">#FBD3D3</Color>
    <Color x:Key="AccentCrimsonBorderColor">#F3A5A5</Color>

    <!-- Indigo, violet and pink: categories and highlights. -->
    <Color x:Key="AccentIndigoColor">#4F46E5</Color>
    <Color x:Key="AccentIndigoDeepColor">#4338CA</Color>
    <Color x:Key="AccentIndigoTextColor">#3730A3</Color>
    <Color x:Key="AccentIndigoSubtleBgColor">#ECEDFE</Color>
    <Color x:Key="AccentVioletColor">#7C3AED</Color>
    <Color x:Key="AccentVioletTextColor">#6D28D9</Color>
    <Color x:Key="AccentVioletBorderColor">#C9B8F5</Color>
    <Color x:Key="AccentVioletSubtleBgColor">#F2EDFE</Color>
    <Color x:Key="AccentPinkColor">#DB2777</Color>
    <Color x:Key="AccentPinkTextColor">#BE185D</Color>
    <Color x:Key="AccentPinkSubtleBgColor">#FCE7F3</Color>

    <!-- Teal: the right VU channel. -->
    <Color x:Key="AccentTealColor">#087A9C</Color>

    <!-- Overlays with alpha (glass highlights, scrims, glows). -->
    <Color x:Key="OverlayHighlightClearColor">#00FFFFFF</Color>
    <Color x:Key="OverlayHighlightFaintColor">#66FFFFFF</Color>
    <Color x:Key="OverlayHighlightSoftColor">#B3FFFFFF</Color>
    <Color x:Key="TextOnScrimColor">#F1F5F9</Color>
    <Color x:Key="OverlayScrimColor">#990F172A</Color>

</ResourceDictionary>
