<!--
    Dark palette (the default theme). Every color the app draws comes from a palette; see docs/theming.md.
    Views use the brushes in Themes/Brushes.xaml with {DynamicResource}, so a theme switch reaches them live.
    Every palette defines exactly these keys (ThemePaletteTests). Keep the keys stable: plugins use them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral ramp. Ink00 is the deepest background; higher steps stand out more against it. A light theme defines the same steps from light to dark. -->
    <Color x:Key="Ink00Color">#07090D</Color>
    <Color x:Key="Ink01Color">#0A0C10</Color>
    <Color x:Key="Ink02Color">#0E1016</Color>
    <Color x:Key="Ink03Color">#0E121B</Color>
    <Color x:Key="Ink04Color">#13161E</Color>
    <Color x:Key="Ink05Color">#0D1622</Color>
    <Color x:Key="Ink06Color">#181C26</Color>
    <Color x:Key="Ink07Color">#1C202C</Color>
    <Color x:Key="Ink08Color">#1B2434</Color>
    <Color x:Key="Ink09Color">#232836</Color>
    <Color x:Key="Ink10Color">#242A3A</Color>
    <Color x:Key="Ink11Color">#232B3D</Color>
    <Color x:Key="Ink12Color">#263348</Color>
    <Color x:Key="Ink13Color">#31384B</Color>
    <Color x:Key="Ink14Color">#334155</Color>
    <Color x:Key="Ink15Color">#36445F</Color>
    <Color x:Key="Ink16Color">#475569</Color>

    <!-- Text levels, from most to least prominent. -->
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextStrongColor">#E2E8F0</Color>
    <Color x:Key="TextSoftColor">#CBD5E1</Color>
    <Color x:Key="TextSecondaryColor">#B0BFCE</Color>
    <Color x:Key="TextMutedColor">#8E9FB3</Color>
    <Color x:Key="TextFaintColor">#64748B</Color>
    <Color x:Key="TextDisabledColor">#475569</Color>
    <Color x:Key="TextOnAccentColor">#06121A</Color>

    <!-- Cyan and sky: the primary accent. -->
    <Color x:Key="AccentCyanColor">#00D4FF</Color>
    <Color x:Key="AccentCyanVividColor">#00E5FF</Color>
    <Color x:Key="AccentCyanInkColor">#04151C</Color>
    <Color x:Key="AccentCyanBrightColor">#38BDF8</Color>
    <Color x:Key="AccentSkyColor">#0EA5E9</Color>
    <Color x:Key="AccentSkyDeepColor">#0284C7</Color>
    <Color x:Key="AccentCyanTextColor">#7DD3FC</Color>
    <Color x:Key="AccentCyanDimColor">#0B3B4B</Color>
    <Color x:Key="AccentCyanSubtleBgColor">#0C2E3D</Color>
    <Color x:Key="AccentCyanSubtleBgDeepColor">#0E2430</Color>
    <Color x:Key="AccentCyanBorderColor">#0E4F6B</Color>
    <Color x:Key="AccentCyanBorderStrongColor">#0E5A78</Color>
    <Color x:Key="AccentCyanGlowColor">#4438BDF8</Color>

    <!-- Blue: information. -->
    <Color x:Key="AccentBlueTextColor">#93C5FD</Color>
    <Color x:Key="AccentBlueTextSoftColor">#DBEAFE</Color>
    <Color x:Key="AccentBlueBorderColor">#1E3A5F</Color>
    <Color x:Key="AccentBlueBorderSoftColor">#1D3347</Color>
    <Color x:Key="AccentBlueSubtleBgColor">#27405E</Color>

    <!-- Emerald: success, "on". -->
    <Color x:Key="AccentEmeraldColor">#10B981</Color>
    <Color x:Key="AccentEmeraldBrightColor">#34D399</Color>
    <Color x:Key="AccentEmeraldDeepColor">#059669</Color>
    <Color x:Key="AccentEmeraldDeeperColor">#064E3B</Color>
    <Color x:Key="AccentEmeraldTextColor">#6EE7B7</Color>
    <Color x:Key="AccentEmeraldSubtleBgColor">#0B2E24</Color>
    <Color x:Key="AccentEmeraldSubtleBgDeepColor">#0B221A</Color>
    <Color x:Key="AccentEmeraldBorderColor">#174D3A</Color>

    <!-- Amber: warning; the left VU channel. -->
    <Color x:Key="AccentAmberColor">#F59E0B</Color>
    <Color x:Key="AccentAmberBrightColor">#FBBF24</Color>
    <Color x:Key="AccentAmberDeepColor">#D97706</Color>
    <Color x:Key="AccentAmberTextColor">#FDE68A</Color>
    <Color x:Key="AccentAmberSubtleBgColor">#261C0A</Color>
    <Color x:Key="AccentAmberSubtleBgDeepColor">#1D180B</Color>
    <Color x:Key="AccentAmberBgColor">#36240A</Color>

    <!-- Crimson and rose: danger, errors, "off". -->
    <Color x:Key="AccentCrimsonColor">#EF4444</Color>
    <Color x:Key="AccentCrimsonBrightColor">#F87171</Color>
    <Color x:Key="AccentCrimsonDeepColor">#C81E1E</Color>
    <Color x:Key="AccentCrimsonTextColor">#FCA5A5</Color>
    <Color x:Key="AccentRoseTextColor">#FB7185</Color>
    <Color x:Key="AccentCrimsonBgColor">#351519</Color>
    <Color x:Key="AccentCrimsonBgDeepColor">#2A1216</Color>
    <Color x:Key="AccentCrimsonBgStrongColor">#4C151B</Color>
    <Color x:Key="AccentCrimsonBorderColor">#7F1D1D</Color>

    <!-- Indigo, violet and pink: categories and highlights. -->
    <Color x:Key="AccentIndigoColor">#818CF8</Color>
    <Color x:Key="AccentIndigoDeepColor">#6366F1</Color>
    <Color x:Key="AccentIndigoTextColor">#C7D2FE</Color>
    <Color x:Key="AccentIndigoSubtleBgColor">#1E1B4B</Color>
    <Color x:Key="AccentVioletColor">#A78BFA</Color>
    <Color x:Key="AccentVioletTextColor">#C4B5FD</Color>
    <Color x:Key="AccentVioletBorderColor">#4C3885</Color>
    <Color x:Key="AccentVioletSubtleBgColor">#1B1830</Color>
    <Color x:Key="AccentPinkColor">#EC4899</Color>
    <Color x:Key="AccentPinkTextColor">#F9A8D4</Color>
    <Color x:Key="AccentPinkSubtleBgColor">#2D1225</Color>

    <!-- Teal: the right VU channel. -->
    <Color x:Key="AccentTealColor">#22D3EE</Color>

    <!-- Overlays with alpha (glass highlights, scrims, glows). -->
    <Color x:Key="OverlayHighlightClearColor">#00FFFFFF</Color>
    <Color x:Key="OverlayHighlightFaintColor">#10FFFFFF</Color>
    <Color x:Key="OverlayHighlightSoftColor">#1FFFFFFF</Color>
    <Color x:Key="TextOnScrimColor">#F1F5F9</Color>
    <Color x:Key="OverlayScrimColor">#CC07090D</Color>

</ResourceDictionary>
