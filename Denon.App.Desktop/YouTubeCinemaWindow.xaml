<Window x:Class="Denon.App.Desktop.YouTubeCinemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Denon Cinema Companion"
        Width="960"
        Height="600"
        MinWidth="460"
        MinHeight="320"
        Background="{StaticResource ChassisBgBrush}"
        Icon="denon_icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="CinemaWindowChrome"
                      CaptionHeight="42"
                      CornerRadius="{StaticResource Radius05}"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource ChassisBgBrush}" BorderBrush="{StaticResource Ink12Brush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,0,1" Padding="12,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentCrimsonBgDeepBrush}" BorderBrush="{StaticResource AccentCrimsonBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="CINEMA" FontSize="{StaticResource FontSize01}" FontWeight="Bold" Foreground="{StaticResource AccentCrimsonTextBrush}" />
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   Text="YouTube Video Companion"
                                   FontSize="{StaticResource FontSize07}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HideBarsButton"
                                Content="Hide Bars (H)"
                                Click="ToggleBars_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0"
                                ToolTip="Hide top &amp; bottom bars for pure full-bleed cinema (move mouse for floating Show Bars / Close buttons, or press H / Esc)" />
                        <Button x:Name="FullscreenButton"
                                Content="Fullscreen (F11)"
                                Click="ToggleFullscreen_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0"
                                ToolTip="Toggle borderless monitor fullscreen for the Cinema window (F11)" />
                        <Button x:Name="PinButton"
                                Content="Pin on Top"
                                Click="PinButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,6,0" />
                        <Button Content="Open Browser"
                                Click="OpenInBrowser_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="{StaticResource FontSize04}"
                                Margin="0,0,8,0" />
                        <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close Cinema Window">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Width="10"
                                  Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView2 Video Surface -->
            <Grid Grid.Row="1" Background="{StaticResource OledBgBrush}">
                <wv2:WebView2 x:Name="VideoWebView" DefaultBackgroundColor="Black" PreviewKeyDown="Window_PreviewKeyDown" />
                <TextBlock x:Name="LoadingOverlay"
                           Text="Loading YouTube Cinema Player..."
                           FontSize="{StaticResource FontSize08}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Bottom A/V Sync & Audio Route Bar -->
            <Border x:Name="BottomSyncBar" Grid.Row="2" Background="{StaticResource Ink03Brush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteVideoButton"
                                Content="Video Muted (Denon Audio)"
                                Click="ToggleVideoMute_Click"
                                Style="{StaticResource PrimaryButton}"
                                Padding="11,6"
                                FontSize="{StaticResource FontSize05}"
                                Margin="0,0,10,0" />
                        <TextBlock Text="A/V SYNC:" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="4,0,6,0" />
                        <Button Content="-500ms" Click="NudgeMinus500_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" ToolTip="Delay video 500ms to match Denon HEOS buffer" />
                        <Button Content="-100ms" Click="NudgeMinus100_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" />
                        <Button Content="+100ms" Click="NudgePlus100_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="{StaticResource FontSize04}" Margin="0,0,4,0" />
                        <Button Content="+500ms" Click="NudgePlus500_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="{StaticResource FontSize04}" Margin="0,0,8,0" />
                        <Button Content="Re-Sync to Denon" Click="ResyncToDenon_Click" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="{StaticResource FontSize04}" ToolTip="Snap video to the current estimated playback position on your Denon AVR" />
                    </StackPanel>

                    <TextBlock x:Name="SyncStatusText"
                               Text="Audio routed to Denon AVR • Video muted"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize05}"
                               Foreground="{StaticResource AccentCyanBrightBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
