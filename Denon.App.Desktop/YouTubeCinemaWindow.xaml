<Window x:Class="Denon.App.Desktop.YouTubeCinemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Denon Cinema Companion"
        Width="860"
        Height="560"
        MinWidth="460"
        MinHeight="320"
        Background="{StaticResource ChassisBgBrush}"
        Icon="denon_icon.ico"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource ChassisBgBrush}" BorderBrush="#233046" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#0D1017" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,0,1" Padding="12,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2D1218" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="CINEMA" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" />
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   Text="YouTube Video Companion"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton"
                                Content="Pin on Top"
                                Click="PinButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="11"
                                Margin="0,0,6,0" />
                        <Button Content="Open Browser"
                                Click="OpenInBrowser_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButton}"
                                Padding="9,4"
                                FontSize="11"
                                Margin="0,0,8,0" />
                        <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close Cinema Window">
                            <Path Data="M1,1 L9,9 M9,1 L1,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Width="10"
                                  Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView2 Video Surface -->
            <Grid Grid.Row="1" Background="#05070B">
                <wv2:WebView2 x:Name="VideoWebView" DefaultBackgroundColor="Black" />
                <TextBlock x:Name="LoadingOverlay"
                           Text="Loading YouTube Cinema Player..."
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Bottom A/V Sync & Audio Route Bar -->
            <Border Grid.Row="2" Background="#0E121B" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteVideoButton"
                                Content="Video Muted (Denon Audio)"
                                Click="ToggleVideoMute_Click"
                                Style="{StaticResource PrimaryButton}"
                                Padding="11,6"
                                FontSize="11.5"
                                Margin="0,0,10,0" />
                        <TextBlock Text="A/V SYNC:" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="4,0,6,0" />
                        <Button Content="-500ms" Click="NudgeMinus500_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" Margin="0,0,4,0" ToolTip="Delay video 500ms to match Denon HEOS buffer" />
                        <Button Content="-100ms" Click="NudgeMinus100_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" Margin="0,0,4,0" />
                        <Button Content="+100ms" Click="NudgePlus100_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" Margin="0,0,4,0" />
                        <Button Content="+500ms" Click="NudgePlus500_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" Margin="0,0,8,0" />
                        <Button Content="Re-Sync to Denon" Click="ResyncToDenon_Click" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" ToolTip="Snap video to the current estimated playback position on your Denon AVR" />
                    </StackPanel>

                    <TextBlock x:Name="SyncStatusText"
                               Text="Audio routed to Denon AVR • Video muted"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource AccentCyanBrightBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
