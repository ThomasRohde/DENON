<UserControl x:Class="Denon.Plugin.HomeAssistant.HomeAssistantDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#F1F5F9"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HaBoolToVis" />

        <Style x:Key="HaCard" TargetType="Border">
            <Setter Property="Background" Value="#13161E" />
            <Setter Property="BorderBrush" Value="#232836" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="HaBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C202C" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2D3548" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3D" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E4B66" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HaPrimaryBtn" TargetType="Button" BasedOn="{StaticResource HaBtn}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="HaInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="HaFilterChip" TargetType="Button" BasedOn="{StaticResource HaBtn}">
            <Setter Property="Padding" Value="10,4.5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,16">

            <!-- ======================== CONNECTION & TELEMETRY CARD ======================== -->
            <Border Style="{StaticResource HaCard}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="Home Assistant REST &amp; Webhook Bridge" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="#0B221A" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectionBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Trigger Home Assistant scenes, scripts, blinds &amp; smart plugs — and publish live Denon AVR telemetry"
                                       FontSize="11.5"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding DemoButtonLabel}" Command="{Binding ToggleDemoCommand}" Style="{StaticResource HaBtn}" Margin="0,0,6,4" />
                            <Button Content="Push Status" Command="{Binding PushNowCommand}" Style="{StaticResource HaBtn}" Margin="0,0,6,4" />
                            <Button Content="{Binding SetupToggleLabel}" Command="{Binding ToggleSetupCommand}" Style="{StaticResource HaBtn}" Margin="0,0,6,4" />
                            <Button Content="Save &amp; Sync" Command="{Binding SaveAndConnectCommand}" Style="{StaticResource HaPrimaryBtn}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Collapsible Connection Setup -->
                    <Border Background="#0D111A"
                            BorderBrush="#1F2739"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsSetupExpanded, Converter={StaticResource HaBoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HOME ASSISTANT URL" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="Cascadia Mono, Consolas" Tag="http://homeassistant.local:8123" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LONG-LIVED ACCESS TOKEN" FontSize="10" FontWeight="Bold" Foreground="#8E9FB3" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="TokenPasswordBox"
                                                 PasswordChanged="TokenPasswordBox_PasswordChanged"
                                                 Background="#0D111A"
                                                 Foreground="#F1F5F9"
                                                 BorderBrush="#252E42"
                                                 BorderThickness="1"
                                                 Padding="10,7"
                                                 FontSize="12"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 ToolTip="Long-Lived Access Token (masked for privacy)" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="WEBHOOK ID (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding WebhookId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="Cascadia Mono, Consolas" Tag="denon_events" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Tip: In Home Assistant, click your Profile (bottom-left) → Security → Long-Lived Access Tokens → Create Token."
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Auto-Push & Live Telemetry Preview -->
                    <CheckBox Content="Automatically push Denon AVR Power, Volume, Input &amp; Smart Scene events to Home Assistant"
                              IsChecked="{Binding PushEvents}"
                              Foreground="#E2E8F0"
                              Margin="0,0,0,8" />

                    <Border Background="#0B0F17" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                        <TextBlock Text="{Binding TelemetryPreviewText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#38BDF8" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#10B981" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ======================== ENTITIES & CONTROLS CARD ======================== -->
            <Border Style="{StaticResource HaCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SCENES, SCRIPTS, SWITCHES &amp; LIGHTS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                            <Border Background="#172030" BorderBrush="#263348" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="8,0,0,0">
                                <TextBlock Text="{Binding EntitiesCountLabel}" FontSize="10" Foreground="#94A3B8" />
                            </Border>
                        </StackPanel>
                        <TextBox Grid.Column="2"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource HaInput}"
                                 Padding="8,4"
                                 FontSize="11.5"
                                 Tag="Filter entities..." />
                        <Button Grid.Column="4" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource HaBtn}" Padding="10,4.5" FontSize="11.5" />
                    </Grid>

                    <!-- Domain Filter Pills -->
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="All" Command="{Binding SetDomainFilterCommand}" CommandParameter="all">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="all">
                                            <Setter Property="Background" Value="#0B2E24" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Scenes" Command="{Binding SetDomainFilterCommand}" CommandParameter="scene">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="scene">
                                            <Setter Property="Background" Value="#0B2E24" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Scripts" Command="{Binding SetDomainFilterCommand}" CommandParameter="script">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="script">
                                            <Setter Property="Background" Value="#0B2E24" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Switches" Command="{Binding SetDomainFilterCommand}" CommandParameter="switch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="switch">
                                            <Setter Property="Background" Value="#0B2E24" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Lights" Command="{Binding SetDomainFilterCommand}" CommandParameter="light">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="light">
                                            <Setter Property="Background" Value="#0B2E24" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>

                    <!-- Empty State Hint -->
                    <Border Background="#0C0F16" BorderBrush="#1F2739" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,4,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEntities}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No Home Assistant entities to show yet. Enter your URL &amp; Access Token and click Save &amp; Sync — or click Try Demo to explore virtual blinds, smart plugs &amp; scenes!"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Entity Tiles -->
                    <ItemsControl ItemsSource="{Binding Entities}" Visibility="{Binding HasEntities, Converter={StaticResource HaBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.TriggerEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,8"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="EntBd"
                                                    Background="#181D29"
                                                    BorderBrush="#2A3244"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,8"
                                                    MinWidth="205">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="28" Height="24" CornerRadius="6" Background="#0D1622" BorderBrush="#264054" BorderThickness="1" Margin="0,0,9,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DomainBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="165">
                                                        <TextBlock Text="{Binding FriendlyName}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding EntityId}" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border x:Name="StatePill" Grid.Column="2" Background="#101520" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="StateTxt" Text="{Binding StateLabel}" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter TargetName="EntBd" Property="Background" Value="#0C261F" />
                                                    <Setter TargetName="EntBd" Property="BorderBrush" Value="#10B981" />
                                                    <Setter TargetName="StatePill" Property="Background" Value="#064E3B" />
                                                    <Setter TargetName="StatePill" Property="BorderBrush" Value="#10B981" />
                                                    <Setter TargetName="StateTxt" Property="Foreground" Value="#6EE7B7" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="EntBd" Property="BorderBrush" Value="#10B981" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
