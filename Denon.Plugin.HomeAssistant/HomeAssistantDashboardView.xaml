<UserControl x:Class="Denon.Plugin.HomeAssistant.HomeAssistantDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="{StaticResource DisplayFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HaBoolToVis" />

        <Style x:Key="HaBtn" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSize06}" />
        </Style>

        <Style x:Key="HaPrimaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSize06}" />
        </Style>

        <Style x:Key="HaInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSize06}" />
        </Style>

        <Style x:Key="HaFilterChip" TargetType="Button" BasedOn="{StaticResource HaBtn}">
            <Setter Property="Padding" Value="10,4.5" />
            <Setter Property="FontSize" Value="{StaticResource FontSize05}" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,16">

            <!-- ======================== CONNECTION & TELEMETRY CARD ======================== -->
            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="Home Assistant REST &amp; Webhook Bridge" FontSize="{StaticResource FontSize10}" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentEmeraldSubtleBgDeepBrush}" BorderBrush="{StaticResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectionBadgeText}" FontSize="{StaticResource FontSize02}" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Trigger Home Assistant scenes, scripts, blinds &amp; smart plugs — and publish live Denon AVR telemetry"
                                       FontSize="{StaticResource FontSize05}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding DemoButtonLabel}" Command="{Binding ToggleDemoCommand}" Style="{StaticResource HaBtn}" Margin="0,0,6,4" />
                            <Button Content="Push Status" Command="{Binding PushNowCommand}" Style="{StaticResource HaBtn}" Margin="0,0,6,4" />
                            <Button Content="{Binding SetupToggleLabel}" Command="{Binding ToggleSetupCommand}" Style="{StaticResource HaBtn}" Margin="0,0,6,4" />
                            <Button Content="Save &amp; Sync" Command="{Binding SaveAndConnectCommand}" Style="{StaticResource HaPrimaryBtn}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Collapsible Connection Setup -->
                    <Border Background="{StaticResource Ink03Brush}"
                            BorderBrush="{StaticResource Ink11Brush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius04}"
                            Padding="12,10"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsSetupExpanded, Converter={StaticResource HaBoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HOME ASSISTANT URL" FontSize="{StaticResource FontSize02}" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="{StaticResource MonoFont}" Tag="http://homeassistant.local:8123" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LONG-LIVED ACCESS TOKEN" FontSize="{StaticResource FontSize02}" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="TokenPasswordBox"
                                                 PasswordChanged="TokenPasswordBox_PasswordChanged"
                                                 Padding="10,7"
                                                 FontSize="{StaticResource FontSize06}"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 ToolTip="Long-Lived Access Token (masked for privacy)" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="WEBHOOK ID (OPTIONAL)" FontSize="{StaticResource FontSize02}" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding WebhookId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="{StaticResource MonoFont}" Tag="denon_events" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Tip: In Home Assistant, click your Profile (bottom-left) → Security → Long-Lived Access Tokens → Create Token."
                                       FontSize="{StaticResource FontSize04}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Auto-Push & Live Telemetry Preview -->
                    <CheckBox Content="Automatically push Denon AVR Power, Volume, Input &amp; Smart Scene events to Home Assistant"
                              IsChecked="{Binding PushEvents}"
                              Foreground="{StaticResource TextStrongBrush}"
                              Margin="0,0,0,8" />

                    <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius03}" Padding="10,7" Margin="0,0,0,8">
                        <TextBlock Text="{Binding TelemetryPreviewText}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize03}" Foreground="{StaticResource AccentCyanBrightBrush}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource FontSize05}" Foreground="{StaticResource AccentEmeraldBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ======================== ENTITIES & CONTROLS CARD ======================== -->
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SCENES, SCRIPTS, SWITCHES &amp; LIGHTS" FontSize="{StaticResource FontSize03}" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Ink08Brush}" BorderBrush="{StaticResource Ink12Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="6,1.5" Margin="8,0,0,0">
                                <TextBlock Text="{Binding EntitiesCountLabel}" FontSize="{StaticResource FontSize02}" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBox Grid.Column="2"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource HaInput}"
                                 Padding="8,4"
                                 FontSize="{StaticResource FontSize05}"
                                 Tag="Filter entities..." />
                        <Button Grid.Column="4" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource HaBtn}" Padding="10,4.5" FontSize="{StaticResource FontSize05}" />
                    </Grid>

                    <!-- Domain Filter Pills -->
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="All" Command="{Binding SetDomainFilterCommand}" CommandParameter="all">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="all">
                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Scenes" Command="{Binding SetDomainFilterCommand}" CommandParameter="scene">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="scene">
                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Scripts" Command="{Binding SetDomainFilterCommand}" CommandParameter="script">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="script">
                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Switches" Command="{Binding SetDomainFilterCommand}" CommandParameter="switch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="switch">
                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Lights" Command="{Binding SetDomainFilterCommand}" CommandParameter="light">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="light">
                                            <Setter Property="Background" Value="{StaticResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>

                    <!-- Empty State Hint -->
                    <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource Ink11Brush}" BorderThickness="1" CornerRadius="{StaticResource Radius04}" Padding="14" Margin="0,4,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEntities}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No Home Assistant entities to show yet. Enter your URL &amp; Access Token and click Save &amp; Sync — or click Try Demo to explore virtual blinds, smart plugs &amp; scenes!"
                                   FontSize="{StaticResource FontSize06}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Entity Tiles -->
                    <ItemsControl ItemsSource="{Binding Entities}" Visibility="{Binding HasEntities, Converter={StaticResource HaBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.TriggerEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,8"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="EntBd"
                                                    Background="{StaticResource CardElevatedBrush}"
                                                    BorderBrush="{StaticResource Ink12Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius04}"
                                                    Padding="12,8"
                                                    MinWidth="205">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="28" Height="24" CornerRadius="{StaticResource Radius02}" Background="{StaticResource Ink05Brush}" BorderBrush="{StaticResource Ink14Brush}" BorderThickness="1" Margin="0,0,9,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DomainBadge}" FontSize="{StaticResource FontSize01}" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="165">
                                                        <TextBlock Text="{Binding FriendlyName}" FontSize="{StaticResource FontSize06}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding EntityId}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize01}" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border x:Name="StatePill" Grid.Column="2" Background="{StaticResource Ink05Brush}" BorderBrush="{StaticResource BorderSpecBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius02}" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="StateTxt" Text="{Binding StateLabel}" FontSize="{StaticResource FontSize01}" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter TargetName="EntBd" Property="Background" Value="{StaticResource AccentEmeraldSubtleBgDeepBrush}" />
                                                    <Setter TargetName="EntBd" Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                                    <Setter TargetName="StatePill" Property="Background" Value="{StaticResource AccentEmeraldDeeperBrush}" />
                                                    <Setter TargetName="StatePill" Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                                    <Setter TargetName="StateTxt" Property="Foreground" Value="{StaticResource AccentEmeraldTextBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="EntBd" Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
