<UserControl x:Class="Denon.Plugin.HomeAssistant.HomeAssistantDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#F1F5F9"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="HaCard" TargetType="Border">
            <Setter Property="Background" Value="#13161E" />
            <Setter Property="BorderBrush" Value="#232836" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="HaBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C202C" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2D3548" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252C3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HaPrimaryBtn" TargetType="Button" BasedOn="{StaticResource HaBtn}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="HaInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0C0F16" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2A3244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,12">
            <Border Style="{StaticResource HaCard}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Home Assistant REST &amp; Webhook Bridge" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Trigger HA scenes, scripts, blinds &amp; smart plugs — and publish sensor.denon_desktop_receiver live" FontSize="11.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding DemoButtonLabel}" Command="{Binding ToggleDemoCommand}" Style="{StaticResource HaBtn}" Margin="0,0,6,0" />
                            <Button Content="Push Status" Command="{Binding PushNowCommand}" Style="{StaticResource HaBtn}" Margin="0,0,6,0" />
                            <Button Content="Save &amp; Sync" Command="{Binding SaveAndConnectCommand}" Style="{StaticResource HaPrimaryBtn}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HOME ASSISTANT URL" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LONG-LIVED ACCESS TOKEN" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                            <TextBox Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="WEBHOOK ID (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                            <TextBox Text="{Binding WebhookId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Automatically push Denon AVR Power, Volume, Input &amp; Smart Scene events to Home Assistant"
                              IsChecked="{Binding PushEvents}"
                              Foreground="#E2E8F0"
                              Margin="0,0,0,8" />

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#10B981" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HaCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="SCENES, SCRIPTS &amp; SWITCHES" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource HaBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Entities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.TriggerEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource HaBtn}"
                                        Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FriendlyName}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding EntityId}" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
