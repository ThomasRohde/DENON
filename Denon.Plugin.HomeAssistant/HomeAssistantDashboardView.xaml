<UserControl x:Class="Denon.Plugin.HomeAssistant.HomeAssistantDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:skin="clr-namespace:Denon.Plugin.HomeAssistant"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource DisplayFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HaBoolToVis" />

        <Style x:Key="HaBtn" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="{skin:Space 11,6}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="HaPrimaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="{skin:Space 11,6}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="HaInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="{skin:Space 9,6}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize06}" />
        </Style>

        <Style x:Key="HaFilterChip" TargetType="Button" BasedOn="{StaticResource HaBtn}">
            <Setter Property="Padding" Value="{skin:Space 10,4.5}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize05}" />
            <Setter Property="Margin" Value="{skin:Space 0,0,6,6}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{skin:Space 0,0,4,16}">

            <!-- ======================== CONNECTION & TELEMETRY CARD ======================== -->
            <Border Style="{StaticResource SurfaceCard}" Margin="{skin:Space 0,0,0,14}">
                <StackPanel>
                    <Grid Margin="{skin:Space 0,0,0,10}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 12}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{skin:Space 0,0,0,3}">
                                <TextBlock Text="Home Assistant REST &amp; Webhook Bridge" FontSize="{DynamicResource FontSize10}" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentEmeraldSubtleBgDeepBrush}" BorderBrush="{DynamicResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 8,2}" Margin="{skin:Space 10,0,0,0}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectionBadgeText}" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource AccentEmeraldBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Trigger Home Assistant scenes, scripts, blinds &amp; smart plugs — and publish live Denon AVR telemetry"
                                       FontSize="{DynamicResource FontSize05}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding DemoButtonLabel}" Command="{Binding ToggleDemoCommand}" Style="{StaticResource HaBtn}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="Push Status" Command="{Binding PushNowCommand}" Style="{StaticResource HaBtn}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="{Binding SetupToggleLabel}" Command="{Binding ToggleSetupCommand}" Style="{StaticResource HaBtn}" Margin="{skin:Space 0,0,6,4}" />
                            <Button Content="Save &amp; Sync" Command="{Binding SaveAndConnectCommand}" Style="{StaticResource HaPrimaryBtn}" Margin="{skin:Space 0,0,0,4}" />
                        </WrapPanel>
                    </Grid>

                    <!-- Collapsible Connection Setup -->
                    <Border Background="{DynamicResource Ink03Brush}"
                            BorderBrush="{DynamicResource Ink11Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius04}"
                            Padding="{skin:Space 12,10}"
                            Margin="{skin:Space 0,0,0,10}"
                            Visibility="{Binding IsSetupExpanded, Converter={StaticResource HaBoolToVis}}">
                        <StackPanel>
                            <Grid Margin="{skin:Space 0,0,0,8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="{skin:Size 10}" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="{skin:Size 10}" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HOME ASSISTANT URL" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                                    <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="{DynamicResource MonoFont}" Tag="http://homeassistant.local:8123" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LONG-LIVED ACCESS TOKEN" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="{skin:Space 0,0,0,4}" />
                                    <PasswordBox x:Name="TokenPasswordBox"
                                                 PasswordChanged="TokenPasswordBox_PasswordChanged"
                                                 Padding="{skin:Space 10,7}"
                                                 FontSize="{DynamicResource FontSize06}"
                                                 FontFamily="{DynamicResource MonoFont}"
                                                 ToolTip="Long-Lived Access Token (masked for privacy)" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="WEBHOOK ID (OPTIONAL)" FontSize="{DynamicResource FontSize02}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" Margin="{skin:Space 0,0,0,4}" />
                                    <TextBox Text="{Binding WebhookId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HaInput}" FontFamily="{DynamicResource MonoFont}" Tag="denon_events" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Tip: In Home Assistant, click your Profile (bottom-left) → Security → Long-Lived Access Tokens → Create Token."
                                       FontSize="{DynamicResource FontSize04}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Auto-Push & Live Telemetry Preview -->
                    <CheckBox Content="Automatically push Denon AVR Power, Volume, Input &amp; Smart Scene events to Home Assistant"
                              IsChecked="{Binding PushEvents}"
                              Foreground="{DynamicResource TextStrongBrush}"
                              Margin="{skin:Space 0,0,0,8}" />

                    <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius03}" Padding="{skin:Space 10,7}" Margin="{skin:Space 0,0,0,8}">
                        <TextBlock Text="{Binding TelemetryPreviewText}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize03}" Foreground="{DynamicResource AccentCyanBrightBrush}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource FontSize05}" Foreground="{DynamicResource AccentEmeraldBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ======================== ENTITIES & CONTROLS CARD ======================== -->
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <Grid Margin="{skin:Space 0,0,0,10}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{skin:Size 10}" />
                            <ColumnDefinition Width="{skin:Size 210}" />
                            <ColumnDefinition Width="{skin:Size 8}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SCENES, SCRIPTS, SWITCHES &amp; LIGHTS" FontSize="{DynamicResource FontSize03}" FontWeight="Bold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Ink08Brush}" BorderBrush="{DynamicResource Ink12Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 6,1.5}" Margin="{skin:Space 8,0,0,0}">
                                <TextBlock Text="{Binding EntitiesCountLabel}" FontSize="{DynamicResource FontSize02}" Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBox Grid.Column="2"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource HaInput}"
                                 Padding="{skin:Space 8,4}"
                                 FontSize="{DynamicResource FontSize05}"
                                 Tag="Filter entities..." />
                        <Button Grid.Column="4" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource HaBtn}" Padding="{skin:Space 10,4.5}" FontSize="{DynamicResource FontSize05}" />
                    </Grid>

                    <!-- Domain Filter Pills -->
                    <WrapPanel Margin="{skin:Space 0,0,0,8}">
                        <Button Content="All" Command="{Binding SetDomainFilterCommand}" CommandParameter="all">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="all">
                                            <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Scenes" Command="{Binding SetDomainFilterCommand}" CommandParameter="scene">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="scene">
                                            <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Scripts" Command="{Binding SetDomainFilterCommand}" CommandParameter="script">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="script">
                                            <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Switches" Command="{Binding SetDomainFilterCommand}" CommandParameter="switch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="switch">
                                            <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Lights" Command="{Binding SetDomainFilterCommand}" CommandParameter="light">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HaFilterChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDomainFilter}" Value="light">
                                            <Setter Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>

                    <!-- Empty State Hint -->
                    <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource Ink11Brush}" BorderThickness="1" CornerRadius="{DynamicResource Radius04}" Padding="{skin:Space 14}" Margin="{skin:Space 0,4,0,0}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEntities}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No Home Assistant entities to show yet. Enter your URL &amp; Access Token and click Save &amp; Sync — or click Try Demo to explore virtual blinds, smart plugs &amp; scenes!"
                                   FontSize="{DynamicResource FontSize06}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Entity Tiles -->
                    <ItemsControl ItemsSource="{Binding Entities}" Visibility="{Binding HasEntities, Converter={StaticResource HaBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.TriggerEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="{skin:Space 0,0,8,8}"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="EntBd"
                                                    Background="{DynamicResource CardElevatedBrush}"
                                                    BorderBrush="{DynamicResource Ink12Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource Radius04}"
                                                    Padding="{skin:Space 12,8}"
                                                    MinWidth="{skin:Size 205}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="{skin:Size 28}" Height="{skin:Size 24}" CornerRadius="{DynamicResource Radius02}" Background="{DynamicResource Ink05Brush}" BorderBrush="{DynamicResource Ink14Brush}" BorderThickness="1" Margin="{skin:Space 0,0,9,0}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DomainBadge}" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource AccentEmeraldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="{skin:Size 165}">
                                                        <TextBlock Text="{Binding FriendlyName}" FontSize="{DynamicResource FontSize06}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding EntityId}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FontSize01}" Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border x:Name="StatePill" Grid.Column="2" Background="{DynamicResource Ink05Brush}" BorderBrush="{DynamicResource BorderSpecBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius02}" Padding="{skin:Space 7,2}" Margin="{skin:Space 10,0,0,0}" VerticalAlignment="Center">
                                                        <TextBlock x:Name="StateTxt" Text="{Binding StateLabel}" FontSize="{DynamicResource FontSize01}" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter TargetName="EntBd" Property="Background" Value="{DynamicResource AccentEmeraldSubtleBgDeepBrush}" />
                                                    <Setter TargetName="EntBd" Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                                    <Setter TargetName="StatePill" Property="Background" Value="{DynamicResource AccentEmeraldDeeperBrush}" />
                                                    <Setter TargetName="StatePill" Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                                    <Setter TargetName="StateTxt" Property="Foreground" Value="{DynamicResource AccentEmeraldTextBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="EntBd" Property="BorderBrush" Value="{DynamicResource AccentEmeraldBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
