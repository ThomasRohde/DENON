<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer probe for the Apple TV plugin: discovery now; pairing and protocol dumps in later milestones. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>atvprobe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Denon.Plugin.AppleTv\Denon.Plugin.AppleTv.csproj" />
    <ProjectReference Include="..\..\Denon.App.PluginSdk\Denon.App.PluginSdk.csproj" />
  </ItemGroup>

</Project>
